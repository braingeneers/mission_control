#!/usr/bin/env python3
"""Entry point; resolve symlinks so the adjacent package is always used."""
import os
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
from nrp_monitor.cli import main

VERSION = "@NRP_MONITOR_VERSION@"
if __name__ == "__main__" and not VERSION.startswith("@"):
    os.environ["NRP_MONITOR_BINARY_VERSION"] = VERSION

if __name__ == "__main__":
    main()
