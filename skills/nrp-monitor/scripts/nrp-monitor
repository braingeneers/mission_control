#!/usr/bin/env python3
"""nrp-monitor: agent-free NRP monitoring, approved tasks and Job chains (no model runs unless something needs a decision).
(Former name nrp-watchdog: the old command is a quiet shim, NRP_WATCHDOG_* variables are honored as a fallback, and install.sh migrates the
old state dir, which stays reachable through a symlink.)

v2 (owner decision 2026-11-05, design docs/design.md): approved work is a TASK.
  nrp-monitor task add TASK.json | list | show NAME | resume NAME [--skip STAGE] [--retries N] [--note TEXT] [--gpu-ok-until DATE] | cancel NAME
  nrp-monitor task handoff NAME FILE                  attach a handoff to a task that was registered without one (written once; see Task field handoff)
  nrp-monitor task stage NAME STAGE --resumable        mark a stage of a registered task as resumable (re-run skips finished items; one 2x deadline resubmit)
  nrp-monitor setup [--non-interactive ...]          choose which assistant (claude / codex / gemini) runs Tier 1 and Tier 2; writes agents.json
  task add ... --origin-harness t3|claude|codex [--origin-session ID --origin-cwd DIR]   where the coordinator chat runs: the monitor wakes THAT chat
  nrp-monitor digest [--hours 24]                    silent events + what needs the owner
  nrp-task ...                                        (wrapper for `nrp-monitor tool`) the fix agent's only shell tool
  nrp-monitor plan sync PATH#ID | list | show ID      plan-run plans (on_done continuation; OFF unless <state>/on_done.enabled exists)
  Task field on_done {plan: PATH#ID, from_step: STEP}: when the task is done, ONE Sonnet continue agent checks the step's "done when"
  and may register the next step (nrp-task next-add) only inside approved_through, never a stop_for_owner step, each step once;
  for that step it may also write + test code on a monitor/<task> branch (nrp-task code-begin|code-test|code-commit|code-ship), inside may_touch.
  Task field handoff: path to a markdown file (absolute, ~, or relative to the TASK.json's folder) written by the registering agent from
  templates/handoff.md once the monitor is started. `task add` checks it (warns when missing, empty or without a substantial `## Registrar`
  section of 200+ characters; NRP_MONITOR_REQUIRE_HANDOFF=1 refuses instead, like NRP_MONITOR_REQUIRE_CONTINUATION) and COPIES it to
  <task dir>/handoff.md: agents only ever see that copy. Fix, continue and follow-up prompts embed it. Fix and continue agents end their answer
  with a HANDOFF_ENTRY: block; the script appends it (UTC time, agent kind, attempt) to `## Fix log` / `## Continuation` (a FOR_OWNER: line goes to
  `## For the owner`; no block: one automatic line) and restores the Registrar from handoff.orig.md if its hash ever changes. A finished task with
  no (or a thin) handoff is listed in the digest as `no-handoff`.
  Stage fields: job, manifest, done_s3, after (stage ids), after_s3 (s3:// URIs that must ALL exist before the stage is submitted: a gate on
  another task's success marker; `task show` lists them as waiting-on).
  A pass submits ready stages, checks done_s3, saves logs and deletes finished Jobs, classifies a failure (resources, util,
  code, queue, infra, outputs, unknown, slow, repeated) and runs the escalation ladder: Tier 0 script rules (incl. deadline extension,
  queue-time credit, one 2x resubmit of a `resumable` stage), Tier 1 triage judge (templates/task_triage.md; CLOSE closes
  the event), Tier 2 ONE fresh fixer (templates/task_agent.md) within the retry budget, Tier 3 the task's coordinator chat
  (status WITH_COORDINATOR, an `escalation` webhook event; the chat runs `task resume` or `task needs-owner`). Retries are silent.
  NEEDS_OWNER (the chat's `task needs-owner`, no webhook / undeliverable or unanswered wake, watch-only, GPU approval, blocked 6 h)
  sends ONE push: a Slack DM to the owner (notification-service, ~/.ssh/braingeneers_jwt_token.json) plus a Claude
  PushNotification, and a macOS banner only if both fail. Everything else goes to digest.log. Pod checks: strike 1 is
  recorded by the script (resize advice, silent); strike 2 / STUCK goes to the task's fix agent, or for a pod outside any
  task, to a Sonnet pod-check agent. The banner-per-event notifications described below are now digest lines.
  Util waiver: a util fix agent may end with `UTIL_OK: evidence` (the Job runs and progresses, deleting it would lose work). The script
  accepts it only when the failure is class util, the flag came from the lab floor alone (rule=lab in nrp-util-check's line; never an NRP
  band or a GPU flag), the stage is not a GPU stage, the Job is Running now and the task has waivers left (util_waiver_max, default 3).
  Then the task keeps running, no retry is used and nobody is messaged; the Job's lab-floor flag is suppressed for util_waiver_hours
  (default 6) or until the Job ends; a `util-waived` digest line and `task show` record it. Anything else is the usual STOP to the owner.

  nrp-monitor run [--dry-run] [--fake-util FILE] [--fake-finished JOB[,JOB]]   one pass (launchd every 5 min, or a terminal loop)
  nrp-monitor add JOB [--resume FILE] [--label TEXT] [-n NS]                   register a job to follow (resume <= 20 KB, copied)
  nrp-monitor list                                                              registered jobs and status
  nrp-monitor log [-n N]                                                        tail of monitor.log
  nrp-monitor status [--quiet]                                                  heartbeat age; exit 3 + warning if stale (>25 min) while work is active
  nrp-monitor chain add FILE [--dry-run]                                        validate + copy a chain file; the next pass starts it
  nrp-monitor chain list | show NAME | cancel NAME
  nrp-monitor chain wait NAME [-m SECONDS]                                      block on the state file; ONE line; exit 0 finished,
                                                                                 1 stopped/cancelled, 2 no chain, 3 -m reached, 4 manual gate, 5 monitor stalled
  nrp-monitor chain resume NAME [--skip STEP] [--edit-step STEP KEY=VALUE]      clear a stop or gate after a person decides

State: ~/.local/state/nrp-monitor (env NRP_MONITOR_STATE overrides):
  jobs.json monitor.log lock state.lock heartbeat templates/ work/ resume/<job>.md chains/<name>/{chain.json,spec.original.json,logs/}
  Nothing under Desktop/Documents/Downloads is read at run time (macOS TCC blocks launchd there): resume notes and chain files
  are copied here when added, and chain cwd under those folders is refused.

One pass (plan: docs/design.md, owner decision 2026-11-04):
 0. Chains (first, because submits are time-critical), per active chain, using ONE `kubectl get jobs -o json` per namespace:
    - a step is ready when all `after` steps are done, it is not gated, its Job does not exist, and fewer than the cap of our
      Jobs are unfinished (policy max_concurrent_jobs: 400 shared, a local override may lower it; NRP_MONITOR_MAX_JOBS lowers it for a run). Order: state "submitting" is saved, argv runs (clean env, step cwd),
      then "running". After a crash a "submitting" step whose Job exists is adopted; one whose Job is missing fails.
    - succeeded Job: last 200 log lines + `describe` job/pods saved to chains/<name>/logs/<step>.txt, `done_s3` URIs checked
      EXACTLY with `aws s3api head-object` (never a prefix `s3 ls`), the Job deleted by name, step done.
    - failed Job, missing S3 output, run past deadline_s (+ max(10 min, 10%)): logs saved, chain STOPPED, notification.
      Nothing is retried or resized and a failed Job is left in the cluster. `chain resume` (optionally --skip / --edit-step)
      is the only way on; a retried step first deletes its old finished Job by name.
    - `gate: manual` step: chain GATED, notification, waits for `chain resume`.
    - all steps done: chain FINISHED; on_finish "notify" (default) or "agent" (one fresh Sonnet agent given the notes, a compact
      step summary and the log file paths; templates/job_followup.md).
    Chain file (JSON, or YAML if PyYAML exists): name, owner, namespace, notes (<=20 KB), on_finish, followup, s3_endpoint,
    aws_profile, steps[{id, job, cwd, argv, env, after, done_s3, gate, deadline_s, state: pending|running|done}].
    `state: running|done` adopts a Job that is already submitted/finished. No secrets in env: the file is stored on disk.
 1. Utilization: nrp-util-check --min-age 300 over the owner's pods in braingeneers (nrp.ai/username annotation).
    Nothing flagged: exit silently. LOW or STUCK pod: ONE fresh headless Haiku agent per pod (templates/pod_check.md)
    that may delete only that pod (or its Job). The rule is about resources, not progress (owner decision 2026-11-04):
    stuck/idle -> delete; first flag -> OVERSIZED (kept, resize advice); an "[NRP violation]" pod flagged again on
    the next pass (strike 2) -> delete. Strikes live in jobs.json "strikes" and reset when a pass does not flag the
    pod. OVERSIZED/DELETED lines are appended to resize.log and to the owner Job's resume notes when registered.
    FAILED pod: notify once, nothing deleted (it holds no resources and
    its logs may still be wanted). 2+ violating pods: notify at once. This script never deletes anything itself
    except a chain's own step Job, by name.
 2. Jobs: a registered job that finished (ok or failed) with a --resume file launches ONE fresh Sonnet agent
    (read-only: kubectl get/describe/logs and `nrp-s3-read ls|cat s3://...`)
    (templates/job_followup.md) with the notes inline, then is marked handled. Without --resume: notify only.
 3. Notifications: macOS osascript. Slack/email: stub (notify_slack), nothing is sent.
 4. Heartbeat: every pass writes <state>/heartbeat (ISO time + counters); `status` and `chain wait` read it.
Headless agents: fixed cwd under work/, scrubbed environment (no secrets), --permission-mode dontAsk with a
per-pod allowlist, --max-turns and --max-budget-usd caps. Chain steps run with the same scrubbed environment plus
AWS_PROFILE/AWS_CONFIG_FILE/AWS_SHARED_CREDENTIALS_FILE/AWS_DEFAULT_REGION when set; credentials are read from ~/.aws and ~/.kube.
"""
import argparse
import collections
import contextlib
import fcntl
import getpass
import hashlib
import json
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
from datetime import datetime, timedelta, timezone
from pathlib import Path

NS = "braingeneers"

for _k in [k for k in os.environ if k.startswith("NRP_WATCHDOG_")]: os.environ.setdefault("NRP_MONITOR_" + _k[13:], os.environ[_k])   # former variable names, honored silently when the new one is unset


def default_state_dir():
    """~/.local/state/nrp-monitor; only when that does not exist yet and a real old nrp-watchdog dir does (install.sh has not migrated it
    yet) is the old dir used, so a pass never splits its state in two."""
    base = Path.home() / ".local/state"
    old = base / "nrp-watchdog"
    return old if not (base / "nrp-monitor").exists() and old.is_dir() and not old.is_symlink() else base / "nrp-monitor"


STATE = Path(os.environ.get("NRP_MONITOR_STATE") or default_state_dir())   # env: tests


def _owner_cfg():
    """Who this installation works for: <state>/config.json, each key overridable by an environment variable. Keys:
    nrp_user_annotation (the nrp.ai/username annotation value on your pods, e.g. http://cilogon.org/serverE/users/NNNN),
    slack_user_id (the Slack user who gets the one DM), owner_label (label value on the monitor's own check Jobs), owner_name (how messages and agent prompts name you),
    skip_limit_fraction (optional; the share of skipped items above which a failure goes to you; default 0.05),
    tier0_mem_cap_gi (optional; the largest memory in GiB the Tier 0 OOM rule may set without asking an agent; default 128),
    util_waiver_max (optional; how many util waivers one task may get before the owner is asked; default 3; 0 = never waive),
    util_waiver_hours (optional; how long one waiver lasts; default 6)."""
    try:
        c = json.loads((STATE / "config.json").read_text())
        return c if isinstance(c, dict) else {}
    except (OSError, ValueError):
        return {}


OWNER = _owner_cfg()
USER_ANN = os.environ.get("NRP_MONITOR_USER_ANNOTATION") or OWNER.get("nrp_user_annotation") or ""
OWNER_LABEL = os.environ.get("NRP_MONITOR_OWNER_LABEL") or OWNER.get("owner_label") or getpass.getuser()
OWNER_NAME = os.environ.get("NRP_MONITOR_OWNER_NAME") or OWNER.get("owner_name") or OWNER_LABEL      # how messages and agent prompts name the person
JOBS, LOG, LOCK = STATE / "jobs.json", STATE / "monitor.log", STATE / "lock"
TPL, WORK = STATE / "templates", STATE / "work"
SLOCK, CHAINS, RESUME_DIR, HEART = STATE / "state.lock", STATE / "chains", STATE / "resume", STATE / "heartbeat"
RESIZE_LOG = STATE / "resize.log"
RESUME_MAX = 20 * 1024                 # bytes: resume notes and chain notes are read by a fresh agent, keep them short
_UTIL = []


def util_policy():
    """The effective utilization policy, read by the sibling `nrp-util-check` (shared file + optional local override; one
    implementation). Returns {} when the sibling is not beside this script (the built-in defaults then apply)."""
    if not _UTIL:
        mod = None
        try:
            import importlib.machinery, importlib.util
            f = Path(__file__).resolve().parent / "nrp-util-check"
            if f.is_file():
                ld = importlib.machinery.SourceFileLoader("nrp_util_check_policy", str(f))
                mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(ld.name, ld))
                ld.exec_module(mod)
        except Exception as e:
            mod = None
            log("utilization policy not readable (%s); built-in defaults" % str(e)[:100])
        if mod is not None:
            for w in mod.POLICY_WARNINGS:
                log(w)
        _UTIL.append(dict(mod.POLICY) if mod is not None else {})
    return _UTIL[0]


DEFAULT_MAX_JOBS = 400                 # the nrp-cluster skill's "max concurrent jobs"


def max_jobs():
    """Cap on our unfinished Jobs at once: `max_concurrent_jobs` of the effective policy (shared default 400; a local override
    may only lower it). NRP_MONITOR_MAX_JOBS can lower it further for one run."""
    n = util_policy().get("max_concurrent_jobs") or DEFAULT_MAX_JOBS
    try:
        e = int(os.environ.get("NRP_MONITOR_MAX_JOBS") or 0)
    except ValueError:
        e = 0
    return min(n, e) if e > 0 else n


def _skip_limit():
    """Fraction of items whose single-item skips make a failure a pattern that goes to the owner (settings: skip_limit_fraction in
    config.json or NRP_MONITOR_SKIP_LIMIT_FRACTION; default 0.05, from the owner's house rules)."""
    v = os.environ.get("NRP_MONITOR_SKIP_LIMIT_FRACTION") or OWNER.get("skip_limit_fraction")
    try:
        v = float(v)
        if 0 < v <= 1:
            return v
    except (TypeError, ValueError):
        pass
    return 0.05


def skip_limit_text():
    return "%g%%" % round(100 * _skip_limit(), 4)


def util_waiver_max():
    """How many util waivers one task may be given (settings: util_waiver_max in config.json or NRP_MONITOR_UTIL_WAIVER_MAX; default 3;
    0 turns waivers off). Once a task has used them, a util flag that survives the fix agent goes to the owner again."""
    v = os.environ.get("NRP_MONITOR_UTIL_WAIVER_MAX")
    v = OWNER.get("util_waiver_max") if v in (None, "") else v
    try:
        v = int(v)
        if v >= 0:
            return v
    except (TypeError, ValueError):
        pass
    return 3


def util_waiver_hours():
    """How long one util waiver suppresses the lab-floor flag of its Job (util_waiver_hours in config.json or NRP_MONITOR_UTIL_WAIVER_HOURS; default 6)."""
    v = os.environ.get("NRP_MONITOR_UTIL_WAIVER_HOURS")
    v = OWNER.get("util_waiver_hours") if v in (None, "") else v
    try:
        v = float(v)
        if 0 < v <= 24 * 30:
            return v
    except (TypeError, ValueError):
        pass
    return 6.0


MISSING_GRACE_S = 10 * 60              # a just-submitted chain Job not yet listed is given this long
SUBMIT_TIMEOUT_S = 900
HEART_WARN_S = 25 * 60                 # `status` warns past this when work is active
HEART_STALL_S = 30 * 60                # `chain wait` gives up (exit 5) past this
WAIT_POLL_S = int(os.environ.get("NRP_MONITOR_POLL_S") or 30)
DEFAULT_S3 = "https://s3-west.nrp-nautilus.io"
POD_DEDUPE_S = 30 * 60
STRIKE_GAP_S = 8 * 60          # strike 2 needs a flag this long after the OVERSIZED verdict: the second pass after it (passes run every 5 min)
NOTIFY_DEDUPE_S = 60 * 60
JOB_GRACE_S = 15 * 60          # a registered job not yet visible in the cluster is given this long
MAX_POD_AGENTS = 3
POD_MODEL, POD_TURNS, POD_BUDGET = "sonnet", "15", "1.00"   # runs only at strike 2 / STUCK (owner decision 2026-11-05: a bigger agent)
JOB_MODEL, JOB_TURNS, JOB_BUDGET = "sonnet", "25", "2.00"
TRIAGE_MODEL, TRIAGE_TURNS, TRIAGE_BUDGET, TRIAGE_TIMEOUT = "haiku", "12", "0.50", 600
FOLLOWUP_REPAIR_ATTEMPTS = 2  # after Haiku: at most two Sonnet attempts, then one alert
AUTH_TURNS, AUTH_BUDGET, AUTH_TIMEOUT = "45", "4.00", 2400   # authorized (debug + resubmit) follow-ups
APPROVED = STATE / "approved"                                # per task: manifest.yaml, code/, code.orig/, PATCH.diff
CODE_SNAPSHOT_MAX = 30 * 1024 * 1024
CODE_SKIP = (".git", "__pycache__", ".pytest_cache", "results", "node_modules")
CLONE_SUFFIXES = frozenset({".py", ".yaml", ".yml", ".json", ".lock", ".txt", ".csv", ".ini", ".md", ".R", ".sh"})   # source and config; same idea as pv3 --ship-code
CLONE_MAX_FILE = 2 * 1024 * 1024
CODE_SKIP_EXT = (".pt", ".npz", ".npy", ".pth", ".safetensors", ".h5", ".nwb", ".fasta", ".fa", ".gz", ".tgz", ".zip")
FLAG = re.compile(r"^(LOW|HIGH|STUCK|FAILED) (?!checked \d+ pods)(\S+?):?(?:\s|$)")
ACCT = re.compile(r"account: (\d+) of (\d+) running pods outside NRP bands")


def now():
    return time.time()


def log(msg):
    STATE.mkdir(parents=True, exist_ok=True)
    with open(LOG, "a") as f:
        f.write("%s %s\n" % (datetime.now().isoformat(timespec="seconds"), " ".join(msg.split())))


def load():
    try:
        d = json.loads(JOBS.read_text())
    except Exception:
        d = {}
    d.setdefault("jobs", {})
    d.setdefault("pods", {})
    d.setdefault("strikes", {})
    d.setdefault("notified", {})
    d.setdefault("errors", 0)
    d.setdefault("kube_errors", 0)
    return d


def save(d):
    tmp = JOBS.with_suffix(".tmp")
    tmp.write_text(json.dumps(d, indent=1, sort_keys=True))
    os.replace(tmp, JOBS)


# ---- origin: which chat a person returns to (owner decision 2026-11-05) --------------------------------------------------
# Every alert is sent by this script (or by a repair agent it starts), never by the chat that owns the work. A task, chain or
# legacy registration therefore carries `origin` = {title, link, assistant, collaborator, note?, evidence?, recorded, source}:
# the human-facing chat that asked for the work. It is supplied explicitly (JSON "origin", --origin-* flags, or the
# `origin` command for work registered before this existed) and never guessed: T3CODE_THREAD_ID inside an agent names
# the agent's own (possibly delegated) thread, not the chat the person talks to. No origin -> "origin not recorded" plus
# the goal and code repo so the person can still find the owner.
ORIGIN_MISSING = "origin not recorded"
ORIGIN_FIELDS = ("title", "link", "assistant", "collaborator", "note", "evidence", "harness", "session", "cwd")
# v3: the origin also says HOW to wake that same chat. `harness` is t3 (CLI or webhook, link = the T3 thread), claude (a Claude Code
# session id, resumed with `claude -p --resume ID`) or codex (a Codex session id, `codex exec resume ID`). `session` is that id and `cwd` the
# directory the chat ran in (Claude Code finds a session by its project directory). A wake lands in that chat's own history; it never starts one.
ORIGIN_HARNESSES = ("t3", "claude", "codex")
ORIGIN_SESSION_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{3,99}$")
SESSION_ENV = {"claude": "CLAUDE_CODE_SESSION_ID", "codex": "CODEX_THREAD_ID"}   # set in the shell of a Claude Code / Codex session
ORIGIN_LINK_RE = re.compile(r"^(t3-thread://[^\s<>|]+|https?://[^\s<>|]+)$")


def one_line(s, n):
    return " ".join(str(s).replace("`", "'").split())[:n]


def norm_origin(raw, source="registered"):
    """Validated origin dict, or None when raw is empty. Raises ChainError on a malformed value."""
    if raw in (None, {}, ""):
        return None
    if not isinstance(raw, dict):
        raise ChainError("origin: object {title, link, assistant, collaborator}")
    bad = sorted(set(raw) - set(ORIGIN_FIELDS))
    if bad:
        raise ChainError("origin: unknown field(s) %s (allowed: %s)" % (", ".join(bad), ", ".join(ORIGIN_FIELDS)))
    o = {k: one_line(raw[k], {"title": 120, "link": 300, "note": 200, "evidence": 300, "cwd": 300}.get(k, 80))
         for k in ORIGIN_FIELDS if raw.get(k) not in (None, "")}
    if o.get("harness") and o["harness"] not in ORIGIN_HARNESSES:
        raise ChainError("origin.harness: one of %s (got %r)" % (", ".join(ORIGIN_HARNESSES), o["harness"][:20]))
    if o.get("session") and not ORIGIN_SESSION_RE.match(o["session"]):
        raise ChainError("origin.session: a session id (letters, digits, . _ : -; 4-100 characters), got %r" % o["session"][:40])
    if o.get("session") and o.get("harness") not in ("claude", "codex"):
        raise ChainError("origin.session needs origin.harness claude or codex (a T3 chat is reached through its webhook and link)")
    if o.get("harness") in ("claude", "codex") and not o.get("session"):
        raise ChainError("origin.harness %s needs origin.session: the id of the chat to wake (--origin-session ID; %s is read when it is "
                         "set in this shell)" % (o["harness"], SESSION_ENV[o["harness"]]))
    if o.get("cwd") and not (o["cwd"].startswith("/") and ".." not in o["cwd"].split("/")):
        raise ChainError("origin.cwd: an absolute directory path without ..")
    link = o.get("link", "")
    if link.startswith("<") and link.endswith(">"):                    # T3 prints links as <t3-thread://...>
        link = o["link"] = link[1:-1]
    if link and not ORIGIN_LINK_RE.match(link):
        raise ChainError("origin.link: a t3-thread://... or https://... link without spaces, <, > or | (got %r)" % link[:60])
    if not o.get("title") and not link and not o.get("session"):
        raise ChainError("origin: needs the chat title and/or its exact link (the chat a person returns to)")
    o.setdefault("collaborator", OWNER_NAME)
    o["recorded"], o["source"] = iso(), source
    return o


def detect_session(harness):
    """The session id of the assistant running THIS command, from its environment, or "". Used only when --origin-harness is given
    without --origin-session: the person said which harness, the id is read, never guessed from anything else. A delegated child agent has
    its own session, not the chat's, so a Claude Code child session gets a warning."""
    v = os.environ.get(SESSION_ENV.get(harness, ""), "")
    if v and harness == "claude" and os.environ.get("CLAUDE_CODE_CHILD_SESSION"):
        print("warning: CLAUDE_CODE_CHILD_SESSION is set: %s may be a delegated child agent's session, not the chat the person talks to. "
              "Pass --origin-session with the chat's own id if they differ." % SESSION_ENV[harness], file=sys.stderr)
    return v


def origin_overlay(raw_origin, a):
    """JSON origin (dict or None) overlaid with --origin-* flags; the flags win. A claude/codex harness without a session takes the id from
    the environment of the assistant running this command, and without a cwd the current directory."""
    flags = {k: getattr(a, "origin_" + k, None) for k in ("title", "link", "assistant", "collaborator", "harness", "session", "cwd")}
    flags = {k: v for k, v in flags.items() if v}
    if raw_origin not in (None, {}) and not isinstance(raw_origin, dict):
        return raw_origin                                              # let norm_origin refuse it
    merged = dict(raw_origin or {}, **flags) if flags else raw_origin
    if isinstance(merged, dict) and merged.get("harness") in ("claude", "codex"):
        if not merged.get("session"):
            merged = dict(merged, session=detect_session(merged["harness"]))
        if not merged.get("cwd"):
            merged = dict(merged, cwd=os.getcwd())
    return merged


def add_origin_args(p):
    p.add_argument("--origin-title", help="title of the chat that owns this work (where a person returns on an alert)")
    p.add_argument("--origin-link", help="exact link of that chat, e.g. t3-thread://v2/ENV/THREAD (T3 thread_read prints it)")
    p.add_argument("--origin-assistant", help="assistant and model of that chat, e.g. 'Codex gpt-6-astra' (optional)")
    p.add_argument("--origin-collaborator", help="person the chat works with (default: the owner_name setting)")
    p.add_argument("--origin-harness", choices=ORIGIN_HARNESSES,
                   help="where the chat runs, so the monitor wakes THAT chat: t3 (thread link or webhook), claude (Claude Code session), codex (Codex session)")
    p.add_argument("--origin-session", help="session id of the claude/codex chat to wake (default: read from CLAUDE_CODE_SESSION_ID / CODEX_THREAD_ID)")
    p.add_argument("--origin-cwd", help="directory the claude/codex chat runs in (default: the current directory); Claude Code finds sessions by it")


def require_origin_note(o, kind, name, always=False):
    """Refuse (always=True, or when NRP_MONITOR_REQUIRE_ORIGIN is set) or warn on stderr; returns nothing."""
    if o:
        return
    msg = ("%s %s has no origin: alerts will say 'origin not recorded' and the person cannot tell which chat owns it. "
           "Add \"origin\": {\"title\": ..., \"link\": ...} (or --origin-title/--origin-link) naming the chat that asked for it; "
           "for existing work: nrp-monitor origin %s %s --title ... --link ... --evidence ..." % (kind, name, kind, name))
    if always or os.environ.get("NRP_MONITOR_REQUIRE_ORIGIN"):
        sys.exit("%s refused: %s" % (kind, msg))
    print("warning: " + msg, file=sys.stderr)


def origin_plain(o, fallback=""):
    """One line for the digest, CLI and banners."""
    if not o:
        return "%s%s" % (ORIGIN_MISSING, " (%s)" % fallback if fallback else "")
    who = ", ".join(x for x in (o.get("assistant"), "with " + o["collaborator"] if o.get("collaborator") else "") if x)
    return "chat %s%s%s" % ('"%s"' % o["title"] if o.get("title") else "(untitled)", " (%s)" % who if who else "",
                            " " + o["link"] if o.get("link") else (" %s session %s" % (o.get("harness", ""), o["session"]) if o.get("session") else ""))


def origin_tag(o):
    return "[%s]" % ((o or {}).get("title") or (o or {}).get("link") or ORIGIN_MISSING)[:40]


def slack_esc(s):
    """Slack mrkdwn escaping (https://api.slack.com/reference/surfaces/formatting#escaping): & < > only."""
    return str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def origin_slack(o, fallback=""):
    """Slack lines. The link is a literal code span: Slack does not turn a custom scheme (t3-thread://) into a
    clickable link, so the title is bold and the exact link is copyable; https links get the <url|title> form."""
    if not o:
        return ["*%s*%s" % (ORIGIN_MISSING, slack_esc(" (%s)" % fallback) if fallback else "")]
    who = ", ".join(x for x in (o.get("assistant"), "working with " + o["collaborator"] if o.get("collaborator") else "") if x)
    title = o.get("title") or "(untitled chat)"
    link = o.get("link", "")
    head = "*Return to chat: %s*%s" % (("<%s|%s>" % (link, slack_esc(title)) if link.startswith("http") else slack_esc(title)),
                                      slack_esc(" (%s)" % who) if who else "")
    out = [head]
    if link and not link.startswith("http"):
        out.append("`%s`" % link)
    return out


def lookup_origin(ref):
    """(origin or None, fallback text) for a ref: 'task NAME' / bare task or legacy-job name / 'chain:NAME' / 'job:NAME'."""
    if not ref or ref == "-":
        return None, ""
    kind, _, name = ref.partition(":") if ref.startswith(("chain:", "job:", "task:")) else ("", "", ref)
    if kind in ("", "task"):
        t = task_load(name) if TASK_RE.match(name or "") else None
        if t:
            c = t.get("code") or {}
            return t.get("origin"), "task %s: %s%s" % (name, t.get("goal", "")[:70], "; code %s/%s" % (Path(c["repo"]).name, c.get("subdir") or ".") if c.get("repo") else "")
    if kind in ("", "job"):
        rec = load()["jobs"].get(name)
        if rec:
            return rec.get("origin"), "job %s: %s" % (name, (rec.get("label") or "")[:70])
    if kind in ("", "chain"):
        c = chain_load(name) if name and "/" not in name else None
        if c:
            return c.get("origin"), "chain %s: %s" % (name, (c.get("owner") or "")[:70])
    return None, "%s (no such registration)" % ref


def owner_of_job(st, job):
    """Registration that owns Job `job`: 'task:NAME', 'chain:NAME', 'job:NAME' or None."""
    tk = task_of_job(job) if job else None
    if tk:
        return "task:" + tk[0]
    for cn in chain_names():
        if any(s["job"] == job for s in (chain_load(cn) or {}).get("steps", [])):
            return "chain:" + cn
    if job and job in st["jobs"]:
        return "job:" + job
    return None


def slack_text(body, refs):
    """Text of the Slack DM. `refs` = registrations the alert is about; empty = shared/system alert, not one chat's.
    Origin first (what a person needs to act), then the script's own attribution (mission-control skill: identify the
    speaker and collaborator). Everything dynamic is escaped."""
    refs = list(dict.fromkeys(refs or []))
    lines = []
    if not refs:
        lines.append("*Not tied to one chat* (account-wide or monitor check; no single chat owns it).")
    for ref in refs[:4]:
        o, fb = lookup_origin(ref)
        pl = origin_slack(o, fb)
        lines += pl if len(refs) == 1 else ["%s %s" % (slack_esc(ref), pl[0])] + pl[1:]
    if len(refs) > 4:
        lines.append("(+%d more registrations)" % (len(refs) - 4))
    lines.append("*NRP monitor* (automated script, working with %s; not a chat): " % OWNER_NAME + slack_esc(body))
    return "\n".join(lines)[:3900]


def short_tag(refs):
    """Prefix for banners and the Claude push (190 chars): the chat title(s), or 'origin not recorded'/'shared'."""
    refs = list(dict.fromkeys(refs or []))
    if not refs:
        return "[shared] "
    return "".join(origin_tag(lookup_origin(r)[0]) for r in refs[:3]) + " "


# ---- notifications -------------------------------------------------------------------------------------------
def notify(msg, state=None, key=None, dry=False, ref="-"):
    """v2 (owner decision 2026-11-05): routine events are SILENT and go to the digest; push() is the one interruption.
    With key, repeats within NOTIFY_DEDUPE_S are dropped. `ref` names the owning registration for the digest."""
    msg = " ".join(msg.split())[:400]
    if dry:
        print("[dry-run] would notify: " + msg)
        return
    if state is not None and key:
        if now() - state["notified"].get(key, 0) < NOTIFY_DEDUPE_S:
            return
        state["notified"][key] = now()
    log("notify: " + msg)
    digest("event", msg, ref)


# ---- headless agents -----------------------------------------------------------------------------------------
def clean_env():
    keep = ("PATH", "HOME", "USER", "LOGNAME", "LANG", "LC_ALL", "TMPDIR", "SHELL", "KUBECONFIG", "XDG_CONFIG_HOME",
            "NRP_MONITOR_STATE", "NRP_MONITOR_TESTING", "NRP_MONITOR_NO_WAKE", "NRP_MONITOR_T3_BIN",
            "NRP_MONITOR_CLAUDE_BIN", "NRP_MONITOR_CODEX_BIN", "NRP_TASK_CACHE", "NRP_MONITOR_NO_PUSH", "NRP_MONITOR_S3_ENDPOINT", "NRP_TASK_PYTHON")
    return {k: v for k, v in os.environ.items() if k in keep}


# ---- agent runners: which CLI starts an agent, per-tier models, fallback when one is out of usage ------------------
# `agent_cmd` builds the Claude Code command (a plain list, so dry-runs and tests read it as before) and attaches a spec.
# `run_agent` / `run_task_agent` start it through the first runner in <state>/agents.json "runners" that is not out of
# usage. A usage-limit answer blocks that runner until its reset time (<state>/runners.json) and the next runner takes
# over; with none left the work waits (no retry is used up) and one DM says so. Without agents.json: Claude only, with
# the constants above, exactly as before.
#   {"runners": ["claude", "codex"],
#    "models": {"triage": {"claude": "haiku", "codex": "gpt-6.1-sol"}, "repair": {...}, "task": {...}, "pod": {...}},
#    "limits": {"repair": {"turns": 25, "budget": 2.0, "timeout": 1500}},      # turns/budget apply to Claude only
#    "followup_ladder": ["triage", "repair", "repair"]}                         # what a finished job's follow-up tries, in order
# v3 (`nrp-monitor setup` writes this): each tier names an ordered list of backends, chosen at install time from the subscriptions the
# user has. The next entry is used ONLY when the one before it is unavailable (usage/rate limit, not signed in, CLI missing); a bad
# answer never fails over. Every failover is a line in the task's events and the digest. Without "tiers" the old `runners` x `models`
# form still loads and means the same ordered list per tier.
#   "tiers": {"triage": [{"runner": "gemini", "model": "gemini-3.8-flash", "thinking": "lowest"}, {"runner": "claude", "model": "haiku"}],
#             "task":   [{"runner": "claude", "model": "sonnet"}]}
# Tier 3 is always the task's coordinator chat (no entry); there is no separate Opus tier.
# Codex runs `codex exec` with approvals off, a workspace-write sandbox (no network, writes only to the agent's own
# directories) and an execpolicy rules file generated from the same allowlist: a matching command may use the network,
# anything else stays in the sandbox. Unlike Claude's dontAsk, a Codex agent can still READ any file the user can.
AGENTS_CFG, RUNNER_STATE = STATE / "agents.json", STATE / "runners.json"
KNOWN_RUNNERS = ("claude", "codex", "gemini", "agy")
GEMINI_TIERS = ("triage",)             # the gemini runner only runs the read-only verdict tier (see exec_gemini); config naming it elsewhere is refused
THINKING_LEVELS = ("lowest", "low", "medium", "high")
TIERS = ("pod", "triage", "repair", "repair_auth", "task", "deputy")
LADDER_STEPS = ("triage", "repair")
UNAVAILABLE = "AGENT UNAVAILABLE"
LIMIT_ANY = re.compile(r"(hit your (?:weekly |usage |\w+ )?limit|usage limit|weekly limit|rate.?limit|quota (?:exceeded|exhausted)|out of (?:credits|usage)|"
                       r"resource.?exhausted|exceeded your (?:current )?quota|too many requests)", re.I)
AUTH_ANY = re.compile(r"(not (?:logged|signed) in|please (?:log ?in|sign in|run /login)|/login\b|invalid (?:api key|authentication)|api key not valid|"
                      r"authentication (?:failed|error|required)|unauthenticated|failed to (?:log ?in|authenticate)|login required|"
                      r"please set an auth method|GEMINI_API_KEY|credentials? (?:expired|invalid|not found)|oauth\b.*(?:expired|invalid))", re.I)
AUTH_BLOCK_S = 3600                    # a runner that is not signed in is set aside this long, then tried again
LIMIT_START = re.compile(r"^(you['’]ve hit your|you have hit your|claude (?:ai )?usage limit)", re.I)


def default_agent_cfg():
    return {"runners": ["claude"],
            "models": {"pod": {"claude": POD_MODEL}, "triage": {"claude": TRIAGE_MODEL}, "repair": {"claude": JOB_MODEL},
                       "repair_auth": {"claude": JOB_MODEL}, "task": {"claude": TASK_MODEL}, "deputy": {"claude": "sonnet", "codex": "gpt-6.1-sol"}},
            "limits": {"pod": {"turns": POD_TURNS, "budget": POD_BUDGET, "timeout": 900},
                       "triage": {"turns": TRIAGE_TURNS, "budget": TRIAGE_BUDGET, "timeout": TRIAGE_TIMEOUT},
                       "repair": {"turns": JOB_TURNS, "budget": JOB_BUDGET, "timeout": 1500},
                       "repair_auth": {"turns": AUTH_TURNS, "budget": AUTH_BUDGET, "timeout": AUTH_TIMEOUT},
                       "task": {"turns": TASK_TURNS, "budget": TASK_BUDGET, "timeout": TASK_TIMEOUT},
                       "deputy": {"turns": TASK_TURNS, "budget": TASK_BUDGET, "timeout": TASK_TIMEOUT}},
            "followup_ladder": ["triage"] + ["repair"] * FOLLOWUP_REPAIR_ATTEMPTS,
            "tiers": {}}


def check_backend(tier, i, b):
    """One validated `tiers.<tier>[i]` entry: {runner, model?, thinking?} -> normalised dict. Raises ValueError."""
    w = "tiers.%s[%d]" % (tier, i)
    if not isinstance(b, dict) or set(b) - {"runner", "model", "thinking"}:
        raise ValueError("%s: an object {runner, model, thinking}" % w)
    r = b.get("runner")
    if r not in KNOWN_RUNNERS:
        raise ValueError("%s.runner: one of %s" % (w, "/".join(KNOWN_RUNNERS)))
    if r in ("gemini", "agy") and tier not in GEMINI_TIERS:
        raise ValueError("%s: this runner is limited to the %s tier (a read-only verdict); use claude or codex for %s" % (w, "/".join(GEMINI_TIERS), tier))
    out = {"runner": r}
    if b.get("model") is not None:
        if not isinstance(b["model"], str) or not re.fullmatch(r"[A-Za-z0-9._:/-]{1,64}", b["model"]):
            raise ValueError("%s.model: a model name" % w)
        out["model"] = b["model"]
    th = b.get("thinking")
    if th is not None:
        if r != "gemini":
            raise ValueError("%s.thinking: only the gemini runner takes a thinking setting" % w)
        if not ((isinstance(th, str) and th in THINKING_LEVELS) or (isinstance(th, int) and not isinstance(th, bool) and 0 <= th <= 32768)):
            raise ValueError("%s.thinking: one of %s, or a token budget (integer)" % (w, ", ".join(THINKING_LEVELS)))
        out["thinking"] = th
    return out


def parse_agent_cfg(raw):
    """The effective config for a parsed agents.json object (defaults + overrides). Raises ValueError naming the first problem."""
    cfg = default_agent_cfg()
    if not isinstance(raw, dict):
        raise ValueError("top level must be an object")
    bad = sorted(set(raw) - {"runners", "models", "limits", "followup_ladder", "tiers"})
    if bad:
        raise ValueError("unknown key(s) %s" % ", ".join(bad))
    if "runners" in raw:
        rs = raw["runners"]
        if not (isinstance(rs, list) and rs and len(set(rs)) == len(rs) and all(r in KNOWN_RUNNERS for r in rs)):
            raise ValueError("runners: a non-empty list of %s, first = preferred" % "/".join(KNOWN_RUNNERS))
        cfg["runners"] = list(rs)
    for tier, per in (raw.get("models") or {}).items():
        if tier not in TIERS or not isinstance(per, dict):
            raise ValueError("models.%s: tier must be one of %s with {runner: model}" % (tier, ", ".join(TIERS)))
        for r, m in per.items():
            if r not in KNOWN_RUNNERS or not isinstance(m, str) or not re.fullmatch(r"[A-Za-z0-9._:/-]{1,64}", m):
                raise ValueError("models.%s.%s: a model name" % (tier, r))
            cfg["models"].setdefault(tier, {})[r] = m
    for tier, per in (raw.get("limits") or {}).items():
        if tier not in TIERS or not isinstance(per, dict) or set(per) - {"turns", "budget", "timeout"}:
            raise ValueError("limits.%s: tier + {turns, budget, timeout}" % tier)
        for k, v in per.items():
            if isinstance(v, bool) or not isinstance(v, (int, float, str)) or float(v) <= 0:
                raise ValueError("limits.%s.%s: a positive number" % (tier, k))
            cfg["limits"][tier][k] = int(v) if k == "timeout" else str(v)
    if "followup_ladder" in raw:
        ld = raw["followup_ladder"]
        if not (isinstance(ld, list) and 1 <= len(ld) <= 6 and all(x in LADDER_STEPS for x in ld)):
            raise ValueError("followup_ladder: 1-6 steps, each triage or repair")
        cfg["followup_ladder"] = list(ld)
    if "tiers" in raw:
        tr = raw["tiers"]
        if not isinstance(tr, dict):
            raise ValueError("tiers: {tier: [backend, ...]}")
        for tier, lst in tr.items():
            if tier not in TIERS or not isinstance(lst, list) or not 1 <= len(lst) <= 4:
                raise ValueError("tiers.%s: tier must be one of %s with 1-4 backends, first = preferred" % (tier, ", ".join(TIERS)))
            cfg["tiers"][tier] = [check_backend(tier, i, b) for i, b in enumerate(lst)]
        if "runners" not in raw:                                          # the runners are the ones the tiers name (status, `agents test`)
            names = []
            for lst in cfg["tiers"].values():
                names += [b["runner"] for b in lst if b["runner"] not in names]
            cfg["runners"] = names + [r for r in cfg["runners"] if r not in names]
    return cfg


def load_agent_cfg():
    """(config, problem). A missing file is the defaults; an invalid one is the defaults plus a problem text (never a crash)."""
    if not AGENTS_CFG.exists():
        return default_agent_cfg(), None
    try:
        return parse_agent_cfg(json.loads(AGENTS_CFG.read_text())), None
    except (ValueError, OSError) as e:
        return default_agent_cfg(), "agents.json ignored (defaults used): %s" % e


def agent_cfg():
    cfg, problem = load_agent_cfg()
    if problem and PASS.get("cfg_problem") != problem:
        PASS["cfg_problem"] = problem
        log(problem)
        digest("fault", problem)
    return cfg


def tier_settings(tier, runner):
    cfg = agent_cfg()
    lim = cfg["limits"][tier]
    return {"model": cfg["models"].get(tier, {}).get(runner), "turns": str(lim["turns"]), "budget": str(lim["budget"]),
            "timeout": int(lim["timeout"])}


def tier_backends(tier):
    """The ordered backends a tier may use: `tiers.<tier>` when configured, else the old `runners` x `models` form (the gemini runner only for
    the tiers it is limited to)."""
    cfg = agent_cfg()
    if tier == "deputy" and not cfg["tiers"].get(tier):
        return [{"runner": "claude", "model": cfg["models"]["deputy"]["claude"]}]
    if cfg["tiers"].get(tier):
        return [dict(b) for b in cfg["tiers"][tier]]
    return [dict({"runner": r}, **({"model": cfg["models"][tier][r]} if cfg["models"].get(tier, {}).get(r) else {}))
            for r in cfg["runners"] if r not in ("gemini", "agy") or tier in GEMINI_TIERS]


def spec_model(spec, runner):
    """The model a runner uses for this spec: the backend dispatch chose, else the tier's `models` entry."""
    b = spec.get("backend") or {}
    return b.get("model") or tier_settings(spec["tier"], runner)["model"]


class AgentCmd(list):
    """The Claude form of an agent command (a list) plus the spec every runner builds its own command from."""
    spec = None


def claude_argv(spec):
    s = tier_settings(spec["tier"], "claude")
    argv = ["claude", "-p", "--model", spec_model(spec, "claude") or s["model"], "--max-turns", s["turns"], "--max-budget-usd", s["budget"],
            "--permission-mode", "dontAsk", "--no-session-persistence"]
    if spec["json"]:
        argv += ["--output-format", "json"]
    if spec["allowed"]:                                                   # dontAsk denies everything else; an empty list is not a valid flag value
        argv += ["--allowedTools"] + spec["allowed"]
    if spec["deny"]:
        argv += ["--disallowedTools"] + spec["deny"]
    return argv


def agent_cmd(tier, allowed, json_out=False, deny=()):
    spec = {"tier": tier, "allowed": list(allowed), "json": json_out, "deny": list(deny)}
    cmd = AgentCmd(claude_argv(spec))
    cmd.spec = spec
    return cmd


def limit_hit(rc, out, err):
    """True when a finished agent process answered with a usage limit instead of doing the work."""
    out = (out or "").strip()
    text = out
    if out.startswith("{"):                                               # claude --output-format json; gemini -o json has `error`
        try:
            j = json.loads(out)
            text = str(j.get("result") or j.get("error") or "")
            rc = rc or (1 if j.get("is_error") or j.get("error") else 0)
        except ValueError:
            pass
    if rc:
        return bool(LIMIT_ANY.search(text[-600:] + "\n" + (err or "")[-600:]))
    return bool(LIMIT_START.search(text[:200]))


def auth_hit(rc, out, err):
    """True when a finished agent process failed because the CLI is not signed in / its credentials are invalid (not a bad answer)."""
    out = (out or "").strip()
    text = out
    if out.startswith("{"):
        try:
            j = json.loads(out)
            text = str(j.get("result") or j.get("error") or "")
            rc = rc or (1 if j.get("is_error") or j.get("error") else 0)
        except ValueError:
            pass
    return bool(rc) and bool(AUTH_ANY.search(text + "\n" + (err or "")) or re.search(
        r"IneligibleTierError|UNSUPPORTED_CLIENT|no longer supported for Gemini Code Assist", out + "\n" + (err or ""), re.I))


def reset_time(text):
    """Epoch seconds of 'resets 2pm (America/Los_Angeles)' (next occurrence, plus a minute), or None."""
    m = re.search(r"resets?\s+(?:at\s+)?(\d{1,2})(?::(\d{2}))?\s*(am|pm)(?:\s*\(([^)]+)\))?", text or "", re.I)
    if not m:
        return None
    hh = int(m.group(1)) % 12 + (12 if m.group(3).lower() == "pm" else 0)
    try:
        from zoneinfo import ZoneInfo
        tz = ZoneInfo(m.group(4)) if m.group(4) else datetime.now().astimezone().tzinfo
    except Exception:
        tz = datetime.now().astimezone().tzinfo
    n = datetime.now(tz)
    t = n.replace(hour=hh, minute=int(m.group(2) or 0), second=0, microsecond=0)
    if t <= n:
        t += timedelta(days=1)
    return t.timestamp() + 60


def runner_ready(name):
    return shutil.which(name, path=clean_env().get("PATH")) is not None


def runner_blocked(name):
    return float((read_json(RUNNER_STATE, {}).get(name) or {}).get("until", 0)) > now()


def available_runners():
    return [r for r in agent_cfg()["runners"] if not runner_blocked(r) and runner_ready(r)]


def agents_available():
    return bool(available_runners())


def is_unavailable(text):
    return str(text).startswith(UNAVAILABLE)


def unavailable_text():
    st, bits = read_json(RUNNER_STATE, {}), []
    for r in agent_cfg()["runners"]:
        u = float((st.get(r) or {}).get("until", 0))
        bits.append("%s %s" % (r, ("%s until %s" % ("not signed in, retried" if (st.get(r) or {}).get("kind") == "auth" else "out of usage",
                                                    datetime.fromtimestamp(u).strftime("%a %H:%M"))) if u > now() else
                               "not installed" if not runner_ready(r) else "unavailable"))
    return "%s: %s" % (UNAVAILABLE, "; ".join(bits))


def block_runner(runner, out, err, kind="limit"):
    """Set a runner aside: `limit` until its reset time (usage / rate limit), `auth` for AUTH_BLOCK_S (not signed in)."""
    text = " ".join(((out or "") + " " + (err or "")).split())
    if kind == "auth":
        m = AUTH_ANY.search(text)
        why = text[max(0, m.start() - 20):m.end() + 100] if m else text[:120]
        until = now() + AUTH_BLOCK_S
    else:
        m = LIMIT_ANY.search(text)
        why = text[max(0, m.start() - 20):m.end() + 100] if m else text[:120]
        until = reset_time(text) or now() + 3600
        until = min(max(until, now() + 300), now() + 8 * 86400)
    st = read_json(RUNNER_STATE, {})
    st[runner] = {"until": until, "since": now(), "why": why[:200], "kind": kind}
    STATE.mkdir(parents=True, exist_ok=True)
    write_json(RUNNER_STATE, st)
    what = "is not signed in (auth error); tried again after" if kind == "auth" else "is out of usage until"
    log("agent runner %s %s %s: %s" % (runner, what, iso_at(until), why[:160]))
    digest("fault", "agent runner %s %s %s (%s); %s" % (
        runner, what, iso_at(until), why[:100], "work moves to " + ", ".join(available_runners()) if available_runners() else "no runner left: agent work waits"))
    if not available_runners():
        push("agents unavailable: %s. Fix agents and follow-ups wait (no retry is used up) and resume by themselves; "
             "`nrp-monitor agents` shows the state, or add a runner in agents.json." % unavailable_text().split(": ", 1)[1],
             "agents:unavailable")


def iso_at(t):
    return datetime.fromtimestamp(t).strftime("%Y-%m-%d %H:%M")


def exec_claude(spec, prompt, cwd, timeout, env):
    try:
        r = subprocess.run(claude_argv(spec), input=prompt, capture_output=True, text=True, cwd=str(cwd), env=env, timeout=timeout)
    except subprocess.TimeoutExpired:
        return "timeout", "", "", None
    if limit_hit(r.returncode, r.stdout, r.stderr):
        return "limit", r.stdout, r.stderr, r.returncode
    return ("auth" if auth_hit(r.returncode, r.stdout, r.stderr) else "ok"), r.stdout, r.stderr, r.returncode


def codex_rules(allowed):
    """Claude `Bash(prefix:*)` allowlist entries as Codex execpolicy rules: a matching command runs outside the sandbox
    (network, kubectl); everything else stays sandboxed."""
    rules = []
    for a in allowed:
        m = re.fullmatch(r"Bash\((.*?)(?::\*)?\)", a)
        if not m:
            continue
        try:
            toks = shlex.split(m.group(1))
        except ValueError:
            continue
        if toks:
            rules.append("prefix_rule(pattern=%s, decision=\"allow\")" % json.dumps(toks))
    return "\n".join(rules) + "\n"


def codex_writable(allowed):
    """Directories the Claude allowlist lets the agent edit (Edit/Write rules), minus anything inside .git."""
    out = []
    for a in allowed:
        m = re.fullmatch(r"(?:Edit|Write)\(/(/.*?)/\*\*\)", a)
        if m and ".git" not in m.group(1).split("/") and m.group(1) not in out:
            out.append(m.group(1))
    return out


def exec_codex(spec, prompt, cwd, timeout, env):
    auth = Path(os.environ.get("NRP_MONITOR_CODEX_AUTH") or Path.home() / ".codex" / "auth.json")   # env: tests
    if not auth.exists():
        return "auth", "", "codex is not signed in (no %s)" % auth, 1
    s = tier_settings(spec["tier"], "codex")
    s["model"] = spec_model(spec, "codex")
    WORK.mkdir(parents=True, exist_ok=True)
    home = Path(tempfile.mkdtemp(prefix="codex-home-", dir=str(WORK)))
    try:
        (home / "rules").mkdir()
        os.symlink(str(auth), str(home / "auth.json"))
        (home / "rules" / "monitor.rules").write_text(codex_rules(spec["allowed"]))
        last = home / "last.txt"
        argv = ["codex", "exec", "-s", "read-only" if spec["tier"] == "triage" else "workspace-write", "-c", 'approval_policy="never"',
                "-c", "sandbox_workspace_write.exclude_tmpdir_env_var=true", "-c", "sandbox_workspace_write.exclude_slash_tmp=true",
                "--skip-git-repo-check", "--ephemeral", "-C", str(cwd), "-o", str(last)]
        for d in codex_writable(spec["allowed"]):
            argv += ["--add-dir", d]
        if s["model"]:
            argv += ["-m", s["model"]]
        argv.append("-")
        try:
            r = subprocess.run(argv, input=prompt, capture_output=True, text=True, cwd=str(cwd), env=dict(env, CODEX_HOME=str(home)),
                               timeout=timeout)
        except subprocess.TimeoutExpired:
            return "timeout", "", "", None
        text = last.read_text().strip() if last.exists() else ""
        if limit_hit(r.returncode, text or r.stdout, r.stderr):
            return "limit", text or r.stdout, r.stderr, r.returncode
        if auth_hit(r.returncode, text or r.stdout, r.stderr):
            return "auth", text or r.stdout, r.stderr, r.returncode
        if spec["json"]:
            text = json.dumps({"result": text or (r.stderr.strip() or r.stdout.strip())[-300:], "is_error": bool(r.returncode),
                               "total_cost_usd": None, "num_turns": None, "permission_denials": [], "runner": "codex",
                               "usage": {"total_tokens": int(re.search(r"tokens used\s+([\d,]+)", r.stderr).group(1).replace(",", ""))} if re.search(r"tokens used\s+([\d,]+)", r.stderr) else None})
        return "ok", text or (r.stdout if r.returncode else ""), r.stderr, r.returncode
    finally:
        shutil.rmtree(str(home), ignore_errors=True)


# ---- gemini runner (v3): the local `gemini` CLI, read-only verdict tiers only (GEMINI_TIERS) ----------------------
# Non-interactive (`-p`, prompt on stdin), JSON output, approval mode `default` (anything not allowed is denied: there is nobody to ask).
# The allowlist is enforced by Gemini CLI's policy engine through an ADMIN policy file written per run (highest priority tier): every tool is
# denied, then only the same `Bash(prefix:*)` commands and `Read(/dir/**)` paths the Claude runner gets are allowed; edit/write rules are never
# translated, so a gemini agent cannot change a file. Thinking depth is set through a per-run system settings file
# (GEMINI_CLI_SYSTEM_SETTINGS_PATH) that defines a model alias with a thinkingConfig; the user's own ~/.gemini is not touched. Documented in the CLI's
# own docs; the policy enforcement itself has not been exercised against the live model (references/agents.md).
GEMINI_THINKING = {"lowest": "MINIMAL", "low": "LOW", "medium": "MEDIUM", "high": "HIGH"}


def gemini_policy(allowed):
    """TOML for Gemini CLI's policy engine from a Claude-style allowlist: deny everything, allow the listed commands and read paths."""
    prefixes, reads = [], []
    for a in allowed:
        m = re.fullmatch(r"Bash\((.*?)(?::\*)?\)", a)
        if m and m.group(1).strip() and '"' not in m.group(1) and "\\" not in m.group(1):
            prefixes.append(m.group(1).strip())
            continue
        m = re.fullmatch(r"Read\(/(/.*?)/\*\*\)", a)
        if m and "'" not in m.group(1) and ".." not in m.group(1).split("/"):
            reads.append(m.group(1))
    out = ['# generated per run by nrp-monitor: deny everything, then allow only what the tier is allowed',
           '[[rule]]', 'toolName = "*"', 'decision = "deny"', 'priority = 1', '']
    if prefixes:
        out += ['[[rule]]', 'toolName = "run_shell_command"', 'commandPrefix = [%s]' % ", ".join(json.dumps(x) for x in prefixes),
                'decision = "allow"', 'priority = 100', '']
    for d in reads:                                                      # TOML literal strings ('...') keep the backslashes of the regex as they are
        rx = re.sub(r"([.^$*+?()\[\]{}|\\])", r"\\\1", d)
        out += ['[[rule]]', 'toolName = "read_file"', "argsPattern = '.*\"file_path\":\"%s/[^\"]*\".*'" % rx, 'decision = "allow"', 'priority = 100', '']
    if reads:
        out += ['[[rule]]', 'toolName = "read_file"', "argsPattern = '\\.\\./'", 'decision = "deny"', 'priority = 900', '']
    return "\n".join(out) + "\n"


def gemini_settings(tier, backend):
    """(alias or None, settings dict) for the system settings file: the model alias carries the thinking setting; MCP servers, auto-update and
    usage statistics are off for the unattended run."""
    st = {"privacy": {"usageStatisticsEnabled": False}, "general": {"disableAutoUpdate": True}, "mcp": {"allowed": []}}
    th, model = backend.get("thinking"), backend.get("model")
    if th is None or not model:
        return model, st
    cfgc = {"thinkingConfig": ({"thinkingLevel": GEMINI_THINKING[th]} if isinstance(th, str) else {"thinkingBudget": int(th)})}
    alias = "nrp-monitor-%s" % tier
    st["modelConfigs"] = {"customAliases": {alias: {"extends": "base", "modelConfig": {"model": model, "generateContentConfig": cfgc}}}}
    return alias, st


def gemini_argv(spec, policy_path, alias):
    argv = ["gemini", "-p", "Answer now, following the instructions above. Reply with the final answer only.",
            "--approval-mode", "default", "--skip-trust", "-o", "json", "--admin-policy", str(policy_path)]
    if alias:
        argv += ["-m", alias]
    return argv


def exec_gemini(spec, prompt, cwd, timeout, env):
    if spec["tier"] not in GEMINI_TIERS:                                   # also enforced in the config; never run gemini with write power
        return "error", "", "the gemini runner only runs the %s tier" % "/".join(GEMINI_TIERS), 1
    b = spec.get("backend") or {}
    WORK.mkdir(parents=True, exist_ok=True)
    home = Path(tempfile.mkdtemp(prefix="gemini-run-", dir=str(WORK)))
    try:
        (home / "policy.toml").write_text(gemini_policy(spec["allowed"]))
        alias, settings = gemini_settings(spec["tier"], b)
        (home / "settings.json").write_text(json.dumps(settings))
        argv = gemini_argv(spec, home / "policy.toml", alias)
        try:
            r = subprocess.run(argv, input=prompt, capture_output=True, text=True, cwd=str(cwd), timeout=timeout,
                               env=dict(env, GEMINI_CLI_SYSTEM_SETTINGS_PATH=str(home / "settings.json")))
        except subprocess.TimeoutExpired:
            return "timeout", "", "", None
        if limit_hit(r.returncode, r.stdout, r.stderr):
            return "limit", r.stdout, r.stderr, r.returncode
        if auth_hit(r.returncode, r.stdout, r.stderr):
            return "auth", r.stdout, r.stderr, r.returncode
        text, err = (r.stdout or "").strip(), False
        j = {}
        try:
            j = json.loads(text)
            text, err = str(j.get("response") or "").strip(), bool(j.get("error"))
        except ValueError:
            pass
        if spec["json"]:
            text = json.dumps({"result": text or (r.stderr.strip() or r.stdout.strip())[-300:], "is_error": bool(r.returncode or err),
                               "total_cost_usd": None, "num_turns": None, "permission_denials": [], "runner": "gemini", "usage": j.get("usage") or j.get("stats")})
        return "ok", text, r.stderr, r.returncode
    finally:
        shutil.rmtree(str(home), ignore_errors=True)


# Antigravity hooks use camelCase toolCall payloads, unlike Claude hooks.
# The gate is a separate immutable copy in the per-run workspace, never agent-authored.
AGY_GATE = r'''import json, re, shlex, sys
from pathlib import Path
cfg = json.loads(Path(sys.argv[1]).read_text())
call = json.load(sys.stdin).get("toolCall", {})
args = call.get("args") or {}
ok = False
if call.get("name") == "run_command":
    cmd = args.get("CommandLine", "")
    # No shell composition, expansion, redirection, or escaped/newline tokens.
    if not re.search(r"[;&|<>`$\\\n\r]", cmd):
        words = shlex.split(cmd)
        for rule in cfg:
            m = re.fullmatch(r"Bash\((nrp-task (?:show|logs|describe|util|s3).*?)(?::\*)?\)", rule)
            if m:
                prefix = shlex.split(m.group(1))
                ok |= words[:len(prefix)] == prefix
elif call.get("name") == "view_file":
    raw = args.get("AbsolutePath", "")
    if raw and ".." not in Path(raw).parts:
        path = Path(raw).resolve()
        for rule in cfg:
            m = re.fullmatch(r"Read\(/(/.*?)/\*\*\)", rule)
            if m:
                root = Path(m.group(1)).resolve()
                ok |= path.is_relative_to(root)
print(json.dumps({"decision": "allow" if ok else "deny", "reason": "nrp-monitor read-only allowlist"}))
'''


def agy_workspace(home, allowed):
    hooks = home / ".agents"
    hooks.mkdir(parents=True)
    (hooks / "allow.json").write_text(json.dumps(allowed))
    (hooks / "gate.py").write_text(AGY_GATE)
    import shlex
    command = " ".join(shlex.quote(x) for x in (sys.executable, str(hooks / "gate.py"), str(hooks / "allow.json")))
    (hooks / "hooks.json").write_text(json.dumps({"nrp-monitor": {"PreToolUse": [
        {"matcher": "*", "hooks": [{"type": "command", "command": command, "timeout": 10}]}]}}))


def exec_agy(spec, prompt, cwd, timeout, env):
    if spec["tier"] != "triage":
        return "error", "", "agy is read-only triage only", 1
    WORK.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="agy-run-", dir=str(WORK)) as td:
        home = Path(td)
        agy_workspace(home, spec["allowed"])
        argv = ["agy", "--print", prompt, "--mode", "plan", "--effort", "low",
                "--output-format", "json", "--model", (spec.get("backend") or {}).get("model") or "gemini-3.8-flash-low"]
        try:
            r = subprocess.run(argv, cwd=str(home), env=env, capture_output=True, text=True, timeout=timeout)
        except subprocess.TimeoutExpired:
            return "timeout", "", "", None
        if limit_hit(r.returncode, r.stdout, r.stderr):
            return "limit", r.stdout, r.stderr, r.returncode
        if auth_hit(r.returncode, r.stdout, r.stderr):
            return "auth", r.stdout, r.stderr, r.returncode
        text, failed = r.stdout.strip(), bool(r.returncode)
        try:
            j = json.loads(text)
            text = str(j.get("result") or j.get("response") or j.get("error") or "")
            failed = failed or bool(j.get("is_error") or j.get("error"))
        except ValueError:
            pass
        if spec["json"]:
            text = json.dumps({"result": text, "is_error": failed, "runner": "agy"})
        return "ok", text, r.stderr, r.returncode


RUNNER_EXEC = {"claude": exec_claude, "codex": exec_codex, "gemini": exec_gemini, "agy": exec_agy}


def backend_name(b):
    return "%s%s" % (b["runner"], "/" + b["model"] if b.get("model") else "")


def note_failover(spec, backends, i, why, on_failover):
    """One line per failover (log, digest, and the task's events through `on_failover`): which backend was unavailable, why, who takes over."""
    nxt = next((x for x in backends[i + 1:] if not runner_blocked(x["runner"]) and runner_ready(x["runner"])), None)
    msg = "backend failover (tier %s): %s unavailable (%s); %s" % (spec["tier"], backend_name(backends[i]), why[:120],
                                                                     "using " + backend_name(nxt) if nxt else "no backend left for this tier")
    log(msg)
    digest("failover", msg)
    if on_failover:
        on_failover(msg)


def dispatch_agent(spec, prompt, cwd, timeout=None, env=None, on_failover=None):
    """(runner, status, out, err, rc). status: ok | timeout | unavailable (every backend of the tier is out of usage, not signed in or missing).
    Backends are tried in the tier's order; the next one is used ONLY when one is unavailable. A timeout or a bad answer is returned as is."""
    cwd.mkdir(parents=True, exist_ok=True)
    env = env or clean_env()
    backends = tier_backends(spec["tier"])
    for i, b in enumerate(backends):
        runner = b["runner"]
        if not runner_ready(runner):
            note_failover(spec, backends, i, "not installed", on_failover)
            continue
        if runner_blocked(runner):
            u = float((read_json(RUNNER_STATE, {}).get(runner) or {}).get("until", 0))
            note_failover(spec, backends, i, "set aside until %s" % iso_at(u), on_failover)
            continue
        status, out, err, rc = RUNNER_EXEC[runner](dict(spec, backend=b), prompt, cwd, timeout or tier_settings(spec["tier"], runner)["timeout"], env)
        if status in ("limit", "auth"):
            block_runner(runner, out, err, status)
            note_failover(spec, backends, i, "usage limit" if status == "limit" else "not signed in", on_failover)
            continue
        if spec.get("json"):
            try:
                payload = json.loads(out)
                payload.setdefault("model", b.get("model") or tier_settings(spec["tier"], runner)["model"])
                out = json.dumps(payload)
            except (ValueError, AttributeError):
                pass
        if status == "ok":
            push_clear("agents:unavailable")
        return runner, status, out, err, rc
    return None, "unavailable", unavailable_text(), "", None


def run_agent(cmd, prompt, cwd, timeout=None):
    spec = dict(cmd.spec, json=True)
    runner, status, stdout, stderr, rc = dispatch_agent(spec, prompt, cwd, timeout)
    try:
        result = json.loads(stdout)
        text = str(result.get("result") or "")
    except (ValueError, AttributeError):
        result, text = {}, stdout
    tier = spec["tier"]
    kind = "pod_agent" if tier == "pod" else "followup"
    cost_event(spec.get("ledger_task", cwd.name), kind, "1" if tier == "triage" else "2",
               "resolved" if followup_solved(text) or (tier == "pod" and re.match(r"^(DELETED|OVERSIZED|KEPT|NOTFOUND)\b", text)) else "stopped" if status != "ok" else "escalated",
               runner=runner, model=result.get("model"), result=result)
    stdout = text
    if status == "unavailable":
        return stdout
    if status == "timeout":
        return "AGENT TIMEOUT"
    out = [l.strip() for l in stdout.splitlines() if l.strip()]
    if rc:
        return "AGENT ERROR rc=%d %s" % (rc, (stderr.strip() or stdout.strip())[-300:])
    verdict = [l for l in out if re.match(r"(DELETED|OVERSIZED|KEPT|NOTFOUND|RESUBMITTED|DONE|STOPPED|ESCALATE)\b", l)]
    return (verdict[-1] if verdict else out[-1]) if out else "AGENT EMPTY"


def kube_read_allow(k):
    """Read-only kubectl patterns for headless follow-up agents. Both flag orders work: `kubectl -n NS get job X` and
    `kubectl get job X -n NS` (agents write the second; a literal `kubectl -n NS get` prefix denied it, 2026-11-05).
    Only job/pod/event reads and logs/describe are allowed, never secrets."""
    pats = [k + " get:*", k + " describe:*", k + " logs:*"]
    pats += ["kubectl get job:*", "kubectl get jobs:*", "kubectl get pod:*", "kubectl get pods:*", "kubectl get event:*", "kubectl get events:*",
             "kubectl describe job:*", "kubectl describe pod:*", "kubectl logs:*"]
    return ["Bash(%s)" % p for p in pats]


def auth_allowed(k, job, ns, adir):
    """Task-level approval (owner decision 2026-11-05): the task was approved when it was registered with --authorize, so the follow-up
    agent may debug and resubmit it without asking: apply Job files, create a ConfigMap, delete THIS task's finished Jobs, edit the
    task's own files under approved/<task>/, and register the replacement (the script enforces the attempt cap and the
    same-failure rule there). It cannot touch secrets, other namespaces or other people's Jobs."""
    a = str(APPROVED).rstrip("/")                    # all task dirs: a next-stage task needs its own manifest dir
    pats = [k + " apply:*", k + " create configmap:*", k + " delete job %s:*" % job,
            "kubectl apply:*", "kubectl create configmap:*", "kubectl delete job %s:*" % job,
            "nrp-monitor add:*", "nrp-monitor list", "nrp-watchdog add:*", "nrp-watchdog list", "tar czf:*", "tar tzf:*", "diff:*", "ls:*", "cat %s/:*" % a, "python3 -m py_compile:*"]
    out = ["Bash(%s)" % p for p in pats]
    out += ["Read(/%s/**)" % a, "Edit(/%s/**)" % a]     # leading // = absolute path; Edit rules cover Write too
    return out


def pod_allowed(pod, owner_job):
    k = "kubectl -n %s" % NS
    a = ["Bash(%s get pod %s:*)" % (k, pod), "Bash(%s logs %s:*)" % (k, pod), "Bash(%s describe pod %s:*)" % (k, pod),
         "Bash(%s exec %s -- nvidia-smi:*)" % (k, pod), "Bash(%s delete pod %s)" % (k, pod),
         "Bash(nrp-util-check:*)"]
    if owner_job:
        a += ["Bash(%s get job %s:*)" % (k, owner_job), "Bash(%s delete job %s)" % (k, owner_job)]
    return a


def pod_prompt(pod, flag_line, owner_job, strike=1):
    t = (TPL / "pod_check.md").read_text()
    text = ("first flag" if strike < 2 else
            "flagged again on the pass after an OVERSIZED warning")
    return (t.replace("{strike}", str(strike)).replace("{strike_text}", text).replace("{pod}", pod).replace("{ns}", NS).replace("{flag_line}", flag_line)
            .replace("{owner_job}", owner_job or "(none: not owned by a Job)").replace("{user}", USER_ANN).replace("{owner}", OWNER_NAME))


def job_prompt(job, rec, status, resume_text):
    t = (TPL / "job_followup.md").read_text()
    out = (t.replace("{job}", job).replace("{ns}", rec.get("ns", NS)).replace("{status}", status)
           .replace("{label}", rec.get("label") or "").replace("{origin}", origin_plain(rec.get("origin")))
           .replace("{resume}", resume_text))
    au = rec.get("authorize")
    if au:
        ta = (TPL / "job_authorized.md").read_text()
        out += "\n" + (ta.replace("{job}", job).replace("{ns}", rec.get("ns", NS)).replace("{dir}", au["dir"])
                        .replace("{attempt}", str(au["attempt"])).replace("{max}", str(au["max"]))
                        .replace("{root}", au["root"]).replace("{failures}", "; ".join(au.get("failures", [])) or "none yet")
                        .replace("{has_manifest}", "yes: %s/manifest.yaml" % au["dir"] if au.get("manifest") else "no (the notes say how the Job was made)")
                        .replace("{has_code}", "yes: %s/code (original in code.orig)" % au["dir"] if au.get("code") else "no"))
    return out


# ---- cluster reads -------------------------------------------------------------------------------------------
def kubectl(*args, timeout=120):
    return subprocess.run(["kubectl", *args], capture_output=True, text=True, timeout=timeout)


def my_pods():
    """{name: owner_job_or_None} for the owner's pods that are Running, Pending or Failed (by annotation)."""
    if not USER_ANN:
        raise RuntimeError("nrp_user_annotation is not set (config.json or NRP_MONITOR_USER_ANNOTATION): cannot tell which pods are yours")
    r = kubectl("-n", NS, "get", "pods", "-o", "json")
    if r.returncode:
        raise RuntimeError(r.stderr.strip()[:150])
    out = {}
    for p in json.loads(r.stdout)["items"]:
        m = p["metadata"]
        if m.get("annotations", {}).get("nrp.ai/username") != USER_ANN or m.get("deletionTimestamp"):
            continue
        if p["status"].get("phase") not in ("Running", "Pending", "Failed"):
            continue
        job = next((o["name"] for o in m.get("ownerReferences", []) if o.get("kind") == "Job"), None)
        out[m["name"]] = job
    return out


def job_state(name, ns):
    """'ok' | 'FAILED' | 'running' | 'pending' | 'missing' | 'error'"""
    r = kubectl("-n", ns, "get", "job", name, "-o", "jsonpath={.status.succeeded}/{.status.failed}/{.status.active}/{.spec.completions}"
                "/{.status.conditions[?(@.type==\"Complete\")].status}")
    if r.returncode:
        return "missing" if "NotFound" in r.stderr else "error"
    ok, fail, act, comp, done = (r.stdout.split("/") + ["", "", "", "", ""])[:5]
    if job_complete(int(ok) if ok.isdigit() else 0, int(comp) if comp.isdigit() else None, bool(act), done == "True"):
        return "ok"
    if fail.isdigit() and int(fail) >= 1 and not act:
        return "FAILED"
    return "running" if act else "pending"


# ---- run -----------------------------------------------------------------------------------------------------
def acct_alarm(st, lines, bad, dry, mine=None):
    """Push once when NRP's own count (or our [NRP violation]/STUCK flags) is 3+ on 2 passes in a row.
    One high pass is ignored: nrp-util-check's account count includes pods that started a minute ago."""
    acct = max([int(m.group(1)) for l in lines for m in [ACCT.search(l)] if m] or [0])
    nrp = [f[1] for f in bad if f[0] == "STUCK" or "[NRP violation]" in f[2]]
    hi = acct >= 3 or len(nrp) >= 3
    if not dry:
        st["acct_hi"] = st.get("acct_hi", 0) + 1 if hi else 0
    if hi and st.get("acct_hi", 0) >= 2:
        owners = [o for o in (owner_of_job(st, (mine or {}).get(p)) for p in nrp) if o]     # chats whose pods are flagged (may be none)
        push("NRP counts %d of your running pods outside its utilization bands on 2 passes in a row (it blocks new submits "
             "past 4)%s. The monitor deletes and resizes task and chain pods at strike 2; other pods need you."
             % (acct, ("; flagged: " + ", ".join(nrp))[:160] if nrp else ""), "acct", dry, refs=owners)
    elif acct < 2 and not nrp:
        push_clear("acct")


def check_pods(a, st):
    if a.fake_util:
        lines = Path(a.fake_util).read_text().splitlines()
        mine = {m.group(2): None for m in map(FLAG.match, lines) if m}      # fake input: trust the file
        code = 4 if mine else 0
    else:
        mine = my_pods()
        if not mine:
            return
        r = subprocess.run(["nrp-util-check", "-n", NS, "--min-age", "300"] + sorted(mine),
                           capture_output=True, text=True, timeout=300)
        lines, code = r.stdout.splitlines(), r.returncode
        if code == 2:
            st["errors"] += 1
            log("util-check error: " + r.stdout.strip()[:150])
            if st["errors"] >= 6:
                push("nrp-util-check has failed %d passes in a row, pod utilization is unchecked: %s" % (st["errors"], r.stdout.strip()[:100]),
                     "util-error", a.dry_run)
            return
        st["errors"] = 0
        push_clear("util-error")
        if code in (0, 5):
            st["strikes"].clear()
            acct_alarm(st, lines, [], a.dry_run, mine)
            return
    flagged = [(m.group(1), m.group(2), l) for l in lines for m in [FLAG.match(l)] if m and m.group(2) in mine]
    if a.dry_run:
        print("[dry-run] nrp-util-check flagged %d of your pods" % len(flagged))
    bad = [f for f in flagged if f[0] in ("LOW", "STUCK")]
    for pod in [p for p in st["strikes"] if p not in {f[1] for f in bad}]:
        del st["strikes"][pod]                                               # not flagged this pass: reset
    acct_alarm(st, lines, bad, a.dry_run, mine)
    launched = 0
    for kind, pod, line in flagged:
        strike = 2 if st["strikes"].get(pod) else 1
        gap = 10**9 if kind == "FAILED" else (STRIKE_GAP_S if strike == 2 else POD_DEDUPE_S)
        if now() - st["pods"].get(pod, 0) < gap:
            continue
        if kind == "FAILED":
            if not a.dry_run:
                st["pods"][pod] = now()
            notify("pod %s FAILED (not deleted; read its logs, delete the Job when done)" % pod, st, None, a.dry_run,
                   ref=owner_of_job(st, mine.get(pod)) or "-")
            continue
        owner = mine.get(pod)
        tk = task_of_job(owner) if owner else None
        if tk:                                                            # a task's pod: the task's fix agent handles it
            if not a.dry_run:
                st["pods"][pod] = now()
                task_pod_flag(st, tk[0], tk[1], pod, kind, line)
            else:
                print("[dry-run] pod %s belongs to task %s: %s" % (pod, tk[0], line[:120]))
            continue
        if kind == "LOW" and not ("[NRP violation]" in line and strike == 2):
            if not a.dry_run:                                             # strike 1 / lab rule: record the resize, silent
                st["pods"][pod] = now()
                if "[NRP violation]" in line:
                    st["strikes"][pod] = {"n": 1, "t": now(), "owner": owner}
                record_resize(st, pod, owner, line, "OVERSIZED: " + resize_advice(line))
            else:
                print("[dry-run] pod %s strike %d: record resize %s" % (pod, strike, resize_advice(line)))
            continue
        if launched >= MAX_POD_AGENTS:
            break
        launched += 1
        cmd = agent_cmd("pod", pod_allowed(pod, owner))
        if a.dry_run:
            print("[dry-run] would launch pod-check agent for %s (owner job: %s, strike %d)\n[dry-run]   cwd=%s\n[dry-run]   %s"
                  % (pod, owner, strike, WORK / "pod_check", " ".join(repr(c) if " " in c or "(" in c else c for c in cmd)))
            continue
        if not agents_available():                                        # no runner has usage left: the pod stays flagged for the next pass
            log("pod-check %s waits: %s" % (pod, unavailable_text()))
            continue
        st["pods"][pod] = now()
        save(st)
        log("pod-check start %s (strike %d): %s" % (pod, strike, line[:160]))
        cmd.spec["ledger_task"] = "pod:" + pod
        res = run_agent(cmd, pod_prompt(pod, line, owner, strike), WORK / "pod_check")
        log("pod-check %s: %s" % (pod, res[:300]))
        verdict = res.split(":")[0].split()[0] if res.strip() else ""
        st["strikes"].pop(pod, None)
        if verdict in ("OVERSIZED", "DELETED"):
            record_resize(st, pod, owner, line, res)
        if verdict not in ("DELETED", "NOTFOUND"):
            push("pod %s (%s) was not deleted at strike 2/STUCK, check by hand: %s" % (pod, "[NRP violation]" if "[NRP violation]" in line else kind, res[:160]),
                 "pod:%s" % pod, refs=[owner_of_job(st, owner)] if owner_of_job(st, owner) else [])
        else:
            notify("pod-check %s: %s" % (pod, res[:200]), ref=owner_of_job(st, owner) or "-")


def record_resize(st, pod, owner, flag_line, verdict):
    """Resize advice goes to resize.log and, when the owner Job is registered, to its resume notes (the follow-up reads them)."""
    entry = "%s %s (job %s): %s | flag: %s" % (iso(), pod, owner or "-", " ".join(verdict.split()), " ".join(flag_line.split()))
    with open(RESIZE_LOG, "a") as f:
        f.write(entry + "\n")
    rec = st["jobs"].get(owner or "")
    resume = rec and rec.get("resume")
    if resume and Path(resume).resolve().is_relative_to(RESUME_DIR.resolve()):
        try:
            with open(resume, "a") as f:
                f.write("\n\nMONITOR RESIZE NOTE (%s): %s\nReport this resize in your one line; whoever resubmits must use it.\n"
                        % (iso(), " ".join(verdict.split())))
        except OSError as e:
            log("resize note to %s failed: %s" % (resume, str(e)[:80]))


def check_jobs(a, st):
    fake = set(filter(None, (a.fake_finished or "").split(",")))
    for job, rec in sorted(st["jobs"].items()):
        if rec.get("status") != "watching":
            continue
        s = "ok" if job in fake else job_state(job, rec.get("ns", NS))
        if s == "missing" and now() - rec.get("added", 0) < JOB_GRACE_S:
            continue
        if s not in ("ok", "FAILED", "missing"):
            continue
        status = {"ok": "succeeded", "FAILED": "FAILED", "missing": "no longer in the cluster (deleted or TTL)"}[s]
        resume = rec.get("resume")
        if a.dry_run:
            print("[dry-run] job %s finished (%s); %s" % (job, status, "would launch follow-up agent with %s" % resume
                  if resume else "would notify only (no resume file)"))
            continue
        if resume and not agents_available():                    # no runner has usage left: stay "watching", try next pass
            log("job %s finished (%s); follow-up waits: %s" % (job, status, unavailable_text()))
            continue
        rec["status"], rec["handled"], rec["result"] = "handled", now(), s       # mark first: exactly once
        save(st)
        label = rec.get("label") or job
        if label.lower().startswith("superseded"):
            digest("event", "job %s %s (superseded registration, no follow-up)" % (job, status), "job:" + job)
            continue
        if not resume:
            log("job %s finished (%s), no resume file" % (job, status))
            notify("job %s %s" % (label, status), st, None, ref="job:" + job)
            continue
        try:
            text = Path(resume).expanduser().read_text()
            if len(text.encode()) > RESUME_MAX:                  # old registrations: never feed an agent a huge LOG.md
                text = text.encode()[:RESUME_MAX].decode(errors="ignore") + "\n[... truncated by nrp-monitor: resume file over 20 KB]\n"
        except Exception as e:
            log("job %s finished (%s) but resume file unreadable: %s" % (job, status, str(e)[:80]))
            notify("job %s %s; resume file unreadable" % (label, status), st, None, ref="job:" + job)
            continue
        k = "kubectl -n %s" % rec.get("ns", NS)
        allowed = kube_read_allow(k) + ["Read(/%s/**)" % (WORK / "followup"), "Bash(nrp-util-check:*)",
                   "Bash(nrp-s3-read ls:*)", "Bash(nrp-s3-read cat:*)"]              # read-only S3 helper
        triage_allowed = list(allowed)
        au = rec.get("authorize")
        if au:
            triage_allowed.append("Read(/%s/**)" % str(APPROVED).rstrip("/"))
            allowed += auth_allowed(k, au["root"], rec.get("ns", NS), au["dir"])
        prompt = job_prompt(job, rec, status, text)
        res = tiered_job_followup(job, rec, prompt, allowed, triage_allowed)
        if is_unavailable(res):                                  # the last runner ran out of usage mid-ladder: nothing was handled
            rec["status"] = "watching"
            rec.pop("handled", None)
            rec.pop("result", None)
            save(st)
            log("job %s follow-up deferred: %s" % (job, res))
            continue
        # An agent may register the SAME job name. Preserve that new generation;
        # otherwise the pass's stale "handled" record overwrites its retry.
        with state_lock():
            disk_rec = load()["jobs"].get(job, {})
            if disk_rec.get("added", 0) > rec.get("added", 0):
                st["jobs"][job] = disk_rec
        log("followup %s: %s" % (job, res[:300]))
        if followup_solved(res):
            notify("job %s %s: %s" % (label, status, res[:300]), ref="job:" + job)
        else:
            push("NRP monitor (working with %s): job %s needs you: %s" % (OWNER_NAME, label, res[:200]),
                 "job:%s:%d" % (job, int(rec["handled"])), refs=["job:" + job])


def followup_solved(result):
    # Fail closed on free-form text, timeouts, and budget/permission errors.
    return bool(re.match(r"^(DONE|RESUBMITTED)\b", result))


def tiered_job_followup(job, rec, prompt, allowed, triage_allowed=None):
    """The follow-up ladder from agents.json (default: one read-only triage, then at most two repairs). No agent waits on jobs."""
    policy = ("\nFOLLOW-UP POLICY (takes precedence over older resume instructions):\n"
              "Inspect current state before any action: a prior agent may have partially acted. "
              "Do not duplicate a submission or reset an attempt budget. Never poll or wait. "
              "Respect registered job-attempt caps and stop on repeated identical job failures. "
              "For retries, register with --continue-from BEFORE deleting/applying so refusal cannot "
              "launch an unauthorized attempt. On success, verify the next stage is registered. "
              "Final line must be DONE: <verified result>, RESUBMITTED: <registered job>, "
              "or ESCALATE: <evidence, actions already taken, remaining problem>. "
              "Do not send notifications yourself.\n")
    triage = ("\nYou are the inexpensive READ-ONLY Haiku triage agent. This overrides all authorization "
              "and next-stage instructions above. Only inspect status, logs and outputs. "
              "NEVER register retries, edit files, delete Jobs or submit work. "
              "Use DONE only when every requested step is already complete and verified. "
              "If any mutation or next-stage launch is needed, return ESCALATE with the evidence "
              "and next action. Escalate code bugs or ambiguity promptly.\n")
    ladder = agent_cfg()["followup_ladder"]
    n_repairs = ladder.count("repair")
    history, res, repair_no = [], "no follow-up step ran", 0
    for step in ladder:
        if step == "triage":
            log("followup start %s: triage" % job)
            cmd = agent_cmd("triage", triage_allowed if triage_allowed is not None else [])
            cmd.spec["ledger_task"] = job
            res = run_agent(cmd, prompt + policy + triage, WORK / "followup")
            digest("followup-triage", res, job)
            history.append("Triage: " + res)
        else:
            repair_no += 1
            au = rec.get("authorize")
            cmd = agent_cmd("repair_auth" if au else "repair", allowed)
            repair = ("\nYou are repair attempt %d/%d. Diagnose and resolve the remaining problem "
                      "within existing approval. Read current registrations and outputs before acting. "
                      "Previous attempts (including partial actions):\n%s\n" %
                      (repair_no, n_repairs, "\n".join(history)))
            log("followup repair %s: %d/%d" % (job, repair_no, n_repairs))
            cmd.spec["ledger_task"] = job
            res = run_agent(cmd, prompt + policy + repair, WORK / "followup")
            digest("followup-repair", "attempt %d: %s" % (repair_no, res), job)
            history.append("Repair %d: %s" % (repair_no, res))
        if is_unavailable(res) or followup_solved(res):
            return res
    return "STOPPED after %s: %s" % (" and ".join(x for x in ("triage" if "triage" in ladder else "",
                                    "%d repair attempt%s" % (n_repairs, "" if n_repairs == 1 else "s") if n_repairs else "") if x), res)


# ---- chains: model-free multi-step Job pipelines ---------------------------------------------------------------
# A chain is a DAG of steps; each step is one command (e.g. nrp/submit.py ... --apply) that creates one k8s Job.
# State lives in chains/<name>/chain.json (spec + progress), written atomically under state.lock, so `chain add/resume/
# cancel/wait` can run beside a pass. Nothing here ever retries or resizes: a stop is a decision for a person.
STEP_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$")
JOB_RE = re.compile(r"^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$")
LIVE = ("active", "gated")                 # chains whose steps may be submitted
OBSERVED = ("active", "gated", "stopped")  # chains whose running Jobs are still looked after
TERMINAL = {"finished": 0, "stopped": 1, "cancelled": 1, "gated": 4}
PASS = {}                                   # counters for the heartbeat line


class ChainError(Exception):
    pass


def iso(ts=None):
    return datetime.fromtimestamp(ts if ts else now()).isoformat(timespec="seconds")


def ago(ts):
    s = max(0, int(now() - ts))
    return "%ds" % s if s < 90 else "%dm" % (s // 60) if s < 5400 else "%.1fh" % (s / 3600)


@contextlib.contextmanager
def state_lock(timeout=60):
    """Short lock around read-modify-write of chain files (not the long-held pass lock)."""
    STATE.mkdir(parents=True, exist_ok=True)
    f = open(SLOCK, "a+")
    end = time.time() + timeout
    while True:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except OSError:
            if time.time() > end:
                f.close()
                raise RuntimeError("state.lock busy for %ds" % timeout)
            time.sleep(0.05)
    try:
        yield
    finally:
        fcntl.flock(f, fcntl.LOCK_UN)
        f.close()


def chain_path(name):
    return CHAINS / name / "chain.json"


def chain_load(name):
    try:
        return json.loads(chain_path(name).read_text())
    except Exception:
        return None


def chain_write(c):
    p = chain_path(c["name"])
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_suffix(".tmp")
    tmp.write_text(json.dumps(c, indent=1, sort_keys=True))
    os.chmod(tmp, 0o600)
    os.replace(tmp, p)


def chain_names():
    return sorted(p.parent.name for p in CHAINS.glob("*/chain.json")) if CHAINS.is_dir() else []


def chain_txn(name, fn):
    """Re-read the chain under state.lock, apply fn(c). fn returns False to abort (nothing written)."""
    with state_lock():
        c = chain_load(name)
        if c is None:
            return False
        r = fn(c)
        if r is False:
            return False
        chain_write(c)
        return True if r is None else r


def ev(c, msg):
    c.setdefault("events", []).append("%s %s" % (iso(), msg))
    del c["events"][:-60]
    log("chain %s: %s" % (c["name"], msg))


def step_of(c, sid):
    return next(s for s in c["steps"] if s["id"] == sid)


def is_done(s):
    return s.get("state") == "done"


# ---- validation ----------------------------------------------------------------------------------------------
def protected_dirs():
    return [(Path.home() / d).resolve() for d in ("Desktop", "Documents", "Downloads")]


def under_protected(path):
    try:
        p = Path(os.path.expanduser(path)).resolve()
    except Exception:
        return None
    for d in protected_dirs():
        if p == d or d in p.parents:
            return d
    return None


def validate_chain(raw):
    """Return (chain dict ready to store, warnings). Raises ChainError listing every problem."""
    bad, warn = [], []
    if not isinstance(raw, dict):
        raise ChainError("top level must be an object")
    name = raw.get("name")
    if not isinstance(name, str) or not re.match(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$", name):
        bad.append("name: required, letters/digits/_.- (max 63)")
    notes = raw.get("notes", "")
    if not isinstance(notes, str):
        bad.append("notes: must be text")
    elif len(notes.encode()) > RESUME_MAX:
        bad.append("notes: %d KB, limit is %d KB (a chain's notes are what the follow-up agent reads; keep them short)"
                   % (len(notes.encode()) // 1024, RESUME_MAX // 1024))
    on_finish = raw.get("on_finish", "notify")
    if on_finish not in ("notify", "agent"):
        bad.append("on_finish: 'notify' or 'agent'")
    follow = raw.get("followup", "")
    if not isinstance(follow, str) or len(follow.encode()) > 4096:
        bad.append("followup: text, at most 4 KB")
    if on_finish == "agent" and not follow:
        warn.append("on_finish=agent without 'followup': the agent only gets the notes and step summary")
    ns = raw.get("namespace", NS)
    if not isinstance(ns, str) or not re.match(r"^[a-z0-9][-a-z0-9]*$", ns):
        bad.append("namespace: invalid")
    steps_in = raw.get("steps")
    if not isinstance(steps_in, list) or not steps_in:
        raise ChainError("; ".join(bad + ["steps: non-empty list required"]))
    if len(steps_in) > 100:
        bad.append("steps: at most 100")
    steps, ids = [], set()
    for i, s in enumerate(steps_in):
        if not isinstance(s, dict):
            bad.append("steps[%d]: must be an object" % i)
            continue
        sid = s.get("id")
        w = "step %s" % (sid if isinstance(sid, str) else "#%d" % i)
        if not isinstance(sid, str) or not STEP_ID_RE.match(sid):
            bad.append("%s: id required (letters/digits/_.-)" % w)
        elif sid in ids:
            bad.append("%s: duplicate id" % w)
        ids.add(sid)
        job = s.get("job")
        if not isinstance(job, str) or not JOB_RE.match(job) or len(job) > 63:
            bad.append("%s: job must be a DNS-1123 name (lowercase, digits, -, max 63)" % w)
        argv = s.get("argv")
        if not isinstance(argv, list) or not argv or not all(isinstance(x, str) for x in argv):
            bad.append("%s: argv must be a non-empty list of strings" % w)
            argv = None
        cwd = s.get("cwd")
        if not isinstance(cwd, str) or not cwd:
            bad.append("%s: cwd required" % w)
        else:
            cwd = os.path.expanduser(cwd)
            if not os.path.isabs(cwd):
                bad.append("%s: cwd must be absolute" % w)
            elif under_protected(cwd):
                bad.append("%s: cwd %s is under %s; macOS privacy (TCC) blocks launchd from reading there. Run from a "
                           "copy outside Desktop/Documents/Downloads (e.g. ~/.cache/<name>/<sha>)" % (w, cwd, under_protected(cwd)))
            elif not os.path.isdir(cwd):
                bad.append("%s: cwd %s is not a directory" % (w, cwd))
        if argv:
            if argv[0].startswith(("/", "~")) and under_protected(argv[0]):
                bad.append("%s: argv[0] %s is under a TCC-protected folder" % (w, argv[0]))
            for x in argv[1:]:
                if (x.startswith("/") or x.startswith("~/")) and under_protected(x):
                    warn.append("%s: argument %s is under Desktop/Documents/Downloads; a launchd-run pass cannot read it" % (w, x))
        env = s.get("env", {})
        if not isinstance(env, dict) or not all(isinstance(k, str) and isinstance(v, str) for k, v in env.items()):
            bad.append("%s: env must map strings to strings (no secrets: this file is stored on disk)" % w)
        after = s.get("after", [])
        if not isinstance(after, list) or not all(isinstance(x, str) for x in after):
            bad.append("%s: after must be a list of step ids" % w)
            after = []
        d3 = s.get("done_s3", [])
        if not isinstance(d3, list) or not all(s3_split(x) for x in d3):
            bad.append("%s: done_s3 must be a list of s3://bucket/key URIs, each ONE object (no trailing slash; checked exactly, not as a prefix)" % w)
        if s.get("gate") not in (None, "manual"):
            bad.append("%s: gate must be 'manual'" % w)
        dl = s.get("deadline_s")
        if dl is not None and (not isinstance(dl, int) or isinstance(dl, bool) or dl <= 0):
            bad.append("%s: deadline_s must be a positive integer" % w)
        st0 = s.get("state", "pending")
        if st0 not in ("pending", "running", "done"):
            bad.append("%s: state may be pending, running or done (adopting existing work)" % w)
        steps.append({"id": sid, "job": job, "cwd": cwd, "argv": argv or [], "env": env if isinstance(env, dict) else {},
                      "after": after, "done_s3": d3 if isinstance(d3, list) else [], "gate": s.get("gate"),
                      "deadline_s": dl, "state": st0})
    jobs = [s["job"] for s in steps if s["job"]]
    for j in set(jobs):
        if jobs.count(j) > 1:
            bad.append("job name %s used by more than one step" % j)
    for s in steps:
        for x in s["after"]:
            if x not in ids:
                bad.append("step %s: after refers to unknown step %s" % (s["id"], x))
            elif x == s["id"]:
                bad.append("step %s: after itself" % s["id"])
    # cycle check (Kahn)
    indeg = {s["id"]: len([x for x in s["after"] if x in ids]) for s in steps if s["id"]}
    queue = [k for k, v in indeg.items() if v == 0]
    seen = 0
    while queue:
        k = queue.pop()
        seen += 1
        for s in steps:
            if k in s["after"] and s["id"] in indeg:
                indeg[s["id"]] -= 1
                if indeg[s["id"]] == 0:
                    queue.append(s["id"])
    if seen < len(indeg) and not any("unknown step" in b for b in bad):
        bad.append("after: dependency cycle among steps " + ", ".join(sorted(k for k, v in indeg.items() if v > 0)))
    if bad:
        raise ChainError("\n  - ".join(["%d problem(s):" % len(bad)] + bad))
    t = now()
    for s in steps:
        if s["state"] == "running":
            s["submitted"] = t
        elif s["state"] == "done":
            s["done_ts"] = t
            s["adopted"] = True
    origin = norm_origin(raw.get("origin"))
    c = {"name": name, "owner": str(raw.get("owner", ""))[:200], "origin": origin, "namespace": ns, "notes": notes, "on_finish": on_finish,
         "followup": follow, "s3_endpoint": raw.get("s3_endpoint") or "", "aws_profile": raw.get("aws_profile") or "",
         "status": "active", "reason": "", "created": t, "steps": steps, "events": []}
    return c, warn


def load_chain_file(path):
    p = Path(path).expanduser()
    if not p.is_file():
        raise ChainError("chain file not found: %s" % p)
    if p.stat().st_size > 1024 * 1024:
        raise ChainError("chain file over 1 MB")
    text = p.read_text()
    if p.suffix in (".yml", ".yaml"):
        try:
            import yaml
        except ImportError:
            raise ChainError("YAML needs PyYAML; use JSON")
        return yaml.safe_load(text), text
    try:
        return json.loads(text), text
    except ValueError as e:
        raise ChainError("not valid JSON: %s" % e)


def dry_run_steps(c):
    """Run every step's argv minus --apply. A step without --apply cannot be dry-run safely: parse-only."""
    bad = 0
    for s in c["steps"]:
        if s["state"] != "pending":
            print("  %-12s skipped (%s)" % (s["id"], s["state"]))
            continue
        if "--apply" not in s["argv"]:
            print("  %-12s parse-only (no --apply in argv; not executed)" % s["id"])
            continue
        argv = [x for x in s["argv"] if x != "--apply"]
        try:
            r = subprocess.run(argv, cwd=s["cwd"], env=step_env(s), capture_output=True, text=True, timeout=300)
            ok, tail = r.returncode == 0, (r.stderr.strip() or r.stdout.strip()).splitlines()[-3:]
        except Exception as e:
            ok, tail = False, [str(e)[:200]]
        bad += not ok
        print("  %-12s %s%s" % (s["id"], "dry-run ok" if ok else "DRY-RUN FAILED", "" if ok else ": " + " | ".join(tail)))
    return bad


# ---- cluster / S3 reads --------------------------------------------------------------------------------------
def aws_env():
    e = clean_env()
    for k in ("AWS_PROFILE", "AWS_CONFIG_FILE", "AWS_SHARED_CREDENTIALS_FILE", "AWS_DEFAULT_REGION"):
        if k in os.environ:
            e[k] = os.environ[k]
    return e


def step_env(s):
    e = aws_env()
    e.setdefault("PATH", "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin")
    e.update(s.get("env") or {})
    return e


def job_complete(succeeded, completions, active, complete_cond):
    """A Job is finished successfully only when ALL its completions succeeded. `status.succeeded >= 1` is NOT that: an Indexed Job
    (pv3 --parallel N, completions=N) has succeeded >= 1 as soon as its first shard exits, while the other shards still run; treating
    that as success made the monitor check a root marker too early and delete the Job's pods (finch-feature-followup, 2026-11-06).
    Complete=True is authoritative; else succeeded >= spec.completions; completions unset (work-queue Job) = one success and no pod active."""
    if complete_cond:
        return True
    if completions is not None:
        return succeeded >= completions
    return succeeded >= 1 and not active


def classify_job(j):
    s = j.get("status", {})
    conds = {c.get("type"): c.get("status") for c in s.get("conditions", [])}
    comp = (j.get("spec") or {}).get("completions")
    if job_complete(s.get("succeeded") or 0, comp if isinstance(comp, int) else None, bool(s.get("active")), conds.get("Complete") == "True"):
        return "ok"
    if conds.get("Failed") == "True" or ((s.get("failed") or 0) >= 1 and not s.get("active")):
        return "FAILED"
    return "running" if s.get("active") else "pending"


def fetch_jobs(ns):
    r = kubectl("-n", ns, "get", "jobs", "-o", "json")
    if r.returncode:
        raise RuntimeError(r.stderr.strip()[:150] or "kubectl get jobs failed")
    out = {}
    for j in json.loads(r.stdout).get("items", []):
        m = j["metadata"]
        out[m["name"]] = {"state": classify_job(j), "start": parse_ts(j.get("status", {}).get("startTime")),
                          "deadline": (j.get("spec") or {}).get("activeDeadlineSeconds"),
                          "ours": m.get("annotations", {}).get("nrp.ai/username") == USER_ANN}
    return out


def parse_ts(s):
    if not s:
        return None
    try:
        return datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()
    except Exception:
        return None


def s3_split(uri):
    """(bucket, key) of an s3://bucket/key URI that names ONE object, else None (bucket-only, empty key, or a trailing-slash 'folder')."""
    m = re.match(r"^s3://([^/]+)/(.+)$", uri) if isinstance(uri, str) else None
    return None if not m or m.group(2).endswith("/") else (m.group(1), m.group(2))


S3_PASS = None            # {uri: True|False} resolved earlier in THIS pass (s3_prepass); None outside a pass
S3_JOB_IMAGE = "amazon/aws-cli:2.22.35"
S3_JOB_ENDPOINT = "http://rook-ceph-rgw-nautiluss3.rook"
S3_JOB_WAIT_S, S3_JOB_POLL_S = 240, 5
S3_JOB_SCRIPT = r'''for u in "$@"; do
  p=${u#s3://}; b=${p%%/*}; k=${p#*/}
  out=$(aws s3api head-object --bucket "$b" --key "$k" --output json 2>&1); rc=$?
  if [ $rc -eq 0 ]; then echo "EXISTS $u"
  elif echo "$out" | grep -q "(404)" && echo "$out" | grep -q HeadObject; then echo "MISSING $u"
  else echo "ERROR $u"; fi
done'''


def s3_incluster_on():
    """NRP_MONITOR_S3_INCLUSTER: auto (default) = check through one in-cluster Job when the external endpoint fails; off = never."""
    return os.environ.get("NRP_MONITOR_S3_INCLUSTER", "auto").strip().lower() not in ("off", "0", "no", "false", "never")


def s3_check_job_manifest(name, args, script=S3_JOB_SCRIPT):
    """Job that runs `bash -c SCRIPT s3check ARGS...` with the in-cluster Ceph endpoint (pods reach it when the laptop cannot reach the public one)."""
    labels = {"pv3/user": OWNER_LABEL, "nrp-monitor/kind": "s3check"}
    return {"apiVersion": "batch/v1", "kind": "Job", "metadata": {"name": name, "namespace": NS, "labels": labels},
            "spec": {"activeDeadlineSeconds": 300, "backoffLimit": 0, "ttlSecondsAfterFinished": 3600,
                     "template": {"metadata": {"labels": labels}, "spec": {
                         "restartPolicy": "Never",
                         "affinity": {"nodeAffinity": {"requiredDuringSchedulingIgnoredDuringExecution": {"nodeSelectorTerms": [
                             {"matchExpressions": [{"key": "kubernetes.io/hostname", "operator": "NotIn", "values": ["nrp-c17.nysernet.org"]}]}]}}},
                         "containers": [{"name": "s3check", "image": S3_JOB_IMAGE, "imagePullPolicy": "IfNotPresent",
                                         "command": ["bash", "-c", script, "s3check"] + list(args),
                                         "env": [{"name": "AWS_SHARED_CREDENTIALS_FILE", "value": "/.aws/credentials"},
                                                 {"name": "AWS_CONFIG_FILE", "value": "/.aws/.s3cfg"},
                                                 {"name": "AWS_ENDPOINT_URL", "value": S3_JOB_ENDPOINT},
                                                 {"name": "AWS_REQUEST_CHECKSUM_CALCULATION", "value": "when_required"},
                                                 {"name": "AWS_RESPONSE_CHECKSUM_VALIDATION", "value": "when_required"}],
                                         "resources": {"requests": {"cpu": "1", "memory": "512Mi", "ephemeral-storage": "1Gi"},
                                                       "limits": {"cpu": "1", "memory": "512Mi", "ephemeral-storage": "1Gi"}},
                                         "volumeMounts": [{"name": "prp-s3-credentials", "mountPath": "/.aws/credentials", "subPath": "credentials"},
                                                          {"name": "prp-s3-credentials", "mountPath": "/.aws/.s3cfg", "subPath": ".s3cfg"}]}],
                         "volumes": [{"name": "prp-s3-credentials", "secret": {"secretName": "prp-s3-credentials"}}]}}}}


def incluster_job(script, args, log_flag):
    """Run ONE short in-cluster Job (read-only S3 script), wait at most S3_JOB_WAIT_S, return its logs (str) or None when it could not
    be created or gave no logs; the Job is always deleted by name. `log_flag` is the `kubectl logs` size flag, e.g. --tail=60."""
    name = "nrpmon-s3check-%s" % uuid.uuid4().hex[:8]
    text = None
    try:
        r = subprocess.run(["kubectl", "-n", NS, "create", "-f", "-"], input=json.dumps(s3_check_job_manifest(name, args, script)),
                           capture_output=True, text=True, timeout=60)
        if r.returncode:
            log("s3 in-cluster check: could not create Job: %s" % (r.stderr or r.stdout).strip()[-150:])
            return None
        end = time.time() + S3_JOB_WAIT_S
        while True:
            g = kubectl("-n", NS, "get", "job", name, "-o", "jsonpath={.status.succeeded}/{.status.failed}", timeout=30)
            ok_, bad_ = (g.stdout.strip().split("/") + ["", ""])[:2] if g.returncode == 0 else ("", "")
            if ok_ not in ("", "0") or bad_ not in ("", "0"):
                break
            if time.time() >= end:
                log("s3 in-cluster check: Job %s not finished in %ds" % (name, S3_JOB_WAIT_S))
                break
            time.sleep(S3_JOB_POLL_S)
        lg = kubectl("-n", NS, "logs", "job/" + name, log_flag, timeout=60)
        text = lg.stdout if lg.returncode == 0 else None
    except Exception as e:
        log("s3 in-cluster check: %s: %s" % (type(e).__name__, str(e)[:120]))
    finally:
        try:
            kubectl("-n", NS, "delete", "job", name, "--wait=false", timeout=60)
        except Exception as e:
            log("s3 in-cluster check: delete of Job %s failed: %s" % (name, str(e)[:100]))
    log("s3 in-cluster Job %s ran (%s)" % (name, "logs read" if text is not None else "no logs"))
    return text


def s3_incluster(uris):
    """{uri: True|False|None} from ONE short in-cluster Job (EXISTS/MISSING/ERROR lines). Anything not answered EXISTS or MISSING stays
    None (callers keep their retry and escalation)."""
    uris = [u for u in dict.fromkeys(uris) if s3_split(u)]
    res = {u: None for u in uris}
    if not uris:
        return res
    for line in (incluster_job(S3_JOB_SCRIPT, uris, "--tail=%d" % (len(uris) + 50)) or "").splitlines():
        w = line.strip().split(" ", 1)
        if len(w) == 2 and w[1] in res and w[0] in ("EXISTS", "MISSING", "ERROR"):
            res[w[1]] = True if w[0] == "EXISTS" else False if w[0] == "MISSING" else None
    log("s3 in-cluster check: %d URIs, %d exist, %d missing, %d unanswered" % (
        len(uris), sum(v is True for v in res.values()), sum(v is False for v in res.values()), sum(v is None for v in res.values())))
    return res


def s3_check_many(uris, c=None):
    """{uri: True|False|None}: the external head-object for each; every URI it could not answer (not a 404) goes through ONE in-cluster Job
    (unless NRP_MONITOR_S3_INCLUSTER=off). None is never success."""
    out = {u: s3_exists(u, c) for u in dict.fromkeys(uris)}
    todo = [u for u, v in out.items() if v is None and s3_split(u)]
    if todo and s3_incluster_on():
        log("s3 external check failed for %d URI(s); falling back to one in-cluster Job" % len(todo))
        PASS["s3_incluster"] = PASS.get("s3_incluster", 0) + len(todo)
        out.update(s3_incluster(todo))
    return out


def s3_prepass(a):
    """Once per pass, before chains and tasks run: gather the success markers (running stages whose Job finished or vanished) and
    gates (pending stages' after_s3) that will be checked, check them all, and keep the answers in S3_PASS for this pass.
    Only here is the in-cluster fallback used, so a pass makes at most one S3-check Job however many URIs failed."""
    global S3_PASS
    S3_PASS = {}
    if a.dry_run or not s3_incluster_on():
        return
    want, conf = [], {}
    jobs_ns = {}

    def jobs_of(ns):
        if ns not in jobs_ns:
            try:
                jobs_ns[ns] = fetch_jobs(ns)
            except Exception:
                jobs_ns[ns] = None
        return jobs_ns[ns]

    for n in [x for x in chain_names() if (chain_load(x) or {}).get("status") in OBSERVED]:
        c = chain_load(n)
        js = jobs_of(c["namespace"])
        if js is None:
            continue
        for s in c["steps"]:
            if s["state"] == "running" and s.get("done_s3") and (js.get(s["job"]) or {"state": "ok"})["state"] == "ok":
                for u in s["done_s3"]:
                    want.append(u)
                    conf[u] = c
    for n in [x for x in task_names() if (task_load(x) or {}).get("status") in TASK_LIVE]:
        t = task_load(n)
        js = jobs_of(t["namespace"])
        if js is None:
            continue
        for s in t["stages"]:
            if s["state"] == "running" and (js.get(s["job"]) or {"state": "ok"})["state"] == "ok":
                want += s["done_s3"]
            elif s["state"] == "pending" and (s.get("after_s3") or s.get("waiting_on")) and all(tstage(t, x)["state"] == "done" for x in s["after"]):
                want += s.get("after_s3", [])
    for u, v in s3_check_many([u for u in dict.fromkeys(want) if s3_split(u)], None).items():
        if v is not None:
            S3_PASS[u] = v


def s3_exists(uri, c):
    """EXACT object check: True (this key exists) / False (404 Not Found) / None (could not tell). Fail-closed.
    Uses `aws s3api head-object`, never `aws s3 ls`: `ls s3://b/k` is a PREFIX match, so `.../DONE` was satisfied by `.../DONE.1`
    (and `DONE.1` by `DONE.10`), the monitor declared an Indexed Job finished while shards were still running and deleted its pods
    (finch-feature-followup, 2026-11-06). None = 403/5xx/network/timeout/odd output/a URI that is not one object; callers retry and
    escalate after repeated passes, they never treat None as success. `c` may be {} (aws_profile, s3_endpoint)."""
    c = c or {}
    bk = s3_split(uri)
    if bk is None:
        log("s3 head %s: not a single-object s3://bucket/key URI" % uri)
        return None
    if S3_PASS is not None and uri in S3_PASS:                              # answered earlier in this pass (s3_prepass)
        return S3_PASS[uri]
    cmd = ["aws"]
    ep = os.environ.get("NRP_MONITOR_S3_ENDPOINT") or c.get("s3_endpoint") or DEFAULT_S3
    if ep:
        cmd += ["--endpoint-url", ep]
    if c.get("aws_profile"):
        cmd += ["--profile", c["aws_profile"]]
    try:
        r = subprocess.run(cmd + ["s3api", "head-object", "--bucket", bk[0], "--key", bk[1], "--output", "json"],
                           capture_output=True, text=True, timeout=120, env=aws_env())
    except Exception as e:
        log("s3 head %s: %s" % (uri, str(e)[:100]))
        return None
    if r.returncode == 0:
        try:
            if isinstance(json.loads(r.stdout), dict):
                return True
        except ValueError:
            pass
        log("s3 head %s rc=0 but unreadable output" % uri)
        return None
    err = r.stderr or ""
    if "(404)" in err and "HeadObject" in err:                            # HEAD has no body: "An error occurred (404) when calling the HeadObject operation: Not Found"
        return False
    log("s3 head %s rc=%s %s" % (uri, r.returncode, err.strip()[-100:]))   # 403, 5xx, could not connect, expired token...
    return None


def save_logs(c, s, reason):
    """Last ~200 log lines + describe of the Job and its pods, kept because pods vanish."""
    ns, job = c["namespace"], s["job"]
    parts = ["# chain %s step %s job %s  saved %s\n# reason: %s\n" % (c["name"], s["id"], job, iso(), reason)]
    for title, args in (("logs (last 200 lines)", ["logs", "job/" + job, "--all-containers", "--tail=200"]),
                        ("describe job", ["describe", "job", job]),
                        ("describe pods", ["describe", "pods", "-l", "job-name=" + job])):
        try:
            r = kubectl("-n", ns, *args, timeout=120)
            body = (r.stdout if r.returncode == 0 else "(kubectl failed rc=%d: %s)\n%s" % (r.returncode, r.stderr.strip()[:200], r.stdout))
        except Exception as e:
            body = "(kubectl error: %s)" % str(e)[:150]
        parts.append("\n## %s\n%s" % (title, body[-40000:]))
    p = CHAINS / c["name"] / "logs" / ("%s.txt" % s["id"])
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text("".join(parts)[-100000:])
    return str(p)


# ---- chain transitions ----------------------------------------------------------------------------------------
def stop_chain(name, sid, reason, a=None):
    """Mark the step failed (when sid) and the chain stopped; notify once."""
    out = {}

    def f(c):
        if sid:
            s = step_of(c, sid)
            if s["state"] != "done":
                s["state"], s["reason"] = "failed", reason
                s["failed_job"] = s["job"]
        if c["status"] in LIVE:
            c["status"], c["reason"], c["stopped_at"] = "stopped", "step %s: %s" % (sid, reason) if sid else reason, now()
            out["new"] = True
        ev(c, "step %s: %s" % (sid, reason) if sid else reason)
    chain_txn(name, f)
    if out.get("new"):
        PASS["stopped"] = PASS.get("stopped", 0) + 1
        c = chain_load(name)
        push("chain %s STOPPED at %s: %s. Nothing retried; `nrp-monitor chain show %s`" %
             (name, sid or "-", reason[:100], name), "chain:%s:%d" % (name, int(c.get("stopped_at") or now())), refs=["chain:" + name])


def set_state(name, sid, **kw):
    def f(c):
        s = step_of(c, sid)
        s.update(kw)
    chain_txn(name, f)


def complete_step(c, s):
    name, sid = c["name"], s["id"]
    if not s.get("logs_saved"):
        p = save_logs(c, s, "Job succeeded")
        set_state(name, sid, logs_saved=True, logs=p)
    for uri in s.get("done_s3", []):
        r = s3_exists(uri, c)
        if r is False:
            stop_chain(name, sid, "Job succeeded but %s does not exist" % uri)
            return
        if r is None:
            n = s.get("s3_errors", 0) + 1
            set_state(name, sid, s3_errors=n)
            if n >= 5:
                stop_chain(name, sid, "cannot check %s (aws s3api head-object failed %d passes)" % (uri, n))
            return
    d = kubectl("-n", c["namespace"], "delete", "job", s["job"], "--wait=false")
    if d.returncode and "NotFound" not in d.stderr:
        log("chain %s: delete job %s failed: %s" % (name, s["job"], d.stderr.strip()[:100]))
        return                                                            # retry next pass; logs already saved
    set_state(name, sid, state="done", done_ts=now(), reason="")
    PASS["done"] = PASS.get("done", 0) + 1
    chain_txn(name, lambda c: ev(c, "step %s done, Job deleted" % sid))


def observe_steps(c, jobs):
    name = c["name"]
    for s in c["steps"]:
        sid = s["id"]
        if s["state"] == "submitting":                                    # crash between "submitting" and "running"
            if s["job"] in jobs:
                set_state(name, sid, state="running", submitted=now(), adopted=True)
                chain_txn(name, lambda c: ev(c, "step %s: adopted existing Job %s after a restart" % (sid, s["job"])))
            else:
                stop_chain(name, sid, "left in 'submitting' and Job %s does not exist (crash or failed submit)" % s["job"])
            continue
        if s["state"] != "running":
            continue
        info = jobs.get(s["job"])
        if info is None:
            if now() - s.get("submitted", 0) < MISSING_GRACE_S:
                continue
            if s.get("done_s3") and all(s3_exists(u, c) is True for u in s["done_s3"]):
                set_state(name, sid, state="done", done_ts=now(), reason="Job gone, outputs present, logs not captured")
                continue
            stop_chain(name, sid, "Job %s is gone (deleted or TTL) before it was seen finishing" % s["job"])
        elif info["state"] == "ok":
            complete_step(chain_load(name), step_of(chain_load(name), sid))
        elif info["state"] == "FAILED":
            p = save_logs(c, s, "Job failed")
            set_state(name, sid, logs=p, logs_saved=True)
            stop_chain(name, sid, "Job %s FAILED (logs: %s)" % (s["job"], p))
        elif s.get("deadline_s") and info["start"] and not s.get("overrun"):
            limit = s["deadline_s"] + max(600, s["deadline_s"] // 10)
            if now() - info["start"] > limit:
                p = save_logs(c, s, "past deadline %ds" % s["deadline_s"])
                set_state(name, sid, logs=p, overrun=True)
                stop_chain(name, sid, "Job %s running %dm past deadline %ds (not deleted; logs: %s)"
                           % (s["job"], (now() - info["start"] - s["deadline_s"]) // 60, s["deadline_s"], p))
                set_state(name, sid, state="running", reason="")           # still running: keep observing it


def submit_step(name, sid):
    """submitting -> run argv -> running. Returns True when a Job was created."""
    def begin(c):
        s = step_of(c, sid)
        if c["status"] not in LIVE or s["state"] != "pending":
            return False
        s["state"], s["submit_started"] = "submitting", now()
        ev(c, "step %s: submitting" % sid)
    if not chain_txn(name, begin):
        return False
    c = chain_load(name)
    s = step_of(c, sid)
    lp = CHAINS / name / "logs" / ("%s.submit.txt" % sid)
    lp.parent.mkdir(parents=True, exist_ok=True)
    try:
        r = subprocess.run(s["argv"], cwd=s["cwd"], env=step_env(s), capture_output=True, text=True, timeout=SUBMIT_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        log("chain %s step %s: submit timed out; left in 'submitting', next pass adopts or fails it" % (name, sid))
        return False
    except Exception as e:                                                # cannot even start: nothing was created
        lp.write_text("could not start: %s\n" % e)
        stop_chain(name, sid, "could not run argv: %s" % str(e)[:100])
        return False
    lp.write_text(("rc=%d\n--- stdout ---\n%s\n--- stderr ---\n%s" % (r.returncode, r.stdout[-8000:], r.stderr[-8000:])))
    if r.returncode:
        tail = (r.stderr.strip() or r.stdout.strip()).splitlines()[-1:] or [""]
        stop_chain(name, sid, "submit exited %d: %s (see %s)" % (r.returncode, tail[0][:100], lp))
        return False
    set_state(name, sid, state="running", submitted=now())
    chain_txn(name, lambda c: ev(c, "step %s: running (Job %s)" % (sid, s["job"])))
    PASS["submitted"] = PASS.get("submitted", 0) + 1
    return True


def finish_chain(name):
    out = {}

    def f(c):
        if c["status"] not in LIVE or not all(is_done(s) for s in c["steps"]):
            return False
        c["status"], c["finished"], c["reason"] = "finished", now(), ""
        ev(c, "all %d steps done" % len(c["steps"]))
        out["c"] = c
    if chain_txn(name, f):
        c = out["c"]
        PASS["finished"] = PASS.get("finished", 0) + 1
        notify("chain %s FINISHED (%d steps, %s)%s" % (name, len(c["steps"]), ago(c["created"]),
               "; follow-up agent will run" if c["on_finish"] == "agent" else ""), ref="chain:" + name)


def advance_chain(name, jobs, counts, a):
    c = chain_load(name)
    observe_steps(c, jobs)
    c = chain_load(name)
    if c["status"] not in LIVE:
        return
    for s in c["steps"]:
        if s["state"] != "pending" or not all(is_done(step_of(c, x)) for x in s["after"]):
            continue
        sid = s["id"]
        if s.get("gate") == "manual" and not s.get("gate_cleared"):
            def g(c):
                if c["status"] != "active":
                    return False
                c["status"], c["gate_step"] = "gated", sid
                c["reason"] = "manual gate before step %s" % sid
                ev(c, "gated before step %s" % sid)
            if chain_txn(name, g):
                push("chain %s GATED before step %s: decide, then `nrp-monitor chain resume %s`" % (name, sid, name),
                     "gate:%s:%s:%d" % (name, sid, int(now())), refs=["chain:" + name])
            continue
        info = jobs.get(s["job"])
        if info is not None:
            if s.get("retry_cleanup") and s.get("failed_job") == s["job"] and info["state"] in ("ok", "FAILED"):
                d = kubectl("-n", c["namespace"], "delete", "job", s["job"], "--wait=false")
                log("chain %s: deleted finished Job %s before retry (rc=%d)" % (name, s["job"], d.returncode))
                jobs.pop(s["job"], None) if not d.returncode else None
            else:
                PASS["blocked"] = PASS.get("blocked", 0) + 1
                log("chain %s step %s waits: Job %s already exists" % (name, sid, s["job"]))
            continue
        cap = max_jobs()
        if counts["n"] >= cap:
            PASS["capped"] = PASS.get("capped", 0) + 1
            log("chain %s step %s waits: %d of our Jobs unfinished (cap %d)" % (name, sid, counts["n"], cap))
            continue
        if submit_step(name, sid):
            counts["n"] += 1
    finish_chain(name)


def process_chains(a, st):
    names = [n for n in chain_names() if (chain_load(n) or {}).get("status") in OBSERVED]
    PASS["chains"] = len(names)
    if not names:
        return
    if a.dry_run:
        for n in names:
            c = chain_load(n)
            print("[dry-run] chain %s (%s): %s" % (n, c["status"], ", ".join("%s=%s" % (s["id"], s["state"]) for s in c["steps"])))
        return
    jobs_ns, bad_ns = {}, set()
    for ns in sorted({chain_load(n)["namespace"] for n in names}):
        try:
            jobs_ns[ns] = fetch_jobs(ns)
        except Exception as e:
            bad_ns.add(ns)
            st["kube_errors"] += 1
            log("chains: kubectl get jobs -n %s failed (%d in a row): %s" % (ns, st["kube_errors"], str(e)[:120]))
            if st["kube_errors"] >= 6:
                push("kubectl has failed %d passes in a row, chains and tasks are not advancing: %s" % (st["kube_errors"], str(e)[:100]),
                     "kube-error")
    if not bad_ns:
        st["kube_errors"] = 0
        push_clear("kube-error")
    mine = {(ns, n) for ns, js in jobs_ns.items() for n, i in js.items() if i["ours"] and i["state"] in ("running", "pending")}
    for n in names:                                                      # chain Jobs count even without the annotation
        c = chain_load(n)
        js = jobs_ns.get(c["namespace"], {})
        mine |= {(c["namespace"], s["job"]) for s in c["steps"] if s["state"] in ("running", "submitting")
                 and js.get(s["job"], {"state": "pending"})["state"] in ("running", "pending")}
    counts = {"n": len(mine)}
    PASS["our_jobs"] = counts["n"]
    for n in names:
        c = chain_load(n)
        if c["namespace"] in bad_ns:
            continue
        try:
            advance_chain(n, jobs_ns[c["namespace"]], counts, a)
        except Exception as e:
            log("chain %s error: %s: %s" % (n, type(e).__name__, str(e)[:150]))


def chain_summary(c):
    lines = []
    for s in c["steps"]:
        lines.append("- %s job=%s state=%s%s%s" % (s["id"], s["job"], s["state"], " (%s)" % s["reason"][:100] if s.get("reason") else "",
                     " log=%s" % s["logs"] if s.get("logs") else ""))
    return "\n".join(lines)


def run_chain_followups(a, st):
    for n in chain_names():
        c = chain_load(n)
        if not c or c["status"] != "finished" or c["on_finish"] != "agent" or c.get("followup_started"):
            continue
        if a.dry_run:
            print("[dry-run] chain %s finished: would launch follow-up agent" % n)
            continue
        if not agents_available():
            log("chain %s follow-up waits: %s" % (n, unavailable_text()))
            continue
        chain_txn(n, lambda c: c.update(followup_started=now()))          # mark first: exactly once
        text = "Chain %s (%s) finished: all %d steps done.\n\nNOTES:\n%s\n\nSTEPS:\n%s\n\n" % (
            n, c["owner"], len(c["steps"]), c["notes"], chain_summary(c))
        if c.get("followup"):
            text += "WHAT TO DO:\n%s\n" % c["followup"]
        text += "\nLog tails are files under %s (read only what you need).\n" % (CHAINS / n / "logs")
        k = "kubectl -n %s" % c["namespace"]
        allowed = kube_read_allow(k) + [
                   "Read(%s/**)" % (WORK / "followup"), "Read(%s/**)" % (CHAINS / n / "logs")]
        cmd = agent_cmd("repair", allowed)
        log("chain %s followup start" % n)
        rec = {"ns": c["namespace"], "label": c["owner"] or n, "origin": c.get("origin")}
        cmd.spec["ledger_task"] = "chain:" + n
        res = run_agent(cmd, job_prompt("chain " + n, rec, "chain finished", text), WORK / "followup")
        log("chain %s followup: %s" % (n, res[:300]))
        if is_unavailable(res):                                           # ran out of usage mid-call: run it again next pass
            chain_txn(n, lambda c: c.pop("followup_started", None))
            continue
        notify("chain %s finished: %s" % (c["owner"] or n, res[:140]), st, None, ref="chain:" + n)


# ---- digest and push (v2: routine events are silent; one push when the owner is needed) ---------------------------
DIGEST, PUSHED, ORPHANS = STATE / "digest.log", STATE / "pushed.json", STATE / "orphans.json"
SLACK_URL = os.environ.get("NRP_MONITOR_SLACK_URL") or "https://notifications.braingeneers.gi.ucsc.edu/v1/slack"
SLACK_USER = os.environ.get("NRP_MONITOR_SLACK_USER") or OWNER.get("slack_user_id") or ""   # the owner's own DM, never a channel or a chat
JWT_FILE = Path(os.environ.get("NRP_MONITOR_JWT") or Path.home() / ".ssh/braingeneers_jwt_token.json")   # env: tests


def read_json(p, default):
    try:
        return json.loads(Path(p).read_text())
    except Exception:
        return default


def write_json(p, d):
    tmp = Path(str(p) + ".tmp")
    tmp.write_text(json.dumps(d, indent=1, sort_keys=True))
    os.replace(tmp, p)


def digest(kind, msg, task="-"):
    """Silent record for the digest (`nrp-monitor digest`, daily file, SessionStart line)."""
    msg = " ".join(str(msg).split())[:500]
    STATE.mkdir(parents=True, exist_ok=True)
    with open(DIGEST, "a") as f:
        f.write(json.dumps({"t": iso(), "kind": kind, "task": task, "msg": msg}) + "\n")
    log("digest %s %s: %s" % (kind, task, msg))


def slack_dm(text):
    """Send `text` (already composed and escaped by slack_text) as the owner's DM."""
    if not SLACK_USER:
        log("slack dm: slack_user_id is not set in %s/config.json; falling back to the other channels" % STATE)
        return False
    try:
        import urllib.request
        tok = json.loads(JWT_FILE.read_text())["access_token"]
        req = urllib.request.Request(SLACK_URL, data=json.dumps({"user_id": SLACK_USER, "text": text}).encode(),
                                     headers={"Authorization": "Bearer " + tok, "Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=30) as r:
            ok = json.loads(r.read().decode()).get("status") == "delivered"
        log("slack dm: %s" % ("delivered" if ok else "not delivered"))
        return ok
    except Exception as e:
        log("slack dm failed: %s" % str(e)[:120])            # never log the token
        return False


def claude_push(msg):
    """PushNotification from a headless agent: reaches the owner's phone when a Remote Control session is open."""
    prompt = ("Call the PushNotification tool exactly once with status \"proactive\" and this message, verbatim: %s\n"
              "Then reply with only the tool result text." % json.dumps(msg))
    try:
        r = subprocess.run(["claude", "-p", "--model", "haiku", "--max-turns", "3", "--max-budget-usd", "0.20",
                            "--permission-mode", "dontAsk", "--no-session-persistence", "--allowedTools", "PushNotification"],
                           input=prompt, capture_output=True, text=True, cwd=str(WORK), env=clean_env(), timeout=180)
        out = r.stdout.strip()
    except Exception as e:
        out = "error %s" % e
    log("claude push: %s" % out[:150])
    return bool(out) and "not sent" not in out.lower() and "error" not in out.lower()


def banner(msg, title="NRP: needs you"):
    try:
        subprocess.run(["osascript", "-e", "on run argv", "-e", "display notification (item 1 of argv) with title (item 2 of argv)",
                        "-e", "end run", msg, title], capture_output=True, timeout=20)
    except Exception as e:
        log("osascript failed: %s" % str(e)[:80])


def push(msg, key, dry=False, refs=None):
    """The ONE interruption: Slack DM to the owner + Claude push; a macOS banner only when both fail. Once per key.
    `refs` = the registrations the alert is about ('task:NAME', 'chain:NAME', 'job:NAME'); their origin chat is named first in
    every channel. No refs = a shared/system alert that no single chat owns."""
    msg = " ".join(msg.split())[:300]
    refs = list(refs or [])
    tag = short_tag(refs)
    if dry:
        print("[dry-run] would PUSH: " + tag + msg)
        print("[dry-run] Slack text:\n" + slack_text(msg, refs))
        return False
    with state_lock():
        sent = read_json(PUSHED, {})
        if key in sent:
            return False
        sent[key] = {"t": iso(), "msg": tag + msg, "origin": [origin_plain(*lookup_origin(r)) for r in refs] or ["shared"]}
        write_json(PUSHED, sent)
    ledger_task = refs[0].split(":", 1)[-1] if len(refs) == 1 else "shared"
    task_failure = ((task_load(ledger_task) or {}).get("failure") or {}) if len(refs) == 1 and refs[0].startswith("task:") else {}
    cost_event(ledger_task, "owner_dm", "owner", "escalated", notification_key=key,
               stage=task_failure.get("stage"), fingerprint=task_failure.get("fingerprint"))
    log("PUSH [%s] %s%s" % (key, tag, msg))
    digest("push", tag + msg, refs[0] if len(refs) == 1 else "-")
    if os.environ.get("NRP_MONITOR_NO_PUSH"):                 # tests: no Slack, no Claude; the (fake) banner records it
        banner(tag + msg, "NRP test push")
        return True
    ok_s, ok_c = slack_dm(slack_text(msg, refs)), claude_push((tag + msg)[:190])
    if not (ok_s or ok_c):
        banner(tag + msg)
    return True


def push_clear(key):
    """Re-arm a push key once its condition has cleared (account alarm, kubectl failing)."""
    with state_lock():
        sent = read_json(PUSHED, {})
        if sent.pop(key, None) is not None:
            write_json(PUSHED, sent)


def jwt_days_left():
    try:
        import base64
        tok = json.loads(JWT_FILE.read_text())["access_token"]
        p = json.loads(base64.urlsafe_b64decode(tok.split(".")[1] + "=="))
        return (p["exp"] - now()) / 86400
    except Exception:
        return None


# ---- tasks (v2): task-level approval, script-classified failures, silent retries ----------------------------------
# A task = owner-approved work: stages (one k8s Job each, from a manifest), success = S3 keys, an optional code clone.
# The script submits stages, checks success, deletes finished Jobs after saving their logs, and classifies failures.
# A fresh Sonnet agent (templates/task_agent.md) is started only to diagnose and fix a failure; its only shell tool is
# `nrp-task` (this script's `tool` subcommand), which validates every argument. Retries are silent; the task moves to
# NEEDS_OWNER (one push) on a repeated failure, a slow/design failure, a used-up budget or an agent STOP.
TASKS = STATE / "tasks"
TASK_CACHE = Path(os.environ.get("NRP_TASK_CACHE") or Path.home() / ".cache/nrp-tasks")
TASK_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,39}$")
SYSTEMIC_CLASSES = ("code", "unknown", "outputs")     # the same one of these on several stages is one bug, not several bad shards
SYSTEMIC_STAGES = 3                                   # ... on this many distinct stages (or 10% of a fan-out, whichever is larger)
LOST_SIG = "lost-pod"                                 # the container never reported an exit and there is no traceback: our code did not fail
CLASS_BUDGET = {"resources": 3, "util": 3, "code": 3, "queue": 2, "infra": 2, "outputs": 1, "unknown": 1}
TASK_LIVE = ("running", "retrying", "blocked")
TASK_HELD = ("NEEDS_OWNER", "WITH_COORDINATOR")      # completion is still observed while waiting for a decision
WAKE_MAX_TRIES = 6                                   # a coordinator wake that fails this many passes (~30 min) falls back to NEEDS_OWNER
COORD_STALE_S = 24 * 3600                            # a delivered wake nobody answered for this long falls back to NEEDS_OWNER
# Tier 0 deadline rules (no model). activeDeadlineSeconds counts from Job start INCLUDING time spent Pending.
DEADLINE_EXT_MAX = 2                                 # in-place extensions for a Job that is still progressing near its deadline
DEADLINE_PEND_EXT_MAX = 8                            # in-place extensions that keep a still-Pending Job alive near its deadline
DEADLINE_CREDIT_MIN_S = 10 * 60                      # Pending time shorter than this is not credited back
DEADLINE_RESUBMITS_MAX = 1                           # a dead stage is resubmitted with 2x deadline this many times (resume-capable stages only)
TRIAGE_CLASSES_ALWAYS = ("unknown", "slow")          # Tier 1 (Haiku) always looks at these; other classes only while the Job is alive or done
TASK_MODEL, TASK_TURNS, TASK_BUDGET, TASK_TIMEOUT = "sonnet", "60", "6.00", 2700   # alias "sonnet" followed the newest Sonnet: claude-sonnet-5-5 under this scrubbed env on 2026-11-05
CODE_PYTHON = Path(OWNER["code_python"]) if OWNER.get("code_python") else None   # config.json "code_python": interpreter for `nrp-task code-test` (needs pytest) and `reship`; default = the one running this script
BLOCK_ESCALATE_S = 6 * 3600
BLOCK_RECHECK_S = 600       # while pods outside the bands explain a block: re-check the namespace this often, re-apply only if the set changed
LAST_BLOCK = {}             # the raw text of the most recent admission refusal (apply_manifest returns only "blocked")
BLOCK_RE = re.compile(r"utilization (is )?too low|exceeded quota|forbidden:.*quota|denied the request.*utiliz", re.I)
TRANSIENT_RE = re.compile(r"ConnectionError|EndpointConnectionError|ReadTimeout|timed out|Temporary failure in name resolution|"
                          r"SlowDown|503 Service|Connection reset|BrokenPipe|Name or service not known|urlopen error", re.I)
EXC_RE = re.compile(r"^\s*([A-Za-z_][\w.]*(Error|Exception|Interrupt))(:.*)?$")
FLAG_RES = re.compile(r"\b(cpu|mem|gpu)\s+([\d.]+)/([\d.]+)(?:Gi)?\s+\((\d+)%(?:,\s*max\s+([\d.]+))?")
GIT_ID = ["-c", "user.name=nrp-monitor", "-c", "user.email=nrp-monitor@localhost"]


def task_dir(n):
    return TASKS / n


def task_load(n):
    t = read_json(task_dir(n) / "task.json", None) if n else None
    if t and t.get("status") == "NEEDS_HUNTER":          # the status was named after its first user; tasks written before the rename
        t["status"] = "NEEDS_OWNER"
    return t


def task_write(t):
    p = task_dir(t["name"]) / "task.json"
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_suffix(".tmp")
    tmp.write_text(json.dumps(t, indent=1, sort_keys=True))
    os.chmod(tmp, 0o600)
    os.replace(tmp, p)


def task_txn(n, fn):
    with state_lock():
        t = task_load(n)
        if t is None:
            return False
        previous = t.get("status")
        completed = set(t.get("completed_stages", [])) | {s["id"] for s in t.get("stages", []) if s["state"] == "done"}
        r = fn(t)
        if r is False:
            return False
        t["completed_stages"] = sorted(completed | {s["id"] for s in t.get("stages", []) if s["state"] == "done"})
        if t.get("status") != previous and t.get("status") in ("done", "failed", "cancelled"):
            terminal_wake(t)
        task_write(t)
        return True if r is None else r


def task_names():
    return sorted(p.parent.name for p in TASKS.glob("*/task.json")) if TASKS.is_dir() else []


# ---- handoff: one markdown file per task. The registering agent writes `## Registrar` once; this script is the only writer of
# the append sections (`## Fix log`, `## Continuation`, `## For the owner`), from the HANDOFF_ENTRY block of an agent's final answer.
# Agents never edit the file: the copy in the task dir (handoff.md) is the source of truth, handoff.orig.md the unmodified original.
HANDOFF_HEADS = ("Registrar", "Fix log", "Continuation", "For the owner")
HANDOFF_APPEND = {"deputy": "Fix log", "fix": "Fix log", "continue": "Continuation"}          # agent kind -> the section it may add to
HANDOFF_MIN_REG = 200                  # characters of text (comments and white space excluded) a Registrar section needs
HANDOFF_MAX_FILE, HANDOFF_MAX_REG = 100 * 1024, 16000
HANDOFF_ENTRY_MAX, HANDOFF_OWNER_MAX = 1500, 500
HANDOFF_PROMPT_MAX = 14000             # characters of handoff embedded in an agent prompt (Registrar whole, newest log entries)
HANDOFF_NONE = "(no handoff written)"
HANDOFF_COMMENT = re.compile(r"<!--.*?-->", re.S)
HANDOFF_ENTRY_RE = re.compile(r"^[ \t>*_`#-]*HANDOFF_ENTRY[ \t*_`]*:[ \t*_`]*(.*)$", re.M)
HANDOFF_OWNER_RE = re.compile(r"^[ \t>*_`-]*FOR_OWNER[ \t*_`]*:[ \t*_`]*(.*)$")


def handoff_split(text):
    """[(heading|None, body)] split at level-2 headings (`## X`), ignoring ones inside code fences. The first item is the preamble."""
    secs, fence = [[None, []]], False
    for line in text.replace("\r\n", "\n").split("\n"):
        if line.lstrip().startswith("```"):
            fence = not fence
        if not fence and line.startswith("## "):
            secs.append([line[3:].strip(), []])
        else:
            secs[-1][1].append(line)
    return [(h, "\n".join(b)) for h, b in secs]


def handoff_join(secs):
    out = []
    for h, b in secs:
        b = b.strip("\n")
        if h is None:
            if b.strip():
                out.append(b)
        else:
            out.append("## %s\n\n%s" % (h, b) if b.strip() else "## %s" % h)
    return "\n\n".join(out) + "\n"


def handoff_body(secs, head):
    return next((b for h, b in secs if h == head), None)


def handoff_set(secs, head, body):
    for i, (h, _) in enumerate(secs):
        if h == head:
            secs[i] = (h, body)
            return secs
    secs.append((head, body))
    return secs


def handoff_sha(secs):
    b = handoff_body(secs, "Registrar")
    return hashlib.sha256(b.strip().encode()).hexdigest() if b is not None else None


def handoff_chars(body):
    return len(" ".join(HANDOFF_COMMENT.sub("", body or "").split()))


def handoff_path(hp, src_file):
    p = Path(str(hp)).expanduser()
    return p if p.is_absolute() else Path(src_file).expanduser().resolve().parent / p


def handoff_load(hp, src_file):
    """Check the task's `handoff` field. -> (text, thin, why). text is the normalised file (all four headings), or None when there is
    nothing usable (why says what is missing). thin: the Registrar exists but is short. ChainError: malformed (too big, duplicate headings)."""
    if hp is None or hp == "":
        return None, False, "the task has no handoff field"
    if not isinstance(hp, str):
        raise ChainError("handoff: path to a markdown file (absolute, ~ or relative to the task file's folder)")
    p = handoff_path(hp, src_file)
    if not p.is_file():
        return None, False, "handoff file %s does not exist" % p
    raw = p.read_bytes()
    if len(raw) > HANDOFF_MAX_FILE:
        raise ChainError("handoff: %s is %d KB; at most %d KB (a fresh agent reads it every time)" % (p, len(raw) // 1024, HANDOFF_MAX_FILE // 1024))
    text = raw.decode("utf-8", "replace")
    if not text.strip():
        return None, False, "handoff file %s is empty" % p
    secs = handoff_split(text)
    for h in HANDOFF_HEADS:
        if sum(1 for x, _ in secs if x == h) > 1:
            raise ChainError("handoff: heading `## %s` appears twice (use ### for sub-headings inside a section)" % h)
    reg = handoff_body(secs, "Registrar")
    if reg is None:
        return None, False, "handoff file %s has no `## Registrar` heading" % p
    if len(reg.strip()) > HANDOFF_MAX_REG:
        raise ChainError("handoff: the ## Registrar section is %d characters; at most %d (what the next agent needs, not a log)" % (len(reg.strip()), HANDOFF_MAX_REG))
    for h in HANDOFF_HEADS:
        if handoff_body(secs, h) is None:
            secs.append((h, ""))
    n = handoff_chars(reg)
    thin = n < HANDOFF_MIN_REG
    return handoff_join(secs), thin, ("its ## Registrar section is thin (%d characters of text, at least %d expected)" % (n, HANDOFF_MIN_REG)) if thin else ""


HANDOFF_ESC_RE = re.compile(r"last resort|escalat|coordinator|sub-?agent", re.I)
HANDOFF_ESC_ASK = ("In the Registrar, say in your own words how failures are handled: the monitor's script and its subagents (Tier 1 triage, "
                   "Tier 2 fixer) handle failures and fixes; this chat is woken only as a last resort, after them; the owner is notified only "
                   "after this chat decides they are needed (`nrp-monitor task needs-owner`).")


def handoff_escalation_missing(text):
    """True when an accepted handoff's Registrar never says who handles failures (the monitor's subagents first, the chat as a last resort,
    the owner last). A warning only: the Registrar is the registering agent's own text."""
    reg = HANDOFF_COMMENT.sub("", handoff_body(handoff_split(text), "Registrar") or "")
    return not HANDOFF_ESC_RE.search(reg)


def handoff_write(path, text):
    tmp = path.with_suffix(".tmp")
    tmp.write_text(text)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def handoff_attach(t, text, thin, source):
    """Write the task's handoff.md and handoff.orig.md and record them in the task (called before task_write / inside task_txn)."""
    d = task_dir(t["name"])
    d.mkdir(parents=True, exist_ok=True)
    handoff_write(d / "handoff.md", text)
    handoff_write(d / "handoff.orig.md", text)
    t["handoff"] = {"registrar_sha256": handoff_sha(handoff_split(text)), "thin": thin, "added": now(), "source": str(source)}
    tev(t, "handoff accepted (%d characters in the Registrar%s)" % (handoff_chars(handoff_body(handoff_split(text), "Registrar")), ", thin" if thin else ""))


def handoff_clean(s, limit):
    """Agent text for the file: control characters out, nothing that can open a heading, a fence or a comment (an entry must not
    be able to start a new section or hide the rest of the file)."""
    s = re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f]", "", s.replace("\r\n", "\n")).replace("<!--", "<! --")
    lines = []
    for l in s.split("\n"):
        l = l.rstrip()
        if "```" in l:
            l = l.replace("```", "'''")
        if l.startswith("#"):
            l = "\\" + l
        lines.append(l)
    s = "\n".join(lines).strip()
    return s if len(s) <= limit else s[:limit - 3].rstrip() + "..."


def handoff_extract(text):
    """(entry|None, [owner lines]) from an agent's final answer: what follows the LAST `HANDOFF_ENTRY:` line. A `FOR_OWNER:` line inside
    the block is returned separately and removed from the entry."""
    ms = list(HANDOFF_ENTRY_RE.finditer(text or ""))
    if not ms:
        return None, []
    m = ms[-1]
    block = (m.group(1) + "\n" + text[m.end():]).replace("\r\n", "\n")
    keep, owner = [], []
    for l in block.split("\n"):
        if l.strip().startswith("```") and l.strip().strip("`") == "":
            continue                                                  # a closing code fence around the block
        o = HANDOFF_OWNER_RE.match(l)
        if o:
            if o.group(1).strip():
                owner.append(o.group(1).strip())
        else:
            keep.append(l)
    entry = "\n".join(keep).strip()
    return (handoff_clean(entry, HANDOFF_ENTRY_MAX) or None), [handoff_clean(x, HANDOFF_OWNER_MAX) for x in owner[:5]]


def handoff_append(t, header, adds):
    """Inside a task transaction. adds = [(section, text)]. Writes the file atomically; the Registrar's hash must be unchanged before
    and after: a changed one (an agent edited the file) is restored from handoff.orig.md and logged. Never raises."""
    h = t.get("handoff")
    if not h:
        return
    d = task_dir(t["name"])
    p, o, want = d / "handoff.md", d / "handoff.orig.md", h["registrar_sha256"]
    try:
        secs = handoff_split(p.read_text())
    except OSError:
        secs = None
    if secs is None or handoff_sha(secs) != want:
        what = "handoff.md is missing" if secs is None else "the Registrar section was changed"
        try:
            osecs = handoff_split(o.read_text())
        except OSError:
            osecs = None
        if osecs is None or handoff_sha(osecs) != want:
            tev(t, "handoff: %s and the original cannot restore it; nothing was appended" % what)
            log("task %s: handoff %s and handoff.orig.md does not match either" % (t["name"], what))
            digest("fault", "handoff Registrar for %s is damaged and could not be restored (%s); nothing appended" % (t["name"], what), t["name"])
            return
        secs = osecs if secs is None else handoff_set(secs, "Registrar", handoff_body(osecs, "Registrar"))
        tev(t, "handoff: %s; Registrar restored from handoff.orig.md" % what)
        log("task %s: handoff %s; Registrar restored" % (t["name"], what))
        digest("fault", "handoff Registrar for %s was changed by an agent and restored from the original" % t["name"], t["name"])
    before = handoff_join(secs)
    for head, text in adds:
        secs = handoff_set(secs, head, (handoff_body(secs, head) or "").rstrip("\n") + "\n\n### %s\n%s" % (header, text))
    after = handoff_join(secs)
    if handoff_sha(handoff_split(after)) != want:                    # cannot happen unless this code is wrong; keep the file as it was
        tev(t, "handoff: Registrar hash changed by an append; the append was dropped")
        log("task %s: handoff append changed the Registrar hash; dropped" % t["name"])
        handoff_write(p, before)
        return
    handoff_write(p, after)


def handoff_record(n, kind, full, rec, ctx):
    """After a fix / continue agent ran: append its HANDOFF_ENTRY block (or an automatic line) to its own section; FOR_OWNER lines go
    to `## For the owner`."""
    t = task_load(n)
    if not t or not t.get("handoff") or kind not in HANDOFF_APPEND:
        return
    entry, owner = handoff_extract(full)
    rep = t.get("report") or {}
    attempt = sum(1 for r in t.get("agent_runs", []) if r["kind"] == kind)
    if not entry:
        bits = ["failure class %s on stage %s" % (ctx.get("cls", "?"), ctx.get("stage", "?"))] if ctx else []
        bits.append("report %s: %s" % (rep["status"], rep.get("line", "")) if rep else "no nrp-task report")
        bits.append("agent said: %s" % (rec.get("result") or "(nothing)")[:200])
        entry = handoff_clean("(automatic entry: the agent returned no HANDOFF_ENTRY block) " + "; ".join(bits), HANDOFF_ENTRY_MAX)
    when = datetime.fromtimestamp(now(), timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    header = "%s | %s agent | attempt %d%s" % (when, kind, attempt, (" | [%s] stage %s" % (ctx.get("cls", "?"), ctx.get("stage", "?"))) if ctx else "")
    adds = [(HANDOFF_APPEND[kind], entry)]
    if owner:
        adds.append(("For the owner", "\n".join("- " + x for x in owner)))
    task_txn(n, lambda t: handoff_append(t, header, adds))
    if owner:
        digest("handoff-owner", "%s agent asks the owner: %s" % (kind, " / ".join(owner)[:400]), n)


def handoff_prompt(t):
    """Handoff text for an agent prompt: the Registrar whole, the newest log entries of each append section within the cap."""
    if not t.get("handoff"):
        return HANDOFF_NONE
    d = task_dir(t["name"])
    try:
        secs = handoff_split((d / "handoff.md").read_text())
    except OSError:
        return HANDOFF_NONE
    reg = handoff_body(secs, "Registrar")
    if reg is None or handoff_sha(secs) != t["handoff"]["registrar_sha256"]:       # edited since: show the original
        try:
            reg = handoff_body(handoff_split((d / "handoff.orig.md").read_text()), "Registrar") or reg or ""
        except OSError:
            reg = reg or ""
    reg = HANDOFF_COMMENT.sub("", reg).strip()
    per = max(1500, (HANDOFF_PROMPT_MAX - len(reg)) // 3)
    out = ["== Registrar (written once by the agent that registered the task; read-only) ==\n" + reg]
    for head in HANDOFF_HEADS[1:]:
        body = HANDOFF_COMMENT.sub("", handoff_body(secs, head) or "")
        ents = [e.strip() for e in re.split(r"(?m)^(?=### )", body) if e.strip().startswith("### ")]
        keep, size = [], 0
        for e in reversed(ents):
            if keep and size + len(e) > per:
                break
            keep.append(e[:per])
            size += len(e)
        keep.reverse()
        note = "[%d older entr%s omitted; the full file is %s]\n" % (len(ents) - len(keep), "y" if len(ents) - len(keep) == 1 else "ies",
                                                                     d / "handoff.md") if len(ents) > len(keep) else ""
        out.append("== %s (appended by the monitor from agents' answers and coordinator decisions) ==\n%s%s" % (head, note, "\n\n".join(keep) or "(no entries yet)"))
    return "\n\n".join(out)


def wake_target(t):
    """Resume a recorded session, use the preferred T3 webhook, or send to the recorded T3 thread through its CLI."""
    o = t.get("origin") or {}
    if o.get("harness") in ("claude", "codex") and o.get("session"):
        return {"harness": o["harness"], "session": o["session"], "cwd": o.get("cwd") or ""}
    if (STATE / "webhooks" / t["name"]).exists():
        return {"harness": "t3"}
    link = str(o.get("link") or "").strip().strip("<>")
    match = re.fullmatch(r"t3-thread://v2/[^/\s]+/([^/\s]+)", link)
    if match:
        return {"harness": "t3-cli", "session": match.group(1)}
    return None


def queue_task_webhook(t, kind, **extra):
    """Called inside the task transaction, so the event and transition are atomic. `extra` (the `summary`) joins the event. The event goes
    to the task's wake target: the T3 webhook, or a Claude Code / Codex session resumed non-interactively (process_task_webhooks)."""
    if wake_target(t):
        generation = uuid.uuid4().hex
        event = dict({"task": t["name"], "event_type": kind, "event_id": generation, "generation": generation}, **extra)
        t.setdefault("webhook_outbox", []).append(event)
        f = t.get("failure") or {}
        cost_event(t["name"], "coordinator_wake", "coordinator", "escalated" if kind != "done" else "done",
                   stage=f.get("stage"), event_id=generation, wake_kind=kind, fingerprint=f.get("fingerprint"))
        return event["event_id"]


def webhook_config(n):
    """Only an owner-only regular file can supply config; never log its contents."""
    p = STATE / "webhooks" / n
    fd = os.open(str(p), os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0))
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077 or st.st_size > 4096:
            raise ValueError("invalid webhook file")
        with os.fdopen(fd, "r") as f:
            fd = -1
            config = json.load(f)
        url, workstream = config["url"], config["workstream"]
        if not isinstance(workstream, str) or not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,63}", workstream):
            raise ValueError("invalid workstream")
        u = urllib.parse.urlsplit(url)
        if not u.hostname or u.username or u.password or u.fragment or (u.scheme != "https" and not
                (u.scheme == "http" and u.hostname in ("127.0.0.1", "::1", "localhost"))):
            raise ValueError("invalid webhook URL")
        return url, workstream
    finally:
        if fd != -1:
            os.close(fd)


# Python-urllib's default User-Agent is rejected by Cloudflare (error 1010) in front of the relay, so every
# delivery failed with HTTP 403 until a User-Agent of our own was sent.
WEBHOOK_USER_AGENT = "nrp-monitor/1.0"


class NoWebhookRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def wake_failed(n, event, why):
    """A wake delivery failed (webhook, or a session resume). Count it on the event. After WAKE_MAX_TRIES passes the wake is given up: when
    the task waits on its coordinator chat (Tier 3) it falls back to NEEDS_OWNER so the escalation is never silently lost; any other wake
    (a step's done wake) is dropped with a digest fault line instead of being retried forever."""
    out = {}

    def f(t):
        eid = event.get("event_id")
        if not any(e.get("event_id") == eid for e in t.get("webhook_outbox") or []):
            return False
        tries = t.setdefault("wake_tries", {})                 # counted beside the outbox, so the delivered payload stays exactly the event
        tries[eid] = out["tries"] = tries.get(eid, 0) + 1
        if out["tries"] >= WAKE_MAX_TRIES:
            t["webhook_outbox"] = [e for e in t.get("webhook_outbox") or [] if e.get("event_id") != eid]
            tries.pop(eid, None)
            tev(t, "wake %s given up after %d failed deliveries: %s" % (event.get("event_type"), out["tries"], why))
            if event.get("event_type") == "escalation" and t.get("status") == "WITH_COORDINATOR":
                out["reason"] = t.get("reason", "")
            else:
                out["dropped"] = True
    task_txn(n, f)
    if out.get("reason") is not None:
        escalate(n, "the coordinator chat could not be woken (delivery failed %d passes in a row: %s). %s" % (out["tries"], why, out["reason"]))
    elif out.get("dropped"):
        digest("fault", "the %s wake for the coordinator chat was not delivered after %d tries (%s); it is dropped. `nrp-monitor task show %s`"
               % (event.get("event_type"), out["tries"], why, n), n)


class WakeError(Exception):
    pass


WAKE_TIMEOUT_S = 600
WAKE_TOOLS = ["Bash(nrp-monitor task show:*)", "Bash(nrp-monitor task resume:*)", "Bash(nrp-monitor task cancel:*)",
              "Bash(nrp-monitor task needs-owner:*)", "Bash(nrp-monitor digest:*)", "Bash(nrp-monitor status:*)"]
# a resumed chat may still run the old command name from its handoff; `nrp-watchdog` is an installed shim of nrp-monitor
WAKE_TOOLS += ["Bash(nrp-monitor decide:*)", "Bash(nrp-monitor wake-review:*)"]
WAKE_TOOLS += [t.replace("nrp-monitor", "nrp-watchdog") for t in WAKE_TOOLS]


def wake_text(t, event):
    """What a resumed claude/codex chat reads (a T3 relay composes its own text from the event). Short: summary, pointers and the commands."""
    n, kind = t["name"], event.get("event_type")
    if event.get("summary"):
        body = event["summary"]
    elif kind == "done":
        body = ("NRP task %s finished: all %d stage(s) succeeded and their success markers exist. Look: `nrp-monitor task show %s`; "
                "its handoff is %s." % (n, len(t.get("stages") or []), n, task_dir(n) / "handoff.md"))
    elif kind == "failure":
        f = t.get("failure") or {}
        body = "NRP task %s: stage %s failed [%s] %s. Look: `nrp-monitor task show %s`." % (n, f.get("stage"), f.get("cls"), (f.get("detail") or "")[:200], n)
    else:
        body = "NRP task %s: %s event. Look: `nrp-monitor task show %s`." % (n, kind, n)
    return ("[NRP monitor wake: an automated message from the monitor script, not from the owner. The monitor's own subagents already handled "
            "what they could; you are woken as a last resort, and the owner only after you.]\n%s\nUse your judgment on what to do next. "
            "Usually you can and should keep going now, in this turn: no later turn follows this message, so work you defer will not happen "
            "until someone asks. After handling this wake, record `nrp-monitor wake-review %s --by rule|agent|coordinator --why TEXT`. Continue the plan's next steps inside its approved range and the task's approval (review outputs, fix, "
            "resume, register the next step). Stop only at a stop_for_hunter step, a decision that is Hunter's, or a fix that needs "
            "tools you do not have here; then say in one line what is needed, and use `nrp-monitor task needs-owner` only if he must act." % (body, n))[:3000]


def wake_argv(target):
    if target["harness"] == "claude":      # --resume: the same session, so the wake lands in that chat's history; --no-session-persistence is NOT used
        return ["claude", "-p", "--resume", target["session"], "--permission-mode", "dontAsk", "--output-format", "json",
                "--allowedTools"] + WAKE_TOOLS
    return ["codex", "exec", "resume", "--all", "--skip-git-repo-check", target["session"], "-"]     # prompt on stdin; no --ephemeral (it must persist)


def claude_session_open(session):
    """Conservative guard: headless resume forks when the coordinator is interactive."""
    try:
        r = subprocess.run(["ps", "-axo", "command="], capture_output=True, text=True, timeout=10)
        if r.returncode:
            return True  # cannot prove the session closed
        for line in r.stdout.splitlines():
            if "claude" in line and re.search(r"(?:--resume(?:=|\s+)|--session-id(?:=|\s+))" + re.escape(session) + r"(?:\s|$)", line):
                return True
        root = Path.home() / ".claude" / "projects"
        return any(now() - p.stat().st_mtime < 300 for p in root.glob("*/%s.jsonl" % session))
    except (OSError, subprocess.TimeoutExpired):
        return True


def wake_session(target, text, timeout=None):
    """Resume the owner's own claude / codex session non-interactively with the wake text, so it lands in that chat's history (never a new
    thread). Raises WakeError with a short reason; the caller counts it toward WAKE_MAX_TRIES."""
    h = target["harness"]
    if h == "claude" and claude_session_open(target["session"]):
        raise WakeError("claude coordinator session is open or recently active; deferred to avoid a fork")
    cwd = target.get("cwd") if target.get("cwd") and os.path.isdir(target["cwd"]) else str(Path.home())
    binary = wake_binary(h)
    try:
        r = subprocess.run([binary] + wake_argv(target)[1:], input=text, capture_output=True, text=True, cwd=cwd, env=clean_env(), timeout=timeout or WAKE_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        raise WakeError("%s resume timed out after %ds" % (h, timeout or WAKE_TIMEOUT_S))
    except OSError as e:
        raise WakeError("%s could not start (%s)" % (h, type(e).__name__))
    out = (r.stdout or "").strip()
    err = " ".join((r.stderr or out).split())[-160:]
    if limit_hit(r.returncode, r.stdout, r.stderr):
        raise WakeError("%s is out of usage" % h)
    if r.returncode:
        raise WakeError("%s resume failed (rc %d): %s" % (h, r.returncode, err))
    if h == "claude" and out.startswith("{"):
        try:
            res = json.loads(out)
        except ValueError:
            return
        if res.get("is_error"):
            raise WakeError("claude resume reported an error: %s" % " ".join(str(res.get("result") or "").split())[:160])
        return res


def wake_test_mode():
    """Scratch state never discovers installed wake clients, even if a harness forgets its environment guard."""
    return bool(os.environ.get("NRP_MONITOR_TESTING")) or STATE.resolve().is_relative_to(Path(tempfile.gettempdir()).resolve())


def wake_binary(harness):
    """Tests may execute only an explicit binary. Normal installs retain CLI discovery."""
    if os.environ.get("NRP_MONITOR_NO_WAKE"):
        raise WakeError("wake delivery disabled")
    override = os.environ.get("NRP_MONITOR_%s_BIN" % harness.upper())
    if override:
        return override
    if wake_test_mode():
        raise WakeError("test wake requires an explicit %s binary" % harness)
    if harness == "t3":
        local = Path.home() / ".t3/bin/t3"
        if local.is_file():
            return str(local)
    binary = shutil.which(harness, path=clean_env().get("PATH"))
    if not binary:
        raise WakeError("%s binary unavailable" % harness)
    return binary


def wake_t3(target, text):
    binary = wake_binary("t3")
    try:
        r = subprocess.run([binary, "thread", "send", target["session"], "-"], input=text,
                           capture_output=True, text=True, env=clean_env(), timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise WakeError("t3 unavailable (%s)" % type(e).__name__)
    if r.returncode:
        raise WakeError("t3 unavailable (rc %d)" % r.returncode)


WAKE_EXEC = {"claude": wake_session, "codex": wake_session, "t3-cli": wake_t3}     # tests replace these; the T3 relay is the webhook path below


def process_task_webhooks(a, st):
    if a.dry_run or os.environ.get("NRP_MONITOR_NO_WAKE"):
        return
    opener = urllib.request.build_opener(NoWebhookRedirect())
    for n in task_names():
        t = task_load(n) or {}
        target = wake_target(t) or {"harness": "t3"}                   # no target: the webhook path fails and is counted like any failed wake
        for event in (t.get("webhook_outbox") or [])[:10]:
            current = task_load(n) or {}
            if current.get("status") == "cancelled" or (current.get("status") == "done" and event.get("event_type") != "done"):
                def discard(cur):
                    cur["webhook_outbox"] = [e for e in cur.get("webhook_outbox", []) if e.get("event_id") != event["event_id"]]
                    (cur.get("wake_tries") or {}).pop(event["event_id"], None)
                    tev(cur, "ignored queued %s wake for terminal task" % event.get("event_type"))
                task_txn(n, discard)
                digest("wake-ignored", "queued %s wake for terminal task" % event.get("event_type"), n)
                continue
            try:
                usage = None
                if target["harness"] in WAKE_EXEC:                       # claude / codex: resume that session with the wake text
                    usage = WAKE_EXEC[target["harness"]](target, wake_text(t, event))
                else:
                    url, workstream = webhook_config(n)
                    payload = dict(event, workstream=workstream)
                    req = urllib.request.Request(url, data=json.dumps(payload).encode(),
                                                 headers={"Content-Type": "application/json", "User-Agent": WEBHOOK_USER_AGENT}, method="POST")
                    with opener.open(req, timeout=5) as response:
                        if not 200 <= response.status < 300:
                            raise ValueError("delivery failed")
            except Exception as e:
                if isinstance(e, WakeError):
                    why = str(e)
                else:
                    why = ("HTTP %s" % e.code) if isinstance(e, urllib.error.HTTPError) else type(e).__name__
                    if isinstance(e, urllib.error.URLError) and not isinstance(e, urllib.error.HTTPError):
                        why += " (%s)" % type(e.reason).__name__
                log("task %s %s wake delivery failed: %s; will retry" % (n, target["harness"], why))
                wake_failed(n, event, why)
                break
            usage = usage if isinstance(usage, dict) else {}
            cost_event(n, "coordinator_result", "coordinator", "done", runner=target["harness"],
                       model=usage.get("model"), result=usage, event_id=event["event_id"], wake_kind=event.get("event_type"))
            def ack(t):
                t["webhook_outbox"] = [e for e in t.get("webhook_outbox", []) if e.get("event_id") != event["event_id"]]
                (t.get("wake_tries") or {}).pop(event["event_id"], None)
                tev(t, "wake delivered: %s via %s" % (event.get("event_type"), target["harness"]))
            task_txn(n, ack)


def tev(t, msg):
    t.setdefault("events", []).append("%s %s" % (iso(), " ".join(msg.split())[:300]))
    del t["events"][:-80]
    log("task %s: %s" % (t["name"], msg[:300]))


def tstage(t, sid):
    return next(s for s in t["stages"] if s["id"] == sid)


def task_of_job(job):
    """(task name, stage id) of a live task whose stage runs Job `job`."""
    for n in task_names():
        t = task_load(n)
        if t and t["status"] in TASK_LIVE + TASK_HELD:
            for s in t["stages"]:
                if s["job"] == job and s["state"] in ("running", "failed"):
                    return n, s["id"]
    return None


def norm_sig(s):
    s = re.sub(r"0x[0-9a-f]+|\b[0-9a-f]{8,}\b|\d+(\.\d+)?", "N", s.lower())
    return " ".join(s.split())[:140]


def resize_advice(line):
    out = []
    for kind, use, req, pct, mx in FLAG_RES.findall(line):
        use, req = float(use), float(req)
        peak = float(mx) if mx else use
        if kind == "mem":
            new = max(1, -(-peak * 1.5 // 1))
            if new < req:                                                    # no advice when it would not shrink
                out.append("memory %gGi -> %dGi (peak %.1fGi)" % (req, new, peak))
        elif kind == "cpu":
            out.append("cpu %g -> %g (mean %.2f)" % (req, max(0.5, -(-peak * 3 // 1) / 2), use))
        else:
            out.append("gpu at %s%% of %g GPU: run on CPU or bundle more work per GPU" % (pct, req))
    return "; ".join(out) or "see the flag line"


# ---- manifests, S3, code -------------------------------------------------------------------------------------
def manifest_check(path, ns, job):
    """Parse one Job manifest (YAML/JSON) and check the NRP house rules. Returns a list of problems."""
    try:
        text = Path(path).read_text()
        try:
            import yaml
            docs = [d for d in yaml.safe_load_all(text) if d]
        except ImportError:
            docs = [json.loads(text)]
    except Exception as e:
        return ["cannot read manifest %s: %s" % (path, str(e)[:120])]
    if len(docs) != 1 or not isinstance(docs[0], dict):
        return ["%s: exactly one Job per manifest file" % path]
    j, bad = docs[0], []
    md, spec = j.get("metadata") or {}, j.get("spec") or {}
    if j.get("kind") != "Job":
        bad.append("kind must be Job (Jobs only: no bare pods or Deployments)")
    if md.get("name") != job:
        bad.append("metadata.name is %r, the stage's job is %r" % (md.get("name"), job))
    if md.get("namespace") not in (None, ns):
        bad.append("namespace must be %s" % ns)
    if spec.get("backoffLimit") != 0:
        bad.append("spec.backoffLimit must be 0")
    if not spec.get("activeDeadlineSeconds"):
        bad.append("spec.activeDeadlineSeconds required (it counts queue time: include the expected wait)")
    ttl = spec.get("ttlSecondsAfterFinished")
    if ttl is not None and ttl < 3600:
        bad.append("ttlSecondsAfterFinished %s: at least 3600, so the monitor sees the Job finish and saves its logs" % ttl)
    pod = ((spec.get("template") or {}).get("spec")) or {}
    if pod.get("restartPolicy") not in ("Never", "OnFailure"):
        bad.append("template.spec.restartPolicy must be Never")
    for c in pod.get("containers") or []:
        res = c.get("resources") or {}
        if not res.get("requests") and not res.get("limits"):
            bad.append("container %s: resources.requests required" % c.get("name"))
        cmdtxt = " ".join(map(str, (c.get("command") or []) + (c.get("args") or [])))
        if re.search(r"\bsleep\s+(inf|infinity|\d{4,})\b", cmdtxt):
            bad.append("container %s: no long sleep (an idle pod is an NRP violation)" % c.get("name"))
    return bad


def manifest_gpu(path):
    """GPUs requested by the first container of a manifest (0 when none or unreadable)."""
    try:
        text = Path(path).read_text()
        try:
            import yaml
            j = yaml.safe_load(text)
        except ImportError:
            j = json.loads(text)
        n = 0
        for c in j["spec"]["template"]["spec"]["containers"]:
            r = c.get("resources") or {}
            for k in ("requests", "limits"):
                n = max(n, int(str((r.get(k) or {}).get("nvidia.com/gpu", 0)) or 0))
        return n
    except Exception:
        return 0


def today_iso():
    return os.environ.get("NRP_MONITOR_TODAY") or datetime.now().strftime("%Y-%m-%d")


def gpu_expired(s):
    """None, or the reason a stage that asks for a GPU may not be (re)submitted today. the owner's GPU OK is per day; a stage
    declares the last day it covers in `gpu_ok_until` (YYYY-MM-DD) and the monitor never submits a GPU Job after it."""
    if not s.get("manifest") or not manifest_gpu(s["manifest"]):
        return None
    if s.get("gpu_plan"):                            # covered by the approval date of an approved plan step (see plan_gpu_cover)
        return None
    until = s.get("gpu_ok_until")
    if not until:
        return "GPU APPROVAL: stage %s requests a GPU but has no gpu_ok_until date" % s["id"]
    if today_iso() > until:
        return "GPU APPROVAL: the owner's GPU OK for stage %s ran through %s (today %s); a GPU retry needs their new OK " \
               "(`nrp-monitor task resume NAME --gpu-ok-until YYYY-MM-DD`)" % (s["id"], until, today_iso())
    return None


def pv3_spec_uri(path):
    """The `--spec s3://...` argument of a pv3 Job's command, or None."""
    try:
        text = Path(path).read_text()
        try:
            import yaml
            j = yaml.safe_load(text)
        except ImportError:
            j = json.loads(text)
        c = j["spec"]["template"]["spec"]["containers"][0]
        argv = [str(x) for x in (c.get("command") or []) + (c.get("args") or [])]
        return next((argv[i + 1] for i, x in enumerate(argv[:-1]) if x == "--spec" and argv[i + 1].startswith("s3://")), None)
    except Exception:
        return None


def manifest_mem(t, s):
    try:
        import yaml
        j = yaml.safe_load(Path(s["manifest"]).read_text())
        c = j["spec"]["template"]["spec"]["containers"][0]["resources"]
        return str((c.get("limits") or {}).get("memory") or (c.get("requests") or {}).get("memory") or "?")
    except Exception:
        return "?"


def aws_cmd(c=None):
    cmd = ["aws", "--endpoint-url", os.environ.get("NRP_MONITOR_S3_ENDPOINT") or (c or {}).get("s3_endpoint") or DEFAULT_S3]
    if (c or {}).get("aws_profile"):
        cmd += ["--profile", c["aws_profile"]]
    return cmd


def s3_bucket_ok(bucket):
    try:
        r = subprocess.run(aws_cmd() + ["s3", "ls", "s3://%s/" % bucket], capture_output=True, text=True, timeout=120, env=aws_env())
    except Exception:
        return None
    if "NoSuchBucket" in r.stderr or "AccessDenied" in r.stderr:
        return False
    return True if r.returncode in (0, 1) else None


def git(*args, cwd=None, inp=None):
    return subprocess.run(["git", *GIT_ID, *args], cwd=cwd, capture_output=True, text=True, input=inp, timeout=600)


def clone_code(name, code, warn):
    """Clone the repo at a commit into ~/.cache/nrp-tasks/<task>/repo (launchd can read there, not ~/Desktop),
    on branch monitor/<task>; uncommitted tracked changes under subdir are applied and committed."""
    repo = Path(os.path.expanduser(code["repo"])).resolve()
    sub = (code.get("subdir") or "").strip("/")
    r = git("rev-parse", "--show-toplevel", cwd=str(repo))
    if r.returncode:
        raise ChainError("code.repo %s is not a git repository" % repo)
    top = Path(r.stdout.strip())
    given = repo
    if repo != top:                                                   # repo given as a subfolder
        sub = str((repo / sub).relative_to(top)).strip(".").strip("/") if sub else str(repo.relative_to(top))
        repo = top
    r = git("rev-parse", "--verify", (code.get("commit") or "HEAD") + "^{commit}", cwd=str(repo))
    if r.returncode:
        raise ChainError("code.commit %s not found in %s" % (code.get("commit"), repo))
    sha = r.stdout.strip()
    extras, shipped_extras = [], []                                   # code dirs the task ships besides subdir: in this repo / as declared
    for x in code.get("extra_pkg_dirs") or []:
        if os.path.isabs(os.path.expanduser(x)):
            shipped_extras.append(str(Path(x).expanduser()))             # another checkout: packed in place at reship, not cloned
        else:
            rel = str((given / x).relative_to(top)).strip(".").strip("/") if given != top else x.strip("/")
            extras.append(rel)
            shipped_extras.append(rel)
    scope = [x for x in ([sub] + extras if sub else []) if x] or ["."]
    dest = TASK_CACHE / name / "repo"
    shutil.rmtree(dest, ignore_errors=True)
    dest.parent.mkdir(parents=True, exist_ok=True)
    for step in (["clone", "-q", "--no-checkout", str(repo), str(dest)],):
        r = git(*step)
        if r.returncode:
            raise ChainError("git clone failed: %s" % r.stderr.strip()[:200])
    if sub:
        git("sparse-checkout", "set", "--cone", *scope, cwd=str(dest))
    r = git("checkout", "-q", "-B", "monitor/" + name, sha, cwd=str(dest))        # -B: a night-code work clone already has this branch
    if r.returncode:
        raise ChainError("git checkout failed: %s" % r.stderr.strip()[:200])
    if not code.get("commit"):
        diff = git("diff", "HEAD", "--binary", "--", *scope, cwd=str(repo)).stdout
        if diff.strip():
            a = git("apply", "--whitespace=nowarn", "-", cwd=str(dest), inp=diff)
            if a.returncode:
                raise ChainError("could not carry uncommitted changes into the clone: %s" % a.stderr.strip()[:200])
            git("add", "-A", cwd=str(dest))
            git("commit", "-qm", "uncommitted state of %s at task add" % repo, cwd=str(dest))
            warn.append("uncommitted changes under %s were committed in the clone" % (sub or repo))
        copied, skipped, total = [], [], 0
        for rel in git("ls-files", "-z", "--others", "--exclude-standard", "--", *scope, cwd=str(repo)).stdout.split("\0"):
            src = repo / rel
            if not rel or not src.is_file():
                continue
            if src.suffix not in CLONE_SUFFIXES or src.stat().st_size > CLONE_MAX_FILE or total + src.stat().st_size > CODE_SNAPSHOT_MAX:
                skipped.append(rel)
                continue
            (dest / rel).parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(src, dest / rel)
            total += src.stat().st_size
            copied.append(rel)
        if copied:
            git("add", "-A", cwd=str(dest))
            git("commit", "-qm", "untracked source files at task add (%d)" % len(copied), cwd=str(dest))
            warn.append("%d untracked source file(s) under %s were copied into the clone and committed (e.g. %s)"
                        % (len(copied), sub or repo, copied[0]))
        if skipped:
            warn.append("%d untracked file(s) under %s are NOT in the clone (not source or over %d MiB; e.g. %s); commit them or set code.commit"
                        % (len(skipped), sub or repo, CLONE_MAX_FILE >> 20, skipped[0]))
    out = {"repo": str(repo), "base": sha, "clone": str(dest), "branch": "monitor/" + name, "subdir": sub}
    if code.get("pkg_dir"):
        out["pkg_dir"] = code["pkg_dir"]
    if shipped_extras:
        out["extra_pkg_dirs"] = shipped_extras
    return out


def code_dir_problem(x, what):
    """None, or why `x` cannot be a code dir: relative = inside the task's repo (no `..`), absolute / `~` = another git checkout."""
    if not isinstance(x, str) or not x.strip() or "\0" in x:
        return "%s: a folder path" % what
    p = Path(os.path.expanduser(x))
    if p.is_absolute():
        return None if p.is_dir() else "%s: %s is not a folder" % (what, x)
    if ".." in Path(x).parts:
        return "%s: %s must stay inside the code repo (no ..); use an absolute path for another checkout" % (what, x)
    return None


def code_dirs_check(code):
    """Problems with code.pkg_dir / code.extra_pkg_dirs (what `nrp-task reship` packs besides the clone's own package)."""
    bad = []
    if code.get("pkg_dir") is not None:
        pr = code_dir_problem(code["pkg_dir"], "code.pkg_dir")
        bad += [pr] if pr else []
    ex = code.get("extra_pkg_dirs")
    if ex is not None:
        if not isinstance(ex, list) or len(ex) > 8:
            bad.append("code.extra_pkg_dirs: a list of at most 8 package folders")
        else:
            for i, x in enumerate(ex):
                pr = code_dir_problem(x, "code.extra_pkg_dirs[%d]" % i)
                if pr:
                    bad.append(pr)
            names = [Path(os.path.expanduser(x)).name for x in ex if isinstance(x, str)]
            if len(set(names)) != len(names) or not all(n.isidentifier() for n in names):
                bad.append("code.extra_pkg_dirs: each folder name must be a distinct Python package name (it is the top-level folder in the shipped tarball)")
    return bad


# ---- task add / validate ---------------------------------------------------------------------------------------
def validate_task(raw, warn, plan_gpu=None):
    bad = []
    if not isinstance(raw, dict):
        raise ChainError("top level must be an object")
    name = raw.get("name")
    if not isinstance(name, str) or not TASK_RE.match(name):
        bad.append("name: lowercase letters, digits and -, max 40")
    for k in ("goal", "approved"):
        if not isinstance(raw.get(k), str) or len(raw[k].strip()) < 8:
            bad.append("%s: required (approved = the owner's words and the date he approved the task)" % k)
    mode = raw.get("mode", "auto")
    if mode not in ("auto", "watch"):
        bad.append("mode: auto (default: agents debug and resubmit) or watch (any failure goes to the owner)")
    notes = raw.get("notes", "")
    if not isinstance(notes, str) or len(notes.encode()) > 4096:
        bad.append("notes: text, at most 4 KB (what a fresh agent needs: how the job works, what a good result looks like)")
    ns = raw.get("namespace", NS)
    mr = raw.get("max_retries", scaled_retry_cap(raw.get("stages") or []))
    if not isinstance(mr, int) or isinstance(mr, bool) or mr < 0:
        bad.append("max_retries: nonnegative integer")
    postcheck = raw.get("postcheck")
    if postcheck is not None:
        if (not isinstance(postcheck, dict) or not isinstance(postcheck.get("cmd"), list)
                or not postcheck["cmd"] or not all(isinstance(x, str) and x for x in postcheck["cmd"])
                or not isinstance(postcheck.get("expect"), str) or not postcheck["expect"]):
            bad.append("postcheck: {cmd: [exact local read-only checker argv], expect: nonempty text}")
    code = raw.get("code")
    if code is not None and (not isinstance(code, dict) or not isinstance(code.get("repo"), str)):
        bad.append("code: {repo: path, commit?: sha, subdir?: path, pkg_dir?: path, extra_pkg_dirs?: [path]}")
        code = None
    if code is not None:
        bad += code_dirs_check(code)
    fol = raw.get("followup", "")
    if not isinstance(fol, str) or len(fol.encode()) > 2048:
        bad.append("followup: text, at most 2 KB (what a read-only agent reports when the task is done)")
    try:
        origin = norm_origin(raw.get("origin"))
    except ChainError as e:
        origin = None
        bad.append(str(e))
    steps = raw.get("stages")
    if not isinstance(steps, list) or not steps:
        raise ChainError("; ".join(bad + ["stages: non-empty list required"]))
    stages, ids, buckets = [], set(), set()
    for i, s in enumerate(steps):
        if not isinstance(s, dict):
            bad.append("stages[%d]: object" % i)
            continue
        sid = s.get("id") or s.get("job")
        w = "stage %s" % sid
        job = s.get("job")
        if not isinstance(job, str) or not JOB_RE.match(job) or len(job) > 63:
            bad.append("%s: job must be a DNS-1123 name" % w)
        if sid in ids:
            bad.append("%s: duplicate id" % w)
        ids.add(sid)
        st0 = s.get("state", "pending")
        if st0 not in ("pending", "running", "done"):
            bad.append("%s: state pending|running|done" % w)
        d3 = s.get("done_s3")
        if not isinstance(d3, list) or not d3 or not all(s3_split(x) for x in d3):
            bad.append("%s: done_s3 = full s3://bucket/key URIs of single objects (no trailing slash; checked EXACTLY, never as a prefix) "
                       "that exist only when the stage succeeded (the success check)" % w)
            d3 = []
        buckets |= {x[5:].split("/")[0] for x in d3}
        m = s.get("manifest")
        if st0 != "done" and (mode == "auto" or st0 == "pending"):
            if not isinstance(m, str) or not os.path.isfile(os.path.expanduser(m)):
                bad.append("%s: manifest (path to the Job yaml) required and must exist" % w)
            else:
                bad += ["%s: %s" % (w, p) for p in manifest_check(os.path.expanduser(m), ns, job)]
        purpose = str(s.get("purpose") or s.get("type") or s.get("kind") or sid).lower()
        smoke = s.get("smoke") is True or s.get("profile") is True or purpose in ("smoke", "profile")
        if smoke and isinstance(m, str) and os.path.isfile(os.path.expanduser(m)):
            try:
                spec = manifest_doc(os.path.expanduser(m))["spec"]
                counts = [spec.get(k, 1) for k in ("parallelism", "completions")]
                cap = util_policy().get("smoke_max_jobs", 3)
                if any(not isinstance(v, int) or isinstance(v, bool) or v < 1 for v in counts) or max(counts) > cap:
                    bad.append("%s: smoke/profile parallelism and completions must be 1..%d (smoke_max_jobs); include the largest/longest item" % (w, cap))
            except (OSError, ValueError, KeyError, TypeError):
                bad.append("%s: cannot determine smoke/profile pod count" % w)
        after = s.get("after", [])
        if not isinstance(after, list):
            bad.append("%s: after = list of stage ids" % w)
            after = []
        a3 = s.get("after_s3", [])
        if not isinstance(a3, list) or not all(s3_split(x) for x in a3):
            bad.append("%s: after_s3 = list of full s3://bucket/key URIs that must all exist before the stage is submitted "
                       "(a gate on another task's success marker)" % w)
            a3 = []
        elif set(a3) & set(d3):
            bad.append("%s: after_s3 repeats one of the stage's own done_s3 URIs (it would never be submitted)" % w)
        buckets |= {x[5:].split("/")[0] for x in a3}
        gok = s.get("gpu_ok_until")
        if gok is not None and not (isinstance(gok, str) and re.fullmatch(r"\d{4}-\d{2}-\d{2}", gok)):
            bad.append("%s: gpu_ok_until = YYYY-MM-DD (the last day of the owner's GPU OK)" % w)
            gok = None
        res = s.get("resumable")
        if res is not None and not isinstance(res, bool):
            bad.append("%s: resumable = true only when re-running the stage skips items whose outputs already exist (Tier 0 then resubmits it once with 2x deadline after a timeout)" % w)
            res = None
        stage = {"id": sid, "job": job, "manifest": os.path.expanduser(m) if isinstance(m, str) else None,
                 "after": after, "done_s3": d3, "state": st0, "attempt": 1}
        if "resource_group" in s:
            if isinstance(s["resource_group"], str) and s["resource_group"].strip():
                stage["resource_group"] = s["resource_group"]
            else:
                bad.append("%s: resource_group must be a nonempty string asserting compatible resource templates" % w)
        if "queue_wait_ceiling" in s:
            try:
                queue_ceiling_seconds(s["queue_wait_ceiling"])
                stage["queue_wait_ceiling"] = s["queue_wait_ceiling"]
            except ValueError:
                bad.append("%s: queue_wait_ceiling must be a positive duration like 6h" % w)
        if "cpu_fallback" in s:
            fallback = s["cpu_fallback"]
            if not ((isinstance(fallback, str) and fallback.strip()) or (isinstance(fallback, dict) and fallback)):
                bad.append("%s: cpu_fallback must be a manifest path or resources override" % w)
            else:
                stage["cpu_fallback"] = fallback
        runtime = s.get("measured_runtime_seconds")
        if runtime is not None:
            if isinstance(runtime, (int, float)) and not isinstance(runtime, bool) and runtime > 0:
                stage["measured_runtime_seconds"] = runtime
            else:
                bad.append("%s: measured_runtime_seconds must be a positive measured stage runtime" % w)
        if smoke:
            stage["purpose"] = "profile" if purpose == "profile" or s.get("profile") else "smoke"
        if res:
            stage["resumable"] = True
        if a3:
            stage["after_s3"] = a3
        if gok:
            stage["gpu_ok_until"] = gok
        if st0 != "done" and stage["manifest"] and os.path.isfile(stage["manifest"]) and manifest_gpu(stage["manifest"]) and plan_gpu:
            stage["gpu_plan"] = plan_gpu                   # an approved plan step: the owner's approval of the plan is the GPU OK
        elif st0 != "done" and stage["manifest"] and os.path.isfile(stage["manifest"]) and manifest_gpu(stage["manifest"]):
            if not gok:
                bad.append("%s: the manifest requests a GPU, so gpu_ok_until (YYYY-MM-DD, last day of the owner's GPU OK) is required" % w)
            elif gok < today_iso():
                bad.append("%s: gpu_ok_until %s is already past (today %s)" % (w, gok, today_iso()))
        stages.append(stage)
    for s in stages:
        for x in s["after"]:
            if x not in ids:
                bad.append("stage %s: after refers to unknown stage %s" % (s["id"], x))
    for b in sorted(buckets):
        ok = s3_bucket_ok(b)
        if ok is False:
            bad.append("bucket %s does not exist or is not readable (outputs must name the real bucket, e.g. braingeneersdev)" % b)
        elif ok is None:
            warn.append("could not check bucket %s" % b)
    if bad:
        raise ChainError("\n  - ".join(["%d problem(s):" % len(bad)] + bad))
    return {"name": name, "goal": raw["goal"].strip(), "approved": raw["approved"].strip(), "label": str(raw.get("label") or name)[:80],
            "namespace": ns, "mode": mode, "notes": notes, "max_retries": mr, "followup": fol, "code": code, "origin": origin,
            "group": raw.get("group"), "postcheck": postcheck, "stages": stages, "status": "running", "attempts": [], "failure": None, "created": now(), "events": [],
            "escalations": 0, "util": [], "agent_runs": []}


def cmd_task_add(a):
    try:
        raw = load_chain_file(a.file)[0]
        if isinstance(raw, dict):
            raw["origin"] = origin_overlay(raw.get("origin"), a)
    except ChainError as e:
        sys.exit("task refused: %s" % e)
    return task_add_raw(raw, a.file, by="session")


def task_add_raw(raw, src_file, by="session", parent=None):
    """Register a task. by = "session" (a person or chat: `task add`) or "continuation" (the plan agent, via `nrp-task next-add`)."""
    warn = []
    try:
        od_raw = raw.pop("on_done", None) if isinstance(raw, dict) else None
        dig = raw.pop("digest_only", None) if isinstance(raw, dict) else None
        hp = raw.pop("handoff", None) if isinstance(raw, dict) else None
        if dig is not None and (not isinstance(dig, str) or not 8 <= len(dig.strip()) <= 300):
            raise ChainError("digest_only: why nobody needs to look at the result (8-300 characters); it turns off the completion wake")
        od = check_on_done(od_raw, raw, src_file, by, parent) if od_raw is not None else None   # refuses unapproved / stop steps first
        if od:
            h = plan_header(od["plan"])
            if raw.get("group") is not None and not isinstance(raw["group"], str):
                raise ChainError("group: a declared group name")
            group = raw.get("group") or next((g for g, steps in h.get("groups", {}).items() if od["from_step"] in steps), None)
            if group and group not in h.get("groups", {}):
                raise ChainError("group: unknown plan group")
            raw["group"] = group
            if group in h.get("retries", {}) and "max_retries" not in raw:
                raw["max_retries"] = h["retries"][group]
        t = validate_task(raw, warn, plan_gpu=plan_gpu_cover(od))
    except ChainError as e:
        sys.exit("task refused: %s" % e)
    if od:
        t["on_done"] = od
    n = t["name"]
    if dig:
        t["digest_only"] = dig.strip()
    if not od and not t.get("followup") and not dig:
        msg = ("no continuation: when this task finishes the coordinator chat is woken with no plan step to check. Add "
               "\"on_done\": {\"plan\": \"PATH#ID\", \"from_step\": \"N\"} (wakes the chat; never passes a named stop), "
               "\"followup\" for a one-shot report, or \"digest_only\": \"why nobody needs to look at the result\" (turns off the wake).")
        if os.environ.get("NRP_MONITOR_REQUIRE_CONTINUATION"):
            sys.exit("task refused: " + msg)
        warn.append(msg)
    try:
        htext, hthin, hwhy = handoff_load(hp, src_file)
    except ChainError as e:
        sys.exit("task refused: %s" % e)
    if htext is None or hthin:
        msg = ("no handoff: %s, so the agents that fix or continue this task later start with only the task fields. After the monitor is "
               "started, write the handoff from templates/handoff.md (`## Registrar`: what is being done and why, what each stage produces, "
               "what to check, decisions made, what NOT to do, where the code and outputs are) and set \"handoff\": \"PATH\" in the task file."
               % hwhy)
        if os.environ.get("NRP_MONITOR_REQUIRE_HANDOFF") and by == "session":     # a continue agent registering the next step is only warned
            sys.exit("task refused: " + msg)
        warn.append(msg)
    if htext is not None and not hthin and handoff_escalation_missing(htext):
        warn.append("the handoff does not say how failures are handled. " + HANDOFF_ESC_ASK)
    # v3: a task registered by a person/chat must name its chat (ft-tables-w6 had none, so its alert woke nobody). A continuation
    # inherits its parent's origin, so one without is only warned about (refusing would strand the approved plan).
    require_origin_note(t["origin"], "task", n, always=(by == "session"))
    with state_lock():
        if task_load(n) and task_load(n)["status"] not in ("done", "cancelled"):
            sys.exit("task %s already exists and is %s (`nrp-monitor task show %s`)" % (n, task_load(n)["status"], n))
        busy = {}
        for o in task_names():
            ot = task_load(o)
            if o != n and ot and ot["status"] in TASK_LIVE + TASK_HELD:
                busy.update({s["job"]: o for s in ot["stages"] if s["state"] != "done"})
        for cn in chain_names():
            c = chain_load(cn)
            if c and c["status"] in OBSERVED:
                busy.update({s["job"]: "chain " + cn for s in c["steps"] if s["state"] != "done"})
        dup = [s["job"] for s in t["stages"] if s["job"] in busy]
        if dup:
            sys.exit("task refused: Job %s already belongs to %s" % (dup[0], busy[dup[0]]))
    if t["code"]:
        try:
            t["code"] = clone_code(n, t["code"], warn)
        except ChainError as e:
            sys.exit("task refused: %s" % e)
    d = task_dir(n)
    shutil.rmtree(d, ignore_errors=True)
    (d / "manifests").mkdir(parents=True)
    (d / "logs").mkdir()
    for s in t["stages"]:
        if s["manifest"]:
            dst = d / "manifests" / ("%s.yaml" % s["job"])
            shutil.copyfile(s["manifest"], dst)
            s["manifest"] = str(dst)
        if s["state"] == "running":
            s["submitted"] = now()
            if job_state(s["job"], t["namespace"]) == "missing":
                warn.append("stage %s is marked running but Job %s is not in the cluster yet" % (s["id"], s["job"]))
        for u in s["done_s3"]:
            if s["state"] != "done" and s3_exists(u, {}) is True:
                warn.append("stage %s: %s ALREADY exists, so the success check would pass on old output; prefer a fresh prefix" % (s["id"], u))
    (d / "task.src").write_text(Path(src_file).expanduser().read_text())
    if htext is not None:
        handoff_attach(t, htext, hthin, handoff_path(hp, src_file))
    tev(t, "added (mode %s, %d stages, max %d retries)" % (t["mode"], len(t["stages"]), t["max_retries"]))
    if od:
        tev(t, "plan %s step %s (registered by %s%s)" % (od["plan"], od["from_step"], by, ", after task " + parent if parent else ""))
    with state_lock():
        task_write(t)
    if od:
        ledger_add(od["plan"], od["from_step"], n, by, parent)
    for w in warn:
        print("warning: " + w, file=sys.stderr)
    digest("added", "%s: %s | %s" % (t["label"], t["goal"][:150], origin_plain(t["origin"])), n)
    print("task %s added (%s, %s): %d stage(s). The monitor submits pending stages, checks done_s3, retries failures with a "
          "fresh agent and pushes to the owner only when it needs them.%s" % (n, t["mode"], origin_plain(t["origin"]), len(t["stages"]),
          " Code clone: %s (branch %s)." % (t["code"]["clone"], t["code"]["branch"]) if t["code"] else ""))
    tgt = wake_target(t)
    print("Wake: %s. The monitor wakes that same chat (never a new thread) once per finished plan step and, as a last resort, when its own "
          "subagents cannot fix a failure; nothing else wakes it." % (
          {"t3": "T3 webhook relay", "t3-cli": "T3 CLI thread %s" % (tgt or {}).get("session"), "claude": "Claude Code session %s" % (tgt or {}).get("session"),
           "codex": "Codex session %s" % (tgt or {}).get("session")}[tgt["harness"]] if tgt else
           "NO wake target (no webhook, no --origin-harness/--origin-session): a failure that needs the chat goes to the owner instead"))
    if htext is None or hthin or handoff_escalation_missing(htext):
        print("HANDOFF: " + HANDOFF_ESC_ASK + " Attach it with `nrp-monitor task handoff %s FILE` (templates/handoff.md)." % n)
    return 0


# ---- task pass ---------------------------------------------------------------------------------------------------
def save_task_logs(t, s, reason):
    ns, job = t["namespace"], s["job"]
    p = task_dir(t["name"]) / "logs" / ("%s-a%d.txt" % (job, s.get("attempt", 1)))
    if reason != "Job succeeded" and p.exists() and p.stat().st_size > 200:
        return str(p), p.read_text()
    parts, logtxt = ["# task %s stage %s job %s attempt %d  saved %s\n# reason: %s\n" % (t["name"], s["id"], job, s.get("attempt", 1), iso(), reason)], ""
    for title, args in (("logs (last 300 lines)", ["logs", "job/" + job, "--all-containers", "--tail=300"]),
                        ("describe job", ["describe", "job", job]),
                        ("describe pods", ["describe", "pods", "-l", "job-name=" + job])):
        try:
            r = kubectl("-n", ns, *args, timeout=120)
            body = r.stdout if r.returncode == 0 else "(kubectl failed rc=%d: %s)\n%s" % (r.returncode, r.stderr.strip()[:200], r.stdout)
        except Exception as e:
            body = "(kubectl error: %s)" % str(e)[:150]
        if title.startswith("logs"):
            logtxt = body
        parts.append("\n## %s\n%s" % (title, body[-40000:]))
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text("".join(parts)[-120000:])
    if reason == "Job succeeded":
        outputs = dict(re.findall(r"^([A-Z][A-Z0-9_]{2,40})=(\S+)$", logtxt, re.M))
        (p.parent / s["id"]).mkdir(exist_ok=True)
        write_json(p.parent / s["id"] / "outputs.json", outputs)
        task_txn(t["name"], lambda cur: tstage(cur, s["id"]).update(outputs=outputs))
    return str(p), logtxt


def run_postcheck(t):
    check = t.get("postcheck")
    if not check:
        return {"ok": True, "output": "no postcheck declared"}
    try:
        r = subprocess.run(check["cmd"], cwd=(t.get("code") or {}).get("clone") or task_dir(t["name"]),
                           env=clean_env(), capture_output=True, text=True, timeout=120)
        output = (r.stdout + "\n" + r.stderr)[-16000:]
        return {"ok": r.returncode == 0 and check["expect"] in r.stdout, "rc": r.returncode, "output": output}
    except (OSError, subprocess.TimeoutExpired) as e:
        return {"ok": False, "output": str(e)[-2000:]}


def pod_started(ns, job):
    """Earliest container start of the Job's pods (None if no container ever ran)."""
    r = kubectl("-n", ns, "get", "pods", "-l", "job-name=" + job, "-o", "json")
    if r.returncode:
        return None
    ts = []
    for p in json.loads(r.stdout or "{}").get("items", []):
        for cs in p.get("status", {}).get("containerStatuses", []) or []:
            for k in ("running", "terminated"):
                v = (cs.get("state") or {}).get(k) or (cs.get("lastState") or {}).get(k)
                if v and v.get("startedAt"):
                    ts.append(parse_ts(v["startedAt"]))
    ts = [x for x in ts if x]
    return min(ts) if ts else None


def classify(t, s, logtxt):
    """(class, signature, detail) from Job conditions, pod status, exit code and the log tail. No model."""
    ns, job, mem = t["namespace"], s["job"], manifest_mem(t, s)
    j = json.loads(kubectl("-n", ns, "get", "job", job, "-o", "json").stdout or "{}")
    pods = json.loads(kubectl("-n", ns, "get", "pods", "-l", "job-name=" + job, "-o", "json").stdout or "{}").get("items", [])
    conds = {c.get("type"): c for c in j.get("status", {}).get("conditions", []) or []}
    freason = (conds.get("Failed") or {}).get("reason", "")
    code = None
    for p in pods:
        ps = p.get("status", {})
        if ps.get("reason") == "Evicted":
            return "resources", "evicted@" + mem, "pod evicted: %s" % (ps.get("message") or "")[:200]
        for cs in (ps.get("initContainerStatuses") or []) + (ps.get("containerStatuses") or []):
            term = (cs.get("state") or {}).get("terminated") or (cs.get("lastState") or {}).get("terminated")
            wait = (cs.get("state") or {}).get("waiting") or {}
            if term and term.get("reason") == "OOMKilled":
                return "resources", "oom@" + mem, "OOMKilled at memory limit %s" % mem
            if wait.get("reason") in ("ImagePullBackOff", "ErrImagePull", "InvalidImageName", "CreateContainerConfigError",
                                      "CreateContainerError"):
                return "infra", "waiting:%s" % wait["reason"], "%s: %s" % (wait["reason"], (wait.get("message") or "")[:200])
            if term and term.get("exitCode") is not None and (code is None or code == 0):
                code = term.get("exitCode")                   # a non-zero exit (init or main container) wins over a zero one
    if freason == "DeadlineExceeded":
        dl = (j.get("spec") or {}).get("activeDeadlineSeconds") or 0
        js, ps0 = parse_ts(j.get("status", {}).get("startTime")), s.get("pod_started")
        if not ps0 or (js and dl and ps0 - js > dl / 2):
            return "queue", "deadline-queue", "deadline %ds passed while the pod waited in the queue" % dl
        return "slow", "deadline-run", "ran %d min of its %d min deadline and did not finish (needs profiling or a design change)" % (
            ((js or ps0) + dl - ps0) // 60, dl // 60)
    lines = [l for l in (logtxt or "").splitlines() if l.strip()]
    err = next((l.strip() for l in reversed(lines[-80:]) if EXC_RE.match(l)), "")
    last = lines[-1].strip() if lines else ""
    if code is None and not err and "Traceback" not in (logtxt or ""):
        # General rule, no list of Kubernetes reasons: our container never reported an exit and printed no traceback, so our code
        # did not fail. Node loss, NotReady/taint evictions, preemption, drains and deleted pods all land here. Retry the stage.
        return "infra", LOST_SIG, "pod ended without an exit code or traceback from our container (node loss, eviction, " \
            "preemption or deletion)%s" % ("; Job condition %s" % freason if freason else "")
    if code == 137:
        return "resources", "137@" + mem, "exit 137 (OOM or eviction) at memory %s" % mem
    if (err or last) and TRANSIENT_RE.search(err or last):
        return "infra", "transient:" + norm_sig(err or last), "transient error: %s" % (err or last)[:200]
    if err or "Traceback" in (logtxt or ""):
        return "code", "code:" + norm_sig(err or last), "%s (exit %s)" % ((err or last)[:250], code)
    return "unknown", "exit%s:%s" % (code, norm_sig(last)), "exit %s, last log line: %s%s" % (
        code, last[:200], "; Job condition %s" % freason if freason else "")


# ---- failure decisions and cost evidence ---------------------------------------------------------------
def scaled_retry_cap(stages):
    return max(4, (len(stages) + 3) // 4)


def fingerprint(t, failure):
    stage = tstage(t, failure["stage"])
    def normalize(value):
        value = str(value).lower().replace(stage["job"].lower(), "STAGE")
        value = re.sub(r"[0-9a-f]{8,}", "H", value)
        value = re.sub(r"\d+", "N", value)
        return " ".join(value.split())
    group = stage.get("resource_group")
    if not group:
        def command(tokens):
            if not isinstance(tokens, list):
                return tokens
            result, selector = [], False
            flag = r"(?i)(?:--)?(?:(?:shard|partition|array|worker)[-_]?(?:index|id)|index|rank)"
            for token in tokens:
                value = str(token)
                if selector and re.fullmatch(r"[0-9]+", value):
                    value = "N"
                value = re.sub(r"^(" + flag.replace("(?i)", "") + r")=([0-9]+)$", r"\1=N", value, flags=re.I)
                selector = bool(re.fullmatch(flag, value))
                result.append(value.replace(stage["job"], "STAGE"))
            return result
        try:
            containers = manifest_doc(stage["manifest"])["spec"]["template"]["spec"]["containers"]
            group = [(c.get("image"), command(c.get("command")), command(c.get("args"))) for c in containers]
        except (OSError, ValueError, KeyError, TypeError):
            # Missing identity must not allow a decision to cross unknown stages.
            group = ["unknown manifest", stage["id"]]
    return hashlib.sha256(json.dumps([normalize(failure.get("detail", "")), failure["cls"], group],
                                     sort_keys=True).encode()).hexdigest()[:16]


def failure_context(t):
    f = t.get("failure") or {}
    fp = f.get("fingerprint") or (fingerprint(t, f) if f else None)
    return "\nFailure fingerprint: %s\nTask decisions: %s\n" % (fp, json.dumps(decisions(t["name"])))


def cost_event(task, kind, tier, outcome, stage=None, runner=None, model=None, result=None, **extra):
    result = result or {}
    row = dict(ts=now(), task=task, stage=stage, kind=kind, tier=tier, runner=runner, model=model,
               cost_usd=result.get("total_cost_usd"), usage=result.get("usage"),
               input_tokens=(result.get("usage") or {}).get("input_tokens"),
               output_tokens=(result.get("usage") or {}).get("output_tokens"), outcome=outcome, **extra)
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / "costs.jsonl").open("a") as stream:
        fcntl.flock(stream, fcntl.LOCK_EX)
        stream.write(json.dumps(row, sort_keys=True) + "\n")
    return row


def cost_rows():
    rows = []
    try:
        for line in (STATE / "costs.jsonl").read_text().splitlines():
            try:
                rows.append(json.loads(line))
            except ValueError:
                continue
    except FileNotFoundError:
        pass
    return rows


def decisions(n):
    return read_json(task_dir(n) / "decisions.json", [])


DECISION_NO_PROGRESS_LIMIT = 3


def postcheck_failure(f):
    return f.get("sig") == "postcheck" or f.get("cls") == "postcheck"


DECISION_ACTIONS = ("resubmit", "resubmit_with_manifest", "escalate", "skip_reuse")


def record_decision(t, fp, action, why, scope="task", max_uses=None, who="coordinator"):
    f = t.get("failure") or {}
    if action not in DECISION_ACTIONS or scope not in ("stage", "task"):
        raise ValueError("invalid decision action or scope")
    if not re.fullmatch(r"[0-9a-f]{16}", fp):
        raise ValueError("fingerprint must be 16 lowercase hex characters")
    if max_uses is not None and max_uses < 1:
        raise ValueError("max_uses must be positive")
    if scope == "stage" and not f.get("stage"):
        raise ValueError("stage scope needs a current failed stage")
    if action == "skip_reuse" and postcheck_failure(f):
        raise ValueError("skip_reuse cannot resolve a failing postcheck; the coordinator must fix the acceptance script")
    entries = decisions(t["name"])
    entry = dict(fingerprint=fp, action=action, scope=scope, stage=f.get("stage"), max_uses=max_uses,
                 uses=0, who=who, why=why, ts=now())
    # Newest decision supersedes the same scope and fingerprint.
    entries = [d for d in entries if (d["fingerprint"], d["scope"], d.get("stage") if scope == "stage" else None) !=
               (fp, scope, entry["stage"] if scope == "stage" else None)]
    entries.append(entry)
    write_json(task_dir(t["name"]) / "decisions.json", entries)
    tev(t, "recorded decision %s: %s (%s)" % (fp, action, why))


def apply_decision(n, a):
    if terminal_task(n):
        return False
    t = task_load(n)
    f = t.get("failure")
    if not f or t["mode"] != "auto" or a.dry_run:
        return False
    if postcheck_failure(f):
        to_coordinator(n, "postcheck failed: the coordinator must fix the acceptance script; skip_reuse cannot resolve it. " + f.get("detail", ""), a, deputy=False)
        return True
    fp = f.get("fingerprint") or fingerprint(t, f)
    entries = decisions(n)
    for d in reversed(entries):
        if d["fingerprint"] != fp or (d["scope"] == "stage" and d.get("stage") != f["stage"]):
            continue
        progress = sorted(set(t.get("completed_stages", [])) | {s["id"] for s in t["stages"] if s["state"] == "done"})
        streak = (t.get("decision_streaks") or {}).get(fp)
        count = (streak["count"] if streak["progress"] == progress else 0) if streak else d.get("uses", 0)
        if count >= DECISION_NO_PROGRESS_LIMIT:
            to_coordinator(n, "decision %s applied %d times without progress (no new stage completed); coordinator action required" % (fp, count), a, deputy=False)
            return True
        if d.get("max_uses") is not None and d.get("uses", 0) >= d["max_uses"]:
            continue
        action = d["action"]
        if action == "escalate":
            to_coordinator(n, "coordinator decision %s: %s" % (fp, d["why"]), a, deputy=False)
            ok = True
        elif action == "skip_reuse":
            stage = tstage(t, f["stage"])
            if not stage.get("done_s3") or not all(s3_exists(uri, t) for uri in stage["done_s3"]):
                return False
            def done(task):
                tstage(task, f["stage"])["state"] = "done"
                task["failure"] = None
            task_txn(n, done)
            ok = True
        else:
            ok, msg = do_submit(n, f["stage"], "coordinator decision %s: %s" % (fp, d["why"]), "decision")
            if not ok:
                return False
        if ok:
            def consumed(task):
                # A coordinator can replace a decision while submit waits on kubectl. Never overwrite that newer log.
                current = decisions(n)
                for entry in current:
                    if (entry["fingerprint"], entry["scope"], entry.get("stage"), entry["ts"]) == (d["fingerprint"], d["scope"], d.get("stage"), d["ts"]):
                        entry["uses"] = entry.get("uses", 0) + 1
                        write_json(task_dir(n) / "decisions.json", current)
                        break
                task.setdefault("decision_streaks", {})[fp] = {"count": count + 1, "progress": progress}
                tev(task, "applied coordinator decision %s" % fp)
            task_txn(n, consumed)
            cost_event(n, "decision", "0", "escalated" if action == "escalate" else "resolved",
                       stage=f["stage"], fingerprint=fp)
            return True
    return False


def cmd_decide(a):
    if not task_load(a.name):
        sys.exit("no task %s" % a.name)
    task_txn(a.name, lambda t: record_decision(t, a.fingerprint, a.action, a.why, a.scope, a.max_uses))


def cmd_wake_review(a):
    wakes = [r for r in cost_rows() if r.get("task") == a.name and r.get("kind") == "coordinator_wake"]
    if not wakes:
        sys.exit("no coordinator wake recorded for " + a.name)
    cost_event(a.name, "wake_review", "coordinator", "done", by=a.by, why=a.why, wake_id=wakes[-1]["event_id"])


def cmd_costs(a):
    rows = [r for r in cost_rows() if (not a.task or r.get("task") == a.task) and r["ts"] >= now() - a.days * 86400]
    counts, costs, resolved, reviews = {}, {}, {}, {}
    by_kind, by_task = {}, {}
    latest_reviews = {r.get("wake_id"): r for r in rows if r["kind"] == "wake_review"}
    for r in rows:
        if r["kind"] == "coordinator_wake":
            key = (r["task"], r.get("wake_kind", "unknown"))
            counts[key] = counts.get(key, 0) + 1
            by_kind[key[1]] = by_kind.get(key[1], 0) + 1
            by_task[key[0]] = by_task.get(key[0], 0) + 1
        if r["kind"] == "wake_review" and latest_reviews.get(r.get("wake_id")) == r:
            key = (r["by"], r["why"])
            reviews[key] = reviews.get(key, 0) + 1
        if r.get("cost_usd") is not None:
            key = (str(r["tier"]), str(r.get("model")))
            costs[key] = costs.get(key, 0) + r["cost_usd"]
        if r.get("fingerprint") and r["outcome"] == "resolved":
            key = str(r["tier"])
            resolved[key] = resolved.get(key, 0) + 1
    print("Completion wakes avoided: %d" % sum(r["kind"] == "wake_avoided" for r in rows))
    print("Coordinator wakes by task / kind:")
    for (task, kind), count in sorted(counts.items()):
        print("  %s / %s: %d" % (task, kind, count))
    print("Wake totals by task: " + json.dumps(by_task, sort_keys=True))
    print("Wake totals by kind: " + json.dumps(by_kind, sort_keys=True))
    print("Resolved failures by tier (recorded resolution events):")
    total = sum(resolved.values())
    for tier in ("0", "1", "2", "deputy", "coordinator"):
        count = resolved.get(tier, 0)
        print("  %s: %d (%.1f%%)" % (tier, count, 100 * count / total if total else 0))
    print("Agent costs by tier / model (unreported costs excluded):")
    for (tier, model), cost in sorted(costs.items()):
        print("  %s / %s: $%.6f" % (tier, model, cost))
    print("Wake reviews by intended handler / reason:")
    for (by, why), count in sorted(reviews.items()):
        print("  %s / %s: %d" % (by, why, count))


def deputy_prompt(t, reason):
    plan = "(none)"
    if (t.get("on_done") or {}).get("plan"):
        path = plan_dir(t["on_done"]["plan"]) / "plan.md"
        if path.exists():
            plan = path.read_text()
    return (task_prompt(t) + "\nYou are the fresh deputy before the coordinator. "
            "Work only inside this task's goal and approval. You may edit unfinished manifests using measured resources, "
            "make routine environment fixes allowed to the fixer, resubmit within budgets, and record task-scoped decisions "
            "with nrp-task decide FINGERPRINT --action ACTION --why TEXT; apply with nrp-task apply-decision. "
            "nrp-task retry-cap N may raise the cap up to %d. "
            "Never change thresholds, checks, data selection or method, touch other tasks, cancel the task or contact the owner. "
            "skip_reuse fixes a failed stage whose success markers exist, never a failing postcheck; a broken postcheck/acceptance script is the coordinator's problem. "
            "End with RESOLVED: what you did, or ESCALATE: a brief of at most 120 words stating what failed, "
            "what was tried and the exact decision needed.\nEscalation reason: %s\nPlan copy:\n%s" %
            (scaled_retry_cap(t["stages"]), reason, plan))


def terminal_task(n, detail=None):
    """Late failures of done/cancelled tasks are audit-only, including queued work."""
    t = task_load(n) or {}
    if t.get("status") not in ("done", "cancelled"):
        return False
    f = t.get("failure") or {}
    detail = detail or ("stage %s [%s] %s" % (f.get("stage"), f.get("cls"), f.get("detail")) if f else None)
    if detail:
        def record(cur):
            if cur.get("status") not in ("done", "cancelled"):
                return False
            key = "%s: %s" % (cur["status"], detail)
            if key in cur.get("ignored_failures", []):
                return False
            cur.setdefault("ignored_failures", []).append(key)
            tev(cur, "ignored late failure for %s task: %s" % (cur["status"], detail))
        if task_txn(n, record):
            digest("failure-ignored", "late failure for %s task: %s" % (t["status"], detail), n)
    return True


def settled_outcome(n, line, a, kind):
    """Accept DONE/RESOLVED only when recovery passes the existing script checks."""
    if terminal_task(n):
        return True
    t = task_load(n)
    report = t.get("report") or {}
    match = re.match(r"^(RESOLVED|DONE)\b", line or "")
    answer = report.get("status") or (match.group(1) if match else None)
    if answer not in ("RESOLVED", "DONE"):
        return False
    if a and a.dry_run:
        return False
    apply_decision(n, a or argparse.Namespace(dry_run=False))
    t = task_load(n)
    if terminal_task(n):
        return True
    if t.get("failure"):
        ok, why = close_failure(n, t["failure"], line, kind=kind)
        if not ok:
            return False
    digest("resolved", "%s settled the event: %s" % (kind, line[:240]), n)
    return True


def task_fail(n, sid, cls, sig, detail, logs=None, extra=None):
    if terminal_task(n, "stage %s [%s] %s" % (sid, cls, detail[:200])):
        return False
    def f(t):
        if t.get("failure"):
            return False
        s = tstage(t, sid)
        s["state"] = "failed"
        if cls == "resources":
            try:
                extra_resources = resource_values(manifest_doc(s["manifest"]))
            except (OSError, ValueError, KeyError, TypeError):
                extra_resources = None
        else:
            extra_resources = None
        t["failure"] = dict({"stage": sid, "job": s["job"], "cls": cls, "sig": sig, "detail": detail[:400], "logs": logs, "ts": now(), "resource_values": extra_resources}, **(extra or {}))
        t["failure"]["fingerprint"] = fingerprint(t, t["failure"])
        tev(t, "stage %s FAILED [%s] %s" % (sid, cls, detail[:200]))     # no wake here: a failure goes up the ladder first (Tier 0/1/2 handle it)
    return task_txn(n, f)


def apply_manifest(ns, path):
    """'ok' | 'blocked' | error text. Server dry-run first."""
    for extra in (["--dry-run=server"], []):
        r = kubectl("-n", ns, "apply", *extra, "-f", path, timeout=180)
        if r.returncode:
            msg = (r.stderr.strip() or r.stdout.strip())[:400]
            if BLOCK_RE.search(msg):
                LAST_BLOCK["msg"] = msg
                return "blocked"
            return msg
    return "ok"


GPU_USE_RE = re.compile(r"\bgpu (\d+)% \(gpu (\d+)")


def pod_gpu_request(p):
    total = 0
    for c in p.get("spec", {}).get("containers", []):
        try:
            total += int((c.get("resources", {}).get("requests") or {}).get("nvidia.com/gpu", 0))
        except (TypeError, ValueError):
            pass
    return total


def namespace_offenders(ns):
    """Every Running pod in `ns`, whoever launched it (no annotation filter), through nrp-util-check: the pods outside NRP's bands
    (rule nrp or gpu; a lab-floor-only flag is not counted by NRP's webhook) or stuck. Returns a list of dicts: pod, owner (Job or other
    ownerReference), username (nrp.ai/username annotation, may be ""), service_account, ours (annotation == our owner annotation),
    usage ({cpu|mem|gpu: use/request/pct}) and line (nrp-util-check's text). Raises RuntimeError when kubectl or the metrics fail."""
    r = kubectl("-n", ns, "get", "pods", "-o", "json")
    if r.returncode:
        raise RuntimeError("kubectl get pods: " + (r.stderr.strip() or r.stdout.strip())[:150])
    running = {}
    for p in json.loads(r.stdout or "{}").get("items", []):
        m = p.get("metadata", {})
        if p.get("status", {}).get("phase") == "Running" and not m.get("deletionTimestamp"):
            running[m["name"]] = p
    if not running:
        return []
    u = subprocess.run(["nrp-util-check", "-n", ns, "--min-age", "300"] + sorted(running), capture_output=True, text=True, timeout=300)
    if u.returncode not in (0, 4, 5):
        raise RuntimeError("nrp-util-check exit %s: %s" % (u.returncode, (u.stdout.strip() or u.stderr.strip())[:150]))
    out = []
    for line in u.stdout.splitlines():
        m = FLAG.match(line)
        if not m or m.group(1) not in ("LOW", "STUCK") or m.group(2) not in running or flag_rule(line) == "lab":
            continue
        p = running[m.group(2)]
        meta, refs = p["metadata"], p["metadata"].get("ownerReferences") or []
        ref = next((o for o in refs if o.get("kind") == "Job"), refs[0] if refs else None)
        user = (meta.get("annotations") or {}).get("nrp.ai/username") or ""
        usage = {k: {"use": float(use), "request": float(req), "pct": int(pct)} for k, use, req, pct, mx in FLAG_RES.findall(line)}
        for pct, gi in GPU_USE_RE.findall(line):
            usage["gpu"] = {"pct": int(pct), "request": pod_gpu_request(p)}
        out.append({"pod": m.group(2), "owner": "%s/%s" % (ref.get("kind"), ref.get("name")) if ref else "", "username": user,
                    "service_account": p.get("spec", {}).get("serviceAccountName") or "", "ours": bool(USER_ANN) and user == USER_ANN,
                    "usage": usage, "line": line.strip()[:300]})
    return sorted(out, key=lambda o: o["pod"])


def offender_text(o):
    who = ", ".join(x for x in (o["owner"], ("user " + o["username"]) if o["username"] else "", ("service account " + o["service_account"])
                                if o["service_account"] and not o["username"] else "") if x) or "owner unknown"
    use = "; ".join("%s %s" % (k, ("%g/%g (%d%%)" % (v["use"], v["request"], v["pct"])) if "use" in v else
                               ("%d%% of %d GPU" % (v["pct"], v["request"]))) for k, v in o["usage"].items())
    return "%s (%s; %s)" % (o["pod"], who, use or o["line"][:80])


def block_wake_text(n, stage, job, refusal, offenders, err):
    head = "NRP refused the submit of task %s (stage %s, Job %s): %s" % (n, stage, job, " ".join(refusal.split())[:200])
    if err:
        return ("%s. The namespace-wide utilization check FAILED (%s), so the cause is unknown. Look at all Running pods with "
                "`kubectl get pods` and `nrp-util-check`; do not retry in a loop. The monitor keeps the task blocked and re-applies it each pass; "
                "it tells the owner after 6 h." % (head, err[:120]))
    if not offenders:
        return ("%s. The namespace-wide utilization check found no Running pod outside the bands, so this may be a quota block or metrics lag. "
                "The monitor keeps the task blocked and re-applies each pass; it tells the owner after 6 h." % head)
    ours, others = [o for o in offenders if o["ours"]], [o for o in offenders if not o["ours"]]
    parts = []
    if ours:
        parts.append("OURS (annotation matches): " + "; ".join(offender_text(o) for o in ours))
    if others:
        parts.append("OTHERS' (not launched by us): " + "; ".join(offender_text(o) for o in others))
    return ("%s. Namespace-wide check: %d Running pod(s) outside the bands. %s. Fix or delete our own pods; ask the owner before touching "
            "anyone else's. The monitor re-checks every %d min and re-applies the submit only when the offender set changes; never retry in a loop."
            % (head, len(offenders), " | ".join(parts), BLOCK_RECHECK_S // 60))


def block_episode(n):
    """First block of a pending submit: run the namespace-wide check once, save it on t["pending"], write a digest line and wake the
    coordinator chat once (the task stays `blocked`, so the monitor goes on re-applying when the offenders clear). Later calls in the same
    episode do nothing. A failed check is logged and still produces the one wake, carrying the raw refusal."""
    t = task_load(n)
    p = (t or {}).get("pending") or {}
    if not t or p.get("checked") is not None:
        return
    ns, offenders, err = t["namespace"], [], None
    try:
        offenders = namespace_offenders(ns)
    except Exception as e:
        err = "%s: %s" % (type(e).__name__, str(e)[:150])
        log("task %s: namespace utilization check failed: %s" % (n, err))
    refusal = p.get("refusal") or LAST_BLOCK.get("msg") or "utilization block or quota"
    text = block_wake_text(n, p.get("stage"), tstage(t, p["stage"])["job"], refusal, offenders, err)
    out = {}

    def f(t):
        pp = t.get("pending")
        if t["status"] != "blocked" or not pp or pp.get("checked") is not None:
            return False
        pp.update(checked=now(), rechecked=now(), offenders=offenders, check_error=err, refusal=refusal[:300], woke=now())
        out["event"] = queue_task_webhook(t, "escalation", summary=text[:2400] + " Look: `nrp-monitor task show %s`." % n)
        tev(t, "submit BLOCKED: %s" % (("%d offender(s): %s" % (len(offenders), ", ".join(o["pod"] for o in offenders))) if not err else "namespace check failed"))
    if not task_txn(n, f):
        return
    short = lambda os_: ", ".join("%s [%s]" % (o["pod"], o["owner"] or o["username"] or o["service_account"] or "?") for o in os_) or "none"
    brief = ("namespace check failed (%s)" % err if err else "%d pod(s) outside the bands. ours: %s. others: %s" % (
        len(offenders), short([o for o in offenders if o["ours"]]), short([o for o in offenders if not o["ours"]])))
    digest("block", "%s: submit refused by NRP; %s" % (t["label"], brief), n)
    PASS["coordinator"] = PASS.get("coordinator", 0) + 1
    if not out["event"]:                                                     # no coordinator chat to wake: the digest line above is the report; the 6 h fallback tells the owner
        log("task %s: submit blocked and the task has no wake target; digest only" % n)


def block_should_reapply(n):
    """True when the pending submit should be applied again this pass. Pods outside the bands explain the block: no re-apply until a
    re-check (at most every BLOCK_RECHECK_S) finds the set changed (or empty). No offenders or a failed check: the block is
    unexplained, so it goes on being applied each pass, as before, with the 6 h escalation as the fallback."""
    p = (task_load(n) or {}).get("pending") or {}
    if p.get("checked") is None:
        block_episode(n)
        p = (task_load(n) or {}).get("pending") or {}
    if not p.get("offenders"):
        return True
    if now() - p.get("rechecked", p.get("checked", 0)) < BLOCK_RECHECK_S:
        return False
    try:
        new = namespace_offenders(task_load(n)["namespace"])
    except Exception as e:
        log("task %s: namespace utilization re-check failed: %s" % (n, str(e)[:150]))
        task_txn(n, lambda t: (t.get("pending") or {}).update(rechecked=now()) if t.get("pending") else False)
        return False
    changed = {o["pod"] for o in new} != {o["pod"] for o in p["offenders"]}

    def f(t):
        if not t.get("pending"):
            return False
        t["pending"].update(offenders=new, rechecked=now())
        if changed:
            tev(t, "block re-check: offender set changed (%s); re-applying the submit" % (", ".join(o["pod"] for o in new) or "none left"))
    task_txn(n, f)
    return changed


def cpu_quantity(value):
    text = str(value).strip()
    factor = {"m": .001, "u": .000001, "n": .000000001}.get(text[-1:], 1)
    return float(text[:-1] if factor != 1 else text) * factor


def resource_values(doc):
    return [{"name": c["name"], **{kind: {key: value for key, value in
            c.get("resources", {}).get(kind, {}).items() if key in ("cpu", "memory")}
            for kind in ("requests", "limits")}}
            for c in doc["spec"]["template"]["spec"]["containers"]]


def resource_template(doc):
    values = resource_values(doc)
    containers = doc["spec"]["template"]["spec"]["containers"]
    return [{"name": value["name"], "image": container.get("image"),
             "resources": {kind: value[kind] for kind in ("requests", "limits")}}
            for value, container in zip(values, containers)]


def class_retries(t, f):
    """Every class budget belongs to its stage (a failure on one shard says nothing about the others). The task is guarded by
    max_retries and by `systemic_failure` (the same code/unknown signature on several stages)."""
    return sum(1 for x in t.get("attempts", [])[t.get("budget_from", 0):]
               if x.get("cls") == f.get("cls") and x.get("stage") == f.get("stage"))


def systemic_failure(t, f):
    """A reason string when the current code/unknown/outputs failure has the same signature as failures on other stages (one bug
    hitting the fan-out), else None. Environment failures (infra, resources, queue) never count: dead nodes are not a bug."""
    if f.get("cls") not in SYSTEMIC_CLASSES:
        return None
    stages = {x.get("stage") for x in t.get("attempts", [])[t.get("budget_from", 0):]
              if x.get("cls") == f.get("cls") and x.get("sig") == f.get("sig")} | {f.get("stage")}
    need = max(SYSTEMIC_STAGES, -(-len(t.get("stages") or []) // 10))
    if len(stages) >= need:
        return "the same [%s] failure on %d stages (%s): one systemic cause, not bad shards; last: %s" % (
            f["cls"], len(stages), ", ".join(sorted(map(str, stages)))[:80], f.get("detail", "")[:200])
    return None


def true_memory_peak(text, container=None):
    """Read the helper's JSON lines. RSS fallback is evidence, not a cgroup true peak."""
    peaks = []
    for line in text.splitlines():
        if not line.startswith("NRP_MEMORY_PEAK "):
            continue
        try:
            row = json.loads(line.split(" ", 1)[1])
            value = row["bytes"]
            if (row.get("source") in ("cgroup_v2", "cgroup_v1") and
                    row.get("container") == container and
                    isinstance(value, int) and not isinstance(value, bool) and value > 0):
                peaks.append(value)
        except (ValueError, KeyError, TypeError):
            continue
    return max(peaks) if peaks else None


def saved_memory_peak(t, s, container=None, all_attempts=False):
    logs = task_dir(t["name"]) / "logs"
    paths = logs.glob(s["job"] + "-a*.txt") if all_attempts else [logs / ("%s-a%d.txt" % (s["job"], s.get("attempt", 1)))]
    peaks = []
    for path in paths:
        try:
            peak = true_memory_peak(path.read_text(), container)
            if peak: peaks.append(peak)
        except OSError:
            pass
    return max(peaks) if peaks else None


def propagate_resources(t, source):
    """Explicit resource_group asserts compatible templates; only raise CPU/memory in files."""
    group = source.get("resource_group")
    proof = next((x for x in reversed(t.get("attempts", [])) if x.get("stage") == source["id"]
                  and x.get("cls") == "resources"), {})
    if (source.get("state") != "done" or not group or not proof.get("resources_changed")
            or proof.get("by") not in ("tier0", "agent", "monitor") or not proof.get("resource_template")):
        return
    try:
        # Propagate what actually ran, even if a review edited the manifest for later runs.
        src = proof["resource_template"]
        signature = [(c["name"], c.get("image")) for c in src]
        for sibling in t["stages"]:
            if sibling["id"] == source["id"] or sibling["state"] == "done" or sibling.get("resource_group") != group:
                continue
            try:
                doc = manifest_doc(sibling["manifest"])
                dst = doc["spec"]["template"]["spec"]["containers"]
                if [(c["name"], c.get("image")) for c in dst] != signature:
                    continue
                changes = []
                for a, b in zip(src, dst):
                    for kind in ("requests", "limits"):
                        for resource in ("cpu", "memory"):
                            value = a.get("resources", {}).get(kind, {}).get(resource)
                            old = b.get("resources", {}).get(kind, {}).get(resource)
                            parse = mem_bytes if resource == "memory" else cpu_quantity
                            if value is not None and (old is None or parse(str(value)) > parse(str(old))):
                                b.setdefault("resources", {}).setdefault(kind, {})[resource] = value
                                changes.append("%s.%s.%s=%s" % (b["name"], kind, resource, value))
                if changes:
                    manifest_write(sibling["manifest"], doc)
                    tev(t, "resource propagation %s -> %s (manifest only): %s" % (source["id"], sibling["id"], ", ".join(changes)))
            except (OSError, ValueError, KeyError, TypeError) as e:
                tev(t, "resource propagation to %s skipped: %s" % (sibling["id"], e))
    except (OSError, ValueError, KeyError, TypeError) as e:
        tev(t, "resource propagation from %s skipped: %s" % (source["id"], e))


def do_submit(n, sid, reason, by):
    """Submit a stage's manifest. A failed stage = a retry (budgets enforced here, whoever asks). Returns (ok, message)."""
    if terminal_task(n):
        return False, "task is terminal"
    t = task_load(n)
    s, ns, f = tstage(t, sid), t["namespace"], t.get("failure")
    retry = s["state"] == "failed"
    if s["state"] not in ("pending", "failed"):
        return False, "stage %s is %s, nothing to submit" % (sid, s["state"])
    if retry:
        if not f or f["stage"] != sid:
            return False, "stage %s has no recorded failure" % sid
        used = len(t["attempts"][t.get("budget_from", 0):])
        cls_used = class_retries(t, f)
        if used >= t["max_retries"]:
            return False, "RETRY CAP REACHED (%d of %d). Do not resubmit; report STOPPED with the diagnosis." % (used, t["max_retries"])
        if cls_used >= CLASS_BUDGET.get(f["cls"], 1):
            return False, "%s RETRY BUDGET USED (%d). Report STOPPED with the diagnosis." % (f["cls"], cls_used)
    probs = manifest_check(s["manifest"], ns, s["job"])
    if probs:
        return False, "manifest refused: " + "; ".join(probs)
    gx = gpu_expired(s)
    if gx:
        return False, gx + ". Report STOPPED; do not resubmit."
    st_ = job_state(s["job"], ns)
    if st_ in ("running", "pending", "error"):
        return False, "Job %s is still %s" % (s["job"], st_)
    if st_ in ("ok", "FAILED"):
        save_task_logs(t, s, "before resubmit")
        d = kubectl("-n", ns, "delete", "job", s["job"], "--wait=true", "--timeout=180s", timeout=240)
        if d.returncode and "NotFound" not in d.stderr:
            return False, "could not delete old Job %s: %s" % (s["job"], d.stderr.strip()[:150])
    # Shared exclusions live only in the submitted copy: expiry must restore capacity.
    doc = manifest_doc(s["manifest"])
    for node in bad_nodes():
        exclude_node(doc, node)
    with tempfile.TemporaryDirectory(prefix="nrp-submit-") as td:
        path = str(Path(td) / "job.json")
        manifest_write(path, doc)
        res = apply_manifest(ns, path)
    if res == "blocked":
        def b(t):
            t["status"] = "blocked"
            if "pending" not in t:
                tev(t, "submit of %s BLOCKED (account utilization or quota); the monitor checks the namespace once, wakes the coordinator, "
                       "and re-applies when the offenders change" % s["job"])
            t.setdefault("pending", {"stage": sid, "reason": reason, "by": by, "since": now(), "refusal": LAST_BLOCK.get("msg", "")[:300]})
        task_txn(n, b)
        block_episode(n)
        return True, ("BLOCKED: NRP refused the submit (utilization block or quota). The monitor checked the namespace once and woke the "
                      "coordinator; it re-applies only when the offender set changes. Do not retry yourself.")
    if res != "ok":
        return False, "kubectl apply failed: %s" % res

    def ok(t):
        s2, f2 = tstage(t, sid), t.get("failure")
        if retry and f2:
            t["attempts"].append({"stage": sid, "job": s2["job"], "cls": f2["cls"], "sig": f2["sig"], "detail": f2["detail"][:200],
                                  "fix": " ".join(reason.split())[:300], "by": by, "ts": now(), "fingerprint": f2.get("fingerprint") or fingerprint(t, f2),
                                  "resources_changed": f2.get("resource_values") is not None and f2["resource_values"] != resource_values(doc),
                                  "resource_template": resource_template(doc) if f2["cls"] == "resources" else None})
            s2["attempt"] = s2.get("attempt", 1) + 1
            t["failure"] = None
        s2.update(state="running", submitted=now())
        s2.pop("pod_started", None)
        s2["dl"] = {"resubmits": (s2.get("dl") or {}).get("resubmits", 0)}      # a new Job gets fresh deadline tracking (Tier 0, deadline_watch)
        s2.pop("util_deleted", None)
        if (t.get("util_event") or {}).get("stage") == sid:
            t.pop("util_event", None)
        t.pop("pending", None)
        t["status"] = "retrying" if retry or t["status"] == "retrying" else "running"
        tev(t, "submitted %s (attempt %d) by %s: %s" % (s2["job"], s2["attempt"], by, reason[:200]))
    task_txn(n, ok)
    return True, "SUBMITTED %s attempt %d (retries used %d of %d)" % (s["job"], tstage(task_load(n), sid)["attempt"],
                                                                       len(task_load(n)["attempts"]), t["max_retries"])


def escalate(n, reason, a=None):
    out = {}

    def f(t):
        if t["status"] in ("NEEDS_OWNER", "done", "cancelled"):
            return False
        t["status"], t["reason"], t["needs_since"] = "NEEDS_OWNER", " ".join(reason.split())[:400], now()
        t["escalations"] = t.get("escalations", 0) + 1
        out["k"], out["label"] = "task:%s:%d" % (n, t["escalations"]), t["label"]
        tev(t, "NEEDS_OWNER: " + reason)
    if task_txn(n, f):
        PASS["escalated"] = PASS.get("escalated", 0) + 1
        push("NRP task %s needs you: %s  (nrp-monitor task show %s)" % (out["label"], reason[:200], n), out["k"],
             a.dry_run if a else False, refs=["task:" + n])


def coordinator_summary(t, reason):
    """The short text a Tier 3 wake carries: what happened, and where to look. No logs, no secrets."""
    n, f = t["name"], t.get("failure") or {}
    bits = ["NRP task %s needs its coordinator chat (the owner is NOT notified unless you say so): %s" % (n, reason)]
    if f:
        bits.append("Event: stage %s [%s] %s." % (f.get("stage"), f.get("cls"), (f.get("detail") or "")[:200]))
    if f:
        bits.append("Fingerprint: " + (f.get("fingerprint") or fingerprint(t, f)))
    bits.append("After handling: `nrp-monitor wake-review %s --by rule|agent|coordinator --why TEXT`." % n)
    bits.append("Look: `nrp-monitor task show %s`; saved logs %s; fix log (handoff) %s." % (n, f.get("logs") or "(none)", task_dir(n) / "handoff.md"))
    bits.append("Then: fix it and `nrp-monitor task resume %s --note TEXT` (resubmits the failed stage, budgets restart), or `nrp-monitor task cancel %s`, "
                "or only if the owner is truly needed `nrp-monitor task needs-owner %s --reason TEXT` (sends the one DM)." % (n, n, n))
    if reason.startswith("Deputy:"):
        bits.insert(0, reason.split(" | ", 1)[0])
    return " ".join(bits)[:2400]


def to_coordinator(n, reason, a=None, deputy=True):
    """Tier 3: wake the task's coordinator chat (its webhook; same machinery as the done/failure wakes) with a short summary and pointers.
    The task goes to WITH_COORDINATOR, not NEEDS_OWNER: the owner is told only if the chat runs `task needs-owner`. With no webhook
    configured for the task there is nobody to wake, so the owner is told instead (NEEDS_OWNER) and nothing is lost. A wake that cannot
    be delivered (wake_failed) or an answer that never comes (check_coordinator_waits) falls back the same way."""
    t = task_load(n)
    if terminal_task(n) or t["status"] in TASK_HELD:
        return
    failure = t.get("failure")
    if deputy and failure and not (a and a.dry_run) and OWNER.get("deputy_enabled", True):
        fp = failure.get("fingerprint") or fingerprint(t, failure)
        key = "%s:%d" % (fp, len(t["attempts"]))
        if key not in t.get("deputy_runs", []):
            task_txn(n, lambda task: task.setdefault("deputy_runs", []).append(key))
            try:
                line, den = run_task_agent(n, deputy_prompt(t, reason), a, kind="deputy")
            except Exception as error:
                line = "ESCALATE: deputy failed (%s)" % type(error).__name__
            if settled_outcome(n, line, a, "deputy"):
                return
            current = task_load(n)
            if not current.get("failure") or current["status"] == "blocked":
                return
            reason = "Deputy: " + " ".join(line.split()[:120]) + " | " + reason
    reason = " ".join(reason.split())
    if not wake_target(task_load(n) or {"name": n}):
        escalate(n, "%s [no coordinator webhook or harness session is configured for this task, so the owner is told]" % reason[:290], a)
        return
    out = {}

    def f(t):
        if t["status"] in TASK_HELD + ("done", "cancelled"):
            return False
        t["status"], t["reason"], t["coordinator_since"] = "WITH_COORDINATOR", reason[:400], now()
        t["coordinator_wakes"] = t.get("coordinator_wakes", 0) + 1
        out["event"] = queue_task_webhook(t, "escalation", summary=coordinator_summary(t, reason))
        tev(t, "WITH_COORDINATOR (Tier 3, wake queued): " + reason)
    if task_txn(n, f):
        digest("coordinator", "woke the coordinator chat: %s" % reason[:260], n)
        PASS["coordinator"] = PASS.get("coordinator", 0) + 1


def check_coordinator_waits(a):
    """A WITH_COORDINATOR task whose wake was delivered but never answered for COORD_STALE_S goes to the owner."""
    if a.dry_run:
        return
    for n in task_names():
        t = task_load(n) or {}
        if t.get("status") == "WITH_COORDINATOR" and now() - t.get("coordinator_since", now()) > COORD_STALE_S:
            escalate(n, "the coordinator chat did not answer for %s. %s" % (ago(t["coordinator_since"]), t.get("reason", "")), a)


# ---- Tier 0 timeouts (no model): extend a progressing Job in place, credit queue time, resubmit a resume-capable stage once at 2x ----
def patch_deadline(ns, job, secs):
    r = kubectl("-n", ns, "patch", "job", job, "--type=merge", "-p", json.dumps({"spec": {"activeDeadlineSeconds": int(secs)}}))
    return r.returncode == 0, (r.stderr or r.stdout).strip()[:150]


def log_signature(ns, job):
    """Hash of the Job's last log lines: it changes between two passes only when the pod is still writing."""
    r = kubectl("-n", ns, "logs", "job/" + job, "--all-containers", "--tail=20", timeout=60)
    lines = [l for l in (r.stdout or "").splitlines() if l.strip()][-20:] if r.returncode == 0 else []
    return hashlib.sha1("\n".join(lines).encode()).hexdigest()[:16] if lines else None


def pod_waiting_error(ns, job):
    """A pod stuck on an error (image pull, bad config) is not queueing: its deadline is not extended."""
    r = kubectl("-n", ns, "get", "pods", "-l", "job-name=" + job, "-o", "json")
    for p in json.loads(r.stdout or "{}").get("items", []) if r.returncode == 0 else []:
        for cs in p.get("status", {}).get("containerStatuses", []) or []:
            w = (cs.get("state") or {}).get("waiting") or {}
            if w.get("reason") in ("ImagePullBackOff", "ErrImagePull", "InvalidImageName", "CreateContainerConfigError", "CreateContainerError"):
                return w["reason"]
    return None


def deadline_watch(n, s, info):
    """Tier 0 for one running stage whose Job is Running or Pending. activeDeadlineSeconds counts from the Job's start, Pending time
    included, so: (1) once the pod has started after a long queue, credit the queue time (deadline = original + queue wait); (2) a pod that
    is still Pending near its deadline is kept alive (deadline = elapsed + original), a limited number of times, unless it is stuck on an
    error; (3) a pod that is still progressing near its deadline (its log tail changed between two passes) gets one more original
    deadline in place, at most DEADLINE_EXT_MAX times. A Job that is not progressing is left to expire and enters the ladder."""
    dl, js = info.get("deadline"), info.get("start")
    if not dl or not js:
        return
    ns, sid, job, t_now = task_load(n)["namespace"], s["id"], s["job"], now()
    d = dict(s.get("dl") or {})
    before = json.dumps(d, sort_keys=True)
    orig = d.setdefault("orig", dl)
    remaining = js + dl - t_now
    margin = min(max(0.2 * orig, 900), 3600)
    started = s.get("pod_started")
    new, why, bump, notes = None, "", None, []
    if started:
        credit = max(0, started - js)
        if "credit" not in d:
            d["credit"] = credit if credit >= DEADLINE_CREDIT_MIN_S else 0
        want = orig + d["credit"] + d.get("exts", 0) * orig
        if want > dl:
            new, why = want, "credited %d min the pod waited Pending (it counts toward activeDeadlineSeconds)" % (d["credit"] // 60)
        elif remaining < 2 * margin:
            sig = log_signature(ns, job)
            prev, d["sig"] = d.get("sig"), sig
            moving = bool(sig and prev and sig != prev)
            if remaining < margin and moving and d.get("exts", 0) < DEADLINE_EXT_MAX:
                new, bump = dl + orig, "exts"
                why = "still progressing (log advanced between passes): extension %d of %d" % (d.get("exts", 0) + 1, DEADLINE_EXT_MAX)
            elif remaining < margin and moving and not d.get("capped"):
                d["capped"] = True
                notes.append("deadline in %d min and the Job still progresses, but all %d extensions were used" % (remaining // 60, DEADLINE_EXT_MAX))
            elif remaining < margin and sig and sig == prev and not d.get("stalled"):
                d["stalled"] = True
                notes.append("deadline in %d min and the Job's log did not advance between passes: no extension" % (remaining // 60))
    elif remaining < margin and d.get("pend", 0) < DEADLINE_PEND_EXT_MAX and (t_now - js) + orig > dl and not pod_waiting_error(ns, job):
        new, bump = (t_now - js) + orig, "pend"
        why = "pod still Pending near the deadline: kept alive (extension %d of %d)" % (d.get("pend", 0) + 1, DEADLINE_PEND_EXT_MAX)
    if new:
        ok, err = patch_deadline(ns, job, new) if d.get("patch_fail", 0) < 3 else (False, "gave up after 3 failed patches")
        if ok:
            if bump:
                d[bump] = d.get(bump, 0) + 1
            notes.append("%s: activeDeadlineSeconds %d -> %d s, %s" % (job, dl, new, why))
            digest("deadline-extended", notes[-1], n)
        else:
            d["patch_fail"] = d.get("patch_fail", 0) + 1
            notes.append("%s: could not extend activeDeadlineSeconds (%s)" % (job, err))
    if notes or json.dumps(d, sort_keys=True) != before:
        def save_dl(t):
            tstage(t, sid)["dl"] = d
            for m in notes:
                tev(t, m)
        task_txn(n, save_dl)


def stage_resumable(s):
    """True only when the stage says so (`resumable: true` in TASK.json) or its manifest passes an explicit skip-existing/resume flag.
    Nothing is inferred beyond that: a stage that restarts from scratch must not be resubmitted blindly."""
    if s.get("resumable") is True:
        return True
    try:
        return bool(re.search(r"--(skip-existing|resume)\b", Path(s["manifest"]).read_text()))
    except (OSError, TypeError, KeyError):
        return False


def tier0_timeout(n, f):
    """A stage died of DeadlineExceeded while running. If it resumes by skipping finished items, resubmit it once with 2x deadline
    (the task's manifest copy is edited); otherwise (or when that was already done) False: the failure enters the ladder at Tier 1."""
    t = task_load(n)
    s = tstage(t, f["stage"])
    done = (s.get("dl") or {}).get("resubmits", 0)
    if done >= DEADLINE_RESUBMITS_MAX or not stage_resumable(s):
        return False
    try:
        text = Path(s["manifest"]).read_text()
        m = re.search(r"(?m)^(\s*activeDeadlineSeconds:\s*)(\d+)\s*$", text)
        old = int(m.group(2))
    except (OSError, AttributeError, ValueError):
        return False
    Path(s["manifest"]).write_text(text[:m.start(2)] + str(old * 2) + text[m.end(2):])
    ok, msg = do_submit(n, f["stage"], "Tier 0: deadline %ds passed while running and the stage resumes by skipping finished items; resubmitted with 2x deadline (%d s)" % (old, old * 2), "monitor")
    if not ok:
        Path(s["manifest"]).write_text(text)
        log("task %s: Tier 0 resubmit refused: %s" % (n, msg[:200]))
        return False
    task_txn(n, lambda t: tstage(t, f["stage"]).update(dl={"resubmits": done + 1}))
    cost_event(n, "rule", "0", "resolved", stage=f["stage"], fingerprint=f.get("fingerprint") or fingerprint(t, f))
    digest("deadline-resubmit", "%s ran into its %d s deadline; resumable stage resubmitted once with %d s" % (f["job"], old, old * 2), n)
    PASS["retries"] = PASS.get("retries", 0) + 1
    return True


# ---- Tier 1 (triage judge) ----
TRIAGE_VERDICT_RE = re.compile(r"^[ \t>*_`#-]*(CLOSE|ESCALATE)\b[ \t*_`]*:?[ \t*_`]*(.*)$", re.M)
TRIAGE_CLOSE = ("CLOSE",)


def triage_verdict(text):
    """(verdict, text) from the LAST verdict line of the judge's answer. Anything else fails closed to ESCALATE."""
    ms = list(TRIAGE_VERDICT_RE.finditer((text or "").strip().splitlines()[-1] if (text or "").strip() else ""))
    if not ms or not ms[-1].group(2).strip():
        return "ESCALATE", "no verdict line in the triage answer"
    return ms[-1].group(1), " ".join(ms[-1].group(2).replace("*", "").replace("`", "").split())[:300]


def triage_wanted(t, f):
    """Tier 1 looks at an event when a benign answer is possible: the Job is still alive or finished, or the class is one the script cannot
    pin down (unknown, slow). A plain terminal failure the rules already classified (OOM, traceback, image pull) goes straight to Tier 2.
    Util observations always receive a judge before a fixer."""
    if f.get("cls") == "util":
        return True
    return f.get("cls") in TRIAGE_CLASSES_ALWAYS or job_state(f["job"], t["namespace"]) in ("running", "pending", "ok")


def triage_prompt(t):
    f = t["failure"] or {}
    tpl = (TPL / "task_triage.md").read_text()
    rep = {"name": t["name"], "goal": t["goal"], "origin": origin_plain(t.get("origin")), "ns": t["namespace"], "notes": t["notes"] or "(none)",
           "cls": f.get("cls", "?"), "stage": f.get("stage", "?"), "job": f.get("job", "?"), "sig": f.get("sig", "?"), "detail": f.get("detail", ""),
           "logs": f.get("logs") or "(none saved)", "dir": str(task_dir(t["name"])),
           "stages": "\n".join("  - %s job=%s state=%s" % (s["id"], s["job"], s["state"]) for s in t["stages"]),
           "attempts": "\n".join("  - %s [%s] %s -> %s" % (x["job"], x["cls"], x["detail"][:120], x["fix"][:120]) for x in t["attempts"][-5:]) or "  (none)"}
    for k, v in rep.items():
        tpl = tpl.replace("{%s}" % k, v)
    return tpl.replace("{handoff}", handoff_prompt(t)) + failure_context(t)


def close_failure(n, f, why, kind="Tier 1 triage"):
    """Close a triaged event as benign. The script decides, not the verdict: the Job must be alive or done, or the stage's outputs present.
    Returns (ok, refusal)."""
    if terminal_task(n):
        return False, "task is terminal"
    t = task_load(n)
    s = tstage(t, f["stage"])
    st_ = job_state(f["job"], t["namespace"])
    present = all(s3_exists(u, {}) is True for u in s["done_s3"])
    if st_ not in ("running", "pending", "ok") and not present:
        return False, "Job %s is %s and the stage's outputs are missing" % (f["job"], st_)

    def c(t):
        cur = t.get("failure")
        if t.get("status") in ("done", "cancelled") or not cur or cur.get("ts") != f.get("ts"):
            return False
        s2 = tstage(t, f["stage"])
        if present and st_ not in ("running", "pending"):
            s2.update(state="done", done_ts=now())
        else:
            s2["state"] = "running"
        s2.pop("util_deleted", None)
        t["failure"] = None
        tev(t, "event closed by %s, no fix needed: %s" % (kind, why[:200]))
    if not task_txn(n, c):
        return False, "the failure changed while it was closed"
    cost_event(n, "triage_resolution" if kind == "Tier 1 triage" else kind + "_resolution",
               "1" if kind == "Tier 1 triage" else "2" if kind == "fixer" else kind, "resolved", stage=f["stage"],
               fingerprint=f.get("fingerprint") or fingerprint(t, f))
    digest("triage-closed" if kind == "Tier 1 triage" else "resolved", "stage %s [%s]: no fix needed (%s)" % (f["stage"], f["cls"], why[:240]), n)
    return True, ""


def observe_task(n, jobs):
    if terminal_task(n):
        return
    t = task_load(n)
    ns = t["namespace"]
    for s in t["stages"]:
        if s["state"] != "running":
            continue
        sid, info = s["id"], jobs.get(s["job"])
        if info and info["state"] in ("running", "pending"):
            if not s.get("pod_started"):
                ps0 = pod_started(ns, s["job"])
                if ps0:
                    task_txn(n, lambda t: tstage(t, sid).update(pod_started=ps0))
                    s = tstage(task_load(n), sid)
            try:
                deadline_watch(n, s, info)                      # Tier 0: credit queue time, keep a progressing Job alive
            except Exception as e:                              # a Tier 0 helper must never stop the pass
                log("task %s: deadline watch error: %s: %s" % (n, type(e).__name__, str(e)[:150]))
            continue
        if info is None:
            if now() - s.get("submitted", 0) < MISSING_GRACE_S:
                continue
            if all(s3_exists(u, {}) is True for u in s["done_s3"]):
                task_txn(n, lambda t: (tstage(t, sid).update(state="done", done_ts=now()), propagate_resources(t, tstage(t, sid)), tev(t, "stage %s done (Job gone, outputs present)" % sid)))
                digest("done", "stage %s done (Job gone before logs were saved; outputs present)" % sid, n)
                continue
            if s.get("util_deleted"):
                task_fail(n, sid, "util", "util:" + norm_sig(s["util_deleted"]), "deleted for NRP utilization: " + s["util_deleted"])
            else:
                task_fail(n, sid, "infra", "vanished", "Job %s disappeared before it finished and its outputs are missing" % s["job"])
        elif info["state"] == "ok":
            p, _ = save_task_logs(t, s, "Job succeeded")
            res = [s3_exists(u, {}) for u in s["done_s3"]]
            if None in res:
                n_err = s.get("s3_errors", 0) + 1
                task_txn(n, lambda t: tstage(t, sid).update(s3_errors=n_err))
                if n_err >= 5:
                    task_fail(n, sid, "infra", "s3-check", "cannot check S3 outputs (aws s3api head-object failed 5 passes)", p)
                continue
            if False in res:
                miss = s["done_s3"][res.index(False)]
                task_fail(n, sid, "outputs", "outputs-missing:" + miss, "Job succeeded but %s does not exist" % miss, p)
                continue
            kubectl("-n", ns, "delete", "job", s["job"], "--wait=false")
            task_txn(n, lambda t: (tstage(t, sid).update(state="done", done_ts=now()), propagate_resources(t, tstage(t, sid)), tev(t, "stage %s done, Job deleted" % sid)))
            digest("done", "stage %s (%s) succeeded; outputs %s" % (sid, s["job"], ", ".join(s["done_s3"])[:200]), n)
            PASS["stage_done"] = PASS.get("stage_done", 0) + 1
        elif info["state"] == "FAILED":
            p, logtxt = save_task_logs(t, s, "Job failed")
            cls, sig, detail = classify(t, s, logtxt)
            task_fail(n, sid, cls, sig, detail, p)


def task_prompt(t):
    f = t["failure"] or {}
    tpl = (TPL / "task_agent.md").read_text()
    att = t["attempts"]
    cls_used = class_retries(t, f)
    code = t.get("code") or {}
    rep = {"name": t["name"], "goal": t["goal"], "approved": t["approved"], "origin": origin_plain(t.get("origin")), "ns": t["namespace"], "notes": t["notes"] or "(none)",
           "used": str(len(att[t.get("budget_from", 0):])), "max": str(t["max_retries"]), "cls": f.get("cls", "?"),
           "cls_used": str(cls_used), "cls_max": str(CLASS_BUDGET.get(f.get("cls"), 1)), "stage": f.get("stage", "?"),
           "job": f.get("job", "?"), "sig": f.get("sig", "?"), "rule": f.get("rule") or "not recorded", "waiver_max": str(util_waiver_max()), "waiver_hours": "%g" % util_waiver_hours(), "detail": f.get("detail", ""), "logs": f.get("logs") or "(none saved)",
           "dir": str(task_dir(t["name"])),
           "stages": "\n".join("  - %s job=%s state=%s attempt=%d manifest=%s done_s3=%s" % (s["id"], s["job"], s["state"], s.get("attempt", 1),
                                s["manifest"], ", ".join(s["done_s3"])) for s in t["stages"]),
           "attempts": "\n".join("  - %s attempt failed [%s] %s -> fix: %s" % (x["job"], x["cls"], x["detail"][:150], x["fix"][:150]) for x in att) or "  (none)",
           "util": "\n".join("  - " + u for u in t.get("util", [])[-5:]) or "  (none)",
           "clone": code.get("clone", "(no code clone registered: fix only the manifest)"), "branch": code.get("branch", "-"),
           "subdir": code.get("subdir") or ".", "skip_limit": skip_limit_text(),
           "triage": f.get("triage_text") or "(Tier 1 did not run for this failure)"}
    for k, v in rep.items():
        tpl = tpl.replace("{%s}" % k, v)
    return tpl.replace("{handoff}", handoff_prompt(t)) + failure_context(t)                 # last: the handoff text is not itself a template


def run_task_agent(n, prompt_text, a, kind="fix"):
    if kind in ("fix", "deputy", "triage") and terminal_task(n):
        return "DONE: task is terminal", []
    t = task_load(n)
    ctx = dict(t.get("failure") or t.get("util_event") or {}) if kind in ("fix", "deputy") else {}            # what the fix agent was started for (a resubmit clears the failure)
    d = str(task_dir(n)).rstrip("/")
    allowed = ["Bash(nrp-task:*)", "Read(/%s/**)" % d, "Edit(/%s/**)" % d]
    if t.get("code"):
        c = t["code"]["clone"].rstrip("/")
        allowed += ["Read(/%s/**)" % c, "Edit(/%s/**)" % c]
    if kind == "continue":                                         # reads outputs and the plan, writes the next TASK file
        pd = str(plan_dir(t["on_done"]["plan"])).rstrip("/")
        allowed = ["Bash(nrp-task:*)", "Read(/%s/**)" % d, "Read(/%s/**)" % pd, "Write(/%s/work/**)" % pd, "Edit(/%s/work/**)" % pd]
    elif kind == "deputy" and (t.get("on_done") or {}).get("plan"):
        allowed += ["Read(/%s/**)" % str(plan_dir(t["on_done"]["plan"])).rstrip("/")]
    elif kind == "triage":                                         # Tier 1: judge, read-only; its verdict is the last line of its answer
        allowed = ["Bash(nrp-task %s:*)" % c for c in ("show", "logs", "describe", "util", "s3")] + ["Read(/%s/**)" % d]
    elif kind not in ("fix", "deputy"):
        allowed = ["Bash(nrp-task:*)", "Read(/%s/**)" % d]
    deny = []
    if kind == "continue":                                         # night code lives in work/code-<step>/: its .git is not the agent's to edit
        deny = ["Write(/%s/work/**/.git/**)" % pd, "Edit(/%s/work/**/.git/**)" % pd]
    cmd = agent_cmd("triage" if kind == "triage" else "deputy" if kind == "deputy" else "task", allowed, json_out=True, deny=deny)
    if kind != "deputy" and not agents_available():                 # deputy has its own configured backends
        return unavailable_text(), []
    env = clean_env()
    env["NRP_TASK"] = n
    env["NRP_MONITOR_AGENT_ROLE"] = kind
    cwd = WORK / "task"
    task_txn(n, lambda t: (t.update(agent_started=now()), t.pop("report", None), t.pop("util_ok_claim", None)))
    log("task %s: %s agent start" % (n, kind))
    runner, status, out, _, _ = dispatch_agent(cmd.spec, prompt_text, cwd, None, env,
                                               on_failover=lambda m: task_txn(n, lambda t: tev(t, m)))
    if status == "unavailable":                                    # the last runner ran out mid-call
        task_txn(n, lambda t: t.pop("agent_started", None))
        return out, []
    if status == "timeout":
        out = ""
    try:
        res = json.loads(out)
        full = str(res.get("result") or "")
    except ValueError:
        res = {"result": (out.strip().splitlines() or ["AGENT EMPTY or TIMEOUT"])[-1], "is_error": True}
        full = out
    den = res.get("permission_denials") or []
    line = " ".join(str(res.get("result") or "").split())[:400]
    if kind in ("fix", "deputy") and not res.get("is_error") and status == "ok":
        # Explanatory prose and HANDOFF_ENTRY blocks are not the outcome.
        answer = full.split("HANDOFF_ENTRY:", 1)[0]
        verdicts = re.findall(r"(?m)^\s*(?:\*\*)?((?:RESOLVED|DONE|ESCALATE|STOPPED|NOT-DONE|RESUBMITTED|UTIL_OK)\b[^\n]*)", answer)
        if verdicts:
            line = " ".join(verdicts[-1].split())[:400]
    claim = util_ok_extract(full) if kind == "fix" else None
    if claim is not None:
        task_txn(n, lambda t: t.update(util_ok_claim=claim))                  # the script decides on it in handle_failure
    rec = {"ts": now(), "kind": kind, "runner": runner, "model": res.get("model"), "usage": res.get("usage"), "cost": res.get("total_cost_usd"), "turns": res.get("num_turns"), "result": line, "denials": len(den)}
    failure = t.get("failure") or t.get("util_event") or {}
    current = task_load(n)
    tier = "1" if kind == "triage" else "deputy" if kind == "deputy" else "2"
    cost_event(n, {"fix": "fixer", "continue": "continue_agent"}.get(kind, kind), tier,
               "resolved" if failure and kind != "triage" and not current.get("failure") and not current.get("util_event") else "stopped" if status != "ok" else "escalated" if failure else "done",
               stage=failure.get("stage"), runner=runner, model=(res.get("model") or tier_settings(cmd.spec["tier"], runner)["model"]) if runner else None,
               result=res, fingerprint=failure.get("fingerprint") or (fingerprint(t, failure) if failure else None))
    if kind == "triage":
        rec["verdict"], rec["verdict_text"] = triage_verdict(full)
    task_txn(n, lambda t: (t.setdefault("agent_runs", []).append(rec), t.pop("agent_started", None)))
    log("task %s: agent done cost=%s denials=%d: %s" % (n, rec["cost"], len(den), line[:250]))
    try:
        handoff_record(n, kind, full, rec, ctx)                         # no-op without a handoff; only fix / continue agents add to it
    except Exception as e:
        log("task %s: handoff entry not written: %s: %s" % (n, type(e).__name__, str(e)[:200]))
    for x in den[:5]:
        digest("fault", "agent permission denied (monitor fault, not a job failure): %s %s"
               % (x.get("tool_name"), json.dumps(x.get("tool_input"))[:200]), n)
    return line, den


# ---- Tier 0: fixed rules, no model (v3 plan) -------------------------------------------------------------------------
# Applied before any agent: OOM -> memory = observed peak x1.3; a known node fault -> exclude that node and resubmit; a long Pending
# reports the scheduler's reason. Every rule goes through do_submit, so retry caps, class budgets, the GPU approval date and the
# manifest rules still hold; anything a rule cannot decide (no peak number, repeat failure, over a cap) falls through to the
# agents (handle_failure) untouched.
OOM_FACTOR = 1.3
OOM_MAX_GI_DEFAULT = 128
NODE_EXCLUDE_MAX = 3                       # nodes excluded per stage by Tier 0; a fourth fault goes to the agents
PENDING_REPORT_S = 30 * 60
PENDING_REREPORT_S = 3600
THANOS_URL = os.environ.get("NRP_MONITOR_THANOS_URL") or "https://thanos.nrp-nautilus.io/api/v1/query"
NODE_FAULT_RE = re.compile(r"uncorrectable ECC|\bXid\b\W*\d+|no CUDA-capable device is detected|nvidia-container-cli|"
                           r"failed to create (?:pod )?sandbox|FailedMount|MountVolume\.\w+ failed|OCI runtime create failed|"
                           r"\bNodeLost\b|ContainerStatusUnknown", re.I)
_MEM_UNITS = {"": 1, "k": 1e3, "K": 1e3, "M": 1e6, "G": 1e9, "T": 1e12, "Ki": 2 ** 10, "Mi": 2 ** 20, "Gi": 2 ** 30, "Ti": 2 ** 40}


def mem_bytes(q):
    """Bytes of a Kubernetes memory quantity ('512Mi', '4Gi', '2G', '123456'); None when not understood."""
    m = re.fullmatch(r"([\d.]+)([A-Za-z]{0,2})", str(q).strip())
    if not m or m.group(2) not in _MEM_UNITS:
        return None
    try:
        return float(m.group(1)) * _MEM_UNITS[m.group(2)]
    except ValueError:
        return None


def mem_text(b):
    import math
    return "%dGi" % math.ceil(b / 2 ** 30) if b >= 2 ** 30 else "%dMi" % max(64, math.ceil(b / 2 ** 20))


def manifest_doc(path):
    text = Path(path).read_text()
    try:
        import yaml
        return yaml.safe_load(text)
    except ImportError:
        return json.loads(text)


def manifest_write(path, doc):
    try:
        import yaml
        Path(path).write_text(yaml.safe_dump(doc, sort_keys=False))
    except ImportError:
        Path(path).write_text(json.dumps(doc, indent=2))


def thanos_peak_mem(ns, job, container, since_ts, per_pod=False):
    """Peak working-set bytes of the Job's pods (one container) since `since_ts`, from NRP's Prometheus; None when unavailable."""
    window = max(300, int(now() - since_ts) + 120)
    expr = 'max(max_over_time(container_memory_working_set_bytes{namespace="%s",pod=~"%s-.*",container="%s"}[%ds]))' % (ns, job, container, window)
    if per_pod:
        expr = expr.replace("max(max_over_time", "max by (pod) (max_over_time", 1)
    res = thanos_query(expr)
    if per_pod:
        import math
        peaks = {}
        for r in res:
            try:
                value = float(r["value"][1])
                if math.isfinite(value) and value >= 0:
                    peaks[r["metric"]["pod"]] = value
            except (KeyError, ValueError, TypeError, IndexError):
                continue
        return peaks
    return float(res[0]["value"][1]) if res else None


def thanos_query(expr):
    try:
        with urllib.request.urlopen(THANOS_URL + "?" + urllib.parse.urlencode({"query": expr}), timeout=60) as r:
            d = json.load(r)
        return d["data"]["result"] if d.get("status") == "success" else []
    except Exception as e:
        log("tier0: thanos query failed: %s" % type(e).__name__)
        return []


def bad_nodes():
    return {n: r for n, r in read_json(STATE / "bad-nodes.json", {}).items() if r.get("expires", 0) > now()}


def record_bad_node(node, why, fault=None):
    with state_lock():
        nodes = read_json(STATE / "bad-nodes.json", {})
        if fault and (nodes.get(node) or {}).get("fault") == fault:
            return
        nodes[node] = {"last_fault": now(), "expires": now() + 86400, "reason": why[:200], "fault": fault}
        write_json(STATE / "bad-nodes.json", nodes)


def bad_node_lines():
    return ["excluded node %s until %s (last fault %s)" % (n, iso_at(r["expires"]), iso_at(r["last_fault"]))
            for n, r in sorted(bad_nodes().items())]


def vanished_nodes(t, s):
    window = max(300, int(now() - (s.get("submitted") or now() - 86400)) + 120)
    expr = 'max_over_time(kube_pod_info{namespace=%s,pod=~%s}[%ds])' % (
        json.dumps(t["namespace"]), json.dumps(re.escape(s["job"]) + "-.*"), window)
    return sorted({r["metric"]["node"] for r in thanos_query(expr) if r.get("metric", {}).get("node")})


def job_pods(ns, job):
    r = kubectl("-n", ns, "get", "pods", "-l", "job-name=" + job, "-o", "json")
    try:
        return json.loads(r.stdout or "{}").get("items", []) if r.returncode == 0 else []
    except ValueError:
        return []


def tier0_oom(t, s, f):
    """(manifest doc, reason, record) raising the OOMKilled container's memory to observed peak x1.3, or None to leave it to the agents."""
    if not str(f.get("sig", "")).startswith("oom@"):
        return None
    if any(x.get("stage") == s["id"] and x.get("rule") == "oom" for x in t.get("tier0") or []):
        return None                                           # already resized once: a second OOM is not a sizing problem a rule can settle
    cname = None
    for p in job_pods(t["namespace"], s["job"]):
        for cs in (p.get("status") or {}).get("containerStatuses") or []:
            term = (cs.get("state") or {}).get("terminated") or (cs.get("lastState") or {}).get("terminated") or {}
            if term.get("reason") == "OOMKilled":
                cname = cs.get("name")
    try:
        doc = manifest_doc(s["manifest"])
        cs_ = doc["spec"]["template"]["spec"]["containers"]
    except Exception:
        return None
    c = next((x for x in cs_ if x.get("name") == cname), cs_[0] if len(cs_) == 1 or not cname else None)
    if c is None:
        return None
    res = c.setdefault("resources", {})
    lim = mem_bytes((res.get("limits") or {}).get("memory") or (res.get("requests") or {}).get("memory") or "")
    true_peak = saved_memory_peak(t, s, c["name"])
    if true_peak is None and len(cs_) == 1:
        true_peak = saved_memory_peak(t, s)
    peak = true_peak if true_peak is not None else thanos_peak_mem(t["namespace"], s["job"], c["name"], s.get("submitted") or now() - 3600)
    if not lim or peak is None:
        return None
    base = max(peak, lim)                                     # an OOM-killed container reached its limit even if the 30 s samples missed it
    new = 2 * lim if true_peak is None and peak < .5 * lim else base * OOM_FACTOR
    cap = float(OWNER.get("tier0_mem_cap_gi") or OOM_MAX_GI_DEFAULT) * 2 ** 30
    if new > cap:
        return None
    tol = float(util_policy().get("limit_to_request_tolerance") or 0.2)
    new_text = mem_text(new)
    new_b = mem_bytes(new_text)
    old_req = mem_bytes((res.get("requests") or {}).get("memory") or "") or lim
    req_b = new_b if old_req >= lim else min(new_b, max(old_req, new_b / (1 + tol)))        # limit stays within the shared tolerance of the request
    res.setdefault("limits", {})["memory"] = new_text
    res.setdefault("requests", {})["memory"] = mem_text(req_b)
    return doc, "OOM at %s (observed peak %.1fGi) -> memory %s (base x%g, Tier 0 rule)" % (
        mem_text(lim), peak / 2 ** 30, new_text, new / base), {"rule": "oom", "memory": new_text}


def node_fault_of(t, s, f):
    """(node, evidence) of a pod of this stage's Job that hit a known node fault, else None. Pod status and conditions plus the saved log tail."""
    tail = ""
    try:
        tail = Path(f.get("logs") or "").read_text()[-8000:] if f.get("logs") else ""
    except OSError:
        pass
    pods = job_pods(t["namespace"], s["job"])
    for p in pods:
        node = (p.get("spec") or {}).get("nodeName")
        ps = p.get("status") or {}
        bits = [ps.get("reason") or "", ps.get("message") or ""]
        for c in ps.get("conditions") or []:
            bits.append(c.get("reason") or "")
            bits.append(c.get("message") or "")
        for cs in ps.get("containerStatuses") or []:
            for k in ("state", "lastState"):
                for v in (cs.get(k) or {}).values():
                    bits += [(v or {}).get("reason") or "", (v or {}).get("message") or ""]
        text = " ".join(bits) + "\n" + (tail if len(pods) == 1 else "")     # the log tail names one pod only when there is one
        m = NODE_FAULT_RE.search(text)
        if m and node:
            return node, m.group(0)
    if not pods:
        # Historical placement alone is not a fault. Restrict inference to a vanished
        # failed pod with no useful diagnostics, or explicit node-fault evidence.
        evidence = NODE_FAULT_RE.search(tail + " " + str(f.get("detail", "")))
        if evidence or (f.get("cls") in ("infra", "unknown") and (not tail.strip() or re.search(
                r"kubectl failed|NotFound|No resources found|no pods found|timed out waiting", tail, re.I))):
            nodes = vanished_nodes(t, s)
            if len(nodes) == 1:
                return nodes[0], evidence.group(0) if evidence else "failed pod vanished without diagnostics"
    return None


def exclude_node(doc, node):
    """Add `kubernetes.io/hostname NotIn [node]` to every required node-affinity term of the Job's pod spec (idempotent)."""
    pod = doc["spec"]["template"]["spec"]
    na = pod.setdefault("affinity", {}).setdefault("nodeAffinity", {})
    req = na.setdefault("requiredDuringSchedulingIgnoredDuringExecution", {})
    terms = req.setdefault("nodeSelectorTerms", [])
    if not terms:
        terms.append({})
    for term in terms:
        exprs = term.setdefault("matchExpressions", [])
        e = next((x for x in exprs if x.get("key") == "kubernetes.io/hostname" and x.get("operator") == "NotIn"), None)
        if e is None:
            exprs.append({"key": "kubernetes.io/hostname", "operator": "NotIn", "values": [node]})
        elif node not in e.get("values", []):
            e["values"] = list(e.get("values", [])) + [node]


def tier0_node(t, s, f):
    hit = node_fault_of(t, s, f)
    if not hit:
        return None
    node, why = hit
    record_bad_node(node, why, "%s/%s/%s" % (t["name"], s["id"], f.get("ts", s.get("submitted"))))
    excluded = [x for x in t.get("tier0") or [] if x.get("stage") == s["id"] and x.get("rule") == "node"]
    if len(excluded) >= NODE_EXCLUDE_MAX or any(x.get("node") == node for x in excluded):
        return None
    try:
        doc = manifest_doc(s["manifest"])
        # The shared expiring list is applied by do_submit, not persisted here.
    except Exception:
        return None
    return doc, "known node fault on %s (%s) -> node excluded, resubmitted (Tier 0 rule)" % (node, why[:60]), {"rule": "node", "node": node}


def tier0_lost(t, s, f):
    """(unchanged manifest doc, reason, record) for a lost pod; do_submit applies the shared bad-node list and the stage's budget."""
    if f.get("sig") != LOST_SIG:
        return None
    try:
        doc = manifest_doc(s["manifest"])
    except Exception:
        return None
    return doc, "pod lost without an exit or traceback (environment, not code) -> resubmitted unchanged (Tier 0 rule)", {"rule": "lost"}


def tier0_fix(n, a):
    """True when a Tier 0 rule edited the manifest and resubmitted the failed stage. Never raises, never starts a model; False hands the
    failure to handle_failure unchanged (watch-only tasks, repeats, anything over a cap, no rule matched)."""
    try:
        if terminal_task(n):
            return False
        t = task_load(n)
        f = (t or {}).get("failure")
        if not f or t["mode"] != "auto" or a.dry_run or f.get("cls") not in ("resources", "infra", "code", "unknown"):
            return False
        if apply_decision(n, a):
            return True
        s = tstage(t, f["stage"])
        if not s.get("manifest"):
            return False
        node_rule = tier0_node(t, s, f)  # record a fresh fault even if the retry budget is used
        if f["sig"] != LOST_SIG and f["sig"] in [x["sig"] for x in t["attempts"] if x["stage"] == f["stage"]]:
            return False                                       # a lost pod may repeat on the same stage; its per-stage infra budget caps it
        for rule in (tier0_node, tier0_oom, tier0_lost):
            r = node_rule if rule is tier0_node else rule(t, s, f)
            if not r:
                continue
            doc, reason, rec = r
            before = Path(s["manifest"]).read_text()
            manifest_write(s["manifest"], doc)
            ok, msg = do_submit(n, s["id"], reason, "tier0")
            if not ok:
                Path(s["manifest"]).write_text(before)         # nothing was submitted: leave the manifest as it was
                log("task %s: tier0 %s not applied: %s" % (n, rec["rule"], msg[:200]))
                return False
            task_txn(n, lambda t: t.setdefault("tier0", []).append(dict(rec, stage=s["id"], ts=now())))
            digest("retry", "%s [%s] -> %s" % (s["job"], f["cls"], reason[:250]), n)
            cost_event(n, "rule", "0", "resolved", stage=f["stage"], fingerprint=f.get("fingerprint") or fingerprint(t, f))
            PASS["tier0"] = PASS.get("tier0", 0) + 1
            return True
    except Exception as e:
        log("task %s: tier0 error: %s: %s" % (n, type(e).__name__, str(e)[:200]))
    return False


def pending_reason(t, s):
    """One line saying why the scheduler has not started a Pending Job: its PodScheduled message, plus the node restrictions in our own
    manifest (for example a GPU allow-list) when it reports nodes excluded by affinity/selector."""
    pods = job_pods(t["namespace"], s["job"])
    msgs = []
    for p in pods:
        for c in (p.get("status") or {}).get("conditions") or []:
            if c.get("type") == "PodScheduled" and c.get("status") == "False" and c.get("message"):
                msgs.append(c["message"])
    if not pods:
        return "the Job has no pod yet (admission, quota or the Job controller)"
    if not msgs:
        return "a pod exists but the scheduler gave no reason yet"
    msg = " ".join(msgs[0].split())[:300]
    own = []
    try:
        pod = manifest_doc(s["manifest"])["spec"]["template"]["spec"]
        for term in (((pod.get("affinity") or {}).get("nodeAffinity") or {}).get("requiredDuringSchedulingIgnoredDuringExecution") or {}).get("nodeSelectorTerms") or []:
            own += ["%s %s %s" % (e.get("key"), e.get("operator"), ",".join(map(str, e.get("values") or []))[:80]) for e in term.get("matchExpressions") or []]
        own += ["%s=%s" % kv for kv in (pod.get("nodeSelector") or {}).items()]
    except Exception:
        pass
    if own and re.search(r"affinity|selector", msg, re.I):
        msg += " | our manifest restricts nodes: %s (an own allow-list may be what excludes them)" % "; ".join(own)[:200]
    return msg


def queue_ceiling_seconds(value):
    m = re.fullmatch(r"([0-9]+(?:\.[0-9]+)?)(s|m|h|d)", str(value))
    if not m or float(m[1]) <= 0:
        raise ValueError("invalid queue duration")
    return float(m[1]) * {"s": 1, "m": 60, "h": 3600, "d": 86400}[m[2]]


def report_long_pending(n, jobs):
    """Record bounded Pending reports and ask the coordinator before a long queue wait continues. Never raises."""
    try:
        _report_long_pending(n, jobs)
    except Exception as e:
        log("task %s: pending report error: %s: %s" % (n, type(e).__name__, str(e)[:200]))


def _report_long_pending(n, jobs):
    t = task_load(n)
    for s in t["stages"]:
        if s["state"] != "running":
            continue
        info = jobs.get(s.get("job"))
        if not info or info["state"] not in ("running", "pending"):
            continue
        if s.get("pod_started") and not s.get("queue_wait") and t.get("queue_hold") != s["id"]:
            continue                                   # already running, nothing queued: no extra kubectl call
        try:
            pods = job_pods(t["namespace"], s["job"])
        except Exception as e:
            log("task %s: pending observation unavailable: %s" % (n, type(e).__name__))
            continue
        scheduled = s.get("pod_started") or any((p.get("spec") or {}).get("nodeName") or any(
            c.get("type") == "PodScheduled" and c.get("status") == "True"
            for c in (p.get("status") or {}).get("conditions", [])) for p in pods)
        q = s.get("queue_wait") or {}
        if scheduled:
            def clear(t):
                tstage(t, s["id"]).pop("queue_wait", None)
                tstage(t, s["id"]).pop("pending_report", None)
                if t.get("queue_hold") == s["id"]:
                    t.pop("queue_hold", None)
                    t.update(status="running", reason="")
                    t["webhook_outbox"] = [e for e in t.get("webhook_outbox", []) if e.get("event_type") != "escalation"]
                    tev(t, "stage %s scheduled; queue hold cleared automatically" % s["id"])
            task_txn(n, clear)
            continue
        unschedulable = any(c.get("type") == "PodScheduled" and c.get("status") == "False" and
                            c.get("reason") == "Unschedulable" for p in pods
                            for c in (p.get("status") or {}).get("conditions", []))
        if q.get("attempt") != s.get("attempt", 1):
            q = {}
        if unschedulable and not q:
            q = {"since": now(), "attempt": s.get("attempt", 1), "multiplier": 1}
            task_txn(n, lambda t: tstage(t, s["id"]).update(queue_wait=q))
        reason = pending_reason(t, s)
        last = s.get("pending_report") or {}
        if now() - s.get("submitted", now()) >= PENDING_REPORT_S and (
                last.get("reason") != reason or now() - last.get("at", 0) >= PENDING_REREPORT_S):
            msg = "stage %s Job %s Pending %s: %s" % (s["id"], s["job"], ago(s["submitted"]), reason)
            task_txn(n, lambda t: (tstage(t, s["id"]).update(pending_report={"reason": reason, "at": now()}), tev(t, msg)))
            digest("pending", msg, n)
        gpu = manifest_gpu(s.get("manifest")) or any(
            float(((c.get("resources") or {}).get(k) or {}).get("nvidia.com/gpu", 0)) > 0
            for p in pods for c in (p.get("spec") or {}).get("containers", []) for k in ("requests", "limits"))
        ceiling = queue_ceiling_seconds(s["queue_wait_ceiling"]) if "queue_wait_ceiling" in s else (6 * 3600 if gpu else None)
        if ceiling and q and not q.get("fired") and now() - q["since"] >= ceiling * q.get("multiplier", 1) and task_load(n)["status"] not in TASK_HELD:
            q["fired"] = True
            task_txn(n, lambda t: (tstage(t, s["id"]).update(queue_wait=q), t.update(queue_hold=s["id"])))
            choices = "keep waiting (nrp-monitor task resume %s re-arms at 2x)" % n
            if s.get("cpu_fallback"):
                choices += ", switch to declared CPU fallback %s" % json.dumps(s["cpu_fallback"])
            to_coordinator(n, "stage %s queue wait %s: %s. Choose: %s, or cancel. Job stays queued." % (s["id"], ago(q["since"]), reason, choices))


def handle_failure(n, a):
    """The task escalation ladder. Tier 0: script rules (classification in observe_task, deadline rules, `tier0_timeout`). Tier 1: read-only
    triage, where a benign answer is possible; 'no fix needed' CLOSES the event. Tier 2: the fixer. Tier 3: the task's
    coordinator chat (`to_coordinator`). The owner is told (NEEDS_OWNER + one DM) only by the chat (`task needs-owner`), or when a person's
    decision is the only way on (watch-only task, GPU approval), or when the chat cannot be woken."""
    if terminal_task(n):
        return
    t = task_load(n)
    f = t["failure"]
    if not f.get("fingerprint"):
        f["fingerprint"] = fingerprint(t, f)
        task_txn(n, lambda task: task["failure"].update(fingerprint=f["fingerprint"]))
    if postcheck_failure(f):
        to_coordinator(n, "postcheck failed: the coordinator must fix the acceptance script; skip_reuse cannot resolve it. " + f["detail"], a, deputy=False)
        return
    if apply_decision(n, a):
        return
    since = t.get("budget_from", 0)
    prior = [x["sig"] for x in t["attempts"] if x["stage"] == f["stage"]]
    used = len(t["attempts"][since:])
    cls_used = class_retries(t, f)
    if t["mode"] == "watch":
        # a watch-only task has no ladder: the failure is final, so this is the one `failure` wake (the chat hears it, and so does the owner)
        if not a.dry_run:
            task_txn(n, lambda t: queue_task_webhook(t, "failure", summary="NRP task %s (watch-only): stage %s failed [%s] %s. Look: "
                     "`nrp-monitor task show %s`. The owner is notified too: a watch-only task has no automatic fixes."
                     % (n, f["stage"], f["cls"], f["detail"][:200], n)))
        escalate(n, "watch-only task, stage %s failed [%s]: %s" % (f["stage"], f["cls"], f["detail"]), a)
        return
    if f["cls"] == "slow" and not a.dry_run and tier0_timeout(n, f):
        return
    why = None
    if f["sig"] in prior and f["sig"] != LOST_SIG:
        why = "stage %s failed the same way again after a retry [%s]: %s" % (f["stage"], f["cls"], f["detail"])
    elif used >= t["max_retries"]:
        why = "retry cap %d reached; last failure [%s]: %s" % (t["max_retries"], f["cls"], f["detail"])
    elif cls_used >= CLASS_BUDGET.get(f["cls"], 1):
        why = "%s retries used (%d) on stage %s; last failure: %s" % (f["cls"], cls_used, f["stage"], f["detail"])
    else:
        why = systemic_failure(t, f)
    if why:
        to_coordinator(n, why, a)
        return
    gx = gpu_expired(tstage(t, f["stage"]))
    if gx and not a.dry_run:
        escalate(n, "stage %s failed [%s] %s | %s" % (f["stage"], f["cls"], f["detail"][:150], gx.split(" (`nrp-monitor")[0]), a)
        return
    if a.dry_run:
        print("[dry-run] task %s: would run Tier 1 triage / start a fix agent for [%s] %s" % (n, f["cls"], f["detail"][:120]))
        return
    if not agents_available():
        log("task %s: fix agent waits: %s" % (n, unavailable_text()))
        return
    if not f.get("triaged") and triage_wanted(t, f):                       # Tier 1: once per failure
        PASS["agents"] = PASS.get("agents", 0) + 1
        line, _ = run_task_agent(n, triage_prompt(t), a, kind="triage")
        if is_unavailable(line):
            return
        run = (task_load(n).get("agent_runs") or [{}])[-1]
        verdict, vtext = run.get("verdict") or "ESCALATE", run.get("verdict_text") or line

        def mark(t):
            cur = t.get("failure")
            if not cur or cur.get("ts") != f.get("ts"):
                return False
            cur["triaged"], cur["triage_text"] = now(), "%s: %s" % (verdict, vtext)
            tev(t, "Tier 1 triage: %s: %s" % (verdict, vtext[:200]))
        task_txn(n, mark)
        if verdict in TRIAGE_CLOSE:
            ok, refused = close_failure(n, f, vtext)
            if ok:
                return
            task_txn(n, lambda t: tev(t, "Tier 1 said no fix needed but the script refused to close it: " + refused))
        t = task_load(n)
        if terminal_task(n) or not t.get("failure"):
            return
        f = t["failure"]
    PASS["agents"] = PASS.get("agents", 0) + 1
    line, den = run_task_agent(n, task_prompt(t), a)                       # Tier 2
    if is_unavailable(line) or settled_outcome(n, line, a, "fixer"):
        return
    t = task_load(n)
    rep = (t.get("report") or {})
    if t["status"] == "blocked":
        return
    if t.get("failure") is None:
        digest("retry", "%s [%s] -> %s" % (f["job"], f["cls"], (t["attempts"][-1]["fix"] if t["attempts"] else line)[:250]), n)
        return
    if den and not rep:
        line = "the fix agent was denied %d tool call(s) (monitor fault): %s" % (len(den), line)
    claim = t.get("util_ok_claim")
    if claim is None and rep.get("status") == "UTIL_OK":
        claim = rep.get("line") or ""
    if claim is not None and rep.get("status") in (None, "UTIL_OK"):          # a STOPPED report stays a stop
        ok, why = util_waive(n, f, claim, a)
        if ok:
            return
        log("task %s: util waiver refused: %s" % (n, why))
        task_txn(n, lambda t: (t.pop("util_ok_claim", None), tev(t, "util waiver refused: " + why)))
        to_coordinator(n, "fix agent did not resubmit: %s [util waiver refused: %s]" % (((rep.get("line") or line)[:200]), why[:110]), a)
        return
    to_coordinator(n, "fix agent did not resubmit: %s" % ((rep.get("line") or line)[:300]), a)                    # Tier 3


def s3_gate(s):
    """URIs in the stage's `after_s3` that do not (yet) exist. An unreadable answer counts as missing: the stage just waits."""
    return [u for u in s.get("after_s3", []) if s3_exists(u, {}) is not True]


def note_waiting(n, sid, missing):
    """Record what a pending stage waits on (shown by `task show`); only writes when it changes."""
    if (tstage(task_load(n), sid).get("waiting_on") or []) == missing:
        return

    def f(t):
        tstage(t, sid)["waiting_on"] = missing
        tev(t, ("stage %s waits on %d S3 key(s): %s" % (sid, len(missing), ", ".join(missing)[:200])) if missing
            else "stage %s: every after_s3 key exists, submitting" % sid)
    task_txn(n, f)


def advance_task(n, jobs, a):
    if terminal_task(n):
        return
    t = task_load(n)
    if a.dry_run:                                                         # read-only: say what the pass would do
        for s in t["stages"]:
            info = jobs.get(s["job"])
            if s["state"] == "pending" and all(tstage(t, x)["state"] == "done" for x in s["after"]):
                miss = s3_gate(s)
                if miss:
                    print("[dry-run] task %s: stage %s (%s) waits on %s" % (n, s["id"], s["job"], ", ".join(miss)))
                    continue
                print("[dry-run] task %s: would submit stage %s (%s)" % (n, s["id"], s["job"]))
            elif s["state"] == "running":
                print("[dry-run] task %s: stage %s Job %s is %s" % (n, s["id"], s["job"], info["state"] if info else "not in the cluster"))
        if t.get("failure"):
            print("[dry-run] task %s: failure [%s] %s -> would start a fix agent or escalate" % (n, t["failure"]["cls"], t["failure"]["detail"][:100]))
        if t["status"] == "blocked":
            print("[dry-run] task %s: submit is blocked; would %s" % (n, "re-check the namespace (no wake, no state change)"
                  if (t.get("pending") or {}).get("checked") is not None else "check the namespace once and wake the coordinator"))
        return
    if t["status"] == "blocked":
        p = t.get("pending") or {}
        if p and not block_should_reapply(n):                                 # pods outside the bands explain it: wait, no retry loop
            ok = True
        else:
            ok, msg = do_submit(n, p.get("stage"), p.get("reason", "re-apply after block"), "monitor") if p else (False, "no pending submit")
        t = task_load(n)
        if t["status"] == "blocked":
            if now() - p.get("since", now()) > BLOCK_ESCALATE_S:
                offs = (t.get("pending") or {}).get("offenders") or []
                escalate(n, "submits refused for %s (NRP utilization block or quota)%s" % (ago(p["since"]), (
                    "; still outside the bands: " + ", ".join(o["pod"] for o in offs)) if offs else ""), a)
            return
        if not ok:
            task_txn(n, lambda t: t.update(status="retrying"))
    observe_task(n, jobs)
    report_long_pending(n, jobs)
    if task_load(n)["status"] in TASK_HELD:
        return
    process_util_event(n, a)
    t = task_load(n)
    if t.get("failure"):
        if not tier0_fix(n, a):                                           # fixed rules first (no model); the agents only when none applies
            handle_failure(n, a)
        return
    for s in t["stages"]:
        if s["state"] == "pending" and all(tstage(t, x)["state"] == "done" for x in s["after"]):
            if a.dry_run:
                print("[dry-run] task %s: would submit stage %s (%s)" % (n, s["id"], s["job"]))
                continue
            if s.get("after_s3") or s.get("waiting_on"):
                miss = s3_gate(s)
                note_waiting(n, s["id"], miss)
                if miss:
                    continue                                              # stays pending; checked again next pass
            if (not s.get("submitted") and s.get("attempt", 1) == 1
                    and not any(x.get("stage") == s["id"] for x in t["attempts"])
                    and s.get("done_s3") and all(s3_exists(u, {}) is True for u in s["done_s3"])):
                message = "stage %s done: success marker already present before submission (reused, not rerun)" % s["id"]
                def reuse(cur):
                    tstage(cur, s["id"]).update(state="done", done_ts=now())
                    tev(cur, message)
                task_txn(n, reuse)
                s.update(state="done")                                # dependents in this pass see completion too
                digest("done", message, n)
                continue
            ok, msg = do_submit(n, s["id"], "stage ready", "monitor")
            if not ok and msg.startswith("GPU APPROVAL"):
                escalate(n, msg.split(". Report STOPPED")[0], a)
                return
            if not ok:
                task_fail(n, s["id"], "infra", "apply:" + norm_sig(msg), "submit failed: " + msg)
                handle_failure(n, a)
                return
            if task_load(n)["status"] == "blocked":
                return
    t = task_load(n)
    if all(s["state"] == "done" for s in t["stages"]) and t["status"] in TASK_LIVE:
        check = run_postcheck(t)
        task_txn(n, lambda cur: cur.update(postcheck_result=check))
        if not check["ok"]:
            task_fail(n, t["stages"][-1]["id"], "outputs", "postcheck", "postcheck failed: " + check["output"][-1000:])
            handle_failure(n, a)
            return
        def finish(t):
            t.update(status="done", finished=now())
            tev(t, "all %d stages done" % len(t["stages"]))
        task_txn(n, finish)
        digest("task-done", "%s: all %d stage(s) done in %s; %d retr%s" % (t["label"], len(t["stages"]), ago(t["created"]),
               len(t["attempts"]), "y" if len(t["attempts"]) == 1 else "ies"), n)
        if not t.get("on_done") and not t.get("followup") and not t.get("digest_only"):
            digest("no-continuation", "%s finished and nothing was set to act on it (no on_done, followup or digest_only); its result "
                   "waits for a person: `nrp-monitor task show %s`" % (t["label"], n), n)
        if not t.get("handoff") or t["handoff"].get("thin"):
            digest("no-handoff", "%s finished with %s: a later fix or continue agent had only the task fields. Write one with templates/handoff.md "
                   "next time (`nrp-monitor task show %s`)" % (t["label"], "no handoff" if not t.get("handoff") else "a thin handoff", n), n)
        if t.get("code") and git("rev-list", "--count", "%s..HEAD" % t["code"]["base"], cwd=t["code"]["clone"]).stdout.strip() not in ("", "0"):
            digest("merge", "fixes on branch %s: git -C %s fetch %s %s" % (t["code"]["branch"], t["code"]["repo"], t["code"]["clone"],
                   t["code"]["branch"]), n)
        if t.get("followup") and not t.get("on_done") and not a.dry_run:
            text = ("You are a fresh read-only agent. NRP task %s finished: all stages succeeded.\nGoal: %s\nOrigin chat (who gets the result): %s\nNotes: %s\nStages:\n%s\n\nHandoff (from the agent that registered the task; read-only context):\n%s\n\n"
                    "WHAT TO REPORT:\n%s\n\nYour only shell tool is `nrp-task` (show, logs JOB, s3 ls URI, s3 cat URI; one command per call). "
                    "Saved logs are under %s/logs. Finish with `nrp-task report DONE \"one line\"` and reply with that line."
                    % (n, t["goal"], origin_plain(t.get("origin")), t["notes"], "\n".join("  - %s %s" % (s["job"], ", ".join(s["done_s3"])) for s in t["stages"]),
                       handoff_prompt(t), t["followup"], task_dir(n)))
            text += ("\nPostcheck: " + json.dumps(task_load(n).get("postcheck_result"))
                     + "\nStage outputs: " + json.dumps({s["id"]: s.get("outputs", {}) for s in task_load(n)["stages"]})
                     + "\nRead saved logs/notes in the task directory. `nrp-task postcheck` reruns only the declared checker.")
            text += person_resolution_context(task_load(n))
            line, _ = run_task_agent(n, text, a, kind="followup")
            if is_unavailable(line):
                line = ("the completion report was not written (%s); read the result with `nrp-monitor task show %s`" % (line, n))
            digest("result", line, n)


def recover_held_completion(n, jobs):
    t = task_load(n)
    sid = (t.get("failure") or {}).get("stage")
    stages = [s for s in t["stages"] if s["id"] == sid] if sid else [s for s in t["stages"] if s["state"] in ("running", "failed")]
    completed = [s for s in stages if (jobs.get(s["job"]) or {}).get("state") == "ok"]
    if not completed:
        return False
    missing = [u for s in completed for u in s["done_s3"] if s3_exists(u, {}) is not True]
    if missing:
        reason = t.get("reason", "").split(" Completion check:", 1)[0] + " Completion check: Job complete but success markers missing or unreadable: " + ", ".join(missing)
        task_txn(n, lambda t: t.update(reason=reason))
        return False
    def recover(t):
        for s in completed:
            tstage(t, s["id"]).update(state="done", done_ts=now())
            propagate_resources(t, tstage(t, s["id"]))
        t.update(status="running", failure=None)
        for key in ("reason", "coordinator_since", "util_event"):
            t.pop(key, None)
        t["webhook_outbox"] = [e for e in t.get("webhook_outbox", []) if e.get("event_type") != "escalation"]
        tev(t, "held stage completed with all success markers; hold cleared")
    task_txn(n, recover)
    return True


def process_tasks(a, st):
    if not a.dry_run:
        for n in task_names():
            terminal_task(n)
    names = [x for x in task_names() if (task_load(x) or {}).get("status") in TASK_LIVE + TASK_HELD]
    PASS["tasks"] = len(names)
    cache = {}
    for n in names:
        t = task_load(n)
        try:
            if t["namespace"] not in cache:
                cache[t["namespace"]] = fetch_jobs(t["namespace"])
            if t["status"] in TASK_HELD:
                if t.get("queue_hold") and not a.dry_run:
                    report_long_pending(n, cache[t["namespace"]])
                    t = task_load(n)
                if t["status"] in TASK_HELD and (a.dry_run or not recover_held_completion(n, cache[t["namespace"]])):
                    continue
            advance_task(n, cache[t["namespace"]], a)
        except Exception as e:
            log("task %s error: %s: %s" % (n, type(e).__name__, str(e)[:200]))

    try:
        check_coordinator_waits(a)
    except Exception as e:
        log("coordinator wait check error: %s: %s" % (type(e).__name__, str(e)[:150]))


FLAG_RULE_RE = re.compile(r"\brule=(lab|nrp|gpu)\b")


def flag_rule(line):
    """Which rule flagged a pod: `gpu`, `nrp` (a CPU/memory band NRP counts) or `lab` (the lab floor only), from the `rule=` token that
    nrp-util-check ends its line with; a line without one (an older nrp-util-check) is read from its tag. `unknown` when neither says."""
    m = FLAG_RULE_RE.search(line or "")
    if m:
        return m.group(1)
    if "[NRP violation]" in (line or ""):
        return "nrp"
    if re.search(r"\bgpu\b", line or ""):
        return "gpu"
    return "lab" if re.search(r"\[lab \d+% rule", line or "") else "unknown"


def waiver_stage(t, w):
    return next((s for s in t.get("stages", []) if s.get("job") == w.get("job")), None)


def waiver_active(t, w):
    """A util waiver holds while it has not run out and the very Job it was given for still runs (a resubmit or a finished Job ends it)."""
    s = waiver_stage(t, w)
    return bool(s) and s.get("state") == "running" and s.get("submitted") == w.get("submitted") and now() < w.get("until", 0)


def active_waiver(t, sid):
    """The live util waiver of stage `sid`'s Job, or None. Reads only what `util_waivers` holds, so a task written before waivers existed has none."""
    if not t:
        return None
    s = next((x for x in t.get("stages", []) if x.get("id") == sid), None)
    return next((w for w in t.get("util_waivers") or [] if s and w.get("job") == s.get("job") and waiver_active(t, w)), None)


UTIL_OK_RE = re.compile(r"^[ \t>*_`#-]*UTIL_OK[ \t*_`]*:[ \t*_`]*(.*)$", re.M)
UTIL_OK_REASON_MAX = 400


def util_ok_extract(text):
    """The evidence text after the LAST `UTIL_OK:` line of a fix agent's answer (that line and the lines after it up to a blank line,
    HANDOFF_ENTRY or FOR_OWNER), whitespace collapsed, at most 400 characters; None when the answer has no such line."""
    ms = list(UTIL_OK_RE.finditer(text or ""))
    if not ms:
        return None
    m = ms[-1]
    parts = [m.group(1)]
    for l in text[m.end():].split("\n")[1:]:
        if not l.strip() or re.match(r"^[ \t>*_`#-]*(HANDOFF_ENTRY|FOR_OWNER)\b", l):
            break
        parts.append(l)
    out = " ".join(" ".join(parts).replace("*", "").replace("`", "").split())[:UTIL_OK_REASON_MAX]
    return out


def util_waiver_check(t, f, claim):
    """(ok, why): whether the script accepts the fix agent's UTIL_OK. The script decides, never the agent's claim: the failure is class util;
    the flag came from the lab floor only (not an NRP band, not a GPU flag); the stage is not a GPU stage; the Job exists and is running now;
    the task still has waivers left."""
    cap = util_waiver_max()
    s = next((x for x in t["stages"] if x["id"] == f.get("stage")), None)
    if not claim:
        return False, "UTIL_OK gave no evidence"
    if f.get("cls") != "util":
        return False, "the failure class is %s, not util" % f.get("cls")
    rule = f.get("rule")
    if rule != "lab":
        return False, ("the flag came from rule %s (NRP-band and GPU flags are never waived)" % rule) if rule else \
            "the failure records no flag rule (written before waivers existed)"
    if s is None or s["job"] != f.get("job"):
        return False, "the failed stage is not in the task"
    if s.get("gpu_ok_until") or s.get("gpu_plan") or (s.get("manifest") and manifest_gpu(s["manifest"])):
        return False, "stage %s requests a GPU (GPU stages are never waived)" % s["id"]
    for note in (t.get("util") or [])[-5:]:                                   # another pod of the Job flagged outside NRP's bands or on a GPU
        m = re.match(r"^(\S+) \[(nrp|gpu)\] ", note)
        try:
            if m and now() - datetime.fromisoformat(m.group(1)).timestamp() < 2 * 3600:
                return False, "another flag on this task's pods came from rule %s at %s" % (m.group(2), m.group(1))
        except ValueError:
            pass
    if len(t.get("util_waivers") or []) >= cap:
        return False, "this task has used its %d util waiver(s)" % cap
    st_ = job_state(f["job"], t["namespace"])
    if st_ != "running":
        return False, "Job %s is %s now, not running" % (f["job"], st_)
    return True, ""


def util_waive(n, f, claim, a):
    """Accept the waiver: the stage goes back to running, the failure clears, no retry is used, nobody is messaged. Returns (ok, why)."""
    t = task_load(n)
    ok, why = util_waiver_check(t, f, claim)
    if not ok:
        return False, why
    hours = util_waiver_hours()
    out = {}

    def acc(t):
        cur = t.get("failure")
        if not cur or cur.get("ts") != f.get("ts"):
            out["why"] = "the failure changed while the waiver was checked"
            return False
        s = tstage(t, f["stage"])
        at = now()
        w = {"job": f["job"], "pod": f.get("pod") or "", "stage": f["stage"], "reason": claim[:UTIL_OK_REASON_MAX], "at": at,
             "until": at + hours * 3600, "submitted": s.get("submitted")}
        t.setdefault("util_waivers", []).append(w)
        t["failure"] = None
        s["state"] = "running"
        s.pop("util_deleted", None)
        t.pop("util_ok_claim", None)
        out["w"], out["k"] = w, len(t["util_waivers"])
        tev(t, "util waiver %d of %d for %s until %s: %s" % (out["k"], util_waiver_max(), f["job"], iso(w["until"]), claim[:160]))
        try:
            when = datetime.fromtimestamp(at, timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
            handoff_append(t, "%s | monitor | util waiver %d of %d | [util] stage %s" % (when, out["k"], util_waiver_max(), f["stage"]),
                           [("Fix log", "Util flag waived until %s (the Job runs and only the lab floor flagged it): %s" % (iso(w["until"]), claim[:UTIL_OK_REASON_MAX]))])
        except Exception as e:
            log("task %s: handoff entry for the waiver not written: %s: %s" % (t["name"], type(e).__name__, str(e)[:120]))
    if not task_txn(n, acc):
        return False, out.get("why", "the task changed")
    cost_event(n, "waiver_resolution", "2", "resolved", stage=f["stage"], fingerprint=f.get("fingerprint") or fingerprint(t, f))
    digest("util-waived", "Job %s is running and only the lab utilization floor flags it (waiver %d of %d, until %s): %s"
           % (f["job"], out["k"], util_waiver_max(), iso(out["w"]["until"]), claim[:240]), n)
    return True, ""


def task_pod_flag(st, n, sid, pod, kind, line):
    """Utilization is a judge event, never a stage failure. STUCK remains an infrastructure failure."""
    if kind == "STUCK":
        task_fail(n, sid, "infra", "stuck:" + norm_sig(line.split(" ", 2)[-1])[:60], "pod %s STUCK: %s" % (pod, line[:200]))
        return
    rule = flag_rule(line)
    if rule == "lab" and active_waiver(task_load(n), sid):               # the owner-side lab floor only, and the fix agent showed the Job is healthy
        st["strikes"].pop(pod, None)
        return
    t = task_load(n)
    stage = tstage(t, sid)
    evidence = memory_low_evidence(t, stage, pod) if kind == "LOW" and any(k == "mem" and int(pct) < 20 for k, use, req, pct, mx in FLAG_RES.findall(line)) else None
    if evidence and evidence["ramp_up"]:
        return
    if stage["state"] != "running":
        return
    event = {"stage": sid, "job": stage["job"], "cls": "util", "sig": "util:" + norm_sig(line),
             "detail": line, "ts": now(), "evidence": evidence, "rule": rule, "pod": pod}
    def record(t):
        t.setdefault("util", []).append("%s [%s] %s" % (iso(), rule, line[:200]))
        del t["util"][:-10]
        if not t.get("util_event"):
            t["util_event"] = event
            tev(t, "utilization observation (stage keeps running): " + line)
            if evidence:
                tev(t, "memory request=%gGi limit=%gGi need=%gGi right=%dGi spread=%s: %s" % (
                    evidence["request_gi"], evidence["limit_gi"], evidence["need_gi"], evidence["right_gi"],
                    evidence["spread"], evidence["suggested_verdict"]))
    task_txn(n, record)


def process_util_event(n, a):
    if terminal_task(n):
        return
    t = task_load(n)
    event = t.get("util_event")
    if not event or t.get("failure") or a.dry_run:
        return
    if tstage(t, event["stage"])["state"] != "running":
        task_txn(n, lambda t: t.pop("util_event", None))
        return
    context = dict(t, failure=event)
    numbers = json.dumps(event.get("evidence"), sort_keys=True)
    prompt = triage_prompt(context) + "\nMemory evidence (GiB): " + numbers + "\n" + MEMORY_RULE
    line, _ = run_task_agent(n, prompt, a, kind="triage")
    if is_unavailable(line):
        return
    runs = task_load(n).get("agent_runs") or []
    verdict = runs[-1].get("verdict", "ESCALATE") if runs else "ESCALATE"
    if verdict not in TRIAGE_CLOSE and t.get("mode") == "watch":
        digest("util-review", "watch-only task: judge recommends fixer review; running Job left alone. " + line, n)
    elif verdict not in TRIAGE_CLOSE:
        context["failure"]["triage_text"] = "%s: %s" % (verdict, runs[-1].get("verdict_text", line) if runs else line)
        line, _ = run_task_agent(n, task_prompt(context) + "\nMemory evidence (GiB): " + numbers + "\n" + MEMORY_RULE, a)
        if is_unavailable(line):
            return
    task_txn(n, lambda t: (t.pop("util_event", None), tstage(t, event["stage"]).update(util_reviewed=now()), tev(t, "utilization review: " + line)))


MEMORY_RULE = """Memory NRP band is 20–150% of request. Tier 1 is judge only: CLOSE with numbers or ESCALATE with numbers and what looks wrong.
The fixer alone changes resources. need=max(stage whole-life per-pod peaks, recorded OOM limits); right=ceil(need*1.5) Gi.
A recorded OOM limit is a proven lower bound even when sampled usage idles below the band between spikes.
CLOSE with that reason when request <= 1.2*right; never STOP or escalate solely for that low mean.
request <= 1.2*right is sized correctly; above it is oversized. If max/median >3 and low pods remain below 20% of request
through their whole life, split inputs into size groups. Missing peaks or incomparable pods require explicit review.
Fixer: write right into the manifest for retries/later runs. Leave running work to finish unless measured time remaining >2h
AND the stage is resumable; only then resubmit at right. Never shrink below OOM evidence. UTIL flags alone never hold a task."""


def memory_low_evidence(t, s, flagged_pod):
    import math
    import statistics
    doc = manifest_doc(s["manifest"])
    containers = doc["spec"]["template"]["spec"]["containers"]
    resources = containers[0].get("resources", {})
    request = (mem_bytes(resources.get("requests", {}).get("memory", "")) or 0) / 2**30
    limit = (mem_bytes(resources.get("limits", {}).get("memory", "")) or 0) / 2**30
    runtime = s.get("measured_runtime_seconds")
    threshold = float(runtime) * .25 if runtime else 1800
    pods = job_pods(t["namespace"], s["job"])
    ages = {p["metadata"]["name"]: max(0, now() - (parse_ts(p.get("status", {}).get("startTime") or p["metadata"].get("creationTimestamp", "")) or now())) for p in pods}
    age = ages.get(flagged_pod, max(0, now() - s.get("pod_started", now())))
    since = min(s.get("memory_since", now()), t.get("created", now()), s.get("submitted", now()),
                *(now() - age for age in ages.values()))
    peaks = thanos_peak_mem(t["namespace"], s["job"], containers[0]["name"], since, per_pod=True)
    true_peak = saved_memory_peak(t, s, containers[0]["name"], all_attempts=True)
    if true_peak is None and len(containers) == 1:
        true_peak = saved_memory_peak(t, s, all_attempts=True)
    previous = s.get("memory_peaks_gi", {})
    peaks = {k: max(v / 2**30, previous.get(k, 0)) for k, v in peaks.items()} | {k: v for k, v in previous.items() if k not in peaks}
    for name in peaks:
        ages.setdefault(name, None)
    oom = list(s.get("oom_limits_gi", []))
    for attempt in t.get("attempts", []):
        if attempt.get("stage") == s["id"] and str(attempt.get("sig", "")).startswith("oom@"):
            b = mem_bytes(attempt["sig"].split("@", 1)[1])
            if b: oom.append(b / 2**30)
    for p in pods:
        for cs in p.get("status", {}).get("containerStatuses", []) or []:
            if any((cs.get(k, {}).get("terminated") or {}).get("reason") == "OOMKilled" for k in ("state", "lastState")):
                pc = next((c for c in p.get("spec", {}).get("containers", []) if c["name"] == cs.get("name")), {})
                b = mem_bytes(pc.get("resources", {}).get("limits", {}).get("memory", ""))
                if b: oom.append(b / 2**30)
    need = max(list(peaks.values()) + oom + [true_peak / 2**30 if true_peak else 0])
    right = math.ceil(need * 1.5)
    spread = max(peaks.values()) / statistics.median(peaks.values()) if peaks and statistics.median(peaks.values()) else None
    missing = sorted((set(ages) | {flagged_pod}) - set(peaks))
    verdict = "missing peaks: review" if not peaks or missing else ("sized correctly" if request <= 1.2 * right else "oversized")
    finished = set(s.get("memory_completed_pods", [])) | {p["metadata"]["name"] for p in pods if p.get("status", {}).get("phase") == "Succeeded"}
    low_whole_life = sorted(k for k, v in peaks.items() if k in finished and v < .2 * request)
    if spread and spread > 3 and low_whole_life and not missing: verdict = "inputs differ in size"
    task_txn(t["name"], lambda t: tstage(t, s["id"]).update(memory_peaks_gi=peaks, oom_limits_gi=sorted(set(oom)), memory_since=since, memory_completed_pods=sorted(finished)))
    return dict(peaks_gi=peaks, ages_seconds=ages, request_gi=request, limit_gi=limit, oom_limits_gi=oom,
                true_peak_gi=true_peak / 2**30 if true_peak else None, need_gi=need, right_gi=right, spread=spread, suggested_verdict=verdict, ramp_up=age < threshold,
                missing_peak_pods=missing, low_whole_life=low_whole_life, measured_runtime_seconds=runtime, remaining_seconds=max(0, runtime-age) if runtime else None)


def check_orphans(a, st):
    """the owner's running Jobs that no task, chain or registration covers go to the digest once."""
    try:
        js = fetch_jobs(NS)
    except Exception:
        return
    known = set()
    for n in task_names():
        known |= {s["job"] for s in (task_load(n) or {}).get("stages", [])}
    for cn in chain_names():
        known |= {s["job"] for s in (chain_load(cn) or {}).get("steps", [])}
    known |= {j for j, r in st["jobs"].items() if r.get("status") == "watching"}
    seen = read_json(ORPHANS, {})
    live = {j for j, i in js.items() if i["ours"] and i["state"] in ("running", "pending") and j not in known}
    for j in sorted(live - set(seen)):
        if not a.dry_run:
            digest("unregistered", "Job %s is running but no task or chain watches it" % j)
        seen[j] = iso()
    seen = {j: v for j, v in seen.items() if j in live}
    if not a.dry_run:
        write_json(ORPHANS, seen)


# ---- plans: on_done continuation (feature flag, default OFF; design docs/agents/plan-run/WATCHDOG_ON_DONE.md) ----
# A task may carry  "on_done": {"plan": "path/to/PLAN.md#plan-id", "from_step": "2"}.  `task add` copies that plan section
# (and the files its run block lists under `templates`) into plans/<id>/, because launchd cannot read ~/Desktop.
# When the task is done, ONE fresh Sonnet "continue" agent checks the step's "done when" against the outputs and, only for
# next steps inside the approved range that are not stops for the owner and were never started before, registers the next task
# (`nrp-task next-add FILE`). Everything else waits for the owner and is listed in the digest's "Plans" section (morning report).
PLANS = STATE / "plans"
PLAN_MAX = 24 * 1024                     # the plan section a fresh agent reads
PLAN_FILES_MAX = 256 * 1024              # templates copied beside it
ON_DONE_FLAG = STATE / "on_done.enabled"   # `touch` it to turn auto-continue on; delete it to turn it off
PLAN_ID_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,39}$")
CONT_STALE_S = 2 * 3600                  # a continue run that never returned (pass crashed) is closed after this
PLAN_KEYS = ("plan", "approval", "steps", "approved_through", "stop_for_owner", "stop_for_hunter", "may_touch", "next", "templates")


def on_done_enabled():
    return ON_DONE_FLAG.exists()


def plan_dir(pid):
    return PLANS / pid


def split_list(v):
    v = (v or "").strip()
    if v.lower() in ("", "none", "-", "[]"):
        return []
    return [x.strip() for x in v.strip("[]").split(",") if x.strip()]


def plan_section(text, pid):
    """The part of a plan file that belongs to plan `pid`: the heading carrying `<!-- plan:pid -->` down to the next heading of the
    same or higher level (code fences skipped). A file whose only run block names pid is used whole."""
    lines, fence, start, level = text.splitlines(), False, None, 0
    for i, l in enumerate(lines):
        if l.lstrip().startswith("```"):
            fence = not fence
            continue
        m = re.match(r"^(#{1,6})\s", l)
        if fence or not m:
            continue
        if start is None and ("<!-- plan:%s -->" % pid) in l:
            start, level = i, len(m.group(1))
        elif start is not None and len(m.group(1)) <= level:
            return "\n".join(lines[start:i]) + "\n"
    if start is not None:
        return "\n".join(lines[start:]) + "\n"
    if len(re.findall(r"^```run\s*$", text, re.M)) == 1:
        return text
    raise ChainError("no heading with <!-- plan:%s --> in the plan file (and it is not a single-plan file)" % pid)


def parse_run_block(section):
    """The machine-read run header: a ```run fenced block of `key: value` lines (# starts a comment)."""
    m = re.search(r"^```run\s*\n(.*?)^```", section, re.S | re.M)
    if not m:
        raise ChainError("the plan section has no ```run block (run header)")
    raw, bad = {}, []
    for l in m.group(1).splitlines():
        l = re.sub(r"(^|\s)#.*$", "", l).rstrip()
        if not l.strip():
            continue
        if ":" not in l:
            bad.append("run block line without `key:`: %r" % l[:60])
            continue
        k, v = l.split(":", 1)
        raw[k.strip()] = v.strip()
    h = {"plan": raw.get("plan", ""), "approval": raw.get("approval", ""), "steps": split_list(raw.get("steps")),
         "approved_through": raw.get("approved_through", "none").strip() or "none",
         "stops": split_list(raw.get("stop_for_owner") or raw.get("stop_for_hunter")), "may_touch": split_list(raw.get("may_touch")),
         "templates": split_list(raw.get("templates")), "next": {}}
    for part in [x for x in (raw.get("next") or "").split(";") if x.strip()]:
        a, _, b = part.partition(">")
        if not b:
            bad.append("next: `step>step[,step]; ...` (got %r)" % part.strip())
            continue
        h["next"][a.strip()] = [x.strip() for x in b.split(",") if x.strip()]
    h["groups"], h["retries"], h["wake_overrides"] = {}, {}, {}
    for part in filter(str.strip, raw.get("groups", "").split(";")):
        name, sep, members = part.strip().partition("=")
        if not sep or not PLAN_ID_RE.fullmatch(name) or name in h["groups"]:
            bad.append("groups: unique name=step[,step] entries")
            continue
        h["groups"][name] = split_list(members)
    assigned = []
    for members in h["groups"].values():
        if not members or any(x not in h["steps"] for x in members):
            bad.append("groups: nonempty sets of known steps required")
        assigned += members
    if len(assigned) != len(set(assigned)):
        bad.append("groups: each step belongs to at most one group")
    h["wake"] = raw.get("wake", "group" if h["groups"] else "task")
    for key, value in raw.items():
        if key.startswith("wake_"):
            name = key[5:]
            if name not in h["groups"]:
                bad.append("wake override: unknown group " + name)
            h["wake_overrides"][name] = value
    if any(v not in ("task", "group", "digest") for v in [h["wake"]] + list(h["wake_overrides"].values())):
        bad.append("wake: task, group or digest")
    for part in filter(str.strip, raw.get("retries", "").split(";")):
        name, sep, value = part.strip().partition("=")
        if not sep or name not in h["groups"] or not value.isdigit():
            bad.append("retries: known-group=nonnegative-integer")
        else:
            h["retries"][name] = int(value)
    if not PLAN_ID_RE.match(h["plan"]):
        bad.append("plan: id of lowercase letters, digits and - (max 40)")
    if len(h["approval"]) < 8:
        bad.append("approval: the owner's words and the date (verbatim), required")
    if not h["steps"]:
        bad.append("steps: the step ids in order, e.g. `1, 2, 2b, 3`")
    for s in h["steps"]:
        if not STEP_ID_RE.match(s):
            bad.append("steps: bad step id %r" % s)
    if len(set(h["steps"])) != len(h["steps"]):
        bad.append("steps: duplicate id")
    known = set(h["steps"])
    if h["approved_through"] != "none" and h["approved_through"] not in known:
        bad.append("approved_through: one of the steps, or none")
    for k in ("stops",):
        bad += ["%s: unknown step %s" % (k, s) for s in h[k] if s not in known]
    for a, bs in h["next"].items():
        bad += ["next: unknown step %s" % s for s in [a] + bs if s not in known]
    for u in h["may_touch"]:
        if u.startswith("s3://") and not re.match(r"^s3://[^/]+/.+", u):
            bad.append("may_touch: %s must be a full s3://bucket/prefix/" % u)
    if bad:
        raise ChainError("run block: " + "; ".join(bad))
    return h


def step_pos(h, s):
    return h["steps"].index(s) if s in h["steps"] else 10 ** 6


def approved_pos(h):
    return -1 if h["approved_through"] == "none" else step_pos(h, h["approved_through"])


def plan_header(pid):
    h = read_json(plan_dir(pid) / "header.json", None) if pid else None
    if isinstance(h, dict) and "stops" not in h:
        # headers synced before the owner-neutral rename store the list as stop_for_hunter / stop_for_owner
        h["stops"] = list(h.get("stop_for_owner") or h.get("stop_for_hunter") or [])
    return h


def plan_state(pid):
    st = read_json(plan_dir(pid) / "state.json", {})
    st.setdefault("status", "idle")
    st.setdefault("ledger", {})
    st.setdefault("events", [])
    return st


def plan_txn(pid, fn):
    with state_lock():
        st = plan_state(pid)
        fn(st)
        plan_dir(pid).mkdir(parents=True, exist_ok=True)
        write_json(plan_dir(pid) / "state.json", st)


def pev(st, msg):
    st["events"].append("%s %s" % (iso(), " ".join(msg.split())[:300]))
    del st["events"][:-60]


def plan_set(pid, status, msg, reason=None):
    def f(st):
        st["status"], st["since"] = status, now()
        st["reason"] = reason or ""
        pev(st, msg)
    plan_txn(pid, f)
    log("plan %s: %s" % (pid, msg[:300]))


def ledger_add(pid, step, task, by, parent):
    plan_txn(pid, lambda st: (st["ledger"].setdefault(step, []).append({"task": task, "by": by, "parent": parent, "t": now()}),
                              st.update(status="running", since=now(), reason=""),
                              pev(st, "step %s registered as task %s by %s" % (step, task, by))))
    digest("plan-start", "plan %s step %s started as task %s (by %s%s)" % (pid, step, task, by, ", after " + parent if parent else ""), task)


def plan_sync(path, pid):
    """Copy plan `pid` from `path` into plans/<pid>/ (session side: launchd cannot read ~/Desktop). Returns the header."""
    p = Path(path).expanduser()
    try:
        text = p.read_text()
    except OSError as e:
        raise ChainError("cannot read plan file %s: %s" % (p, e))
    sec = plan_section(text, pid)
    if len(sec.encode()) > PLAN_MAX:
        raise ChainError("plan section %s is %d KB; keep it under %d KB (details belong in linked docs)" % (pid, len(sec.encode()) >> 10, PLAN_MAX >> 10))
    h = parse_run_block(sec)
    if h["plan"] != pid:
        raise ChainError("run block says plan: %s, the reference says #%s" % (h["plan"], pid))
    files, total = [], 0
    for rel in h["templates"]:
        src = (p.parent / rel).resolve()
        if not src.is_file():
            raise ChainError("templates: %s not found next to the plan" % rel)
        total += src.stat().st_size
        files.append((Path(rel).name, src))
    if total > PLAN_FILES_MAX:
        raise ChainError("templates total %d KB, over %d KB" % (total >> 10, PLAN_FILES_MAX >> 10))
    d = plan_dir(pid)
    (d / "work").mkdir(parents=True, exist_ok=True)
    shutil.rmtree(d / "files", ignore_errors=True)
    (d / "files").mkdir()
    for name, src in files:
        shutil.copyfile(src, d / "files" / name)
    (d / "plan.md").write_text(sec)
    write_json(d / "header.json", dict(h, source=str(p.resolve()), synced=iso()))
    plan_txn(pid, lambda st: pev(st, "synced from %s (approved through %s; stops %s)" % (p.name, h["approved_through"], ", ".join(h["stops"]) or "none")))
    return h


def next_steps(h, from_step, ledger=None, parent=None):
    """(go, held): steps after `from_step` the continue agent may start, and [(step, why)] for those it may not.
    `parent` = the task whose continue agent is registering: tasks it already registered for a step do not hold that step, so one
    step can have several tasks (per-cell fan-outs); a step started by anyone else is still held."""
    ledger = ledger if ledger is not None else plan_state(h["plan"])["ledger"]
    if from_step in h["next"]:
        cand = h["next"][from_step]
    else:
        i = step_pos(h, from_step)
        cand = h["steps"][i + 1:i + 2] if i < len(h["steps"]) else []
    go, held = [], []
    for s in cand:
        if s in h["stops"]:
            held.append((s, "planned stop for the owner"))
        elif step_pos(h, s) > approved_pos(h):
            held.append((s, "beyond the approved range (approved through %s)" % h["approved_through"]))
        elif [e for e in ledger.get(s, []) if not (parent and e.get("by") != "session" and e.get("parent") == parent)]:
            held.append((s, "already started once (task %s); a rerun needs a session" % ledger[s][-1]["task"]))
        else:
            go.append(s)
    return go, held


def resolve_plan_path(path, raw, src_file):
    p = Path(path).expanduser()
    if p.is_absolute():
        return p
    bases = []
    code = raw.get("code") if isinstance(raw, dict) else None
    if isinstance(code, dict) and code.get("repo"):
        r = git("rev-parse", "--show-toplevel", cwd=os.path.expanduser(code["repo"]))
        if r.returncode == 0:
            bases.append(Path(r.stdout.strip()))
    bases += [Path(src_file).expanduser().resolve().parent, Path.cwd()]
    for b in bases:
        if (b / p).is_file():
            return b / p
    raise ChainError("on_done.plan: %s not found (relative to the code repo, the task file's folder or the current folder)" % path)


def check_on_done(od, raw, src_file, by, parent):
    if not isinstance(od, dict) or not od.get("plan") or str(od.get("from_step") or "") == "":
        raise ChainError('on_done: {"plan": "path/PLAN.md#plan-id", "from_step": "STEP"} (from_step = the plan step this task runs)')
    ref, step = str(od["plan"]), str(od["from_step"])
    if by == "session":
        path, _, pid = ref.partition("#")
        if not pid:
            raise ChainError("on_done.plan: path#plan-id (the id in the plan's run block)")
        h = plan_sync(resolve_plan_path(path, raw, src_file), pid)
    else:
        pid = ref.partition("#")[2] or ref
        h = plan_header(pid)
        if not h:
            raise ChainError("plan %s has no snapshot (register the first task from a session)" % pid)
    if step not in h["steps"]:
        raise ChainError("on_done.from_step %s is not a step of plan %s (%s)" % (step, pid, ", ".join(h["steps"])))
    if step_pos(h, step) > approved_pos(h):
        raise ChainError("plan %s is approved through step %s; step %s is not. Record the owner's answer in the plan's run block "
                         "(approved_through) first" % (pid, h["approved_through"], step))
    if step in h["stops"]:
        raise ChainError("step %s is a stop for the owner in plan %s: record the owner's decision in the plan and take it out of stop_for_owner first" % (step, pid))
    # v3: a step may have several tasks (per-cell fan-outs); it counts as done when all of them are (process_continuations).
    # A session may add another task to a step at any time; a continue agent only to a step it started itself in this run.
    led = plan_state(pid)["ledger"].get(step) or []
    if by != "session" and [e for e in led if not (e.get("by") != "session" and e.get("parent") == parent)]:
        raise ChainError("step %s of plan %s was already started once (task %s); only a session may rerun it" % (step, pid, led[-1]["task"]))
    depth = 0
    if parent:
        depth = int(((task_load(parent) or {}).get("on_done") or {}).get("depth", 0)) + 1
        if depth > len(h["steps"]):
            raise ChainError("continuation depth %d exceeds the plan's %d steps (loop guard)" % (depth, len(h["steps"])))
    return {"plan": pid, "from_step": step, "depth": depth, "by": by, "parent": parent}


def person_resolution_context(t):
    # Older state already stores resume notes in attempts. New resumes also cover a task with no failure.
    resumes = t.get("resume_notes", [])
    first = min((x["ts"] for x in resumes), default=float("inf"))
    entries = [(x.get("ts", 0), x.get("fix", "")) for x in t.get("attempts", [])
               if x.get("by") == "person" and x.get("ts", 0) < first]
    entries += [(x["ts"], x["note"]) for x in resumes]
    notes = [note for _, note in sorted(entries, key=lambda x: x[0]) if note]
    if not notes:
        return ""
    return ("\nLatest person/coordinator resume and skip notes (chronological; newest wins):\n"
            + "\n".join(notes) + "\nThese notes supersede the original brief's artifact locations. "
            "Verify and report the replacement run/artifacts they name.\n")


def continue_prompt(t, h, go, held):
    od = t["on_done"]
    d = plan_dir(od["plan"])
    tpl = (TPL / "continue_agent.md").read_text()
    rep = {"name": t["name"], "plan": od["plan"], "step": od["from_step"], "goal": t["goal"], "origin": origin_plain(t.get("origin")),
           "approval": h["approval"], "approved_through": h["approved_through"], "stops": ", ".join(h["stops"]) or "none",
           "may_touch": ", ".join(h["may_touch"]) or "(not set: only the outputs this plan names)",
           "go": ", ".join(go) or "NONE (do not register anything)",
           "held": "\n".join("  - step %s: %s" % x for x in held) or "  (none)",
           "code_scope": ", ".join(code_scope_dirs(h)) or "NONE (the plan names no repo folder: write no code)",
           "plan_file": str(d / "plan.md"), "files": str(d / "files"), "work": str(d / "work"), "dir": str(task_dir(t["name"])),
           "stages": "\n".join("  - %s job=%s outputs=%s" % (s["id"], s["job"], ", ".join(s["done_s3"])) for s in t["stages"]),
           "notes": t.get("notes") or "(none)", "clone": (t.get("code") or {}).get("clone", "(no code clone)")}
    for k, v in rep.items():
        tpl = tpl.replace("{%s}" % k, v)
    return (tpl.replace("{handoff}", handoff_prompt(t)) + failure_context(t) + person_resolution_context(t)
            + "\nSave a separate result note for this task: " + str(d / "work" / ("step-" + od["from_step"] + "-" + t["name"] + "-result.md"))
            + "\nFollowup (do this in this same agent): " + t.get("followup", "")
            + "\nPostcheck: " + json.dumps(t.get("postcheck_result"))
            + "\nStage outputs: " + json.dumps({s["id"]: s.get("outputs", {}) for s in t["stages"]})
            + "\nScoped helpers: nrp-task s3 cp URI DEST (small text sidecar, URI under may_touch, DEST under task downloads); "
              "nrp-task postcheck (rerun the exact declared read-only checker). Read saved logs and notes in the task directory.")


def close_continuation(n, status, line):
    t = task_load(n)
    od = t["on_done"]
    reg = (t.get("continuation") or {}).get("registered") or []
    if status == "CONTINUED" and not reg:
        status, line = "WAITING", "agent said CONTINUED but registered no task: " + line
    task_txn(n, lambda t: t["continuation"].update(state="closed", status=status, line=line[:400], closed=now()))
    msg = "step %s (task %s): %s %s" % (od["from_step"], n, status, line[:300])
    if status == "CONTINUED":
        plan_set(od["plan"], "running", msg)
        digest("plan-continued", "plan %s %s -> started %s" % (od["plan"], msg, ", ".join(reg)), n)
    elif status == "WAITING":
        plan_set(od["plan"], "waiting", msg, reason=line[:400])
        digest("plan-wait", "plan %s %s" % (od["plan"], msg), n)
    else:                                                               # NOT-DONE, STOPPED, FAILED
        plan_set(od["plan"], "waiting", msg, reason="%s: %s" % (status, line[:380]))
        digest("plan-stop", "plan %s %s" % (od["plan"], msg), n)
    if status in ("NOT-DONE", "STOPPED", "FAILED"):
        def reason_wake(cur):
            summary = "Continuation %s: %s" % (status, line)
            found = False
            for owner in [cur] + step_siblings(cur, include_cancelled=True):
                queued = [event for event in owner.get("webhook_outbox", []) if event.get("event_type") == "done"]
                for event in queued:
                    event["summary"] = summary
                    found = True
                if queued and owner["name"] != cur["name"]:
                    task_write(owner)  # already inside the global task transaction lock
            if not found:
                queue_task_webhook(cur, "done", summary=summary)
        task_txn(n, reason_wake)
    else:
        h = plan_header(od["plan"]) or {}
        _, held = next_steps(h, od["from_step"])
        if any(step in h.get("stops", []) for step, _ in held):
            def stop_wake(cur):
                siblings = step_siblings(cur, include_cancelled=True)
                if any(other["status"] != "done" or (other.get("continuation") or {}).get("state") != "closed" for other in siblings):
                    return
                if any(other.get("stop_event_id") for other in [cur] + siblings):
                    return
                group = task_group(cur, h)
                if completion_policy(cur) == "group" and group_ready(h, group, group_members(od["plan"], group, h)):
                    return  # the group summary carries this planned stop in the same pass
                summary = "Planned stop reached: " + msg
                queued = [(owner, event) for owner in [cur] + siblings for event in owner.get("webhook_outbox", [])
                          if event.get("event_type") == "done"]
                if queued:
                    owner, event = queued[-1]
                    event["summary"] = summary
                    cur["stop_event_id"] = event["event_id"]
                    if owner["name"] != cur["name"]:
                        task_write(owner)
                else:
                    event = queue_task_webhook(cur, "done", summary=summary)
                    if event:
                        cur["stop_event_id"] = event
            task_txn(n, stop_wake)
    cc = (task_load(n).get("continuation") or {}).get("code")
    extra = ""
    if cc:                                                              # night code: always say where it is, used or not
        used = cc["name"] in reg
        extra = " | code: branch %s in %s @ %s, %d commit(s), tests %s, %s" % (
            cc["branch"], cc["dir"], code_head(cc["dir"])[:10] if os.path.isdir(cc["dir"]) else "?", len(cc.get("commits") or []),
            "green" if any(x["rc"] == 0 and not x["dirty"] for x in cc.get("tests") or []) else "not green",
            "pinned by task %s" % cc["name"] if used else "NOT used by any task (review before reuse)")
        if not used:
            digest("plan-code", "plan %s step %s: night code left unused on branch %s in %s" % (od["plan"], cc["step"], cc["branch"], cc["dir"]), n)
    with open(plan_dir(od["plan"]) / "results.md", "a") as f:
        f.write("- %s step %s, task %s: %s %s%s\n" % (iso(), od["from_step"], n, status, line, extra))


def continue_task(n, a):
    t = task_load(n)
    od = t["on_done"]
    h = plan_header(od["plan"])
    if not h:
        task_txn(n, lambda t: t.update(continuation={"state": "closed", "status": "FAILED", "line": "no plan snapshot", "closed": now()}))
        digest("plan-stop", "task %s finished but plan %s has no snapshot" % (n, od["plan"]), n)
        return
    go, held = next_steps(h, od["from_step"])
    if a.dry_run:
        print("[dry-run] plan %s: task %s (step %s) done; auto-continue %s; may start %s; held %s"
              % (od["plan"], n, od["from_step"], "on" if on_done_enabled() else "OFF", go or "nothing", held or "nothing"))
        return
    if not on_done_enabled():
        task_txn(n, lambda t: t.update(continuation={"state": "closed", "status": "OFF", "closed": now()}))
        why = "auto-continue is off; with it on, an agent would check 'done when' for step %s and %s" % (
            od["from_step"], ("start step(s) %s" % ", ".join(go)) if go else "start nothing")
        plan_set(od["plan"], "waiting", "step %s (task %s) done; %s" % (od["from_step"], n, why), reason=why)
        digest("plan-off", "plan %s: step %s done (task %s); %s" % (od["plan"], od["from_step"], n, why), n)
        return

    if not agents_available():                                          # stays unclaimed; the next pass tries again
        log("plan %s: continue agent for task %s waits: %s" % (od["plan"], n, unavailable_text()))
        return

    def claim(t):
        if t.get("continuation"):
            return False
        t["continuation"] = {"state": "running", "started": now(), "go": go, "registered": []}
    if not task_txn(n, claim):
        return
    PASS["continued"] = PASS.get("continued", 0) + 1
    log("plan %s: continue agent for task %s (step %s; may start %s; held %s)" % (od["plan"], n, od["from_step"], go, held))
    line, den = run_task_agent(n, continue_prompt(t, h, go, held), a, kind="continue")
    if is_unavailable(line):                                            # ran out of usage mid-call: release the claim, retry next pass
        task_txn(n, lambda t: t.pop("continuation", None))
        return
    rep = task_load(n).get("report") or {}
    status = rep.get("status") if rep.get("status") in ("CONTINUED", "WAITING", "NOT-DONE", "STOPPED") else "FAILED"
    if status == "FAILED" and den:
        line = "the continue agent was denied %d tool call(s) (monitor fault): %s" % (len(den), line)
    close_continuation(n, status, rep.get("line") or line)


def step_mates(t):
    """Other tasks of task `t`'s plan step (empty without on_done or when the plan state is unreadable)."""
    if not t.get("on_done"):
        return []
    try:
        return step_siblings(t)
    except Exception as e:
        log("task %s: step siblings unreadable: %s: %s" % (t["name"], type(e).__name__, str(e)[:120]))
        return []


def task_group(t, h):
    return t.get("group") or next((g for g, steps in h.get("groups", {}).items()
                                   if t.get("on_done", {}).get("from_step") in steps), None)


def completion_policy(t):
    h = plan_header((t.get("on_done") or {}).get("plan")) or {}
    group = task_group(t, h)
    policy = h.get("wake_overrides", {}).get(group, h.get("wake", "task"))
    return "task" if policy == "group" and group is None else policy


def group_members(pid, group, h):
    return [t for n in task_names() for t in [task_load(n)] if t
            and (t.get("on_done") or {}).get("plan") == pid and task_group(t, h) == group]


def group_ready(h, group, members):
    # Every declared step must be represented; cancellations and failed checks remain open.
    ledger = plan_state(h["plan"])["ledger"]
    names = {t["name"] for t in members}
    missing = [e["task"] for step in h["groups"][group] for e in ledger.get(step, [])
               if e["task"] not in names and not task_load(e["task"])]
    return (not missing and all(any(t["on_done"]["from_step"] == step for t in members) for step in h["groups"][group])
            and all(t["status"] == "done" and (t.get("continuation") or {}).get("state") == "closed"
                    and t["continuation"].get("status") in ("CONTINUED", "WAITING", "COVERED") for t in members))


def process_group_wakes(a):
    if a.dry_run:
        return
    for pid in plan_names():
        h = plan_header(pid) or {}
        for group in h.get("groups", {}):
            with state_lock():
                members = group_members(pid, group, h)
                if not members or completion_policy(members[0]) != "group" or not group_ready(h, group, members):
                    continue
                st = plan_state(pid)
                if group in st.get("group_wakes", {}):
                    continue
                summary = "Plan %s group %s complete. " % (pid, group)
                summary += "; ".join("%s: %d/%d stages done; results %s; postcheck %s; outputs %s; %s" % (
                    t["name"], sum(s["state"] == "done" for s in t["stages"]), len(t["stages"]),
                    plan_dir(pid) / "results.md", json.dumps(t.get("postcheck_result")),
                    json.dumps({s["id"]: s.get("outputs", {}) for s in t["stages"]}),
                    t["continuation"].get("line", "")) for t in members)
                summary += "; planned stops reached: " + ", ".join(sorted({step for t in members
                    for step, _ in next_steps(h, t["on_done"]["from_step"]) [1] if step in h.get("stops", [])}))
                summary += "; resolved failures: " + json.dumps([r for r in cost_rows()
                    if r.get("task") in {t["name"] for t in members} and r.get("outcome") == "resolved"])
                key = pid + ":" + group
                prior = next((t.get("group_wakes", {}).get(key) for t in members if t.get("group_wakes", {}).get(key)), None)
                if prior:
                    st.setdefault("group_wakes", {})[group] = prior
                    write_json(plan_dir(pid) / "state.json", st)
                    continue
                t = next((t for t in reversed(members) if wake_target(t)), members[-1])
                event = queue_task_webhook(t, "done", summary=summary)
                if event:
                    t.setdefault("group_wakes", {})[key] = event
                    task_write(t)
                    st.setdefault("group_wakes", {})[group] = event
                    write_json(plan_dir(pid) / "state.json", st)
                    cost_event(t["name"], "group_wake", "coordinator", "done", plan=pid, group=group, event_id=event)


def terminal_wake(t):
    """Under state_lock: check every terminal transition, including internal cancellations."""
    if not t.get("on_done"):
        if t["status"] == "done" and t.get("digest_only"):
            digest("done", "%s finished; digest only, no coordinator wake (%s)" % (t["name"], t["digest_only"]), task=t["name"])
            return
        if t["status"] == "done":
            event = queue_task_webhook(t, "done")
            if event:
                t["done_event_id"] = event
        return
    policy = completion_policy(t)
    if policy in ("group", "digest"):
        if t["status"] == "done":
            cost_event(t["name"], "wake_avoided", "coordinator", "done", policy=policy)
        return
    sib = step_siblings(t, include_cancelled=True)
    waiting = [x["name"] for x in sib if x["status"] not in ("done", "failed", "cancelled")]
    if waiting:
        tev(t, "step %s: done wake held until task(s) %s finish" % (t["on_done"]["from_step"], ", ".join(waiting)))
        return
    if any(x.get("done_event_id") for x in [t] + sib):
        return
    event = queue_task_webhook(t, "done", summary=step_done_summary(t, sib))
    if event:
        t["done_event_id"] = event


def step_done_summary(t, sib):
    tasks = sorted([t] + sib, key=lambda x: x["name"])
    names = ", ".join(x["name"] for x in tasks)
    outcomes = "; ".join("%s: %s" % (status, ", ".join(x["name"] for x in tasks if x["status"] == status) or "none")
                         for status in ("done", "failed", "cancelled"))
    return ("NRP plan step %s (plan %s) finished: tasks %s. %s. Check results and the plan's done-when before continuing. Look: %s" %
            (t["on_done"]["from_step"], t["on_done"]["plan"], names, outcomes,
             "; ".join("`nrp-monitor task show %s`" % x["name"] for x in tasks)))[:1600]


def step_siblings(t, include_cancelled=False):
    """The other tasks bound to the same plan step as task `t` (from the plan's ledger), as loaded task dicts; cancelled ones do not count."""
    od = t["on_done"]
    out = []
    for e in plan_state(od["plan"])["ledger"].get(od["from_step"]) or []:
        o = task_load(e["task"]) if e["task"] != t["name"] else None
        if o and (include_cancelled or o.get("status") != "cancelled") and o.get("on_done") and o["on_done"].get("from_step") == od["from_step"]:
            out.append(o)
    return out


def process_continuations(a, st=None):
    for n in task_names():
        t = task_load(n)
        if not t or t.get("status") != "done" or not t.get("on_done"):
            continue
        c = t.get("continuation")
        if c and c.get("state") == "running" and now() - c.get("started", now()) > CONT_STALE_S and not a.dry_run:
            close_continuation(n, "FAILED", "the continue agent never returned (pass crashed or timed out)")
            continue
        if c:
            continue
        sib = step_siblings(t)
        waiting = [x for x in sib if x["status"] in TASK_LIVE + TASK_HELD]
        if waiting and completion_policy(t) == "task" and not a.dry_run:  # legacy: one continuation per step
            names = ", ".join(x["name"] for x in waiting)
            if t.get("step_waits_for") != names:
                task_txn(n, lambda t: (t.update(step_waits_for=names), tev(t, "step %s is not done: waiting for task(s) %s" % (t["on_done"]["from_step"], names))))
            continue
        covered = [x["name"] for x in sib if x.get("continuation")]
        if covered and completion_policy(t) == "task" and not a.dry_run:  # group/digest: each task gets its result check
            task_txn(n, lambda t: (t.update(continuation={"state": "closed", "status": "COVERED", "line": "step %s continued by task %s" % (t["on_done"]["from_step"], covered[0]), "closed": now()}),
                                   tev(t, "step %s continued by task %s" % (t["on_done"]["from_step"], covered[0]))))
            continue
        try:
            continue_task(n, a)
        except Exception as e:
            log("plan continuation %s error: %s: %s" % (n, type(e).__name__, str(e)[:200]))

    process_group_wakes(a)


# ---- plans: code written overnight by the continue agent (design: docs/agents/plan-run/WATCHDOG_ON_DONE.md "Night code") ----
# For a step it MAY start (approved, not a stop, never started), the continue agent can write and test new code on a branch
# `monitor/<new-task>` of the plan task's code repo, in a work clone under plans/<id>/work/code-<step>/. Never main, never the real
# repo: the next session reviews the branch and merges it. Every gate is enforced here: only repo folders named in the plan's
# `may_touch` may change, the commit passes py_compile, tests ran green on exactly that commit, the code tarball shipped to NRP is
# built from that commit, and the registered task pins it (code.commit) with a manifest that names the tarball's sha256.
CODE_TEST_TIMEOUT = 1800
CODE_MAX_FILES, CODE_MAX_FILE_BYTES, CODE_SHIP_MAX = 200, 1 << 20, 20 << 20
CODE_NO_TOUCH_TOP = (".git", ".claude", ".agents", ".github")
CODE_NO_TOUCH_NAMES = ("PLAN.md",)           # the plan's own file: only a session changes what the owner approved


def plan_gpu_cover(od):
    """Why a GPU stage of this plan task needs no gpu_ok_until: the plan's approval (with its date) covers GPU stages of its
    approved steps (owner decision 2026-11-06). None when the task is not a plan step or the approval line has no ISO date."""
    if not od:
        return None
    h = plan_header(od["plan"]) or {}
    m = re.search(r"\d{4}-\d{2}-\d{2}", h.get("approval", ""))
    return "plan %s approved %s" % (od["plan"], m.group(0)) if m else None


def cgit(*args, cwd):
    """git for night-code work clones: no hooks (the agent can write into .git), fixed identity."""
    return subprocess.run(["git", *GIT_ID, "-c", "core.hooksPath=/dev/null", *args], cwd=cwd, capture_output=True, text=True, timeout=600)


def code_scope_dirs(h):
    return [u.strip("/") + "/" for u in h["may_touch"] if not u.startswith("s3://") and u.strip("/")]


def code_changes(d):
    """Repo-relative paths that differ from HEAD in work clone `d` (compiled caches ignored); renames list both ends."""
    out, items = [], git("status", "--porcelain", "-z", "--untracked-files=all", cwd=d).stdout.split("\0")
    i = 0
    while i < len(items):
        e = items[i]
        i += 1
        if len(e) < 4:
            continue
        paths = [e[3:]]
        if e[0] in "RC" and i < len(items):
            paths.append(items[i])
            i += 1
        out += [x for x in paths if "__pycache__" not in x.split("/") and not x.endswith(".pyc")]
    return sorted(set(out))


def code_scope_problems(h, files):
    dirs, bad = code_scope_dirs(h), []
    for f in files:
        norm = os.path.normpath(f)
        top = norm.split("/")[0]
        if norm.startswith("..") or os.path.isabs(norm):
            bad.append("%s (outside the repo)" % f)
        elif top in CODE_NO_TOUCH_TOP or os.path.basename(norm) in CODE_NO_TOUCH_NAMES:
            bad.append("%s (never changed overnight)" % f)
        elif not any(norm.startswith(x) for x in dirs):
            bad.append("%s (not under the plan's may_touch repo folders: %s)" % (f, ", ".join(dirs) or "none named"))
    return bad


def code_head(d):
    return cgit("rev-parse", "HEAD", cwd=d).stdout.strip()


def code_need(t):
    cont, od = t.get("continuation") or {}, t.get("on_done") or {}
    if cont.get("state") != "running" or not od:
        sys.exit("code tools are only for the continue agent of a finished plan task")
    cc = cont.get("code")
    return cont, od, cc


def tool_code(n, t, c, rest):
    """nrp-task code-begin STEP NAME | code-test [-k EXPR] [PATH ...] | code-commit MESSAGE | code-ship  (continue agent only)."""
    cont, od, cc = code_need(t)
    h = plan_header(od["plan"])
    if c == "code-begin":
        if len(rest) != 2:
            sys.exit("nrp-task code-begin STEP NEW-TASK-NAME   (STEP = the step you will register; NAME = lowercase, digits, -)")
        step, name = rest
        go, held = next_steps(h, od["from_step"])
        if step not in go:
            sys.exit("code-begin refused: step %r may not be started automatically (%s). Report WAITING instead." %
                     (step, dict(held).get(step, "not a next step of %s" % od["from_step"])))
        if cc:
            sys.exit("code-begin refused: this run already began code for step %s (%s); one code workspace per run" % (cc["step"], cc["name"]))
        if not TASK_RE.match(name) or task_load(name):
            sys.exit("code-begin refused: NAME must match %s and not be an existing task" % TASK_RE.pattern)
        if not t.get("code"):
            sys.exit("code-begin refused: the finished task has no code repo, so there is nothing to build on. Report WAITING (ready for a session).")
        if not code_scope_dirs(h):
            sys.exit("code-begin refused: the plan's may_touch names no repo folder, so no code may be written. Report WAITING.")
        pc = t["code"]
        d = plan_dir(od["plan"]) / "work" / ("code-%s" % step)
        shutil.rmtree(d, ignore_errors=True)
        base = code_head(pc["clone"])
        r = git("clone", "-q", "--no-checkout", pc["clone"], str(d))
        if r.returncode:
            sys.exit("code-begin: clone failed: %s" % r.stderr.strip()[:200])
        folders = sorted({x.strip("/") for x in [pc.get("subdir") or ""] + code_scope_dirs(h) if x.strip("/")})
        if folders:
            cgit("sparse-checkout", "set", "--cone", *folders, cwd=str(d))
        r = cgit("checkout", "-q", "-b", "monitor/" + name, base, cwd=str(d))
        if r.returncode:
            sys.exit("code-begin: checkout failed: %s" % r.stderr.strip()[:200])
        rec = {"step": step, "name": name, "dir": str(d), "branch": "monitor/" + name, "base": base, "subdir": pc.get("subdir") or "",
               "tests": [], "commits": [], "shipped": None}
        task_txn(n, lambda t: (t["continuation"].update(code=rec), tev(t, "night code begun for step %s: branch monitor/%s in %s" % (step, name, d))))
        plan_txn(od["plan"], lambda st: pev(st, "night code begun for step %s by the continue agent of %s: branch monitor/%s (base %s)" % (step, n, name, base[:10])))
        print("work clone: %s   (branch %s at %s, a copy of the task's code, never the real repo)\nYou may change only: %s\n"
              "Write/Edit files there, then: code-test, code-commit MESSAGE, code-ship." % (d, rec["branch"], base[:10], ", ".join(code_scope_dirs(h))))
        return 0
    if not cc:
        sys.exit("%s: run `nrp-task code-begin STEP NAME` first" % c)
    d = cc["dir"]
    sub = Path(d) / cc["subdir"]
    if c == "code-test":
        args, paths, i = [], [], 0
        while i < len(rest):
            if rest[i] == "-k" and i + 1 < len(rest):
                args += ["-k", rest[i + 1]]
                i += 2
                continue
            p = (Path(d) / rest[i]).resolve()
            if rest[i].startswith("-") or not p.exists() or not p.is_relative_to(Path(d).resolve()):
                sys.exit("code-test [-k EXPR] [PATH ...]: PATH = a test file or folder in the work clone, relative to the repo root")
            paths.append(str(p))
            i += 1
        py = os.environ.get("NRP_TASK_PYTHON") or (str(CODE_PYTHON) if CODE_PYTHON and CODE_PYTHON.exists() else sys.executable)
        env = dict(clean_env(), PYTHONPATH=str(sub), PYTHONDONTWRITEBYTECODE="1")
        try:
            r = subprocess.run([py, "-m", "pytest", "-q", "-x", "--no-header", "-p", "no:cacheprovider", *args, *paths], cwd=str(sub), env=env,
                               capture_output=True, text=True, timeout=CODE_TEST_TIMEOUT)
            rc, out = r.returncode, r.stdout + r.stderr
        except subprocess.TimeoutExpired:
            rc, out = 124, "tests timed out after %d s" % CODE_TEST_TIMEOUT
        head, dirty = code_head(d), bool(code_changes(d))
        rec = {"sha": head, "dirty": dirty, "args": " ".join(args + [os.path.relpath(x, d) for x in paths]) or "(all)", "rc": rc, "t": now()}
        task_txn(n, lambda t: (t["continuation"]["code"]["tests"].append(rec), tev(t, "night code test rc=%d on %s%s: %s" % (rc, head[:10], "+uncommitted" if dirty else "", rec["args"][:80]))))
        sys.stdout.write(out[-6000:] + "\n")
        print("code-test: exit %d on commit %s%s" % (rc, head[:10], " (+ uncommitted changes: tests only count once they are committed and re-run)" if dirty else ""))
        return rc
    if c == "code-commit":
        if not rest:
            sys.exit("nrp-task code-commit MESSAGE")
        files = code_changes(d)
        if not files:
            sys.exit("nothing to commit")
        bad = code_scope_problems(h, files)
        if bad:
            sys.exit("code-commit refused: %d file(s) outside what the plan lets the night agent change:\n  - %s\nUndo those edits first." % (len(bad), "\n  - ".join(bad[:10])))
        big = [f for f in files if (Path(d) / f).is_file() and (Path(d) / f).stat().st_size > CODE_MAX_FILE_BYTES]
        if len(files) > CODE_MAX_FILES or big:
            sys.exit("code-commit refused: %d files (limit %d)%s" % (len(files), CODE_MAX_FILES, ", over 1 MiB: " + ", ".join(big[:3]) if big else ""))
        for f in [x for x in files if x.endswith(".py") and (Path(d) / x).is_file()]:
            r = subprocess.run([sys.executable, "-m", "py_compile", str(Path(d) / f)], capture_output=True, text=True)
            if r.returncode:
                sys.exit("py_compile failed for %s: %s" % (f, r.stderr.strip()[-300:]))
        cgit("add", "-A", "--", *files, cwd=d)
        r = cgit("commit", "-qm", "monitor night code (%s, plan %s step %s): %s" % (n, od["plan"], cc["step"], " ".join(rest)[:200]), cwd=d)
        if r.returncode:
            sys.exit("commit failed: %s" % (r.stderr.strip() or r.stdout.strip())[:300])
        sha = code_head(d)
        task_txn(n, lambda t: (t["continuation"]["code"]["commits"].append({"sha": sha, "files": len(files), "msg": " ".join(rest)[:150]}),
                               tev(t, "night code commit %s on %s (%d file(s)): %s" % (sha[:10], cc["branch"], len(files), " ".join(rest)[:120]))))
        print("committed %s on %s (%d file(s): %s). Now re-run code-test on this commit." % (sha[:10], cc["branch"], len(files), ", ".join(files[:6])))
        return 0
    if c == "code-ship":
        head = code_head(d)
        if code_changes(d):
            sys.exit("code-ship refused: uncommitted changes in the work clone (commit them, or undo them, then re-run code-test)")
        if head == cc["base"]:
            sys.exit("code-ship refused: the work clone has no commit of yours; the step reuses the task's code, nothing to ship")
        if not any(x["sha"] == head and x["rc"] == 0 and not x["dirty"] for x in cc["tests"]):
            sys.exit("code-ship refused: no passing code-test on exactly this commit (%s). Run code-test now." % head[:10])
        s3 = [u for u in h["may_touch"] if u.startswith("s3://")]
        if not s3:
            sys.exit("code-ship refused: the plan's may_touch has no s3:// prefix to put the tarball under")
        if not sub.is_dir():
            sys.exit("code-ship refused: %s is not a folder in the work clone" % sub)
        tgz = WORK / "task" / ("%s-code.tgz" % cc["name"])
        tgz.parent.mkdir(parents=True, exist_ok=True)
        ex = [x for p in CODE_SKIP for x in ("--exclude", p)] + [x for e in CODE_SKIP_EXT for x in ("--exclude", "*" + e)]
        r = subprocess.run(["tar", "czf", str(tgz), *ex, "-C", str(sub), "."], capture_output=True, text=True)
        if r.returncode or tgz.stat().st_size > CODE_SHIP_MAX:
            sys.exit("tar failed or archive over %d MiB: %s" % (CODE_SHIP_MAX >> 20, r.stderr.strip()[:200]))
        sha256 = hashlib.sha256(tgz.read_bytes()).hexdigest()
        uri = "%scode/%s-%s.tgz" % (s3[0].rstrip("/") + "/", cc["name"], head[:12])
        u = subprocess.run(aws_cmd() + ["s3", "cp", str(tgz), uri], capture_output=True, text=True, timeout=300, env=aws_env())
        if u.returncode:
            sys.exit("upload of the code tarball failed: %s" % u.stderr.strip()[:200])
        rec = {"uri": uri, "sha256": sha256, "commit": head}
        task_txn(n, lambda t: (t["continuation"]["code"].update(shipped=rec), tev(t, "night code shipped %s (commit %s, sha256 %s)" % (uri, head[:10], sha256[:16]))))
        print("shipped: %s\nsha256: %s\ncommit: %s\nPut the sha256 and the commit in the stage manifest (they pin the code the Job runs); "
              "next-add refuses a manifest that does not contain the sha256." % (uri, sha256, head))
        return 0
    sys.exit("unknown code command %s" % c)



def tool_next_add(n, t, rest):
    """`nrp-task next-add FILE`: the continue agent registers the next plan step. Every gate is checked here, not trusted to the prompt."""
    cont, od = t.get("continuation") or {}, t.get("on_done") or {}
    if cont.get("state") != "running" or not od:
        sys.exit("next-add is only for the continue agent of a finished plan task")
    if len(rest) != 1:
        sys.exit("nrp-task next-add FILE   (a TASK.json you wrote under %s)" % (plan_dir(od["plan"]) / "work"))
    p = Path(rest[0]).expanduser().resolve()
    if not (p.is_relative_to(plan_dir(od["plan"]).resolve() / "work") and p.is_file()):
        sys.exit("FILE must be an existing file under %s" % (plan_dir(od["plan"]) / "work"))
    try:
        raw = load_chain_file(str(p))[0]
    except ChainError as e:
        sys.exit("next-add refused: %s" % e)
    if not isinstance(raw, dict):
        sys.exit("next-add refused: TASK file must be an object")
    h = plan_header(od["plan"])
    step = str((raw.get("on_done") or {}).get("from_step") or "")
    go, held = next_steps(h, od["from_step"], parent=n)
    if step not in go:
        why = dict(held).get(step, "not a next step of %s" % od["from_step"])
        sys.exit("next-add refused: step %r may not be started automatically (%s). Report WAITING instead." % (step, why))
    s3_ok = [u for u in h["may_touch"] if u.startswith("s3://")]
    for s in raw.get("stages") or []:
        for u in list(s.get("done_s3") or []) + list(s.get("after_s3") or []):
            if s3_ok and not any(str(u).startswith(x) for x in s3_ok):
                sys.exit("next-add refused: %s is outside the plan's may_touch (%s)" % (u, ", ".join(s3_ok)))
        m = s.get("manifest")
        if isinstance(m, str) and not Path(m).expanduser().resolve().is_relative_to(plan_dir(od["plan"]).resolve() / "work"):
            sys.exit("next-add refused: manifest %s must be a file you wrote under %s" % (m, plan_dir(od["plan"]) / "work"))
    cc = cont.get("code")
    changed = False
    if cc:
        if step != cc["step"] or raw.get("name") != cc["name"]:
            sys.exit("next-add refused: code was begun for step %s as task %s; the TASK file must be that step and name" % (cc["step"], cc["name"]))
        head = code_head(cc["dir"])
        if code_changes(cc["dir"]):
            sys.exit("next-add refused: uncommitted changes in the code work clone (code-commit, then code-test, code-ship)")
        changed = head != cc["base"]
        if changed:
            sh = cc.get("shipped") or {}
            if not any(x["sha"] == head and x["rc"] == 0 and not x["dirty"] for x in cc["tests"]):
                sys.exit("next-add refused: no passing code-test on exactly the committed code %s" % head[:10])
            if sh.get("commit") != head:
                sys.exit("next-add refused: the shipped tarball is not built from the committed code %s (run code-ship)" % head[:10])
            mans = [Path(x["manifest"]).expanduser() for x in raw.get("stages") or [] if isinstance(x.get("manifest"), str)]
            if not any(m.is_file() and sh["sha256"] in m.read_text() for m in mans):
                sys.exit("next-add refused: no stage manifest contains the shipped code's sha256 %s (the Job would not run the pinned code)" % sh["sha256"][:16])
    hp = raw.get("handoff")
    if isinstance(hp, str) and hp and not handoff_path(hp, str(p)).resolve().is_relative_to(plan_dir(od["plan"]).resolve() / "work"):
        sys.exit("next-add refused: handoff %s must be a file you wrote under %s" % (hp, plan_dir(od["plan"]) / "work"))
    raw["on_done"] = {"plan": od["plan"], "from_step": step}
    raw["approved"] = ("auto-continued by the monitor after task %s, plan %s approved through step %s: %s"
                       % (n, od["plan"], h["approved_through"], h["approval"]))[:1000]
    o = t.get("origin") or {}
    raw["origin"] = {k: o[k] for k in ORIGIN_FIELDS if o.get(k)} or None
    raw.pop("mode", None)
    carry = {k: t["code"][k] for k in ("pkg_dir", "extra_pkg_dirs") if (t.get("code") or {}).get(k)}     # what reship packs stays declared
    if cc:
        raw["code"] = dict({"repo": cc["dir"], "commit": head, "subdir": cc["subdir"]}, **carry)      # pinned: the new task runs exactly this commit
    elif t.get("code"):
        raw["code"] = dict({"repo": t["code"]["clone"], "subdir": (raw.get("code") or {}).get("subdir") or t["code"].get("subdir") or ""}, **carry)
    else:
        raw.pop("code", None)
    rc = task_add_raw(raw, str(p), by="continuation", parent=n)
    task_txn(n, lambda t: t["continuation"].setdefault("registered", []).append(raw["name"]))
    if changed:
        nt = task_load(raw["name"]) or {}
        clone = (nt.get("code") or {}).get("clone", cc["dir"])
        rec = {"step": step, "task": raw["name"], "branch": cc["branch"], "commit": head, "clone": clone, "tarball": (cc.get("shipped") or {}).get("uri"),
               "files": sum(x["files"] for x in cc["commits"]), "t": iso()}
        plan_txn(od["plan"], lambda st: (st.setdefault("code", []).append(rec),
                 pev(st, "night code for step %s registered: branch %s @ %s, task %s, tests green" % (step, cc["branch"], head[:10], raw["name"]))))
        digest("plan-code", "plan %s step %s: night code on branch %s @ %s (%d file(s), tests green, tarball %s). Review and merge in a session: "
               "git fetch %s %s" % (od["plan"], step, cc["branch"], head[:10], rec["files"], rec["tarball"], clone, cc["branch"]), raw["name"])
    return rc


def cmd_plan_sync(a):
    path, _, pid = a.ref.partition("#")
    try:
        h = plan_sync(path, pid)
    except ChainError as e:
        sys.exit("plan refused: %s" % e)
    print("plan %s synced: steps %s; approved through %s; stops for the owner %s; auto-continue is %s"
          % (pid, ", ".join(h["steps"]), h["approved_through"], ", ".join(h["stops"]) or "none", "on" if on_done_enabled() else "OFF"))
    return 0


def plan_names():
    return sorted(p.parent.name for p in PLANS.glob("*/header.json")) if PLANS.is_dir() else []


def plan_line(pid):
    h, st = plan_header(pid) or {}, plan_state(pid)
    return "%s [%s] approved through %s; stops %s; %s%s" % (pid, st["status"], h.get("approved_through", "?"),
           ", ".join(h.get("stops") or []) or "none", "started: " + ", ".join(
           "%s=%s" % (s, e[-1]["task"]) for s, e in st["ledger"].items()) if st["ledger"] else "nothing started",
           ("; waiting: " + st["reason"]) if st.get("reason") else "") + (
           "; night code to review: " + ", ".join("%s@%s (%s)" % (c["branch"], c["commit"][:8], c["clone"]) for c in st["code"]) if st.get("code") else "")


def cmd_plan_list(a):
    names = plan_names()
    print("auto-continue is %s (%s)" % ("on" if on_done_enabled() else "OFF", ON_DONE_FLAG))
    for pid in names:
        print("- " + plan_line(pid))
    if not names:
        print("no plans")
    return 0


def cmd_plan_show(a):
    if not plan_header(a.id):
        sys.exit("no plan %s" % a.id)
    print(plan_line(a.id))
    h = plan_header(a.id)
    print("wake policy: " + h.get("wake", "task"))
    for group, steps in h.get("groups", {}).items():
        members = group_members(a.id, group, h)
        print("group %s steps=%s wake=%s ready=%s members=%s" % (group, ",".join(steps),
              h.get("wake_overrides", {}).get(group, h.get("wake", "task")), group_ready(h, group, members),
              ", ".join(t["name"] + ":" + t["status"] for t in members) or "unregistered"))
    d = plan_dir(a.id)
    print("plan text: %s\nresults: %s" % (d / "plan.md", d / "results.md"))
    for e in plan_state(a.id)["events"][-12:]:
        print("  . " + e)
    return 0


# ---- digest ------------------------------------------------------------------------------------------------------
def needs_owner():
    out = []
    for n in task_names():
        t = task_load(n)
        if t and t["status"] == "NEEDS_OWNER":
            out.append((n, t))
    return out


def coordinating():
    return [(n, t) for n in task_names() for t in [task_load(n)] if t and t["status"] == "WITH_COORDINATOR"]


def ref_label(ref):
    """'task-name · origin title' for digest lines (looked up now, so a backfilled origin also labels old events)."""
    if not ref or ref == "-":
        return ""
    o, _ = lookup_origin(ref)
    return "[%s \u00b7 %s]" % (ref, (o or {}).get("title") or (o or {}).get("link") or ORIGIN_MISSING)


def render_digest(hours):
    cut = now() - hours * 3600
    rows = []
    if DIGEST.exists():
        for l in DIGEST.read_text().splitlines():
            try:
                r = json.loads(l)
                if datetime.fromisoformat(r["t"]).timestamp() >= cut:
                    rows.append(r)
            except Exception:
                pass
    lines = ["# nrp-monitor digest, last %dh (%s)" % (hours, iso()),
             "Sent by the monitor script, not by one chat: each task/chain below names the chat that owns it (origin) when recorded."]
    lines.extend(bad_node_lines())
    nh = needs_owner()
    lines.append("\n## Needs the owner (%d)" % len(nh))
    lines += ["- %s (%s): %s  -> `nrp-monitor task show %s`" % (n, origin_plain(t.get("origin"), "goal: " + t.get("goal", "")[:60]),
                                                               t.get("reason", "")[:300], n) for n, t in nh] or ["- nothing"]
    co = coordinating()
    lines.append("\n## With the coordinator chat, owner not notified (%d)" % len(co))
    lines += ["- %s (%s) for %s: %s  -> `nrp-monitor task show %s`" % (n, origin_plain(t.get("origin"), "goal: " + t.get("goal", "")[:60]),
                                                                        ago(t.get("coordinator_since", now())), t.get("reason", "")[:300], n) for n, t in co] or ["- nothing"]
    live = [(n, task_load(n)) for n in task_names()]
    live = [(n, t) for n, t in live if t and t["status"] in TASK_LIVE]
    lines.append("\n## Running tasks (%d)" % len(live))
    lines += ["- %s [%s] %s  (%s)" % (n, t["status"], ", ".join("%s=%s" % (s["id"], s["state"]) for s in t["stages"]),
                                  origin_plain(t.get("origin"))) for n, t in live] or ["- none"]
    pl = plan_names()
    if pl:
        wait = [p for p in pl if plan_state(p)["status"] == "waiting"]
        lines.append("\n## Plans (auto-continue %s): %d waiting on the owner" % ("on" if on_done_enabled() else "OFF", len(wait)))
        lines += ["- " + plan_line(p) for p in wait + [p for p in pl if p not in wait]]
        night = [r for r in rows if r["kind"].startswith("plan-") or r["kind"] in ("task-done", "result")]
        if night:
            lines.append("Finished, started and stopped in this window:")
            lines += ["- %s %s" % (r["t"][5:16], r["msg"][:260]) for r in night[-20:]]
    # Pending history stays on disk; show each stage's current wait once.
    for n in task_names():
        t = task_load(n)
        if not t or t["status"] not in TASK_LIVE + TASK_HELD:
            continue
        for stage in t["stages"]:
            report = stage.get("pending_report")
            if report and stage["state"] == "running" and not stage.get("pod_started"):
                since = (stage.get("queue_wait") or {}).get("since", stage.get("submitted", now()))
                lines.append("- %s stage %s Pending %s: %s" % (n, stage["id"], ago(since), report["reason"]))
    rows = [r for r in rows if r["kind"] != "pending"]
    cnt = collections.Counter(r["kind"] for r in rows)
    lines.append("\n## Events: " + (", ".join("%s %d" % kv for kv in sorted(cnt.items())) or "none"))
    for r in rows[-60:]:
        lines.append("- %s %-12s %s %s" % (r["t"][5:16], r["kind"], ref_label(r["task"]), r["msg"][:260]))
    days = jwt_days_left()
    if days is not None and days < 7:
        lines.append("\nSlack token expires in %.1f days: renew ~/.ssh/braingeneers_jwt_token.json (mission-control skill)." % days)
    return "\n".join(lines) + "\n"


def cmd_digest(a):
    print(render_digest(a.hours), end="")
    return 0


def daily_digest(a):
    if a.dry_run or datetime.now().hour < 8:
        return
    p = STATE / "digests" / ("%s.md" % datetime.now().strftime("%Y-%m-%d"))
    if p.exists():
        return
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(render_digest(24))
    log("daily digest written: %s" % p)
    wait = [x for x in plan_names() if plan_state(x)["status"] == "waiting"] if on_done_enabled() else []
    if wait:
        push("Morning: %d plan(s) wait on you: %s  (nrp-monitor digest)" % (len(wait), "; ".join(
             "%s: %s" % (x, plan_state(x).get("reason", "")[:90]) for x in wait)), "morning:" + datetime.now().strftime("%Y-%m-%d"))


# ---- task commands (people / registering agents) -----------------------------------------------------------------
def cmd_task_list(a):
    names = task_names()
    if not names:
        print("no tasks")
    for n in names:
        t = task_load(n)
        print("%-12s %-28s %s  retries %d/%d  %s  <%s>" % (t["status"], n, ", ".join("%s=%s" % (s["id"], s["state"]) for s in t["stages"])[:70],
              len(t["attempts"]), t["max_retries"], (t.get("reason") or "")[:80],
              (t.get("origin") or {}).get("title") or ORIGIN_MISSING))
    return 0


def cmd_task_watch(a):
    """Set one task to watch mode only when no monitor pass is running."""
    STATE.mkdir(parents=True, exist_ok=True)
    with open(LOCK, "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print("ERROR monitor pass in progress; try again after it finishes")
            return 1
        if not task_txn(a.name, lambda t: (t.update(mode="watch"), tev(t, "mode set to watch by operator"))):
            print("ERROR no task %s" % a.name)
            return 2
    print("task %s: mode watch" % a.name)
    return 0


def cmd_task_code(a):
    """`task code NAME [--pkg-dir D] [--extra-pkg-dir D ...] [--replace]`: declare the code dirs `nrp-task reship` packs for a task registered
    without them (for example finetune/ from another repo). Relative = inside the task's clone (added to its sparse checkout), absolute = another checkout."""
    t = task_load(a.name)
    if not t or not t.get("code"):
        sys.exit("no task %s with a code clone" % a.name)
    code = dict(t["code"])
    if a.pkg_dir:
        code["pkg_dir"] = a.pkg_dir
    new = list(a.extra_pkg_dir or [])
    code["extra_pkg_dirs"] = new if a.replace else list(code.get("extra_pkg_dirs") or []) + [x for x in new if x not in (code.get("extra_pkg_dirs") or [])]
    bad = code_dirs_check(code)
    if bad:
        sys.exit("task code refused: " + "; ".join(bad))
    clone = Path(code["clone"])
    for x in code["extra_pkg_dirs"]:
        if not os.path.isabs(os.path.expanduser(x)) and not (clone / x).is_dir() and code.get("subdir"):
            git("sparse-checkout", "add", x, cwd=str(clone))
            git("checkout", "-q", cwd=str(clone))
        if not os.path.isabs(os.path.expanduser(x)) and not (clone / x).is_dir():
            sys.exit("task code refused: %s is not in the task's code clone %s (it must be committed in %s)" % (x, clone, code["repo"]))
    try:
        reship_dirs(code)
    except ChainError as e:
        sys.exit("task code refused: %s" % e)
    if not task_txn(a.name, lambda t: (t["code"].update({k: code[k] for k in ("pkg_dir", "extra_pkg_dirs") if code.get(k)}),
                                      tev(t, "code dirs declared by operator: pkg %s, extra %s" % (code.get("pkg_dir") or "default", ", ".join(code["extra_pkg_dirs"]) or "none")))):
        sys.exit("no task %s" % a.name)
    print("task %s: reship packs %s%s" % (a.name, code.get("pkg_dir") or "predictor_v3 (default)", " + " + ", ".join(code["extra_pkg_dirs"]) if code["extra_pkg_dirs"] else ""))
    return 0


def cmd_task_stage(a):
    """`task stage NAME STAGE --resumable`: mark a stage of an already registered task as resumable (re-running it skips finished items),
    so Tier 0 may resubmit it once with 2x deadline after a timeout. Same effect as `resumable: true` in TASK.json at `task add`."""
    t = task_load(a.name)
    if not t:
        sys.exit("no task %s" % a.name)
    if not any(s["id"] == a.stage for s in t["stages"]):
        sys.exit("task %s has no stage %s (stages: %s)" % (a.name, a.stage, ", ".join(s["id"] for s in t["stages"])))
    nodes = getattr(a, "exclude_node", None) or []
    if not a.resumable and not nodes:
        sys.exit("nothing to change: pass --resumable or --exclude-node NODE")
    for node in nodes:
        if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9.-]{0,252}", node):
            sys.exit("invalid node name")
    if nodes:
        doc = manifest_doc(tstage(t, a.stage)["manifest"])
        for node in nodes:
            exclude_node(doc, node)
        manifest_write(tstage(t, a.stage)["manifest"], doc)
    if not a.resumable:
        print("stage %s: excluded %s" % (a.stage, ", ".join(nodes)))
        return 0

    def mark(t):
        tstage(t, a.stage)["resumable"] = True
        tev(t, "stage %s marked resumable by operator (Tier 0 may resubmit it once with 2x deadline after a timeout)" % a.stage)
    if not task_txn(a.name, mark):
        sys.exit("no task %s" % a.name)
    print("task %s: stage %s is resumable" % (a.name, a.stage))
    return 0


def cmd_task_show(a):
    t = task_load(a.name)
    if not t:
        sys.exit("no task %s" % a.name)
    print("%s [%s] mode=%s ns=%s created %s ago  retries %d/%d" % (t["name"], t["status"], t["mode"], t["namespace"], ago(t["created"]),
          len(t["attempts"]), t["max_retries"]))
    print("goal: %s\napproved: %s\norigin: %s" % (t["goal"], t["approved"], origin_plain(t.get("origin"), "no chat recorded; goal and code repo above identify it")))
    for old in t.get("origin_history", []):
        print("previous origin (%s): %s" % (old.get("replaced_at", "?"), origin_plain(old)))
    if t.get("reason"):
        print("reason: " + t["reason"])
    if (t.get("code") or {}).get("extra_pkg_dirs") or (t.get("code") or {}).get("pkg_dir"):
        print("code dirs reship packs: pkg %s; extra %s" % (t["code"].get("pkg_dir") or "default", ", ".join(t["code"].get("extra_pkg_dirs") or []) or "none"))
    print("postcheck: " + json.dumps(t.get("postcheck_result")))
    print("stage outputs: " + json.dumps({s["id"]: s.get("outputs", {}) for s in t["stages"]}))
    print("decisions: " + json.dumps(decisions(a.name)))
    if t.get("failure"):
        f = t["failure"]
        print("fingerprint: " + (f.get("fingerprint") or fingerprint(t, f)))
        print("failure: stage %s [%s] %s\n  logs: %s" % (f["stage"], f["cls"], f["detail"], f.get("logs")))
    uw = t.get("util_waivers") or []
    if uw:
        print("util waivers: %d of %d used" % (len(uw), util_waiver_max()))
        for w in uw[-5:]:
            print("  util waiver %s %s until %s (given %s): %s" % ("ACTIVE" if waiver_active(t, w) else "ended", w.get("job", "?"), iso(w["until"]) if w.get("until") else "?",
                  iso(w["at"]) if w.get("at") else "?", (w.get("reason") or "")[:200]))
    for s in t["stages"]:
        print("  %-14s %-8s %s attempt %d  %s" % (s["id"], s["state"], s["job"], s.get("attempt", 1), s["manifest"]))
        if s["state"] == "pending" and s.get("after_s3"):                 # gate on another task's success marker
            for u in (s["waiting_on"] if "waiting_on" in s else s["after_s3"]):
                print("      waiting-on %s" % u)
    for x in t["attempts"]:
        print("  retry: %s [%s] %s -> %s" % (x["job"], x["cls"], x["detail"][:100], x["fix"][:120] + " fp=" + str(x.get("fingerprint"))))
    for r in t.get("agent_runs", [])[-3:]:
        print("  agent %s %s cost=%s denials=%s: %s" % (iso(r["ts"])[5:16], r["kind"], r.get("cost"), r.get("denials"), r["result"][:200]))
    if t.get("code"):
        print("code: %s branch %s (base %s)" % (t["code"]["clone"], t["code"]["branch"], t["code"]["base"][:10]))
    h = t.get("handoff")
    if h:
        try:
            secs = handoff_split((task_dir(t["name"]) / "handoff.md").read_text())
            ent = {k: len(re.findall(r"(?m)^### ", handoff_body(secs, k) or "")) for k in HANDOFF_HEADS[1:]}
            ok = "Registrar intact" if handoff_sha(secs) == h["registrar_sha256"] else "REGISTRAR CHANGED (restored at the next append)"
            print("handoff: accepted%s, %s, %d characters in the Registrar; entries: fix log %d, continuation %d, for the owner %d  (%s)"
                  % (" (thin)" if h.get("thin") else "", ok, handoff_chars(handoff_body(secs, "Registrar")), ent["Fix log"], ent["Continuation"],
                     ent["For the owner"], task_dir(t["name"]) / "handoff.md"))
        except OSError:
            print("handoff: recorded but %s is missing" % (task_dir(t["name"]) / "handoff.md"))
    else:
        print("handoff: none (no file accepted at task add)")
    for e in t.get("events", [])[-6:]:
        print("  . " + e)
    return 0


def cmd_task_resume(a):
    """After the owner decides: clear NEEDS_OWNER; the failed stage is resubmitted next pass (or --skip it), budgets restart."""
    msgs, skipped, again, who = [], [], [], ["a person"]

    def f(t):
        del skipped[:], again[:]
        if t["status"] not in ("NEEDS_OWNER", "WITH_COORDINATOR", "blocked"):
            msgs.append("task %s is %s; only NEEDS_OWNER, WITH_COORDINATOR or blocked can be resumed" % (t["name"], t["status"]))
            return False
        who[0] = "the coordinator chat" if t["status"] == "WITH_COORDINATOR" else "a person"
        t["webhook_outbox"] = [e for e in t.get("webhook_outbox") or [] if e.get("event_type") != "escalation"]   # the question is answered
        t.pop("queue_hold", None)
        for s in t["stages"]:
            q = s.get("queue_wait") or {}
            if q.get("fired") and q.get("attempt") == s.get("attempt", 1):
                q.update(fired=False, multiplier=q.get("multiplier", 1) * 2)
            if s["state"] == "failed":
                s["state"] = "done" if s["id"] in (a.skip or []) else "pending"
                s["attempt"] = s.get("attempt", 1) + (0 if s["state"] == "done" else 1)
                (skipped if s["state"] == "done" else again).append(s["id"])
        if getattr(a, "decide", None) and t.get("failure"):
            record_decision(t, t["failure"].get("fingerprint") or fingerprint(t, t["failure"]), a.decide, a.note or "resume decision")
        if t.get("failure"):
            cost_event(t["name"], "coordinator_resolution", "coordinator", "resolved", stage=t["failure"]["stage"],
                       fingerprint=t["failure"].get("fingerprint") or fingerprint(t, t["failure"]))
            t["attempts"].append(dict(stage=t["failure"]["stage"], job=t["failure"]["job"], cls=t["failure"]["cls"], sig=t["failure"]["sig"], fingerprint=t["failure"].get("fingerprint") or fingerprint(t, t["failure"]),
                                      detail=t["failure"]["detail"][:200], fix="resumed by %s: %s" % (who[0], a.note or ""), by="person", ts=now()))
        t["failure"], t["status"], t["reason"] = None, "running", ""
        t["budget_from"] = len(t["attempts"])
        if a.retries is not None:
            t["max_retries"] = a.retries
        if getattr(a, "gpu_ok_until", None):
            for s in t["stages"]:
                if s["state"] != "done" and s.get("manifest") and manifest_gpu(s["manifest"]):
                    s["gpu_ok_until"] = a.gpu_ok_until
        if a.note and a.note.strip():
            t.setdefault("resume_notes", []).append(dict(note=a.note, ts=now(), skipped=list(skipped)))
            handoff_append(t, "%s | coordinator | resume note" % iso(now()),
                           [("Fix log", handoff_clean(a.note, HANDOFF_ENTRY_MAX))])
        tev(t, "resumed by %s%s" % (who[0], ": " + a.note if a.note else ""))
    if not task_txn(a.name, f):
        sys.exit(msgs[0] if msgs else "no task %s" % a.name)
    said = (["skipped (marked done): %s" % ", ".join(skipped)] if skipped else []) + (
        ["the next pass resubmits %s from %s/manifests" % (", ".join(again), task_dir(a.name))] if again else [])
    print("task %s resumed; %s" % (a.name, "; ".join(said) or "no failed stage; pending stages run as usual"))
    return 0


def cmd_task_needs_owner(a):
    """`task needs-owner NAME --reason TEXT`: what the task's coordinator chat runs when the owner is truly needed. Sets NEEDS_OWNER and sends
    the one DM (the same path as every other stop). Nothing else tells the owner about a task that is WITH_COORDINATOR."""
    t = task_load(a.name)
    if not t:
        sys.exit("no task %s" % a.name)
    if t["status"] in ("done", "cancelled"):
        sys.exit("task %s is %s; nothing to hand to the owner" % (a.name, t["status"]))
    if t["status"] == "NEEDS_OWNER":
        sys.exit("task %s is already NEEDS_OWNER (reason: %s)" % (a.name, t.get("reason", "")[:200]))
    if len(a.reason.strip()) < 8:
        sys.exit("--reason: say what the owner must decide (at least a short sentence)")
    escalate(a.name, "the coordinator chat needs you: " + a.reason.strip(), None)
    print("task %s is NEEDS_OWNER; the owner was sent one DM. They continue it with `nrp-monitor task resume %s`" % (a.name, a.name))
    return 0


def cmd_task_handoff(a):
    """`task handoff NAME FILE`: attach the handoff to a task registered without one (the registering agent writes it after the monitor is
    started). Same checks as the `handoff` field of `task add`; a missing or empty file is an error here. The Registrar is written once:
    a task that has a handoff keeps it."""
    t = task_load(a.name)
    if not t:
        sys.exit("no task %s" % a.name)
    if t.get("handoff"):
        sys.exit("task %s already has a handoff: the Registrar is written once and agents only add to the other sections" % a.name)
    try:
        text, thin, why = handoff_load(a.file, str(Path.cwd() / "x"))
    except ChainError as e:
        sys.exit("handoff refused: %s" % e)
    if text is None:
        sys.exit("handoff refused: %s" % why)
    if thin and os.environ.get("NRP_MONITOR_REQUIRE_HANDOFF"):
        sys.exit("handoff refused: %s" % why)
    if thin:
        print("warning: %s; fix agents will have little to go on" % why, file=sys.stderr)
    elif handoff_escalation_missing(text):
        print("warning: the handoff does not say how failures are handled. " + HANDOFF_ESC_ASK, file=sys.stderr)
    src = handoff_path(a.file, str(Path.cwd() / "x"))

    def attach(t):
        if t.get("handoff"):
            return False
        handoff_attach(t, text, thin, src)
    if not task_txn(a.name, attach):
        sys.exit("task %s changed while attaching; run `nrp-monitor task show %s`" % (a.name, a.name))
    print("handoff attached to %s (copy: %s)" % (a.name, task_dir(a.name) / "handoff.md"))
    return 0


def cmd_task_cancel(a):
    if not task_txn(a.name, lambda t: (t.update(status="cancelled"), tev(t, "cancelled by a person"))):
        sys.exit("no task %s" % a.name)
    print("task %s cancelled; nothing deleted" % a.name)
    return 0


def cmd_origin(a):
    """Metadata-only: record (or show) which chat owns a task/chain/legacy job. Same locks as the runner; no state, approval,
    submission or ownership changes. Refuses to overwrite an existing origin without --replace; --evidence is required."""
    chat = getattr(a, "chat", None)
    if chat:
        chat = chat.strip().strip("<>")
        if re.fullmatch(r"t3-thread://v2/[^/]+/[^/]+", chat):
            a.harness, a.link = "t3", chat
        elif a.harness in ("claude", "codex"):
            a.session = chat
        else:
            sys.exit("--chat needs a T3 v2 link or --harness claude|codex for a session id")
    flags = {k: getattr(a, k) for k in ("title", "link", "assistant", "collaborator", "note", "harness", "session", "cwd") if getattr(a, k)}
    if flags.get("harness") in ("claude", "codex"):                     # same defaults as `task add --origin-harness`
        flags.setdefault("session", detect_session(flags["harness"]))
        flags.setdefault("cwd", os.getcwd())
    kind, name = a.kind, a.name
    if not flags:
        cur = {"task": lambda: (task_load(name) or {}).get("origin"), "chain": lambda: (chain_load(name) or {}).get("origin"),
               "job": lambda: (load()["jobs"].get(name) or {}).get("origin")}[kind]()
        print("%s %s origin: %s" % (kind, name, origin_plain(cur)))
        return 0
    if not a.evidence:
        sys.exit("--evidence is required: say how the owning chat was verified (e.g. 'T3 thread_read 2026-11-05 title+link; task code repo is its worktree'). Never guess.")
    try:
        new = norm_origin(dict(flags, evidence=a.evidence), source="backfilled %s" % datetime.now().date().isoformat())
    except ChainError as e:
        sys.exit("origin refused: %s" % e)
    msgs = []

    def apply(rec, log_fn):
        old = rec.get("origin")
        if old and not a.replace:
            msgs.append("%s %s already has origin %s; use --replace to change it" % (kind, name, origin_plain(old)))
            return False
        if old:
            new["collaborator"] = flags.get("collaborator") or old.get("collaborator", OWNER_NAME)
            changed_chat = any(k in flags and flags[k] != old.get(k) for k in ("link", "session"))
            if not changed_chat:
                for k in ("assistant", "title", "link", "harness", "session", "cwd"):
                    if k not in flags and old.get(k):
                        new[k] = old[k]
            rec.setdefault("origin_history", []).append(dict(old, replaced_at=iso(), replacement_evidence=a.evidence,
                                                             by=getattr(a, "by", None) or os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("CODEX_THREAD_ID") or "cli"))
        rec["origin"] = new
        by = getattr(a, "by", None) or os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("CODEX_THREAD_ID") or "cli"
        log_fn("origin %s -> %s by %s (evidence: %s)" % (origin_plain(old), origin_plain(new), by, a.evidence))
    if kind == "task":
        ok = task_txn(name, lambda t: apply(t, lambda m: tev(t, m)))
    elif kind == "chain":
        ok = chain_txn(name, lambda c: apply(c, lambda m: ev(c, m)))
    else:
        with state_lock():
            st = load()
            rec = st["jobs"].get(name)
            ok = False
            if rec is not None:
                ok = apply(rec, lambda m: log("job %s: %s" % (name, m))) is not False
                if ok:
                    save(st)
    if not ok:
        sys.exit(msgs[0] if msgs else "no %s named %s" % (kind, name))
    print("%s %s origin recorded: %s" % (kind, name, origin_plain(new)))
    return 0


# ---- nrp-task: the fix agent's only shell tool -------------------------------------------------------------------
def reship_dirs(code):
    """(primary package dir, [extra package dirs]) that `nrp-task reship` packs: everything the task's code declares.
    Primary = code.pkg_dir, else code.subdir when it is the predictor_v3 folder, else <clone>/predictor_v3. Extras = code.extra_pkg_dirs
    (relative = inside the clone, absolute = another checkout read in place). Raises ChainError when something declared is missing."""
    clone = Path(code["clone"])

    def res(x):
        p = Path(os.path.expanduser(x))
        return p if p.is_absolute() else clone / x
    if code.get("pkg_dir"):
        pkg = res(code["pkg_dir"])
    else:
        sub = clone / (code.get("subdir") or "")
        pkg = sub if sub.name == "predictor_v3" else clone / "predictor_v3"
    if not pkg.is_dir() or pkg.name != "predictor_v3":
        raise ChainError("needs the predictor_v3 package folder (code.subdir, <clone>/predictor_v3, or code.pkg_dir); got %s" % pkg)
    extras = [res(x) for x in code.get("extra_pkg_dirs") or []]
    for x in extras:
        if not x.is_dir():
            raise ChainError("code.extra_pkg_dirs: %s does not exist in the clone (commit it, or check the path)" % x)
    return pkg.resolve(), [x.resolve() for x in extras]


def cmd_tool(a):
    if any(x in ("--help", "-h") for x in a.rest):
        print("Usage: NRP_TASK=<name> nrp-task show|logs JOB|describe JOB|util JOB|s3 ls URI|reship JOB|submit JOB --reason TEXT\n"
              "Coordinator chats must select a task with NRP_TASK; use nrp-monitor task list to find it.")
        return 0
    n = os.environ.get("NRP_TASK", "")
    t = task_load(n)
    if not t:
        sys.exit("nrp-task: use NRP_TASK=<name> nrp-task ...; live tasks: " + ", ".join(
            n for n in task_names() if (task_load(n) or {}).get("status") in TASK_LIVE))
    argv, ns = a.rest, t["namespace"]
    jobs = {s["job"]: s for s in t["stages"]}
    usage = ("nrp-task show | logs JOB [--tail N] | describe JOB | util JOB | s3 ls URI | s3 cat URI | configmap NAME [--from SUBDIR] | "
             "reship JOB | commit MESSAGE | submit JOB --reason TEXT | delete JOB | plan | next-add FILE | "
             "code-begin STEP NAME | code-test [-k EXPR] [PATH ...] | code-commit MESSAGE | code-ship | "
             "report RESUBMITTED|STOPPED|DONE|CONTINUED|WAITING|NOT-DONE TEXT")
    if not argv:
        sys.exit(usage)
    c, rest = argv[0], argv[1:]
    if os.environ.get("NRP_MONITOR_AGENT_ROLE") == "triage" and c not in ("show", "logs", "describe", "util", "s3"):
        sys.exit("triage is judge only; changes belong to the fixer")

    def need_job():
        if not rest or rest[0] not in jobs:
            sys.exit("nrp-task %s: JOB must be one of this task's Jobs: %s" % (c, ", ".join(jobs)))
        return rest[0]

    def kc(*args):
        r = kubectl("-n", ns, *args, timeout=180)
        sys.stdout.write(r.stdout[-60000:])
        sys.stderr.write(r.stderr[-2000:])
        return r.returncode

    if c == "decide":
        parser = argparse.ArgumentParser(prog="nrp-task decide")
        parser.add_argument("fingerprint")
        parser.add_argument("--action", choices=DECISION_ACTIONS, required=True)
        parser.add_argument("--why", required=True)
        parser.add_argument("--max-uses", type=int)
        args = parser.parse_args(rest)
        task_txn(n, lambda task: record_decision(task, args.fingerprint, args.action, args.why, "task", args.max_uses, os.environ.get("NRP_MONITOR_AGENT_ROLE", "agent")))
        return 0
    if c == "apply-decision":
        if not apply_decision(n, argparse.Namespace(dry_run=False)):
            sys.exit("decision not applicable or refused by budgets/markers")
        return 0
    if c == "retry-cap":
        if os.environ.get("NRP_MONITOR_AGENT_ROLE") != "deputy" or len(rest) != 1 or not rest[0].isdigit():
            sys.exit("retry-cap is deputy-only: N")
        value = int(rest[0])
        if not t["max_retries"] <= value <= scaled_retry_cap(t["stages"]):
            sys.exit("retry-cap exceeds scaled cap or lowers the existing cap")
        task_txn(n, lambda task: task.update(max_retries=value))
        return 0
    if c == "show":
        return cmd_task_show(argparse.Namespace(name=n))
    if c == "logs":
        j = need_job()
        tail = rest[rest.index("--tail") + 1] if "--tail" in rest else "200"
        if not tail.isdigit():
            sys.exit("--tail N")
        saved = sorted((task_dir(n) / "logs").glob(j + "-a*.txt"))
        if t["status"] == "done" and saved:
            print("\n".join(saved[-1].read_text().splitlines()[-int(tail):]))
            return 0
        rc = kc("logs", "job/" + j, "--all-containers", "--tail=" + tail)
        if rc:
            print("(live logs unavailable; saved logs: %s)" % ", ".join(str(p) for p in sorted((task_dir(n) / "logs").glob(j + "-a*.txt"))))
        return 0
    if c == "describe":
        j = need_job()
        kc("describe", "job", j)
        return kc("describe", "pods", "-l", "job-name=" + j)
    if c == "util":
        j = need_job()
        r = subprocess.run(["nrp-util-check", "-n", ns, "--min-age", "0", j + "-"], capture_output=True, text=True, timeout=300)
        print(r.stdout.strip() or r.stderr.strip())
        return 0
    if c == "postcheck":
        if rest:
            sys.exit("postcheck takes no arguments; only the declared command may run")
        result = run_postcheck(t)
        print(json.dumps(result))
        return 0 if result["ok"] else 1
    if c == "s3" and rest[:1] == ["cp"]:
        if len(rest) != 3:
            sys.exit("s3 cp URI DEST")
        uri, dest = rest[1:]
        h = plan_header((t.get("on_done") or {}).get("plan")) or {}
        if not any(uri.startswith(prefix.rstrip("/") + "/") for prefix in h.get("may_touch", []) if prefix.startswith("s3://")):
            sys.exit("source outside plan may_touch")
        if dest.startswith("s3://"):
            if not any(dest.startswith(prefix.rstrip("/") + "/") for prefix in h.get("may_touch", []) if prefix.startswith("s3://")):
                sys.exit("destination outside plan may_touch")
            target = dest
        else:
            root = (task_dir(n) / "downloads").resolve()
            target = Path(dest).resolve()
            if not target.is_relative_to(root):
                sys.exit("destination must be under task downloads")
        if not s3_split(uri) or (dest.startswith("s3://") and not s3_split(dest)):
            sys.exit("copy requires exact object URIs")
        bucket, key = s3_split(uri)
        head = subprocess.run(aws_cmd() + ["s3api", "head-object", "--bucket", bucket, "--key", key],
                              capture_output=True, text=True, timeout=120, env=aws_env())
        try:
            size = json.loads(head.stdout)["ContentLength"]
        except (ValueError, KeyError):
            sys.exit("cannot verify small object size")
        if head.returncode or not isinstance(size, int) or not 0 <= size <= 256 * 1024:
            sys.exit("copy limited to objects up to 256 KiB")
        if isinstance(target, Path):
            target.parent.mkdir(parents=True, exist_ok=True)
        result = subprocess.run(aws_cmd() + ["s3", "cp", uri, str(target)], capture_output=True, text=True, timeout=120, env=aws_env())
        print(result.stdout[-1000:])
        return result.returncode
    if c == "s3":
        if len(rest) != 2 or rest[0] not in ("ls", "cat"):
            sys.exit("nrp-task s3 ls|cat s3://bucket/key")
        r = subprocess.run(["nrp-s3-read", rest[0], rest[1]], capture_output=True, text=True, timeout=300)
        sys.stdout.write(r.stdout)
        sys.stderr.write(r.stderr[-1000:])
        return r.returncode
    if c == "configmap":
        if not t.get("code"):
            sys.exit("this task has no code clone")
        if not rest or not re.match(r"^%s-[a-z0-9-]{1,40}$" % re.escape(n), rest[0]):
            sys.exit("configmap NAME must be %s-<suffix> (lowercase)" % n)
        sub = rest[rest.index("--from") + 1] if "--from" in rest else (t["code"].get("subdir") or ".")
        src = (Path(t["code"]["clone"]) / sub).resolve()
        if not src.is_dir() or not src.is_relative_to(Path(t["code"]["clone"]).resolve()):
            sys.exit("--from must be a folder inside the clone")
        tgz = WORK / "task" / ("%s.tgz" % rest[0])
        tgz.parent.mkdir(parents=True, exist_ok=True)
        ex = [x for p in CODE_SKIP for x in ("--exclude", p)] + [x for e in CODE_SKIP_EXT for x in ("--exclude", "*" + e)]
        r = subprocess.run(["tar", "czf", str(tgz), *ex, "-C", str(src), "."], capture_output=True, text=True)
        if r.returncode or tgz.stat().st_size > 900 * 1024:
            sys.exit("tar failed or archive over 900 KB (ConfigMap limit 1 MB): %s" % r.stderr.strip()[:200])
        rc = kc("create", "configmap", rest[0], "--from-file=code.tgz=%s" % tgz)
        if rc == 0:
            task_txn(n, lambda t: tev(t, "configmap %s built from %s" % (rest[0], sub)))
        return rc
    if c == "reship":
        # pv3 Jobs run code shipped through S3 (spec.json -> code.uri), not code baked into the manifest: a fix in the clone
        # reaches the Job only when the clone's predictor_v3/ is packed like `--ship-code`, uploaded, and spec.json points at it.
        j = need_job()
        if not t.get("code"):
            sys.exit("this task has no code clone")
        if job_state(j, ns) in ("running", "pending"):
            sys.exit("Job %s is still running; reship only for a finished, failed or deleted Job" % j)
        spec_uri = pv3_spec_uri(jobs[j]["manifest"])
        if not spec_uri:
            sys.exit("Job %s does not run from an S3 spec (no `--spec s3://...` in its command): nothing to reship" % j)
        try:
            pkg, extras = reship_dirs(t["code"])
        except ChainError as e:
            sys.exit("reship refused: %s" % e)
        r = subprocess.run(aws_cmd() + ["s3", "cp", spec_uri, "-"], capture_output=True, text=True, timeout=180, env=aws_env())
        try:
            spec = json.loads(r.stdout)
            old = spec["code"]["uri"]
        except Exception:
            sys.exit("cannot read %s with a `code` entry (aws rc=%d %s)" % (spec_uri, r.returncode, r.stderr.strip()[:150]))
        tgz = WORK / "task" / ("%s-reship.tgz" % j)
        tgz.parent.mkdir(parents=True, exist_ok=True)
        py = os.environ.get("NRP_TASK_PYTHON") or (str(CODE_PYTHON) if CODE_PYTHON and CODE_PYTHON.exists() else sys.executable)
        # the same `codeship.build` the original --ship-code used, from the package's own checkout; extra dirs are packed beside
        # predictor_v3/ exactly as at submission (PV3_CODE_EXTRA_PACKAGES layout), so the pod's imports resolve the same way
        snippet = ("import json,sys,pathlib; pkg,out=sys.argv[1:3]; extras=[pathlib.Path(x) for x in sys.argv[3:]]; "
                   "sys.path.insert(0,str(pathlib.Path(pkg).parent)); "
                   "from predictor_v3.utils.jobs import codeship; "
                   "b=codeship.build(pathlib.Path(pkg), **({'extra_pkg_dirs': tuple(extras)} if extras else {})); "
                   "pathlib.Path(out).write_bytes(b.data); print(json.dumps({'sha256':b.sha256,'n':b.n_files,'skipped':list(b.skipped)}))")
        b = subprocess.run([py, "-c", snippet, str(pkg), str(tgz), *map(str, extras)], capture_output=True, text=True, timeout=300,
                           cwd=str(pkg.parent), env=dict(clean_env(), PYTHONPATH=str(pkg.parent)))
        if b.returncode:
            sys.exit("could not pack the task's code (%s): %s" % (", ".join(x.name for x in [pkg] + extras), (b.stderr.strip() or b.stdout.strip())[-400:]))
        info = json.loads(b.stdout.strip().splitlines()[-1])
        new_uri = old.rsplit("/", 1)[0] + "/%s.tgz" % info["sha256"][:16]
        if info["sha256"] == spec["code"].get("sha256"):
            print("the task's code (%s) is identical to what %s already runs (%s); nothing to reship"
                  % (", ".join(x.name for x in [pkg] + extras), j, info["sha256"][:16]))
            return 0
        for src, dst in ((str(tgz), new_uri),):
            u = subprocess.run(aws_cmd() + ["s3", "cp", src, dst], capture_output=True, text=True, timeout=300, env=aws_env())
            if u.returncode:
                sys.exit("upload of the code tarball failed: %s" % u.stderr.strip()[:200])
        spec["code"] = {"uri": new_uri, "sha256": info["sha256"]}
        u = subprocess.run(aws_cmd() + ["s3", "cp", "-", spec_uri], input=json.dumps(spec, sort_keys=True, indent=2),
                           capture_output=True, text=True, timeout=180, env=aws_env())
        if u.returncode:
            sys.exit("could not rewrite %s: %s" % (spec_uri, u.stderr.strip()[:200]))
        task_txn(n, lambda t: tev(t, "reshipped code for %s: %s (%d files; dirs %s) -> %s" % (j, info["sha256"][:16], info["n"], ", ".join(x.name for x in [pkg] + extras), spec_uri)))
        print("reshipped: %s now runs code %s (%d files from %s%s); spec %s rewritten. Resubmit with `nrp-task submit %s --reason ...`."
              % (j, info["sha256"][:16], info["n"], ", ".join(x.name for x in [pkg] + extras), ", left out for size: %s" % ", ".join(info["skipped"]) if info["skipped"] else "", spec_uri, j))
        return 0
    if c == "commit":
        if not t.get("code") or not rest:
            sys.exit("nrp-task commit MESSAGE (task needs a code clone)")
        cl = t["code"]["clone"]
        changed = git("status", "--porcelain", cwd=cl).stdout.splitlines()
        py = [l[3:].strip() for l in changed if l[3:].strip().endswith(".py")]
        for f in py:
            r = subprocess.run([sys.executable, "-m", "py_compile", str(Path(cl) / f)], capture_output=True, text=True)
            if r.returncode:
                sys.exit("py_compile failed for %s: %s" % (f, r.stderr.strip()[-300:]))
        if not changed:
            sys.exit("nothing to commit")
        git("add", "-A", cwd=cl)
        r = git("commit", "-qm", "monitor fix (%s): %s" % (n, " ".join(rest)[:200]), cwd=cl)
        sha = git("rev-parse", "--short", "HEAD", cwd=cl).stdout.strip()
        task_txn(n, lambda t: tev(t, "fix commit %s: %s" % (sha, " ".join(rest)[:150])))
        print("committed %s on %s (%d file(s)); compiled: %s" % (sha, t["code"]["branch"], len(changed), ", ".join(py) or "none"))
        return r.returncode
    if c == "submit":
        j = need_job()
        if "--reason" not in rest or rest.index("--reason") + 1 >= len(rest):
            sys.exit("nrp-task submit JOB --reason 'cause -> fix'")
        ok, msg = do_submit(n, jobs[j]["id"], rest[rest.index("--reason") + 1], "agent")
        print(msg)
        return 0 if ok else 1
    if c == "delete":
        j = need_job()
        st_, f = job_state(j, ns), t.get("failure") or {}
        util = t.get("util_event") or {}
        util_retry = util.get("job") == j and st_ in ("running", "pending")
        if util_retry:
            evidence = util.get("evidence") or {}
            if not stage_resumable(jobs[j]) or (evidence.get("remaining_seconds") or 0) - max(0, now() - util.get("ts", now())) <= 7200:
                sys.exit("utilization review: leave running Job to finish; resubmit requires resumable stage and >2h measured time left")
            f = util
        if st_ in ("running", "pending") and not (f.get("job") == j and f.get("cls") in ("util", "infra")):
            sys.exit("Job %s is %s; only a finished Job, or one this task's failure says to stop (util/stuck), may be deleted" % (j, st_))
        save_task_logs(t, jobs[j], "deleted by the fix agent")
        rc = kc("delete", "job", j, "--wait=true", "--timeout=180s")
        if rc == 0 and util_retry:
            task_fail(n, jobs[j]["id"], "util", util["sig"], util["detail"], extra={"evidence": util.get("evidence")})
        task_txn(n, lambda t: tev(t, "agent deleted Job %s (was %s)" % (j, st_)))
        return rc
    if c == "plan":
        od = t.get("on_done")
        if not od:
            sys.exit("this task belongs to no plan")
        h = plan_header(od["plan"])
        go, held = next_steps(h, od["from_step"])
        print("plan %s, this task ran step %s. Approved through %s. Stops for the owner: %s. may_touch: %s"
              % (od["plan"], od["from_step"], h["approved_through"], ", ".join(h["stops"]) or "none", ", ".join(h["may_touch"]) or "-"))
        print("may start now: %s" % (", ".join(go) or "nothing"))
        for x in held:
            print("held: step %s (%s)" % x)
        print("plan text: %s   templates: %s   write next TASK files under: %s"
              % (plan_dir(od["plan"]) / "plan.md", plan_dir(od["plan"]) / "files", plan_dir(od["plan"]) / "work"))
        return 0
    if c == "next-add":
        return tool_next_add(n, t, rest)
    if c in ("code-begin", "code-test", "code-commit", "code-ship"):
        return tool_code(n, t, c, rest)
    if c == "report":
        kinds = ("CONTINUED", "WAITING", "NOT-DONE", "STOPPED") if (t.get("continuation") or {}).get("state") == "running" \
            else ("RESUBMITTED", "STOPPED", "DONE", "UTIL_OK")
        if len(rest) < 2 or rest[0] not in kinds:
            sys.exit("nrp-task report %s 'one line'" % "|".join(kinds))
        line = " ".join(" ".join(rest[1:]).split())[:400]
        task_txn(n, lambda t: (t.update(report={"status": rest[0], "line": line, "ts": now()}), tev(t, "agent report %s: %s" % (rest[0], line))))
        print("recorded")
        return 0
    sys.exit(usage)


# ---- chain commands --------------------------------------------------------------------------------------------
def cmd_chain_add(a):
    try:
        raw, text = load_chain_file(a.file)
        if isinstance(raw, dict):
            raw["origin"] = origin_overlay(raw.get("origin"), a)
        c, warn = validate_chain(raw)
    except ChainError as e:
        sys.exit("chain file refused: %s" % e)
    if not a.dry_run:
        require_origin_note(c["origin"], "chain", c["name"])
    for w in warn:
        print("warning: " + w, file=sys.stderr)
    if a.dry_run:
        print("chain %s valid: %d steps. Dry-running steps that have --apply (without it):" % (c["name"], len(c["steps"])))
        return 1 if dry_run_steps(c) else 0

    def create():
        if chain_path(c["name"]).exists():
            sys.exit("chain %s already exists (`chain show`, or choose another name)" % c["name"])
        owner_of = {}
        for n in chain_names():
            o = chain_load(n)
            if o and o["status"] in OBSERVED:
                owner_of.update({s["job"]: n for s in o["steps"] if s["state"] != "done"})
        dup = [s["job"] for s in c["steps"] if s["job"] in owner_of]
        if dup:
            sys.exit("Job name(s) %s already belong to chain %s" % (", ".join(dup), owner_of[dup[0]]))
        d = CHAINS / c["name"]
        d.mkdir(parents=True, exist_ok=True)
        (d / "spec.original.json").write_text(text)                      # the copy that nothing reads at run time
        chain_write(c)
    with state_lock():
        create()
    log("chain add %s: %d steps" % (c["name"], len(c["steps"])))
    n = collections.Counter(s["state"] for s in c["steps"])
    print("chain %s added: %d steps (%d pending, %d running, %d done). The next `nrp-monitor run` pass starts it; "
          "`nrp-monitor chain wait %s` blocks until it ends." % (c["name"], len(c["steps"]), n["pending"], n["running"], n["done"], c["name"]))
    return 0


def cmd_chain_list(a):
    names = chain_names()
    if not names:
        print("no chains")
    for n in names:
        c = chain_load(n)
        if not c:
            continue
        cnt = collections.Counter(s["state"] for s in c["steps"])
        print("%-9s %-28s %d/%d done%s%s  [%s] <%s> %s" % (c["status"], n, cnt["done"], len(c["steps"]),
              ", %d running" % cnt["running"] if cnt["running"] else "", ", %d failed" % cnt["failed"] if cnt["failed"] else "",
              c["owner"][:40], (c.get("origin") or {}).get("title") or ORIGIN_MISSING, c["reason"][:90]))
    return 0


def cmd_chain_show(a):
    c = chain_load(a.name)
    if not c:
        sys.exit("no chain %s" % a.name)
    print("%s [%s] owner=%s ns=%s created %s ago on_finish=%s" % (c["name"], c["status"], c["owner"], c["namespace"],
          ago(c["created"]), c["on_finish"]))
    print("origin: " + origin_plain(c.get("origin"), "owner field: %s" % (c.get("owner") or "-")))
    if c["reason"]:
        print("reason: " + c["reason"])
    for s in c["steps"]:
        extra = " after=%s" % ",".join(s["after"]) if s["after"] else ""
        extra += " GATE%s" % ("(cleared)" if s.get("gate_cleared") else "") if s.get("gate") else ""
        if s["state"] == "running":
            extra += " running %s" % ago(s["submitted"])
        if s.get("reason"):
            extra += " (%s)" % s["reason"][:120]
        if s.get("logs"):
            extra += " log=%s" % s["logs"]
        print("  %-12s %-10s %s%s" % (s["id"], s["state"], s["job"], extra))
    for e in c.get("events", [])[-5:]:
        print("  . " + e)
    hb = heartbeat_age()
    print("monitor heartbeat: %s" % ("none" if hb is None else ago(hb) + " ago"))
    return 0


def cmd_chain_cancel(a):
    def f(c):
        if c["status"] in ("finished", "cancelled"):
            return False
        c["status"], c["reason"] = "cancelled", "cancelled by a person"
        ev(c, "cancelled")
    if not chain_txn(a.name, f):
        sys.exit("chain %s not found or already ended" % a.name)
    c = chain_load(a.name)
    left = [s["job"] for s in c["steps"] if s["state"] in ("running", "submitting")]
    print("chain %s cancelled. Nothing is deleted; Jobs still in the cluster: %s" % (a.name, ", ".join(left) or "none"))
    return 0


def cmd_chain_resume(a):
    edits = {}
    for kv in a.edit_step or []:
        if len(kv) != 2 or "=" not in kv[1]:
            sys.exit("--edit-step STEP key=value")
        k, v = kv[1].split("=", 1)
        try:
            v = json.loads(v)
        except ValueError:
            pass
        edits.setdefault(kv[0], []).append((k, v))
    err = []

    def f(c):
        if c["status"] not in ("stopped", "gated"):
            err.append("chain %s is %s: only a stopped or gated chain can be resumed" % (c["name"], c["status"]))
            return False
        ids = {s["id"] for s in c["steps"]}
        for sid in list(edits) + list(a.skip or []):
            if sid not in ids:
                err.append("no step %s" % sid)
                return False
        for sid, kvs in edits.items():
            s = step_of(c, sid)
            for k, v in kvs:
                head, _, tail = k.partition(".")
                if head == "env" and tail and isinstance(v, str):
                    s["env"][tail] = v
                elif k == "argv" and isinstance(v, list) and v and all(isinstance(x, str) for x in v):
                    s["argv"] = v
                elif k == "job" and isinstance(v, str) and JOB_RE.match(v) and len(v) <= 63:
                    s["job"] = v
                elif k == "cwd" and isinstance(v, str) and os.path.isdir(os.path.expanduser(v)) and not under_protected(v):
                    s["cwd"] = os.path.expanduser(v)
                elif k == "deadline_s" and isinstance(v, int) and v > 0:
                    s["deadline_s"] = v
                elif k == "done_s3" and isinstance(v, list) and all(isinstance(x, str) for x in v):
                    s["done_s3"] = v
                else:
                    err.append("cannot edit %s.%s (editable: argv, job, cwd, deadline_s, done_s3, env.KEY; value JSON)" % (sid, k))
                    return False
        for sid in a.skip or []:
            s = step_of(c, sid)
            s.update(state="done", skipped=True, done_ts=now(), reason="skipped by a person")
        for s in c["steps"]:
            if s["state"] == "failed":
                s["state"], s["retry_cleanup"], s["reason"] = "pending", True, ""
                s.pop("logs_saved", None)
                s.pop("s3_errors", None)
            if s["id"] == c.get("gate_step") or (s.get("gate") and not s.get("gate_cleared") and c["status"] == "gated"):
                s["gate_cleared"] = True
        c["status"], c["reason"] = "active", ""
        c.pop("gate_step", None)
        ev(c, "resumed%s%s" % (" skip=" + ",".join(a.skip) if a.skip else "", " edits=" + ",".join(edits) if edits else ""))
    ok = chain_txn(a.name, f) if chain_load(a.name) else err.append("no chain %s" % a.name)
    if err or not ok:
        sys.exit(err[0] if err else "resume failed")
    print("chain %s resumed; the next run pass continues it" % a.name)
    return 0


def heartbeat_age():
    try:
        return HEART.stat().st_mtime
    except OSError:
        return None


def write_heartbeat(text):
    STATE.mkdir(parents=True, exist_ok=True)
    HEART.write_text("%s %s\n" % (iso(), text))


def cmd_chain_wait(a):
    start = now()
    while True:
        c = chain_load(a.name)
        if c is None:
            print("ERROR no chain %s" % a.name)
            return 2
        st_ = c["status"]
        cnt = collections.Counter(s["state"] for s in c["steps"])
        prog = "%d/%d done" % (cnt["done"], len(c["steps"]))
        if st_ == "finished":
            print("FINISHED %s: %s" % (a.name, prog))
            return 0
        if st_ in ("stopped", "cancelled"):
            print("%s %s: %s; %s" % (st_.upper(), a.name, prog, c["reason"][:160]))
            return 1
        if st_ == "gated":
            print("GATED %s: %s; %s" % (a.name, prog, c["reason"][:160]))
            return 4
        hb = max(heartbeat_age() or 0, c["created"])
        if now() - hb > HEART_STALL_S:
            print("STALLED %s: %s; monitor has not run for %s (start `sh -c 'while :; do nrp-monitor run; sleep 300; done'`)"
                  % (a.name, prog, ago(hb)))
            return 5
        if a.m and now() - start >= a.m:
            print("RUNNING %s: %s; %s" % (a.name, prog, ", ".join("%s=%s" % (s["id"], s["state"]) for s in c["steps"] if s["state"] in ("running", "submitting"))))
            return 3
        time.sleep(min(WAIT_POLL_S, max(1, a.m - (now() - start))) if a.m else WAIT_POLL_S)


# ---- setup: choose each tier's backend from the subscriptions the user has (writes agents.json) ----------------------
# Tier 1 (triage) and Tier 2 (fixer) are configurable; Tier 3 is always the coordinator chat and there is no separate Opus tier.
SUBSCRIPTIONS = ("claude", "codex", "gemini", "agy", "t3")          # t3 only changes what is explained: it is a harness for the coordinator chat, not a runner
SETUP_TIERS = (("triage", "Tier 1 triage judge (reads one event, answers CLOSE / ESCALATE)"),
               ("task", "Tier 2 fixer (edits manifests and code, resubmits)"))
SETUP_DEFAULT_MODEL = {("claude", "triage"): "haiku", ("claude", "task"): "sonnet", ("codex", "triage"): "gpt-6.1-sol", ("codex", "task"): "gpt-6.1-sol",
                       ("gemini", "triage"): "gemini-3.8-flash"}


def installed_runners():
    return [r for r in KNOWN_RUNNERS if shutil.which(r)]


def suggest_tiers(have):
    """The suggested ordered backends per tier for the runners `have` (installed AND subscribed). Gemini flash with the lowest thinking for
    triage when available (its only tier), Sonnet for the fixer; the other available runner is listed after as the failover."""
    tiers = {}
    tri = []
    if "agy" in have:
        tri.append({"runner": "agy", "model": "gemini-3.8-flash-low"})
    if "gemini" in have:
        tri.append({"runner": "gemini", "model": SETUP_DEFAULT_MODEL[("gemini", "triage")], "thinking": "lowest"})
    for r in ("claude", "codex"):
        if r in have:
            tri.append({"runner": r, "model": SETUP_DEFAULT_MODEL[(r, "triage")]})
    fix = [{"runner": r, "model": SETUP_DEFAULT_MODEL[(r, "task")]} for r in ("claude", "codex") if r in have]
    if tri:
        tiers["triage"] = tri[:3]
    if fix:
        tiers["task"] = fix[:3]
    return tiers


def parse_backend_spec(tier, text, i=0):
    """'runner[:model[:thinking]]' -> a validated backend dict (ValueError names the problem)."""
    parts = [x.strip() for x in text.split(":")]
    if not parts[0] or len(parts) > 3:
        raise ValueError("backend %r: runner[:model[:thinking]]" % text)
    b = {"runner": parts[0]}
    if len(parts) > 1 and parts[1]:
        b["model"] = parts[1]
    if len(parts) > 2 and parts[2]:
        b["thinking"] = int(parts[2]) if parts[2].isdigit() else parts[2]
    return check_backend(tier, i, b)


def parse_backend_list(tier, text):
    return [parse_backend_spec(tier, x, i) for i, x in enumerate(t for t in text.split(",") if t.strip())]


def backend_label(b):
    return "%s%s%s" % (b["runner"], "/" + b["model"] if b.get("model") else " (CLI default model)", ", thinking " + str(b["thinking"]) if b.get("thinking") is not None else "")


def setup_config(old, tiers):
    """The agents.json object to write: whatever the user already had (limits, models, follow-up ladder) plus `tiers`, and `runners` (the
    tiers' runners, fixer first; read-only runners are still excluded from writing tiers)."""
    cfg = {k: v for k, v in (old or {}).items() if k != "tiers"}
    cfg["tiers"] = dict((old or {}).get("tiers") or {}, **tiers)
    runners = []
    for tier in ("task", "triage", "deputy"):
        for b in cfg["tiers"].get(tier, []):
            if b["runner"] not in runners:
                runners.append(b["runner"])
    if runners:
        cfg["runners"] = runners
    else:
        cfg.pop("runners", None)
    return {k: cfg[k] for k in ("runners", "tiers", "models", "limits", "followup_ladder") if k in cfg}


def write_agents_cfg(new_text):
    """Atomically replace agents.json with `new_text`, keeping the old file as agents.json.bak. Returns the backup path or None."""
    AGENTS_CFG.parent.mkdir(parents=True, exist_ok=True)
    bak = None
    if AGENTS_CFG.exists():
        bak = AGENTS_CFG.with_name(AGENTS_CFG.name + ".bak")
        shutil.copy2(str(AGENTS_CFG), str(bak))
    tmp = AGENTS_CFG.with_name(AGENTS_CFG.name + ".tmp")
    tmp.write_text(new_text)
    os.chmod(str(tmp), 0o600)
    os.replace(str(tmp), str(AGENTS_CFG))
    return bak


def setup_ask(prompt, default=""):
    try:
        ans = input("%s%s: " % (prompt, " [%s]" % default if default else "")).strip()
    except EOFError:
        sys.exit("setup needs answers: run it in a terminal, or use --non-interactive with --triage/--fixer")
    return ans or default


def cmd_setup(a):
    import difflib
    installed = installed_runners()
    interactive = not a.non_interactive
    if interactive and not sys.stdin.isatty() and not os.environ.get("NRP_MONITOR_SETUP_ANYSTDIN"):
        sys.exit("setup is interactive and stdin is not a terminal. Run it in a terminal, or pass --non-interactive "
                 "[--subscriptions claude,gemini] [--triage RUNNER:MODEL[:THINKING],...] [--fixer RUNNER:MODEL,...] [--dry-run].")
    print("NRP monitor setup: which assistants run its background agents (Tier 1 triage, Tier 2 fixer).")
    print("Tier 3 is always the chat that owns the work (woken once per finished step, or as a last resort); there is no separate Opus tier.\n")
    print("Installed CLIs: %s" % (", ".join("%s (%s)" % (r, shutil.which(r)) for r in installed) or "none found on PATH"))
    if a.subscriptions is not None:
        subs = [x.strip() for x in a.subscriptions.split(",") if x.strip()]
    elif interactive:
        ans = setup_ask("Which do you have a subscription or API access for? (%s)" % ", ".join(SUBSCRIPTIONS), ",".join(installed) or "claude")
        subs = [x.strip().lower() for x in ans.replace(" ", ",").split(",") if x.strip()]
    else:
        subs = list(installed)
    bad = [x for x in subs if x not in SUBSCRIPTIONS]
    if bad:
        sys.exit("unknown subscription(s) %s (choose from %s)" % (", ".join(bad), ", ".join(SUBSCRIPTIONS)))
    for r in subs:
        if r in KNOWN_RUNNERS and r not in installed:
            print("note: you named %s but its CLI is not on PATH; install it before using it (it is left out of the suggestions)." % r)
    have = [r for r in KNOWN_RUNNERS if r in subs and r in installed]
    if "t3" in subs:
        print("T3: the coordinator chat is woken through the task's webhook relay (configured per task by the operator); the T3 chat itself "
              "may run Claude or Codex, which is a separate choice from the agents below.")
    sugg = suggest_tiers(have)
    tiers, explicit = {}, {"triage": a.triage, "task": a.fixer}
    for tier, title in SETUP_TIERS:
        if explicit[tier]:
            try:
                tiers[tier] = parse_backend_list(tier, explicit[tier])
            except ValueError as e:
                sys.exit("--%s: %s" % ("fixer" if tier == "task" else "triage", e))
            if not tiers[tier]:
                sys.exit("--%s: at least one backend" % ("fixer" if tier == "task" else "triage"))
            continue
        default = sugg.get(tier, [])
        if not default:
            sys.exit("no backend is available for %s: it needs %s installed and in your subscriptions" % (title, "Claude Code or Codex" if tier == "task" else "Claude Code, Codex or Gemini CLI"))
        if interactive:
            print("\n%s\n  suggested, in order (the next is used only when the one before is unavailable):" % title)
            for i, b in enumerate(default, 1):
                print("   %d. %s" % (i, backend_label(b)))
            print("  Enter to accept, or type backends as runner[:model[:thinking]],... (e.g. gemini:gemini-3.8-flash:lowest,claude:haiku).")
            while True:
                ans = setup_ask("%s backends" % ("Tier 1" if tier == "triage" else "Tier 2"), "")
                try:
                    tiers[tier] = parse_backend_list(tier, ans) if ans else default
                    unavailable = [b["runner"] for b in tiers[tier] if b["runner"] not in have]
                    if unavailable:
                        print("  %s: not installed or not in your subscriptions; they stay in the list but will be skipped." % ", ".join(sorted(set(unavailable))))
                    break
                except ValueError as e:
                    print("  %s" % e)
        else:
            tiers[tier] = default
    old, old_text = None, ""
    if AGENTS_CFG.exists():
        old_text = AGENTS_CFG.read_text()
        try:
            old = json.loads(old_text)
            if not isinstance(old, dict):
                raise ValueError("not an object")
        except ValueError:
            sys.exit("%s exists but is not valid JSON; fix or move it first (setup will not overwrite what it cannot read)" % AGENTS_CFG)
    if getattr(a, "deputy", None):
        try:
            tiers["deputy"] = parse_backend_list("deputy", a.deputy)
        except ValueError as e:
            sys.exit("--deputy: %s" % e)
    new = setup_config(old, tiers)
    try:
        parse_agent_cfg(new)
    except ValueError as e:
        sys.exit("the chosen configuration is invalid: %s" % e)
    new_text = json.dumps(new, indent=2) + "\n"
    old_lines = old_text.splitlines(True)
    if old_lines and not old_lines[-1].endswith("\n"):
        old_lines[-1] += "\n"
    diff = "".join(difflib.unified_diff(old_lines, new_text.splitlines(True), "agents.json (current)" if old is not None else "(new file)", "agents.json (proposed)"))
    if not diff:
        print("\nagents.json already matches: nothing to change.")
        return 0
    print("\n" + diff)
    if a.dry_run:
        print("(dry run: nothing written)")
        return 0
    if interactive and setup_ask("Write %s%s? (y/n)" % (AGENTS_CFG, " (the old file is kept as .bak)" if old is not None else ""), "y").lower() not in ("y", "yes"):
        print("nothing written")
        return 1
    bak = write_agents_cfg(new_text)
    print("wrote %s%s. Check with `nrp-monitor agents` and `nrp-monitor agents test`." % (AGENTS_CFG, " (previous version: %s)" % bak if bak else ""))
    return 0


def cmd_agents(a):
    cfg, problem = load_agent_cfg()
    if a.acmd == "unblock":
        st = read_json(RUNNER_STATE, {})
        if a.runner not in KNOWN_RUNNERS:
            sys.exit("runner must be one of %s" % ", ".join(KNOWN_RUNNERS))
        st.pop(a.runner, None)
        write_json(RUNNER_STATE, st)
        push_clear("agents:unavailable")
        print("%s: block cleared" % a.runner)
        return 0
    if a.acmd == "test":
        spec = {"tier": "triage", "allowed": [], "json": False, "deny": []}
        (WORK / "followup").mkdir(parents=True, exist_ok=True)
        rc = 0
        for r in ([a.runner] if a.runner else list(dict.fromkeys(cfg["runners"] + [b["runner"] for bs in cfg.get("tiers", {}).values() for b in bs]))):
            if r not in KNOWN_RUNNERS or not runner_ready(r):
                print("%-7s not installed" % r)
                rc = 1
                continue
            t0 = time.time()
            bk = next((x for x in tier_backends("triage") if x["runner"] == r), {"runner": r})
            status, out, err, code = RUNNER_EXEC[r](dict(spec, backend=bk), "Reply with exactly the single word OK and nothing else.", WORK / "followup", 180, clean_env())
            if status in ("limit", "auth"):
                block_runner(r, out, err, status)
            ok = status == "ok" and not code and out.strip().upper().startswith("OK")
            print("%-7s %s in %.0fs: %s" % (r, "works" if ok else "FAILED (%s)" % status, time.time() - t0,
                                           " ".join((out or err or "").split())[-120:]))
            rc = rc or (0 if ok else 1)
        return rc
    print("config: %s%s" % (AGENTS_CFG, "" if AGENTS_CFG.exists() else " (absent: Claude only, built-in models)"))
    if problem:
        print("PROBLEM: " + problem)
    st = read_json(RUNNER_STATE, {})
    for r in cfg["runners"]:
        u = float((st.get(r) or {}).get("until", 0))
        print("runner %d: %-7s %s" % (cfg["runners"].index(r) + 1, r, "NOT INSTALLED" if not runner_ready(r) else
              "out of usage until %s (%s)" % (iso_at(u), st[r].get("why", "")[:70]) if u > now() else "ready"))
    for tier in TIERS:
        lim = cfg["limits"][tier]
        print("  %-11s %s  turns %s budget $%s timeout %ss (turns/budget: Claude only)" % (
              tier, " -> ".join("%s%s%s" % (x["runner"], "/" + x["model"] if x.get("model") else " (default model)",
                                           " thinking=%s" % x["thinking"] if x.get("thinking") is not None else "") for x in tier_backends(tier)) or "(no backend)",
              lim["turns"], lim["budget"], lim["timeout"]))
    print("Tier 3 (every task): its coordinator chat, woken through its origin (t3 CLI/webhook / claude or codex session); no model entry")
    print("job follow-up ladder: " + " -> ".join(cfg["followup_ladder"]) + " -> a person")
    return 0


def cmd_status(a):
    for line in bad_node_lines():
        print(line)
    hb = heartbeat_age()
    chains = [chain_load(n) for n in chain_names()]
    live = [c for c in chains if c and c["status"] in LIVE]
    watching = [j for j, r in load()["jobs"].items() if r.get("status") == "watching"]
    tasks = [n for n in task_names() if (task_load(n) or {}).get("status") in TASK_LIVE]
    active = len(live) + len(watching) + len(tasks)
    age = None if hb is None else now() - hb
    # counts are registrations, not Kubernetes Jobs: a task covers many Jobs (its stages), a legacy `add` covers one
    n_stage_jobs = sum(1 for n in tasks for s in (task_load(n) or {}).get("stages", []) if s["state"] == "running")
    desc = "%d chain(s), %d task(s) (%d running stage Job(s)) and %d legacy watched job(s) active" % (len(live), len(tasks), n_stage_jobs, len(watching))
    if active and (age is None or age > HEART_WARN_S):
        print("WARNING: nrp-monitor %s but %s; nothing is being submitted, checked or notified. Start: "
              "sh -c 'while :; do nrp-monitor run; sleep 300; done'" %
              ("has never run" if age is None else "has not run for %d min" % (age // 60), desc))
        return 3
    nh = needs_owner()
    if nh:
        print("nrp-monitor: %d task(s) need the owner: %s  (`nrp-monitor digest`)" % (len(nh), "; ".join(
              "%s: %s" % (n, (t.get("reason") or "")[:100]) for n, t in nh[:3])))
    co = coordinating()
    if co:
        print("nrp-monitor: %d task(s) wait on their coordinator chat (the owner is told only if the chat says so): %s" % (
              len(co), "; ".join("%s: %s" % (n, (t.get("reason") or "")[:80]) for n, t in co[:3])))
    blocked = [r for r in agent_cfg()["runners"] if runner_blocked(r)]
    if blocked:
        print("nrp-monitor: agent runner(s) out of usage: %s%s  (`nrp-monitor agents`)" % (", ".join(blocked),
              "; NO runner left, agent work is waiting" if not agents_available() else "; work uses the next runner"))
    if not a.quiet:
        print("ok: heartbeat %s, %s" % ("none" if age is None else ago(hb) + " ago", desc))
    return 0


def save_merged(st):
    """Save jobs.json, keeping registrations that `add` wrote while this (possibly long) pass ran."""
    with state_lock():
        disk = load()
        for k, v in disk["jobs"].items():
            st["jobs"].setdefault(k, v)
            if v.get("origin") and not st["jobs"][k].get("origin"):        # `origin job` ran while this pass held a stale copy
                st["jobs"][k]["origin"] = v["origin"]
        save(st)


def cmd_run(a):
    global S3_PASS
    try:
        return cmd_run_pass(a)
    finally:
        S3_PASS = None


def cmd_run_pass(a):
    STATE.mkdir(parents=True, exist_ok=True)
    lock = open(LOCK, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0                                                              # another pass is running
    st = load()
    PASS.clear()
    t0 = now()
    try:
        s3_prepass(a)                                                         # success markers/gates checked once; in-cluster fallback if S3 is unreachable from here
    except Exception as e:
        log("s3_prepass error: %s: %s" % (type(e).__name__, str(e)[:150]))

    def beat(tag):
        if not a.dry_run:
            write_heartbeat("%s %s" % (tag, " ".join("%s=%s" % kv for kv in sorted(PASS.items())) or "idle"))
    first = () if a.tasks_only else (process_chains,)                       # chains first: submits are time-critical
    for fn in first:
        try:
            fn(a, st)
        except Exception as e:
            log("%s error: %s" % (fn.__name__, str(e)[:150]))
    beat("chains-done")
    rest = (process_tasks, process_continuations, process_task_webhooks) if a.tasks_only else (check_pods, process_tasks, process_continuations, process_task_webhooks, check_jobs,
                                                                         run_chain_followups, check_orphans)
    for fn in rest:
        try:
            fn(a, st)
        except Exception as e:
            log("%s error: %s" % (fn.__name__, str(e)[:150]))
        beat("after-" + fn.__name__)
    if not a.dry_run:
        save_merged(st)
        beat("pass-ok %ds" % (now() - t0))
        try:
            daily_digest(a)
        except Exception as e:
            log("digest error: %s" % str(e)[:150])
    return 0


def cmd_add(a):
    resume = None
    if a.resume:
        p = Path(a.resume).expanduser().resolve()
        if not p.is_file():
            sys.exit("resume file not found: %s" % p)
        size = p.stat().st_size
        if size > RESUME_MAX:
            sys.exit("resume file %s is %d KB; the limit is %d KB. A fresh follow-up agent reads it whole, so register a "
                     "short notes file instead (output prefix, what to do with the result, next commands), not a LOG.md."
                     % (p, size // 1024, RESUME_MAX // 1024))
        RESUME_DIR.mkdir(parents=True, exist_ok=True)
        dst = RESUME_DIR / ("%s.md" % re.sub(r"[^A-Za-z0-9_.-]", "_", a.job))
        shutil.copyfile(p, dst)                                               # run time never reads the Desktop
        resume = str(dst)
    with state_lock():
        st = load()
        rec = {"added": now(), "ns": a.n, "label": a.label or "", "resume": resume, "status": "watching"}
        try:                                     # explicit origin, else the origin of the same Job / its predecessor (repair agents re-register)
            rec["origin"] = (norm_origin(origin_overlay(None, a)) or (st["jobs"].get(a.continue_from or "") or st["jobs"].get(a.job) or {}).get("origin"))
        except ChainError as e:
            sys.exit("add refused: %s" % e)
        if not rec["origin"]:
            del rec["origin"]
            require_origin_note(None, "job", a.job)
        if a.continue_from:                                                    # a replacement Job for an authorized task
            old = st["jobs"].get(a.continue_from)
            au = old and old.get("authorize")
            if not au:
                sys.exit("%s is not an authorized task; register with --authorize instead" % a.continue_from)
            fail = " ".join((a.failure or "").lower().split())
            if not fail:
                sys.exit("--continue-from needs --failure 'one line: why the previous Job failed'")
            if au["attempt"] + 1 > au["max"]:
                sys.exit("ATTEMPT CAP REACHED (%d of %d used). Do not resubmit: report the diagnosis (cause, what was tried) as your final line."
                         % (au["attempt"], au["max"]))
            if fail in [f.lower() for f in au.get("failures", [])]:
                sys.exit("SAME FAILURE as an earlier attempt (%r). Do not resubmit: report it as your final line; a person must decide." % fail)
            rec["authorize"] = dict(au, attempt=au["attempt"] + 1, failures=au.get("failures", []) + [fail])
            if not resume:                                                     # keep the old notes, add a lineage line
                rec["resume"] = old.get("resume")
        elif a.authorize:
            adir = APPROVED / re.sub(r"[^A-Za-z0-9_.-]", "_", a.job)
            adir.mkdir(parents=True, exist_ok=True)
            au = {"root": a.job, "max": a.max_attempts, "attempt": 1, "dir": str(adir), "failures": []}
            if a.manifest:
                src_m = Path(a.manifest).expanduser().resolve()
                if src_m != (adir / "manifest.yaml").resolve():                 # already in the task dir (an agent wrote it there)
                    shutil.copyfile(src_m, adir / "manifest.yaml")
                au["manifest"] = True
            if a.code_dir:
                au["code"] = snapshot_code(Path(a.code_dir).expanduser().resolve(), adir)
            rec["authorize"] = au
        st["jobs"][a.job] = rec
        save(st)
    au = rec.get("authorize")
    log("add %s resume=%s label=%s%s" % (a.job, rec["resume"], a.label,
        " authorized attempt %d/%d" % (au["attempt"], au["max"]) if au else ""))
    print("watching %s [%s]%s%s" % (a.job, origin_plain(rec.get("origin")), " (resume copy: %s)" % rec["resume"] if rec["resume"] else " (notify only)",
          "; AUTHORIZED attempt %d of %d, task dir %s" % (au["attempt"], au["max"], au["dir"]) if au else ""))
    return 0


def snapshot_code(src, adir):
    """Copy a code folder (no data/weights/git) to approved/<task>/code and code.orig, so a launchd agent (which cannot read
    Desktop) can fix and rebuild a ConfigMap; the diff is kept in PATCH.diff for a person to merge. Refuses > 30 MB."""
    total = 0
    files = []
    for f in src.rglob("*"):
        rel = f.relative_to(src)
        if f.is_dir() or any(part in CODE_SKIP for part in rel.parts) or f.suffix in CODE_SKIP_EXT:
            continue
        total += f.stat().st_size
        files.append(rel)
    if total > CODE_SNAPSHOT_MAX:
        sys.exit("code dir snapshot is %d MB (limit 30 MB): point --code-dir at a smaller folder" % (total // 2**20))
    for name in ("code", "code.orig"):
        shutil.rmtree(adir / name, ignore_errors=True)
        for rel in files:
            (adir / name / rel).parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(src / rel, adir / name / rel)
    return True


def cmd_list(a):
    st = load()
    if not st["jobs"]:
        print("no registered jobs")
    for j, r in sorted(st["jobs"].items()):
        print("%-8s %s  added %s%s%s" % (r.get("status"), j, datetime.fromtimestamp(r["added"]).strftime("%m-%d %H:%M"),
              "  resume=" + r["resume"] if r.get("resume") else "", "  [" + r["label"] + "]" if r.get("label") else ""))
    return 0


def cmd_log(a):
    if LOG.exists():
        print("\n".join(LOG.read_text().splitlines()[-a.n:]))
    return 0


