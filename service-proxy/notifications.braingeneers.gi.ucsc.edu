# Keep the normal oauth2-proxy/session-or-service-account-JWT authentication,
# trusted identity headers, and downstream Authorization stripping.
include /etc/nginx/vhost.d/default;

access_log /var/log/nginx/notifications.access.log vhost;
error_log /var/log/nginx/notifications.error.log info;
client_max_body_size 12m;
client_body_buffer_size 128k;
client_body_timeout 30s;
proxy_read_timeout 45s;
proxy_send_timeout 45s;
